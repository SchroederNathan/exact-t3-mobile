shape ReviewRow
  id: string
  kind: string
  text: string
  oldLine: string
  newLine: string

shape TurnReview
  threadId: string
  turnCount: number
  rows: ReviewRow[]
  error: string

component TurnReviewContent
  props
    review: TurnReview
    loading: bool
    failure: bool
    retry: action
  view
    if loading and not failure
      text "Loading changes…" color="muted" padding=16 font-size=14 line-height="19px" testId="turn-review-loading"
    else if failure or review.error != ""
      column padding=16 gap=12
        text (failure ? "This diff could not be loaded." : review.error) color="danger" font-size=14 line-height="19px" testId="turn-review-error"
        button press=retry min-height=44 testId="turn-review-retry"
          text "Retry"
    else if review.rows.length == 0
      text "No changes in this turn." color="muted" padding=16 font-size=14 line-height="19px" testId="turn-review-empty"
    else
      list id="turn-review-lines" appearance="none" virtualized=true flex=1 min-height=0 estimated-item-height=22 padding-bottom=12 background-color="code-surface"
        for line in review.rows key=line.id
          column min-width=0
            if line.kind == "file"
              column margin="6px 8px" padding="10px" min-height=44 box-sizing="border-box" justify-content="center" border-radius=10 background-color="code-surface" border="1px solid var(--edge)"
                text line.text role="heading" aria-level=3 font-family="system-ui" font-size=11 line-height="16px" font-weight=600 white-space="pre-wrap" overflow-wrap="break-word" color="foreground" testId=`review-file-${line.id}`
            else if line.kind == "hunk" or line.kind == "meta"
              text line.text user-select="text" font-family="ui-monospace" font-size=11 line-height="22px" font-weight=(line.kind == "hunk" ? 500 : 400) color=(line.kind == "hunk" ? "foreground" : "muted") background-color=(line.kind == "hunk" ? "card" : "transparent") padding=(line.kind == "hunk" ? "0 7px 0 57px" : "0 12px") white-space="pre-wrap" overflow-wrap="break-word" testId=`review-${line.kind}-${line.id}`
            else
              row min-height=22 align-items="stretch" background-color=(line.kind == "addition" ? "light-dark(#e5f8f5, #0d2f28)" : line.kind == "deletion" ? "light-dark(#ffe6e7, #391415)" : "transparent") testId=`review-line-${line.id}`
                view width=4 flex-shrink=0 background-color=(line.kind == "addition" ? "#00cab1" : line.kind == "deletion" ? "#ff2e3f" : "transparent")
                text (line.newLine != "" ? line.newLine : line.oldLine) width=46 flex-shrink=0 box-sizing="border-box" padding-right=7 text-align="right" color=(line.kind == "addition" ? "light-dark(#199f43, #5ecc71)" : line.kind == "deletion" ? "light-dark(#d52c36, #ff6762)" : "muted") font-family="ui-monospace" font-size=11 line-height="22px" font-variant-numeric="tabular-nums"
                text (line.text == "" ? " " : line.text.replaceAll("\t", "    ")) user-select="text" flex=1 min-width=0 padding="0 7px" color="foreground" font-family="ui-monospace" font-size=12 line-height="22px" white-space="pre-wrap" overflow-wrap="break-word"
