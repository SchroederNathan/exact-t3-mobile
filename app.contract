                              if pull.row.review != ""
                                image (pull.row.review == "Reviews approved" ? "symbol:sf/person.fill.checkmark" : pull.row.review == "Changes requested" ? "symbol:sf/person.fill.xmark" : "symbol:sf/person.badge.clock") color=(pull.row.review == "Reviews approved" ? "status-done" : pull.row.review == "Changes requested" ? "danger" : pull.row.review == "Your review requested" ? "status-warning" : "muted") width=13 height=13 flex-shrink=0
                              if pull.row.addedText != "" or pull.row.deletedText != ""
                                row align-items="center" gap=7 flex-shrink=0
