                      column id="composer-surface" focusin=composerFocused focusout=composerBlurred flex=1 min-width=0 box-sizing="border-box" padding="2px 0" border-radius=27 backgroundMaterial="glass" box-shadow="0 6px 28px var(--composer-shadow)" testId="composer-surface"
                        if composerFocus and composerAttachments.length > 0
                          ComposerAttachments(items=composerAttachments, uploads=uploadProgresses, remove=removeAttachment, retry=retryAttachment, preview=previewDraftAttachment)
                        row flex-wrap="wrap" align-items="flex-end" min-width=0
                          button popovertarget="attachment-menu" disabled=(not draftsReady or pending(stagedAttachments)) appearance="none" order=1 display="flex" align-items="center" justify-content="center" flex-shrink=0 aria-label="Add attachment" width=44 height=44 opacity=(not draftsReady or pending(stagedAttachments) ? 0.5 : 1) testId="add-attachment"
                            image "symbol:sf/plus" width=20 height=20
                          textarea id="composer" disabled=not draftsReady value=composer input=editComposer rows=1 field-sizing="content" order=(composerExpanded ? 0 : 2) width=(composerExpanded ? "calc(100% - 28px)" : "auto") flex-grow=(composerExpanded ? 0 : 1) flex-shrink=(composerExpanded ? 0 : 1) flex-basis=(composerExpanded ? "auto" : "0px") min-width=(composerExpanded or composerAttachments.length > 0 ? "0px" : "40%") margin=(composerExpanded ? "0 14px 8px" : "4px") max-height=104 min-height=36 box-sizing="border-box" padding="6px 0" font-family="DM Sans" font-size=16 line-height="23px" appearance="none" border-width=0 outline="none" background-color="transparent" placeholder=approvalComposerPlaceholder aria-label="Message" testId="composer"
                            ::placeholder
                              color="muted"
                          if not composerFocus and composerAttachments.length > 0
                            row order=3 height=44 flex-shrink=0 align-items="center" gap=4 padding-left=4 testId="composer-thumbnails"
                              for item in composerAttachments.slice(0, composerThumbnailLimit) key=item.localId
                                ComposerThumbnail(item=item, uploads=uploadProgresses, preview=previewDraftAttachment)
                              if composerAttachments.length > composerThumbnailLimit
                                button press=focusComposer appearance="none" display="flex" align-items="center" justify-content="center" width=30 height=30 border-radius=8 background-color="bubble" aria-label="Show all attachments" testId="more-attachments"
                                  text `+${composerAttachments.length - composerThumbnailLimit}` font-size=12 line-height="16px" font-weight=700 color="muted"
                          row order=4 flex-grow=(composerExpanded ? 1 : 0) flex-shrink=1 min-width=0 align-items="center" justify-content="flex-end"
                            button press=openModelSettings disabled=not modelDraftsReady appearance="none" display="flex" align-items="center" gap=8 flex-shrink=1 min-width=0 height=44 padding="0 8px" border-radius=14 color="foreground" opacity=(modelDraftsReady ? 1 : 0.45) aria-label=(composerModel.label == "" ? "Model and reasoning settings" : `Model and reasoning settings, ${composerModel.label}${composerModel.summary == "" ? "" : `, ${composerModel.summary}`}`) testId="model-settings"
                              row width=16 height=16 flex-shrink=0 align-items="center" justify-content="center"
                                ProviderIcon(provider=composerModel.provider, size=16)
                              if composerExpanded
                                text (composerModel.label == "" ? "Choose model" : composerModel.label) flex-shrink=1 min-width=0 font-size=14 line-height="19px" font-weight=500 color="foreground" line-clamp=1 text-overflow="ellipsis" testId="model-label"
                                if composerModel.summary != ""
                                  text composerModel.summary flex-shrink=1 min-width=0 font-size=13 line-height="17px" color="muted" line-clamp=1 text-overflow="ellipsis" testId="model-summary"
                              image "symbol:sf/chevron.down" font-size=10 flex-shrink=0
                            if threadControls.stop.runId != "" and composer.trim() == "" and composerAttachments.length == 0
                              button press=stopTurn(e.params.id, threadControls.accessKey, threadControls.stop.runId) disabled=(not controlsAllowed or stopBusy or threadControls.stop.state == "unresponsive") appearance="none" display="flex" align-items="center" justify-content="center" flex-shrink=0 retainFocus=true aria-label=(stopBusy ? "Stopping turn" : "Stop turn") testId="stop" width=44 height=44
                                row width=30 height=30 border-radius=15 background-color=(controlsAllowed and not stopBusy and threadControls.stop.state != "unresponsive" ? "control-danger-fill" : "send-disabled") color=(controlsAllowed and not stopBusy and threadControls.stop.state != "unresponsive" ? "danger" : "send-disabled-ink") align-items="center" justify-content="center"
                                  image "symbol:sf/stop.fill" font-size=12
                            else
                              button press=sendMessage disabled=not canSend appearance="none" display="flex" align-items="center" justify-content="center" flex-shrink=0 retainFocus=true aria-label=(activeApproval != none and not hasQuestion ? "Send" : threadControls.stop.runId != "" ? "Queue message" : "Send") testId="send" width=44 height=44
                                row width=30 height=30 border-radius=15 background-color=(canSend ? "AccentColor" : "send-disabled") color=(canSend ? "white" : "send-disabled-ink") align-items="center" justify-content="center"
                                  image (threadControls.stop.runId != "" and (activeApproval == none or hasQuestion) ? "symbol:sf/list.number" : "symbol:sf/arrow.up") font-size=16 font-weight=600
              if e.name == "threadSettings"
                column navigationKey=`${e.id}` data-workspace-header="settings-sheet" navigationPresentation="modal" navigationDetent="large" navigationGrabber="visible" navigationScroll="models-list" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    button id="back" press=cancelModelSettings aria-label="Cancel thread settings" testId="cancel-settings"
                      image "symbol:close"
                    text "Thread settings" role="heading" aria-level=2
                    input type="search" value=modelQuery input=searchModels placeholder="Find a model" aria-label="Find a model" testId="model-search"
                    button popovertarget="model-filters" aria-label="Model filters" testId="model-filters-button"
                      image "symbol:filter"
                    button press=saveModelSettings buttonStyle="bordered-prominent" accent-color="foreground" aria-label=settings.saveLabel disabled=(settings.error != "" or pending(settingsUpdated) or pending(settingsClosed)) testId="save-settings"
                      image "symbol:checkmark"
                  scroll id="models-list" flex=1 min-height=0 padding-top=4 padding-bottom="calc(env(safe-area-inset-bottom) + 64px)" background-color="screen"
                    for group in shownModelGroups key=group.id
                      column
                        button press=toggleModelGroup(group.id) disabled=(modelProviderFilter != "" or modelQuery.trim() != "") appearance="none" aria-label=`${group.label}, ${matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites").length} models` display="flex" align-items="center" gap=7 margin="3.5px 14px 0" padding="7px 3.5px 0" min-height=38.5 box-sizing="border-box" text-align="left" color="muted"
                          ProviderIcon(provider=group.provider, size=15)
                          text group.label font-size=14 line-height="19px" font-weight=500
                          view flex=1
                          if modelProviderFilter == "" and modelQuery.trim() == ""
                            if modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, false)
                              text `${matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, false).length}` font-size=12 font-weight=500
                            image (modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, false) ? "symbol:sf/chevron.down" : "symbol:sf/chevron.up") width=12 height=12
                        if not modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, modelProviderFilter != "" or modelQuery.trim() != "")
                          column margin="0 14px" border-radius=14 overflow="hidden" background-color="card"
                            for model, index in matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites") key=model.id
                              if index > 0
                                view height=1 background-color="edge" opacity=0.5
                              row align-items="center" gap=7 padding="0 14px" min-height=38.5
                                button role="radio" aria-checked=(settings.selectedModelId == model.id) press=selectSettingsModel(model.id) disabled=(not model.available or pending(settingsUpdated)) testId=`model-${model.id}` appearance="none" display="flex" align-items="center" gap=7 text-align="left" flex=1 min-width=0 min-height=38.5 color="foreground"
                                  column flex=1 min-width=0
                                    row align-items="center" gap=7
                                      text model.label font-size=16 line-height="23px" font-weight=500 min-width=0 flex-shrink=1 line-clamp=1
                                      if model.isDefault or model.isLegacy
                                        text (model.isDefault ? "Default" : "Legacy") font-size=10 font-weight=700 color="muted" background-color="screen" padding="1.75px 5.25px" border-radius=5.25
                                    if model.unavailableReason != ""
                                      text model.unavailableReason font-size=13 line-height="17px" color="muted"
                                  if settings.selectedModelId == model.id
                                    image "symbol:checkmark" width=16 height=16 font-weight=600
                                button press=toggleModelFavorite(model.id, not model.isFavorite) disabled=pending(favoriteChanged) appearance="none" display="flex" align-items="center" justify-content="center" min-width=38.5 min-height=38.5 color=(model.isFavorite ? "foreground" : "muted") aria-label=`${model.isFavorite ? "Remove from" : "Add to"} favorites: ${group.label}, ${model.label}` testId=`favorite-${model.id}`
                                  image (model.isFavorite ? "symbol:sf/star.fill" : "symbol:sf/star") width=18 height=18
                    if shownModelGroups.length == 0
                      text (modelProviderFilter == "@favorites" ? "No favorite models" : "No matching models") padding="49px 28px" font-size=14 color="muted" text-align="center" testId="empty-models"
                    text "Options" padding="7px 17.5px" font-size=14 line-height="19px" font-weight=500 color="muted"
                    column margin="0 14px" border-radius=14 overflow="hidden" background-color="card"
                      for option in settings.options key=option.id
                        if option.kind == "boolean"
                          row align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box"
                            text option.label font-size=14 line-height="19px" font-weight=500 flex=1
                            input type="checkbox" switch checked=(option.value == "true") change=toggleSettingsOption(option.id) aria-label=option.label testId=`option-${option.id}`
                        else
                          button press=openSettingChoice("option", option.id) testId=`option-${option.id}` appearance="none" display="flex" align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box" color="foreground"
                            text option.label font-size=14 line-height="19px" font-weight=500
                            view flex=1
                            text option.valueLabel font-size=14 line-height="19px" color="muted"
                            image "symbol:forward-chevron" width=12 height=12 color="muted"
                        view height=1 background-color="edge" opacity=0.5
                      button press=openSettingChoice("runtime", "runtime") testId="runtime-options" appearance="none" display="flex" align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box" color="foreground"
                        text "Runtime" font-size=14 line-height="19px" font-weight=500
                        view flex=1
                        text settings.runtimeLabel font-size=14 line-height="19px" color="muted"
                        image "symbol:forward-chevron" width=12 height=12 color="muted"
                    text (favoriteError != "" ? favoriteError : settingsCloseError != "" ? settingsCloseError : settingsUpdateError != "" ? settingsUpdateError : settings.error) margin="7px 17.5px" font-size=13 color="danger" testId="settings-error"
                  column id="model-filters" popover="auto" role="menu"
                    button role="menuitemradio" aria-checked=(modelProviderFilter == "") press=filterModelProvider("")
                      text "All providers"
                    button role="menuitemradio" aria-checked=(modelProviderFilter == "@favorites") press=filterModelProvider("@favorites")
                      text "Favorites"
                    for group in settings.groups key=group.id
                      button role="menuitemradio" aria-checked=(modelProviderFilter == group.id) press=filterModelProvider(group.id)
                        text group.label
                    button role="menuitemcheckbox" aria-checked=showLegacyModels press=toggleLegacyModels
                      text "Show legacy models"
              if e.name == "settingChoice"
                column navigationKey=`${e.id}` data-workspace-header="settings-sheet" navigationScroll="choices-list" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text (e.params.kind == "runtime" ? "Runtime" : optionTitle(settings.options, e.params.option)) role="heading" aria-level=2
                  scroll id="choices-list" flex=1 min-height=0 padding="16px 16px calc(env(safe-area-inset-bottom) + 12px)" background-color="screen"
                    column border-radius=14 overflow="hidden" background-color="card"
                      for choice, index in (e.params.kind == "runtime" ? settings.runtimeChoices : optionChoices(settings.options, e.params.option)) key=choice.id
                        if index > 0
                          view height=1 background-color="edge" opacity=0.5
                        button role="radio" aria-checked=((e.params.kind == "runtime" ? settings.runtimeMode : optionValue(settings.options, e.params.option)) == choice.id) press=chooseSetting(e.params.kind, e.params.option, choice.id) disabled=(not choice.available or pending(settingsUpdated)) testId=`choice-${choice.id}` appearance="none" display="flex" align-items="center" gap=10.5 padding="10.5px 14px" min-height=49 box-sizing="border-box" color="foreground" text-align="left"
                          column flex=1 min-width=0 gap=1.75 opacity=(choice.available ? 1 : 0.5)
                            text choice.label font-size=16 line-height="23px" font-weight=500
                            if choice.description != "" or choice.unavailableReason != ""
                              text (choice.available ? choice.description : choice.unavailableReason) font-size=14 line-height="17.5px" color="muted"
                          if (e.params.kind == "runtime" ? settings.runtimeMode : optionValue(settings.options, e.params.option)) == choice.id
                            image "symbol:checkmark" width=16 height=16 font-weight=600
                    text settingsUpdateError font-size=13 color="danger" margin-top=7
              if e.name == "linkedFile"
                column navigationKey=`${e.id}` navigationScroll="linked-file-lines" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text e.params.file role="heading" aria-level=2
                  if pending(linkedFile)
                    text "Loading…" color="muted" padding=16
                  else if failed(linkedFile) or linkedFile.error != ""
                    text (failed(linkedFile) ? "This file could not be opened." : linkedFile.error) color="danger" padding=16 testId="linked-file-error"
                  else
                    list id="linked-file-lines" appearance="none" virtualized=true flex=1 min-height=0 estimated-item-height=23 padding="12px 0"
                      for line in linkedFile.lines key=line.id
                        row align-items="flex-start" gap=12 padding="0 12px" background-color=(line.id == linkedFile.targetLine ? "thread-selected" : "transparent") testId=`file-line-${line.id}`
                          text line.id color="muted" font-family="Menlo" font-size=12 width=42 text-align="right" line-height="23px"
                          text user-select="text" white-space="pre-wrap" overflow-wrap="break-word" flex=1 min-width=0 color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.prefix white-space="pre-wrap" color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.focus white-space="pre-wrap" color="foreground" background-color="send-disabled" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.suffix white-space="pre-wrap" color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
              if e.name == "turnReview"
                column navigationKey=`${e.id}` navigationScroll="turn-review-lines" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text "Review" role="heading" aria-level=2
                    text `Turn ${e.params.turn}`
                  TurnReviewContent(review=turnReview, loading=(pending(turnReview) or turnReview.threadId != e.params.id or `${turnReview.turnCount}` != e.params.turn), failure=failed(turnReview), retry=retryTurnReview)
              if e.name == "inspector"
                column navigationKey=`${e.id}` navigationScroll="inspector" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text (e.params.kind == "git" ? "Source control" : "Files") role="heading" aria-level=2
                  scroll id="inspector" flex=1 min-height=0 padding=16
                    if e.params.kind == "git" and gitStatus.isRepo and gitStatus.workingFiles.length > 0
                      button press=openGitCommit disabled=gitBusy appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-commit"
                        image "symbol:sf/checkmark.circle" width=20 height=20
                        column flex=1 min-width=0 gap=3
                          text "Commit changes" font-size=16
                          text `${gitStatus.workingFiles.length} changed file${gitStatus.workingFiles.length == 1 ? "" : "s"}` font-size=13 color="muted"
                    if e.params.kind == "git" and gitStatus.isRepo and gitStatus.behindCount > 0
                      button press=pullLatest disabled=gitBusy appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-pull"
                        image "symbol:sf/arrow.down.circle" width=20 height=20
                        column flex=1 min-width=0 gap=3
                          text "Pull latest" font-size=16
                          text `${gitStatus.behindCount} commit${gitStatus.behindCount == 1 ? "" : "s"} behind upstream` font-size=13 color="muted"
                    if e.params.kind == "git" and gitStatus.isRepo and gitStatus.aheadCount > 0
                      button press=requestGitAction("push", false) disabled=(gitBusy or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-push"
                        image "symbol:sf/arrow.up.circle" width=20 height=20
                        column flex=1 min-width=0 gap=3
                          text "Push changes" font-size=16
                          text `${gitStatus.aheadCount} commit${gitStatus.aheadCount == 1 ? "" : "s"} ahead` font-size=13 color="muted"
                    if e.params.kind == "git" and gitStatus.isRepo and gitStatus.aheadCount > 0 and gitStatus.pullRequest == none
                      button press=requestGitAction("create_pr", false) disabled=(gitBusy or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-create-pr"
                        image "symbol:sf/arrow.up.right.circle" width=20 height=20
                        column flex=1 min-width=0 gap=3
                          text "Create pull request" font-size=16
                          text "Publish this branch for review" font-size=13 color="muted"
                    if e.params.kind == "git" and gitStatus.isRepo
                      text "Branches & worktrees" font-size=17 font-weight=700 padding-top=18 padding-bottom=4
                      if pending(gitRefs)
                        text "Loading branches…" color="muted" testId="git-branches-loading"
                      else if gitRefs.refs.length == 0
                        text "No branches available" color="muted" testId="git-branches-empty"
                      else
                        for ref in gitRefs.refs.filter(item => not item.isRemote) key=ref.name
                          button press=switchGitRef(ref.name) disabled=(gitBusy or ref.current or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="10px 0" width="100%" text-align="left" testId=`git-ref-${ref.name}`
                            image (ref.current ? "symbol:checkmark.circle.fill" : "symbol:sf/arrow.branch") width=18 height=18
                            column flex=1 min-width=0 gap=3
                              text ref.name line-clamp=1
                              text (ref.worktreePath != "" ? ref.worktreePath : ref.isDefault ? "Default branch" : "") font-size=13 color="muted" line-clamp=1
                      if gitStatus.pullRequest != none
                        match gitStatus.pullRequest
                          case some(pr)
                            button press=openPullRequestUrl(pr.url) appearance="none" display="flex" align-items="center" gap=10 padding="10px 0" width="100%" text-align="left" testId="git-linked-pr"
                              image "symbol:sf/arrow.up.right.square" width=18 height=18
                              column flex=1 min-width=0 gap=3
                                text `View pull request #${pr.number}`
                                text pr.title font-size=13 color="muted" line-clamp=1
                          case none
                            view
                    if pending(inspected)
                      text "Loading…" color="muted"
                    else
                      match inspected
                        case some(result)
                          if result.error != ""
                            text result.error color="-exact-system-red"
                          else
                            column gap=10
                              text result.title font-size=21 font-weight=700
                              text result.body user-select="text" white-space="pre-wrap" font-size=14 line-height="21px" color="muted"
                              for item in result.items key=item.id
                                button press=inspectEntry(item.id, item.kind) disabled=(item.kind == "info") appearance="none" padding="12px 0" width="100%" text-align="left"
                                  row align-items="center" gap=10
                                    image (item.kind == "directory" ? "symbol:sf/folder" : "symbol:sf/document") width=20 height=20
                                    column flex=1 min-width=0 gap=3
                                      text item.label font-size=16
                                      if item.detail != ""
                                        text item.detail font-size=13 color="muted"
                        case none
                          view
              if e.name == "gitOverview"
                column navigationKey=`${e.id}` navigationScroll="git-overview" navigationPresentation="modal" navigationDetent="large" navigationGrabber="visible" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    button press=cancelGitRoute aria-label="Close Git overview" testId="git-overview-cancel"
                      image "symbol:close"
                    column flex=1 min-width=0 align-items="flex-start"
                      text gitBranchLabel(gitStatus) role="heading" aria-level=2 line-clamp=1
                      text gitStatusLabel(gitStatus) font-size=13 color="muted" line-clamp=1
                    button press=refreshGitOverview disabled=gitBusy aria-label="Refresh repository status" testId="git-overview-refresh"
                      image "symbol:sf/arrow.clockwise"
                  scroll id="git-overview" flex=1 min-height=0 padding=16
                    if gitError != ""
                      text gitError color="danger" padding-bottom=12 testId="git-overview-error"
                    if pending(gitStatus)
                      row align-items="center" gap=8 padding=12
                        progress width=18 height=18
                        text "Checking repository status…" color="muted" testId="git-overview-loading"
                    else
                      section
                        text "Source control" font-size=17 font-weight=700 padding-bottom=4
                        if gitStatus.workingFiles.length > 0
                          button press=openGitCommit disabled=(gitBusy or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-overview-commit"
                            image "symbol:sf/checkmark.circle" width=20 height=20
                            column flex=1 min-width=0 gap=3
                              text "Commit changes"
                              text `${gitStatus.workingFiles.length} file${gitStatus.workingFiles.length == 1 ? "" : "s"} changed` font-size=13 color="muted"
                        if gitStatus.behindCount > 0
                          button press=pullLatest disabled=(gitBusy or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-overview-pull"
                            image "symbol:sf/arrow.down.circle" width=20 height=20
                            column flex=1 min-width=0 gap=3
                              text "Pull latest"
                              text `${gitStatus.behindCount} commit${gitStatus.behindCount == 1 ? "" : "s"} behind upstream` font-size=13 color="muted"
                        if gitStatus.aheadCount > 0
                          button press=requestGitAction("push", false) disabled=(gitBusy or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-overview-push"
                            image "symbol:sf/arrow.up.circle" width=20 height=20
                            column flex=1 min-width=0 gap=3
                              text "Push changes"
                              text `${gitStatus.aheadCount} commit${gitStatus.aheadCount == 1 ? "" : "s"} ahead` font-size=13 color="muted"
                        button press=inspect("git") disabled=(gitBusy or not gitStatus.isRepo) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-overview-review"
                          image "symbol:sf/text.bubble" width=20 height=20
                          column flex=1 min-width=0 align-items="flex-start"
                            text "Review changes"
                            text "Inspect changes, uncommitted edits, and turn diffs" font-size=13 color="muted"
                      section
                        text "Branches & worktrees" font-size=17 font-weight=700 padding-top=18 padding-bottom=4
                        column gap=8 background-color="card" padding=12 border-radius=12
                          text "New branch" font-weight=600
                          input value=gitNewBranch input=editGitNewBranch placeholder="feature/mobile-polish" aria-label="New branch name" testId="git-new-branch"
                          button press=createGitBranch disabled=(gitBusy or not gitWritable or gitNewBranch.trim() == "") buttonStyle="filled" testId="git-create-branch"
                            text (gitBusy ? "Creating…" : "Create & checkout")
                        column gap=8 background-color="card" padding=12 border-radius=12
                          text "New worktree" font-weight=600
                          input value=gitWorktreeBase input=editGitWorktreeBase placeholder="main" aria-label="Worktree base branch" testId="git-worktree-base"
                          input value=gitWorktreeBranch input=editGitWorktreeBranch placeholder="feature/mobile-thread" aria-label="Worktree branch name" testId="git-worktree-branch"
                          button press=createGitWorktree disabled=(gitBusy or not gitWritable or gitWorktreeBase.trim() == "" or gitWorktreeBranch.trim() == "") buttonStyle="filled" testId="git-create-worktree"
                            text (gitBusy ? "Creating…" : "Create worktree")
                      if pending(gitRefs)
                        text "Loading branches…" color="muted" testId="git-overview-branches-loading"
                      else if gitRefs.refs.filter(item => not item.isRemote).length == 0
                        text "No local branches found." color="muted" testId="git-overview-branches-empty"
                      else
                        for ref in gitRefs.refs.filter(item => not item.isRemote) key=ref.name
                          button press=switchGitRef(ref.name) disabled=(gitBusy or ref.current or not gitWritable) appearance="none" display="flex" align-items="center" gap=10 padding="10px 0" width="100%" text-align="left" testId=`git-overview-ref-${ref.name}`
                            image (ref.current ? "symbol:checkmark.circle.fill" : "symbol:sf/arrow.branch") width=18 height=18
                            column flex=1 min-width=0 gap=3
                              text ref.name line-clamp=1
                              text (ref.worktreePath != "" ? ref.worktreePath : ref.isDefault ? "Default branch" : "Local branch") font-size=13 color="muted" line-clamp=1
                      if gitStatus.pullRequest != none
                        section
                          text "Linked pull request" font-size=17 font-weight=700 padding-top=18 padding-bottom=4
                          match gitStatus.pullRequest
                            case some(pr)
                              button press=openPullRequestUrl(pr.url) appearance="none" display="flex" align-items="center" gap=10 padding="12px 0" width="100%" text-align="left" testId="git-overview-linked-pr"
                                image "symbol:sf/arrow.up.right.square" width=18 height=18
                                column flex=1 min-width=0 gap=3
                                  text `#${pr.number} ${pr.title}` line-clamp=2
                                  text `${pr.headBranch} → ${pr.baseBranch} · ${pr.state}` font-size=13 color="muted" line-clamp=1
                            case none
                              view
              if e.name == "gitCommit"
                column navigationKey=`${e.id}` navigationScroll="git-commit-sheet" navigationPresentation="modal" navigationDetent="large" navigationGrabber="visible" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    button press=cancelGitRoute aria-label="Cancel commit" testId="git-commit-cancel"
                      image "symbol:close"
                    text "Commit changes" role="heading" aria-level=2
                  scroll id="git-commit-sheet" flex=1 min-height=0 padding=16
                    if gitStatus.isDefaultRef
                      text "You’re on the default branch. You can create a new branch when committing." color="status-warning" padding-bottom=12 testId="git-default-branch"
                    text "Commit message" font-weight=500
                    input value=gitCommitMessage input=editGitCommitMessage placeholder="Describe your changes…" aria-label="Commit message" testId="git-commit-message" min-height=90 padding=12 background-color="card" border-radius=12
                    text "Leave empty to generate a message automatically." font-size=13 color="muted" padding-bottom=12
                    text "Changed files" font-weight=700
                    row align-items="center" justify-content="space-between" gap=10
                      column flex=1 min-width=0 gap=3
                        text `${selectedGitFiles.length} of ${gitStatus.workingFiles.length} selected · +${selectedGitInsertions} −${selectedGitDeletions}` font-size=13 color="muted"
                      if gitStatus.workingFiles.length > 0
                        button press=toggleAllGitFiles appearance="none" padding="4px 0" testId="git-toggle-all"
                          text (gitExcludedFiles.length == 0 ? "Deselect all" : "Select all") color="foreground"
                    for file in gitStatus.workingFiles key=file.path
                      button press=toggleGitFile(file.path) role="checkbox" aria-checked=(not gitExcludedFiles.includes(file.path)) appearance="none" display="flex" align-items="center" gap=10 padding="10px 0" testId=`git-file-${file.path}`
                        image (gitExcludedFiles.includes(file.path) ? "symbol:sf/circle" : "symbol:checkmark.circle.fill") width=18 height=18
                        text file.path flex=1 min-width=0 line-clamp=1
                        text `+${file.insertions} −${file.deletions}` font-size=13 color="muted"
                    if gitStatus.workingFiles.length == 0
                      text "No changed files to commit." color="muted" padding="12px 0"
                    button press=submitGitCommit(false) disabled=(gitBusy or not gitWritable or selectedGitFiles.length == 0) buttonStyle="filled" testId="git-commit-submit"
                      text (gitBusy ? "Committing…" : "Commit changes")
                    button press=submitGitCommit(true) disabled=(gitBusy or not gitWritable or selectedGitFiles.length == 0) appearance="none" padding=12 testId="git-commit-branch"
                      text "Commit on a new branch"
              if e.name == "gitConfirm"
                column navigationKey=`${e.id}` navigationPresentation="modal" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    button press=cancelGitRoute aria-label="Cancel" testId="git-confirm-cancel"
                      image "symbol:close"
                    text "Confirm source control action" role="heading" aria-level=2
                  column padding=20 gap=14
                    text `You’re on the default branch (${gitStatus.refName}).` font-size=17 font-weight=700
                    text "Publishing changes from the default branch can make review harder. Continue or create a feature branch first." color="muted"
                    button press=confirmGitAction(false) disabled=gitBusy buttonStyle="filled" testId="git-confirm-continue"
                      text (gitBusy ? "Running…" : "Continue")
                    button press=confirmGitAction(true) disabled=gitBusy appearance="none" padding=12 testId="git-confirm-branch"
                      text (gitConfirmIncludesCommit ? "Feature branch & commit" : "Feature branch & continue")
              if e.name == "pullRequests"
                column navigationKey=`${e.id}` navigationScroll="pulls" data-workspace-header="brand" data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Pull Requests" role="heading" aria-level=2
                  list id="pulls" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    if pending(pullRequests)
                      section
                        row
                          progress width=18 height=18
                          text "Loading pull requests…" font="-exact-body" testId="pulls-loading"
                    else if pullRequests.error != ""
                      section
                        row
                          text pullRequests.error color="danger" testId="pulls-error"
                    else if pullRequests.items.length == 0
                      section
                        row
                          text "No pull requests yet" font="-exact-body" testId="pulls-empty"
                        footer
                          text "Pull requests linked to your threads will appear here." font="-exact-footnote" color="-exact-secondary-label"
                    else
                      section
                        for pull in pullRequests.items key=`${pull.projectId}:${pull.number}`
                          row press=openPullRequest(pull.projectId, pull.number) role="button" aria-label=`Open pull request #${pull.number}, ${pull.title}` testId=`pull-${pull.projectId}-${pull.number}`
                            column flex=1 min-width=0 gap=3
                              text `#${pull.number} ${pull.title}` font="-exact-body" line-clamp=2
                              text `${pull.repository} · ${pull.headBranch} → ${pull.baseBranch}` font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
                              text (pull.author != "" ? `by ${pull.author}` : "") font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
                            text pull.state font="-exact-footnote" color=(pull.state == "open" ? "status-working" : "muted")
                            text "View" color="foreground" testId=`pull-open-${pull.projectId}-${pull.number}`
              if e.name == "pullRequest"
                column navigationKey=`${e.id}` navigationScroll="pull-request-detail" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    button press=backPullRequest aria-label="Back" testId="pull-request-back"
                      image "symbol:back"
                    text (match selectedPullRequest { case some(pull) => `#${pull.number} ${pull.title}`, case none => "Pull request" }) role="heading" aria-level=2 line-clamp=1
                  scroll id="pull-request-detail" flex=1 min-height=0 padding=16
                    if pending(pullRequests)
                      row align-items="center" gap=8
                        progress width=16 height=16
                        text "Loading pull requests…" color="muted" testId="pull-request-list-loading"
                    else if pullRequests.error != ""
                      text pullRequests.error color="danger" testId="pull-request-list-error"
                    else
                      match selectedPullRequest
                        case some(pull)
                          column gap=14
                            text pull.title font-size=22 font-weight=700
                            text `#${pull.number} · ${pull.state}${pull.isDraft ? " · Draft" : ""}` color="muted"
                            text `${pull.repository} · ${pull.headBranch} → ${pull.baseBranch}` color="muted"
                            if pending(pullRequestDetail)
                              row align-items="center" gap=8
                                progress width=16 height=16
                                text "Loading pull request details…" color="muted" testId="pull-request-detail-loading"
                            else if pullRequestDetail.error != ""
                              text pullRequestDetail.error color="danger" testId="pull-request-detail-error"
                            else
                              text (pullRequestDetail.author != "" ? `Opened by ${pullRequestDetail.author}` : (pull.author != "" ? `Opened by ${pull.author}` : "")) color="muted"
                              text `${pullRequestDetail.changedFiles > 0 ? pullRequestDetail.changedFiles : pull.changedFiles} changed file${(pullRequestDetail.changedFiles > 0 ? pullRequestDetail.changedFiles : pull.changedFiles) == 1 ? "" : "s"} · +${pullRequestDetail.additions > 0 ? pullRequestDetail.additions : pull.additions} −${pullRequestDetail.deletions > 0 ? pullRequestDetail.deletions : pull.deletions}` color="muted"
                              text (pullRequestDetail.checksState != "" ? `Checks: ${pullRequestDetail.checksState}` : "") color="muted"
                              if pullRequestDetail.body != ""
                                text pullRequestDetail.body line-clamp=12 padding-top=6
                            if pending(pullRequestActivity)
                              row align-items="center" gap=8 padding-top=8
                                progress width=16 height=16
                                text "Loading activity…" color="muted" testId="pull-request-activity-loading"
                            else if pullRequestActivity.error != ""
                              text pullRequestActivity.error color="danger" testId="pull-request-activity-error"
                            else
                              if pullRequestActivity.commits.length > 0
                                column gap=6 padding-top=8
                                  text "Commits" font-size=17 font-weight=700
                                  for commit in pullRequestActivity.commits key=commit.id
                                    row align-items="flex-start" gap=8 padding="8px 0" border-bottom="1px solid edge" testId=`pull-request-commit-${commit.id}`
                                      image "symbol:sf/arrow.triangle.branch" width=15 height=15 color="muted"
                                      column flex=1 min-width=0 gap=2
                                        text commit.subject line-clamp=2
                                        text `${commit.author != "" ? `${commit.author} · ` : ""}${commit.createdAt}` font-size=13 color="muted" line-clamp=1
                              if pullRequestActivity.comments.length > 0
                                column gap=6 padding-top=8
                                  text `Activity${pullRequestActivity.commentsTruncated ? " · Showing recent comments" : ""}` font-size=17 font-weight=700
                                  for comment in pullRequestActivity.comments key=comment.id
                                    column gap=3 padding="8px 0" border-bottom="1px solid edge" testId=`pull-request-comment-${comment.id}`
                                      row align-items="center" gap=6
                                        text (comment.author != "" ? comment.author : "Unknown reviewer") font-weight=700 line-clamp=1
                                        text comment.kind font-size=12 color="muted"
                                      if comment.path != ""
                                        text comment.path font-size=12 color="muted" line-clamp=1
                                      text comment.body white-space="pre-wrap" line-clamp=8
                                      text comment.createdAt font-size=12 color="muted"
                              if pullRequestActivity.commits.length == 0 and pullRequestActivity.comments.length == 0
                                text "No activity yet." padding-top=8 color="muted" testId="pull-request-activity-empty"
                            text `Updated ${pull.updatedAt}` font-size=13 color="muted"
                            button press=openPullRequestUrl(pull.url) buttonStyle="filled" testId="pull-request-open-url"
                              text "Open in source control"
                        case none
                          text "This pull request is no longer available." color="muted" testId="pull-request-not-found"
              if e.name == "usage"
                column navigationKey=`${e.id}` navigationScroll="usage" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Usage" role="heading" aria-level=2
                  list id="usage" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        column gap=3
                          text "This month" font="-exact-body"
                          text "0 agent minutes" font="-exact-footnote" color="-exact-secondary-label"
              if e.name == "settings"
                column navigationKey=`${e.id}` navigationScroll="settings" data-workspace-header=(split ? "brand" : "page") data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Settings" role="heading" aria-level=2
                  list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "T3 Code" font="-exact-body"
                        text "Exact iOS" font="-exact-footnote" color="-exact-secondary-label"
                      button press=openEnvironments testId="environments-button" aria-label="Environments"
                        text "Environments"
                        image "symbol:forward-chevron"
      if device.kind == "web" or device.kind == ""
        column id="environment-filter-menu" popover="auto" role="menu" aria-label="Filter threads by environment"
          button press=filterEnvironment("") role="menuitemradio" aria-checked=(selectedEnvironment == "") popovertarget="environment-filter-menu" popovertargetaction="hide" testId="filter-all"
            text "All environments"
          for environment in catalog.environments key=environment.id
            button press=filterEnvironment(environment.id) role="menuitemradio" aria-checked=(selectedEnvironment == environment.id) popovertarget="environment-filter-menu" popovertargetaction="hide" testId=`filter-${environment.id}`
              text environment.label
        column id="project-filter-menu" popover="auto" role="menu" aria-label="Filter threads by project"
          button press=filterProject("") role="menuitemradio" aria-checked=(selectedProject == "") popovertarget="project-filter-menu" popovertargetaction="hide" testId="project-all"
            text "All projects"
          for project in catalog.projects key=project.id
            button press=filterProject(project.id) role="menuitemradio" aria-checked=(selectedProject == project.id) popovertarget="project-filter-menu" popovertargetaction="hide" testId=`project-${project.id}`
              text project.title
      dialog id="force-stop-confirmation" role="alertdialog" aria-label="Force stop the agent?"
        text "It has not answered Stop. Force stop ends the turn and kills the agent's processes, unless other working threads share them."
        button commandfor="force-stop-confirmation" command="close" testId="force-stop-cancel"
          text "Cancel"
        button press=forceStopTurn destructive=true commandfor="force-stop-confirmation" command="close" disabled=pending(forceStopped) testId="force-stop-confirm"
          text "Force stop"
      dialog id="force-stop-result" role="alertdialog" aria-label=forceStopTitle
        text forceStopMessage
        button commandfor="force-stop-result" command="close" testId="force-stop-ok"
          text "OK"
      dialog id="remove-environment" role="alertdialog" aria-label=`Remove ${environmentLabel(catalog, removedEnvironment)}?`
        text "This environment will be removed from this device. Your projects and threads will stay on the server."
        button commandfor="remove-environment" command="close" testId="environment-remove-cancel"
          text "Cancel"
        button press=removeEnvironment destructive=true commandfor="remove-environment" command="close" testId="environment-remove-confirm"
          text "Remove"
      column id="terminal-menu" popover="auto" role="menu" aria-label="Terminal"
        button role="menuitem" disabled=true
          text "No project scripts"
      column id="git-menu" popover="auto" position="absolute" position-area="bottom span-left" role="menu" aria-label="Git controls" width=320 max-width="92vw" padding=8 gap=2 background-color="screen"
        button role="menuitem" disabled=true testId="git-status-row"
          image "symbol:sf/point.topleft.down.curvedto.point.bottomright.up"
          column flex=1 min-width=0 align-items="flex-start"
            text (pending(gitStatus) ? "Checking status" : gitBranchLabel(gitStatus)) line-clamp=1
            text (pending(gitStatus) ? "Checking status" : gitStatusLabel(gitStatus)) font-size=13 color="muted" testId="git-status"
        button role="menuitem" press=runQuickGitAction popovertarget="git-menu" popovertargetaction="hide" disabled=(pending(gitStatus) or gitBusy or not gitStatus.isRepo or ["detached", "no_origin", "no_commits", "clean", "diverged"].includes(gitQuickActionKind(gitStatus, gitBusy, gitWritable)) or (not gitWritable and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "open_pr")) testId="git-quick-action"
          image (gitQuickActionKind(gitStatus, gitBusy, gitWritable) == "pull" ? "symbol:sf/arrow.down.circle" : gitQuickActionKind(gitStatus, gitBusy, gitWritable) == "commit" ? "symbol:sf/checkmark.circle" : "symbol:sf/arrow.up.circle")
          column flex=1 min-width=0 align-items="flex-start"
            text (pending(gitStatus) ? "Checking status" : gitQuickAction(gitStatus, gitBusy, gitWritable))
            text (gitStatus.unavailableReason != "" ? gitStatus.unavailableReason : not gitWritable and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "open_pr" ? "This connection cannot change source control." : gitBusy ? gitOperation.label : gitQuickActionHint(gitStatus, gitBusy, gitWritable)) font-size=13 color="muted"
        button role="menuitem" press=inspect("git") popovertarget="git-menu" popovertargetaction="hide" disabled=(pending(gitStatus) or not gitStatus.isRepo or not activeThreadHasMessage) testId="git-review-changes"
          image "symbol:sf/text.bubble"
          column flex=1 min-width=0 align-items="flex-start"
            text "Review changes"
            text (not activeThreadHasMessage ? "Available after the first message" : "Inspect changes, uncommitted edits, and turn diffs") font-size=13 color="muted"
        button role="menuitem" press=openGitOverview popovertarget="git-menu" popovertargetaction="hide" disabled=(activeThreadId == "" or not activeThreadHasMessage) testId="git-more"
          image "symbol:sf/ellipsis"
          column flex=1 min-width=0 align-items="flex-start"
            text "More"
            text (not activeThreadHasMessage ? "Available after the first message" : "Branches, worktrees, links, and repository details") font-size=13 color="muted"
        if gitError != ""
          text gitError color="danger" font-size=13 padding="7px 14px" testId="git-error"
      workspace-tab-bar selected-tab=visibleTab shows-compose=(visibleTab == "threads" ? "true" : "false") compact="true" message=workspaceAction height=128 position="absolute" bottom="calc(0px - env(safe-area-inset-bottom))" left=8 right=(visibleTab == "threads" ? 12 : 76) display=(atRoot and not device.rail ? "flex" : "none")
      row role="tablist" aria-label="Workspace" testId="tabs" display=(device.rail ? "flex" : "none")
        button role="tab" aria-controls="panel-threads" aria-selected=(nav.tab == "threads") press=selectTab("threads") testId="tab-threads" flex=1
          image "symbol:sf/text.bubble"
          text "Chats"
        button role="tab" aria-controls="panel-threadDetail" aria-selected=(nav.tab == "threadDetail") press=selectTab("threadDetail") testId="tab-threadDetail" display="none"
          image "symbol:sf/text.bubble"
          text "Thread"
        button role="tab" aria-controls="panel-pullRequests" aria-selected=(nav.tab == "pullRequests") press=selectTab("pullRequests") testId="tab-pullRequests" flex=1
          image "symbol:sf/arrow.triangle.branch"
          text "PRs"
        button role="tab" aria-controls="panel-usage" aria-selected=(nav.tab == "usage") press=selectTab("usage") testId="tab-usage" flex=1
          image "symbol:sf/chart.bar.xaxis"
          text "Usage"
        button role="tab" aria-controls="panel-settings" aria-selected=(nav.tab == "settings") press=selectTab("settings") testId="tab-settings" flex=1
          image "symbol:settings"
          text "Settings"
        button role="tab" aria-controls="panel-settingsDetail" aria-selected=(nav.tab == "settingsDetail") press=selectTab("settingsDetail") testId="tab-settingsDetail" display="none"
          image "symbol:settings"
          text "Setting"

component ThreadList
  props
    catalog: Catalog
    visibleThreads: Thread[]
    selectedEnvironment: string
    selectedProject: string
    selectedProjectLabel: string
    nativeMenus: bool
    query: string
    showSettled: bool
    showWorking: bool
    sidebar: bool
    selectedId: string
    toggleSettled: action
    toggleWorking: action
    openThread: action
    filterEnvironment: action
    filterProject: action
    resetFilters: action
  derive searching = query.trim() != ""
  derive activeThreads = visibleThreads.filter(thread => not thread.settled and (searching or not thread.working))
  derive workingThreads = visibleThreads.filter(thread => not searching and not thread.settled and thread.working)
  derive displayedWorking = workingThreads.filter(thread => showWorking or selectedId == thread.id)
  derive settledThreads = visibleThreads.filter(thread => thread.settled)
  derive availableProjects = catalog.projects.filter(project => selectedEnvironment == "" or project.environmentId == selectedEnvironment)
  view
    list id="home" appearance="none" flex=1 min-height=0 background-color=(sidebar ? "transparent" : "screen")
      section
        scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0
          row gap=8 padding="2px 20px 10px" flex-wrap="nowrap" align-items="center"
            if nativeMenus
              workspace-filter-menu chip-label=(selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) options-query=("=All%20environments&" + catalog.environments.map(environment => `${encodeURIComponent(environment.id)}=${encodeURIComponent(environment.label)}`).join("&")) selected-id=selectedEnvironment active=(selectedEnvironment != "" ? "true" : "false") accessibility-label="Filter threads by environment" test-id="all-environments" testId="all-environments" message=filterEnvironment flex-shrink=0
              workspace-filter-menu chip-label=selectedProjectLabel options-query=("=All%20projects&" + availableProjects.map(project => `${encodeURIComponent(project.id)}=${encodeURIComponent(project.title)}`).join("&")) selected-id=selectedProject active=(selectedProject != "" ? "true" : "false") accessibility-label="Filter threads by project" test-id="all-projects" testId="all-projects" message=filterProject flex-shrink=0
            else
              button popovertarget="environment-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedEnvironment == "" ? "muted" : "white") background-color=(selectedEnvironment == "" ? "transparent" : "AccentColor") testId="all-environments"
                text (selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) max-width=180 line-clamp=1
                image "symbol:sf/chevron.down" width=11 height=11
              button popovertarget="project-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedProject == "" ? "muted" : "white") background-color=(selectedProject == "" ? "transparent" : "AccentColor") testId="all-projects"
                text selectedProjectLabel max-width=180 line-clamp=1
                image "symbol:sf/chevron.down" width=11 height=11
            if selectedEnvironment != "" or selectedProject != ""
              button press=resetFilters appearance="none" aria-label="Reset thread filters" testId="reset-filters" width=28 height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:sf/xmark.circle.fill" width=18 height=18 color="muted"
      section
        if visibleThreads.length == 0
          column align-items="center" padding="28px 21px" gap=7
            text "No threads yet" font-size=21 line-height="28px" font-weight=700 text-align="center" testId="empty-title"
            text "Start a new thread to begin coding." font-size=16 line-height="24px" color="muted" text-align="center"
      for threads, groupIndex in [activeThreads, displayedWorking] key=groupIndex
        section
          if groupIndex == 1 and workingThreads.length > 0
            button press=toggleWorking appearance="none" padding="14px 17.5px 5.25px" width="100%" box-sizing="border-box" aria-label="Working threads" testId="working-threads"
              row align-items="center" gap=8.75 width="100%"
                text (showWorking ? "Working" : `Working (${workingThreads.length})`) font-size=13 line-height="17px" font-weight=500 color="muted"
                view flex=1 height=1 background-color="edge"
                image (showWorking ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") font-size=10 color="muted"
          for thread, index in threads key=thread.id
            button press=openThread(path("thread", thread.id)) appearance="none" testId=`thread-${thread.id}` width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" text-align="left" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) background-color=(sidebar and selectedId == thread.id ? "thread-selected" : "transparent")
              column flex=1 min-width=0 gap=3.5 opacity=(thread.working and selectedId != thread.id ? 0.55 : 1) padding=(sidebar ? "10px 12px" : "8.75px 17.5px")
                row align-items="flex-start" gap=7 color=(sidebar ? "sidebar-foreground" : "foreground")
                  if thread.projectIcon != ""
                    image thread.projectIcon width=20 height=20 margin-top=1.5 border-radius=4
                  else
                    text thread.projectInitials width=20 height=20 margin-top=1.5 line-height="20px" border-radius=4 font-size=10 font-weight=700 color=thread.projectIconColor background-color=`${thread.projectIconColor}22` text-align="center"
                  text thread.title font-size=16 line-height="23px" font-weight=(thread.working and selectedId != thread.id ? 400 : 500) flex=1 min-width=0 line-clamp=2
                  if thread.status != ""
                    row align-items="center" gap=3.5 min-height=23 color=(sidebar and selectedId == thread.id ? "foreground" : threadStatusColor(thread.status))
                      image threadStatusSymbol(thread.status) width=13 height=13 font-weight=600
                      text thread.status font-size=13 line-height="17px" font-weight=700
                  else
                    text thread.updatedAt font-size=13 line-height="23px" color=(sidebar ? "sidebar-muted" : "muted") font-variant-numeric="tabular-nums"
                row align-items="center" gap=7 min-height=14 padding-left=28
                  if thread.lastError != ""
                    text thread.lastError font-size=13 line-height="17px" color=(sidebar and selectedId == thread.id ? "muted" : "danger") flex=1 min-width=0 line-clamp=1
                  else if catalog.environments.length > 1
                    image "symbol:sf/laptopcomputer" font-size=12 color="muted"
                    text environmentLabel(catalog, thread.environmentId) font-size=13 line-height="17px" color="muted" flex=1 min-width=0 line-clamp=1
                  else
                    view flex=1
                  row opacity=0.6
                    ProviderIcon(provider=thread.provider, size=14)
            if index < threads.length - 1
              view height=1 background-color="edge" opacity=0.7 margin-left=17.5 display=(sidebar ? "none" : "flex")
      if settledThreads.length > 0
        section
          if not searching
            button press=toggleSettled appearance="none" padding="14px 17.5px 5.25px" width="100%" box-sizing="border-box" aria-label="Settled threads"
              row align-items="center" gap=8.75 width="100%"
                text (showSettled ? "Settled" : `Settled (${settledThreads.length})`) font-size=13 line-height="17px" font-weight=500 color="muted"
                view flex=1 height=1 background-color="edge"
                image (showSettled ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") font-size=10 color="muted"
          for thread in settledThreads.filter(thread => searching or showSettled or selectedId == thread.id) key=thread.id
            button press=openThread(path("thread", thread.id)) appearance="none" testId=`thread-${thread.id}` width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" text-align="left" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) background-color=(sidebar and selectedId == thread.id ? "thread-selected" : "transparent")
              row flex=1 min-width=0 min-height=44 box-sizing="border-box" align-items="center" gap=7 padding=(sidebar ? "7px 10.5px" : "7px 17.5px")
                if thread.projectIcon != ""
                  image thread.projectIcon width=20 height=20 border-radius=4 opacity=0.4
                else
                  text thread.projectInitials width=20 height=20 line-height="20px" border-radius=4 font-size=10 font-weight=700 color=thread.projectIconColor background-color=`${thread.projectIconColor}22` text-align="center" opacity=0.4
                text thread.title font-size=16 line-height="23px" font-weight=400 flex=1 min-width=0 line-clamp=1 color=(sidebar and selectedId == thread.id ? "foreground" : sidebar ? "sidebar-muted" : "muted")
                text thread.updatedAt font-family="Menlo" font-size=14 line-height="19px" color=(sidebar ? "sidebar-muted" : "muted") font-variant-numeric="tabular-nums"

component EnvironmentList
  props
    scrollId: string
    catalog: Catalog
    toggleEnvironment: action
    manageEnvironment: action
  view
    scroll id=scrollId flex=1 min-height=0 padding="14px 17.5px 36px"
      column border-radius=24 background-color="card" overflow="hidden"
        if catalog.environments.length == 0
          column align-items="center" gap=10.5 padding="28px 21px"
            row width=42 height=42 border-radius=16 background-color="bubble" align-items="center" justify-content="center"
              image "symbol:sf/point.3.connected.trianglepath.dotted" width=20 height=20 color="muted"
            text "No environments connected yet.\nTap + to add one." font-size=14 line-height="21px" color="muted" text-align="center"
        for environment in catalog.environments key=environment.id
          EnvironmentRow(environment=environment, toggleEnvironment=toggleEnvironment, manageEnvironment=manageEnvironment, detail=false, expanded=false)

component EnvironmentRow
  props
    environment: Environment
    toggleEnvironment: action
    manageEnvironment: action
    detail: bool
    expanded: bool
  derive label = detail ? `${expanded ? "Collapse" : "Expand"} details for ${environment.label}` : `Manage ${environment.label}`
  view
    row gap=10.5 padding="12.25px 14px" align-items="center"
      button press=manageEnvironment(environment.id) appearance="none" aria-label=label testId=`manage-${environment.id}` text-align="left" flex=1 min-width=0 display="flex" flex-direction="column" align-items="stretch" gap=1.75 color="foreground"
        row align-items="center" gap=5.25
          row width=16 height=16 align-items="center" justify-content="center"
            view width=8 height=8 border-radius=4 background-color=(environment.status == "Connected" ? "online" : "muted")
          image `symbol:sf/${environment.machineSymbol}` width=14 height=14 color="muted"
          text environment.label font-weight=700 font-size=16 line-height="20px" flex=1 min-width=0 line-clamp=1
        text (environment.url.endsWith("/") ? environment.url : environment.url + "/") font-size=13 line-height="17px" color="muted" line-clamp=1
        text environment.status font-size=13 line-height="17px" color="muted"
      input type="checkbox" switch accent-color="AccentColor" checked=environment.enabled change=toggleEnvironment(environment.id) aria-label=`Enable ${environment.label}` testId=`environment-${environment.id}`
      button press=manageEnvironment(environment.id) aria-label=label appearance="none" width=44 height=44 color="muted"
        image (detail ? (expanded ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") : "symbol:forward-chevron") width=12 height=12

component ProviderIcon
  props
    provider: string
    size: number
  derive monochrome = provider == "codex" or provider == "cursor" or provider == "grok" or provider == "fx" or provider == "pi" or provider == "openrouter" or provider == "acpRegistry" or provider == ""
  derive source = provider == "claudeAgent" ? "assets/provider-claude.svg" : provider == "antigravity" ? "assets/provider-antigravity.png" : provider == "acpRegistry" ? "assets/provider-acp-registry.svg" : ["codex", "cursor", "grok", "fx", "kiro", "muse", "pi", "openrouter"].includes(provider) ? `assets/provider-${provider}.svg` : "assets/provider-codex.svg"
  derive ink = provider == "cursor" ? "provider-cursor-ink" : provider == "grok" or provider == "fx" or provider == "pi" ? "provider-neutral-ink" : provider == "openrouter" ? "provider-openrouter-ink" : "provider-ink"
  view
    if provider == "opencode"
      svg width=size height=size viewBox="0 0 32 40" fill="none"
        path d="M24 32H8V16H24V32Z" fill="provider-opencode-inner"
        path d="M24 8H8V32H24V8ZM32 40H0V0H32V40Z" fill="provider-opencode-outer"
    else if monochrome or source == "assets/provider-codex.svg"
      image source width=size height=size -exact-tint-color=ink
    else
      image source width=size height=size
