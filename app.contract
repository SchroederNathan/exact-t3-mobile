                          text (pullRequests.error != "" ? pullRequests.error : catalog.environments.length == 0 ? "Add an environment in Settings to browse its pull requests." : catalog.environments.filter(env => env.enabled and env.status == "Connected").length == 0 ? "Reconnect to load pull requests that aren't saved on this device." : "Pull requests from the selected environments' projects appear here.") font-size="1rem" line-height="1.5rem" text-align="center" color="muted" testId="pulls-empty-detail"
