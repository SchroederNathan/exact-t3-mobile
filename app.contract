                      if pullRequests.hasMore
                        PullPageFooter(error=pullRequests.moreError, busy=pending(pullRequests), load=morePulls)
              if e.name == "pullFilterSearch"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="75% large" navigationInitialDetent="75%" navigationGrabber="visible" navigationScroll="pr-facet-results" data-workspace-header="editor" data-search-placement=(split ? "integrated" : "toolbar") position="absolute" inset=0 background-color="screen" display="flex" flex-direction="column"
                  header
                    button id="back" press=backPullRequest aria-label=(facetKind == "labels" ? "Close label filter" : "Close author filter") testId="pr-facet-close"
                      image "symbol:close"
                    text (facetKind == "labels" ? "Filter by label" : facetKind == "authors" ? "Filter by author" : "Unknown filter") role="heading" aria-level=2
                    input type="search" value=facetDraft input=editFacetQuery placeholder=(facetKind == "labels" ? "Search labels" : "Search authors") aria-label=(facetKind == "labels" ? "Search labels" : "Search authors") testId="pr-facet-query"
                  scroll id="pr-facet-results" flex=1 min-height=0 padding=(split ? "16px" : "16px 16px calc(env(safe-area-inset-bottom) + 72px)")
                    if facetRows.length > 0
                      column border-radius=14 overflow="hidden" background-color="card"
                        for option, index in facetRows key=option.id
                          button role=(facetKind == "labels" ? "checkbox" : "radio") aria-checked=option.selected aria-label=option.title press=chooseFacetRow(option.id) appearance="none" display="flex" align-items="center" gap=10.5 min-height=49 padding="10.5px 14px" box-sizing="border-box" color="foreground" text-align="left" border-bottom=(index + 1 < facetRows.length ? "1px solid border-subtle" : "none") testId=`pr-facet-result-${option.id}`
                            if facetKind == "labels"
                              box width=8.75 height=8.75 border-radius=5 background-color=(option.color == "" ? "transparent" : option.color) flex-shrink=0
                            text option.title flex=1 min-width=0 font-size="1rem" line-height="1.4375rem" font-weight=500 line-clamp=1
                            if option.selected
                              image "symbol:checkmark" width=16 height=16 font-weight=600 color="icon" flex-shrink=0
                    else if facetKind != "" and not facetSettled
                      progress aria-label="Searching" testId="pr-facet-loading"
                    else
                      column align-items="center" gap=7 padding="36px 16px"
                        text (hostedFacets.failed ? "Couldn't search the host" : facetKind == "labels" ? "No matching labels" : "No matching authors") font="-exact-headline" testId="pr-facet-empty"
                        text (hostedFacets.failed ? "The host didn't answer. Try again in a moment." : facetKind == "labels" ? "Search the labels of the repositories this list covers." : "Search the authors of the repositories this list covers.") font="-exact-footnote" color="muted" text-align="center"
              if e.name == "pullRequest"
                column navigationKey=`${e.id}` navigationScroll="pull-request-detail" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    button press=backPullRequest aria-label="Back" testId="pull-request-back"
                      image "symbol:back"
                    text (match selectedPullRequest { case some(pull) => `#${pull.number} ${pull.title}`, case none => "Pull request" }) role="heading" aria-level=2 line-clamp=1
                  scroll id="pull-request-detail" flex=1 min-height=0 padding=16
                    if pending(pullRequests) or (matchingPulls.length == 0 and pullLink.length > 0 and (pending(catalog) or pending(pullRequestDetail)))
                      row align-items="center" gap=8
                        progress width=16 height=16
                        text "Loading pull requests…" color="muted" testId="pull-request-list-loading"
                    else if matchingPulls.length > 1
                      text "This link matches more than one pull request. Choose one from Pull Requests." color="muted" testId="pull-request-ambiguous"
                    else if pullLink.length > 0 and matchingPulls.length == 0 and pullRequestDetail.error != ""
                      text pullRequestDetail.error color="danger" testId="pull-request-direct-error"
                    else if pullRequests.error != "" and matchingPulls.length == 0 and pullLink.length == 0
                      text pullRequests.error color="danger" testId="pull-request-list-error"
                    else
                      match selectedPullRequest
                        case some(pull)
                          column gap=14
                            PullIdentity(pull=pull, detail=pullRequestDetail, loaded=currentPullDetail, now=time.epochAtZero + threadListClock, copy=copyMessage)
                            row role="tablist" aria-label="Pull request sections" min-width=0 width="100%" testId="pull-sections"
                              for section in ["Overview", "Activity"] key=section
                                button role="tab" aria-selected=(visiblePullSection == section) press=choosePullSection(section) flex=1 min-width=0 testId=`pull-section-${section}`
                                  text section line-clamp=1
                            if visiblePullSection == "Overview"
                              if pending(pullRequestDetail)
                                row align-items="center" gap=8
                                  progress width=16 height=16
                                  text "Loading pull request details…" color="muted" testId="pull-request-detail-loading"
                              else if pullRequestDetail.error != ""
                                text pullRequestDetail.error color="danger" testId="pull-request-detail-error"
                              else
                                if pullRequestDetail.checksState != ""
                                  text `Checks: ${pullRequestDetail.checksState}` color="muted"
                                if pullRequestDetail.body != ""
                                  text pullRequestDetail.body line-clamp=12 padding-top=6
                            if visiblePullSection == "Activity"
                              if pending(pullRequestActivity)
                                row align-items="center" gap=8 padding-top=8
                                  progress width=16 height=16
                                  text "Loading activity…" color="muted" testId="pull-request-activity-loading"
                              else if pullRequestActivity.error != ""
                                text pullRequestActivity.error color="danger" testId="pull-request-activity-error"
                              else
                                if pullRequestActivity.commits.length > 0
                                  column gap=6 padding-top=8
                                    text "Commits" font-size=17 font-weight=700
                                    for commit in pullRequestActivity.commits key=commit.id
                                      row align-items="flex-start" gap=8 padding="8px 0" border-bottom="1px solid edge" testId=`pull-request-commit-${commit.id}`
                                        image "symbol:sf/arrow.triangle.branch" width=15 height=15 color="muted"
                                        column flex=1 min-width=0 gap=2
                                          text commit.subject line-clamp=2
                                          text `${commit.author != "" ? `${commit.author} · ` : ""}${commit.createdAt}` font-size=13 color="muted" line-clamp=1
                                if pullRequestActivity.comments.length > 0
                                  column gap=6 padding-top=8
                                    text `Activity${pullRequestActivity.commentsTruncated ? " · Showing recent comments" : ""}` font-size=17 font-weight=700
                                    for comment in pullRequestActivity.comments key=comment.id
                                      column gap=3 padding="8px 0" border-bottom="1px solid edge" testId=`pull-request-comment-${comment.id}`
                                        row align-items="center" gap=6
                                          text (comment.author != "" ? comment.author : "Unknown reviewer") font-weight=700 line-clamp=1
                                          text comment.kind font-size=12 color="muted"
                                        if comment.path != ""
                                          text comment.path font-size=12 color="muted" line-clamp=1
                                        text comment.body white-space="pre-wrap" line-clamp=8
                                        text comment.createdAt font-size=12 color="muted"
                                if pullRequestActivity.commits.length == 0 and pullRequestActivity.comments.length == 0
                                  text "No activity yet." padding-top=8 color="muted" testId="pull-request-activity-empty"
                            if visiblePullSection == "Overview"
                              row align-items="center" min-height=60 gap=7
                                column flex=1 min-width=0 gap=3.5
                                  text "Changed files" role="heading" aria-level=3 font-weight=600 testId="pull-files-heading"
                                  if pullFiles.files.length > 0
                                    text `${visiblePullFiles.length} ${hiddenPullFileCount > 0 ? "visible" : "changed"} ${visiblePullFiles.length == 1 ? "file" : "files"}${viewedScope and viewedFiles.complete ? ` · ${visibleViewedCount} viewed` : ""} · ${hidePullTests ? `${hiddenPullFileCount} test ${hiddenPullFileCount == 1 ? "file" : "files"} hidden` : "Test files included"}` font-size="0.8125rem" line-height="1.0625rem" color="muted" testId="pull-files-summary"
                                if pullFiles.files.length > 0
                                  button popovertarget="pull-file-filter-menu" aria-label="Filter review files" aria-haspopup="menu" min-height=44 min-width=44 testId="pull-file-filter"
                                    image "symbol:filter"
                              if pending(pullFiles) and pullFiles.files.length == 0
                                progress aria-label="Loading changed files" width=18 height=18
                              else if pullFiles.error != "" and pullFiles.files.length == 0
                                text pullFiles.error color="danger" testId="pull-files-error"
                                button press=retryPullFiles testId="pull-files-retry"
                                  text "Retry loading files"
                              else
                                for file in visiblePullFiles key=file.path
                                  column min-width=0
                                    button press=openPullFile(pull.routeKey, pull.number, file.path) aria-label=`View diff for ${file.path}, ${file.additions} additions, ${file.deletions} deletions${viewedScope and viewedFiles.paths.includes(file.path) ? ", viewed" : ""}` min-height=49 testId=`pull-file-${file.path}`
                                      row min-width=0 align-items="center" gap=7
                                        column flex=1 min-width=0 gap=1.75
                                          text file.name font-size="0.875rem" font-weight=500 line-clamp=2
                                          if file.directory != ""
                                            text file.directory font-size="0.8125rem" color="muted" line-clamp=1
                                          if file.previousPath != ""
                                            text `${file.copied ? "Copied" : "Renamed"} from ${file.previousPath}` font-size="0.8125rem" color="muted" line-clamp=1 testId=`pull-file-origin-${file.path}`
                                        text `+${file.additions}` color="status-done"
                                        text `−${file.deletions}` color="danger"
                                        if viewedScope and viewedFiles.paths.includes(file.path)
                                          image "symbol:select-fill" width=18 height=18 color="status-done" testId=`pull-viewed-${file.path}`
                                        image "symbol:icon.disclose-forward" width=12 height=12 color="muted"
                                    if file.omitted
                                      text "Patch omitted" color="muted"
                                if pullFiles.files.length == 0
                                  text "No text changes available." color="muted"
                                else if visiblePullFiles.length == 0
                                  text (pullFiles.nextCursor != "" ? "No non-test files loaded yet" : "Only test files changed") role="heading" aria-level=3
                                  text "Test files are hidden from this review." color="muted"
                                  button press=togglePullTests testId="pull-show-test-files"
                                    text "Show test files"
                                if pullFiles.truncated
                                  text "Showing a partial diff." color="muted" testId="pull-files-partial"
                                if pullFiles.nextCursor != ""
                                  if pullFiles.error != ""
                                    text pullFiles.error color="danger"
                                  button press=retryPullFiles disabled=pending(pullFiles) min-height=44 testId="pull-files-more"
                                    text (pullFiles.error != "" ? "Retry loading files" : "Load more files")
                              button press=openPullRequestUrl(pull.url) buttonStyle="filled" testId="pull-request-open-url"
                                text "Open in source control"
                        case none
                          text "This pull request is no longer available." color="muted" testId="pull-request-not-found"
              if e.name == "pullFilesSheet"
                column navigationKey=`${e.id}` navigationPresentation="modal" navigationDetent="60% large" navigationInitialDetent="60%" navigationGrabber="visible" navigationScroll="pull-picker-files" position="absolute" inset=0 background-color="screen" display="flex" flex-direction="column"
                  header
                    button id="back" press=backPullRequest aria-label="Close changed files" testId="pull-picker-close"
                      image "symbol:close"
                    text "Changed files" role="heading" aria-level=2
                  row align-items="center" gap=7 padding="0 14px"
                    text (match first(pullRefs) { case some(ref) => `#${ref.number} · ${ref.repository}`, case none => "Changed files" }) flex=1 min-width=0 line-clamp=1 font="-exact-footnote" color="muted" testId="pull-picker-subtitle"
                    button popovertarget="pull-file-filter-menu" aria-label="Filter review files" min-height=44 min-width=44 testId="pull-picker-filter"
                      image "symbol:filter" width=20 height=20
                  list id="pull-picker-files" virtualized=true estimated-item-height=49 flex=1 min-height=0 appearance="none"
                    for item in pickerFiles key=item.key
                      column min-width=0
                        if item.kind == "directory"
                          button press=foldFileDirectory(item.path) aria-label=item.label aria-expanded=(not foldedPullDirectories.includes(item.path)) appearance="none" display="flex" align-items="center" text-align="left" gap=7 min-height=44 padding="14px 14px 7px" testId=`pull-picker-${item.key}`
                            image (foldedPullDirectories.includes(item.path) ? "symbol:icon.disclose-forward" : "symbol:icon.disclose-down") width=11 height=11 color="muted"
                            image "symbol:icon.directory" width=16 height=16 color="muted"
                            text item.label flex=1 min-width=0 font="-exact-subheadline" color="muted" line-clamp=2
                        else
                          button press=jumpFromFilePicker(item.path) aria-label=`View diff for ${item.path}, ${item.added} additions, ${item.deleted} deletions${viewedScope and viewedFiles.paths.includes(item.path) ? ", viewed" : ""}` appearance="none" display="flex" align-items="center" text-align="left" gap=10.5 min-height=49 padding="10.5px 14px" border-bottom="1px solid border-subtle" testId=`pull-picker-${item.key}`
                            column flex=1 min-width=0 gap=1.75
                              text item.label font-size="0.875rem" font-weight=500 line-clamp=2
                              if item.origin != ""
                                text item.origin font-size="0.8125rem" color="muted" line-clamp=1
                            text `+${item.added}` color="status-done" font="-exact-caption1"
                            text `−${item.deleted}` color="danger" font="-exact-caption1"
                            if viewedScope and viewedFiles.paths.includes(item.path)
                              image "symbol:select-fill" color="status-done" width=18 height=18
                            image "symbol:icon.disclose-forward" color="muted" width=12 height=12
                  if pending(pullFiles) and pullFiles.files.length == 0
                    progress aria-label="Loading changed files"
                  else if pullFiles.error != ""
                    text pullFiles.error color="danger" padding=14
                    button press=retryPullFiles min-height=44 testId="pull-picker-retry"
                      text "Retry loading files"
                  else if visiblePullFiles.length == 0
                    text (hiddenPullFileCount > 0 ? "Only test files changed" : "No text changes available.") color="muted" padding=14
                    if hiddenPullFileCount > 0
                      button press=togglePullTests min-height=44 testId="pull-picker-show-tests"
                        text "Show test files"
                  if pullFiles.nextCursor != "" and pullFiles.error == ""
                    button press=retryPullFiles disabled=pending(pullFiles) min-height=44 testId="pull-picker-more"
                      text "Load more files"
              if e.name == "pullFile"
                column navigationKey=`${e.id}` navigationScroll="pull-diff-lines" position="absolute" inset=0 background-color="screen" display="flex" flex-direction="column"
                  header
                    button id="back" press=backPullRequest aria-label="Back to pull request" testId="pull-diff-back"
                      image "symbol:back"
                    text "Changes" role="heading" aria-level=2
                  text `#${e.params.number} · ${diffVisibleFiles.length} ${diffVisibleFiles.length == 1 ? "file" : "files"}` color="muted" font="-exact-footnote" padding="7px 14px" testId="pull-diff-summary"
                  if viewedError != ""
                    text viewedError color="danger" role="alert" padding="7px 14px" testId="pull-viewed-error"
                  if pullFiles.error != ""
                    text pullFiles.error color="danger" padding=14
                    button press=retryPullFiles testId="pull-diff-retry"
                      text "Retry loading files"
                  else if not diffFileFound and (pending(pullFiles) or pending(catalog) or pullFiles.nextCursor != "")
                    progress aria-label="Loading changes" testId="pull-diff-loading"
                  else if not diffFileFound
                    text "This file is not in the available diff." color="muted" padding=14 testId="pull-diff-missing"
                  list id="pull-diff-lines" appearance="none" virtualized=true flex=1 min-height=0 estimated-item-height=22 background-color="code-surface"
                    for line in diffRows key=line.key
                      column min-width=0
                        if line.kind == "file"
                          row align-items="center" background-color="card"
                            button press=foldDiffFile(line.path) aria-expanded=line.expanded aria-label=`${line.text}, ${line.added} additions, ${line.deleted} deletions` display="flex" flex=1 min-width=0 align-items="center" gap=7 padding="7px 14px" min-height=44 text-align="left" testId=`pull-diff-file-${line.path}`
                              image (line.expanded ? "symbol:icon.disclose-down" : "symbol:icon.disclose-forward") width=11 height=11
                              text line.text flex=1 min-width=0 line-clamp=2 font="-exact-footnote" font-weight=600
                              text `+${line.added}` color="status-done" font="-exact-caption1"
                              text `−${line.deleted}` color="danger" font="-exact-caption1"
                            if viewedScope
                              button press=toggleViewedFile(line.path) disabled=(not viewedFiles.writable or pending(changedViewedFile) or pending(viewedFiles)) aria-label=`Mark ${line.path} as ${viewedFiles.paths.includes(line.path) ? "unviewed" : "viewed"}` min-width=44 min-height=44 testId=`pull-toggle-viewed-${line.path}`
                                if pending(changedViewedFile) and viewedPendingKey == viewedFiles.key and viewedPendingPath == line.path
                                  progress width=18 height=18 aria-label="Updating viewed state"
                                else
                                  image (viewedFiles.paths.includes(line.path) ? "symbol:select-fill" : "symbol:sf/circle") width=18 height=18 color=(viewedFiles.paths.includes(line.path) ? "status-done" : "muted")
                        else if line.kind == "hunk" or line.kind == "meta"
                          text line.text user-select="text" font-family="ui-monospace" font-size="0.75rem" line-height="1.375rem" color="muted" padding="0 12px" white-space="pre-wrap" overflow-wrap="break-word" testId=`pull-diff-${line.key}`
                        else
                          row min-height=22 align-items="stretch" background-color=(line.kind == "addition" ? "diff-add-fill" : line.kind == "deletion" ? "diff-remove-fill" : "transparent")
                            text (line.newLine != "" ? line.newLine : line.oldLine) width=42 padding-right=7 box-sizing="border-box" text-align="right" color="muted" font-family="ui-monospace" font-size="0.6875rem" line-height="1.375rem" font-variant-numeric="tabular-nums" flex-shrink=0
                            text `${line.prefix}${line.text == "" ? " " : line.text}` user-select="text" flex=1 min-width=0 font-family="ui-monospace" font-size="0.75rem" line-height="1.375rem" color="foreground" padding-right=7 white-space="pre-wrap" overflow-wrap="break-word" testId=`pull-diff-${line.key}`
                  if pullFiles.nextCursor != "" and diffFileFound
                    button press=retryPullFiles disabled=pending(pullFiles) min-height=44 testId="pull-diff-more"
                      text "Load more files"
                  button press=openFilePicker aria-label="Changed files" buttonStyle="glass" align-self="end" min-height=44 min-width=44 testId="pull-diff-open-picker"
                    image "symbol:sf/doc.on.doc" font-size=20
              if e.name == "usage"
                column navigationKey=`${e.id}` navigationScroll="usage" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Usage" role="heading" aria-level=2
                    if catalog.environments.length > 0 and usageView != "Limits"
                      button press=refreshUsage buttonStyle="glass" aria-label="Refresh usage" testId="usage-refresh" disabled=pending(usageReport)
                        image "symbol:refresh"
                  scroll id="usage" resize=measureUsage flex=1 min-height=0 background-color="screen"
                    column padding="16px 16px 0" width="100%" max-width="67.5rem" box-sizing="border-box" align-self="center"
                      row role="radiogroup" aria-label="Usage view" width="100%" box-sizing="border-box"
                        for metric in ["Cost", "Tokens", "Limits"] key=metric
                          button role="radio" aria-checked=(usageView == metric) press=selectUsageView(metric) testId=`usage-view-${metric}` flex=1
                            text metric
                    if catalog.environments.length == 0 or failed(environmentState) or failed(catalog)
                      column padding="64px 21px" align-items="center"
                        text (failed(environmentState) or failed(catalog) ? "Can’t load environments." : not environmentState.loaded or pending(environmentState) or pending(catalog) ? "Loading environments…" : usageView == "Limits" ? "Select an environment to see limits." : "Connect an environment to see usage.") testId="usage-status" font="-exact-body" text-align="center" color="muted"
                    else if usageView == "Limits"
                      column padding="24px 16px 128px" width="100%" max-width="67.5rem" box-sizing="border-box" align-self="center" gap=24
                        if catalog.limitProviders.length == 0
                          text (catalog.environments.filter(env => env.status == "Connected").length == 0 ? "Waiting for connection…" : "No provider on the selected environments reports subscription limits.") padding="48px 0" color="muted" text-align="center" testId="usage-no-limits"
                        for provider in catalog.limitProviders key=provider.id
                          column gap=12
                            row align-items="center" gap=8 padding="0 4px"
                              if provider.notice == ""
                                ProviderIcon(provider=provider.id, size=18)
                              text provider.provider role="heading" aria-level=3 font-size=16 font-weight=500
                            if provider.notice != ""
                              text provider.environment color="muted" font="-exact-footnote"
                              text provider.notice color="muted"
                            for window in provider.windows key=window.id
                              view display="flex" flex-direction=(usageWide ? "row" : "column") align-items=(usageWide ? "center" : "stretch") gap=(usageWide ? 24 : 12) padding=16 border-radius=24 background-color="card" testId=`limit-card-${provider.id}-${window.id}`
                                column width=(usageWide ? 176 : "100%") gap=4
                                  text window.label font-size=14 font-weight=500
                                  row align-items="baseline" gap=6
                                    text `${window.remaining}%` font-size=30 font-weight=700 font-variant-numeric="tabular-nums" testId=`usage-limit-${provider.id}-${window.id}`
                                    text "left" font-size=14 color="muted"
                                column flex=(usageWide ? "1 1 0px" : "0 0 auto") min-width=0 gap=(usageWide ? 4 : 12)
                                  row gap=4 resize=measureLimitBar
                                    for member in window.columns key=member.id
                                      column flex=1 min-width=0 height=(usageWide ? 36 : 28) position="relative" justify-content="center" align-items="center" border-radius=6 overflow="hidden" background-color=(member.reported ? "input-fill" : "transparent") testId=`limit-segment-${provider.id}-${window.id}-${member.number}`
                                        if member.reported
                                          view position="absolute" inset="0 auto 0 0" width=`${member.remaining}%` background-color=(member.color != "" ? member.color : providerColor(provider.id == "claudeAgent" ? "claude" : provider.id)) opacity=0.35
                                          if usageWide and limitBarWidth >= 96 * window.columns.length
                                            row align-items="center" gap=6 padding="0 8px" align-self="stretch" min-width=0
                                              text member.name font-size=12 font-weight=500 line-clamp=1 min-width=0
                                              text `${member.remaining}%` font-size=14 font-weight=700 font-variant-numeric="tabular-nums"
                                          else
                                            text `${member.number}` font-size=12 font-weight=500 aria-label=`Segment ${member.number}, ${member.name}, ${member.remaining}% left`
                                  if not usageWide or limitBarWidth < 96 * window.columns.length
                                    column testId=`limit-legend-${provider.id}-${window.id}`
                                      for member in window.columns key=member.id
                                        if member.reported
                                          row align-items="center" gap=8 min-height=44
                                            text `${member.number}` font-size=12 font-weight=500 width=20 text-align="center" background-color="input-fill" border-radius=5
                                            text member.name font-size=14 font-weight=500 flex=1 min-width=0 line-clamp=1
                                            text `${member.remaining}%` font-size=14 font-weight=500 font-variant-numeric="tabular-nums"
                    else
                      column padding="24px 16px 128px" width="100%" max-width="67.5rem" box-sizing="border-box" align-self="center" gap=16
                        row role="radiogroup" aria-label="Usage period" width="100%" box-sizing="border-box"
                          for days in [1, 7, 30, 90] key=days
                            button role="radio" press=selectUsageDays(days) aria-checked=(usageDays == days) aria-label=(days == 1 ? "Past 24 hours" : `Past ${days} days`) testId=`usage-period-${days}` flex=1
                              text (days == 1 ? "24h" : `${days}d`)
                        if pending(usageReport) or failed(usageReport)
                          text (failed(usageReport) ? "Usage could not be loaded." : "Scanning provider transcripts…") color="muted" text-align="center" testId="usage-loading"
                        else
                          for report in usageReport key=report.id
                            column gap=8 min-width=0 testId=`usage-environment-${report.id}`
                              text report.label role="heading" aria-level=3 font="-exact-headline"
                              if report.error != ""
                                text report.error color="muted"
                              else
                                view display="flex" flex-direction=(usageWide ? "row" : "column") gap=(usageWide ? 24 : 16) align-items=(usageWide ? "flex-start" : "stretch") padding=(usageWide ? 0 : 16) border-radius=24 background-color=(usageWide ? "transparent" : "card")
                                  column width=(usageWide ? "18rem" : "100%") min-width=0 box-sizing="border-box" gap=2 padding=(usageWide ? 16 : 0) border-radius=24 background-color="card" testId=`chart-summary-${report.id}`
                                    text (usageView == "Cost" ? "Raw token cost" : "Processed tokens") font-size="0.875rem" color="muted"
                                    if usageView == "Cost"
                                      row align-items="baseline" gap=0
                                        text report.cost testId=`usage-cost-${report.id}` font-size="2.25rem" line-height="2.5rem" font-weight=700 font-variant-numeric="tabular-nums"
                                        if report.cost != "Unpriced"
                                          text "*" font-size="2.25rem" line-height="2.5rem" font-weight=700
                                      if report.cost != "Unpriced"
                                        text "* if billed at full API rate" font-size="0.875rem" color="muted"
                                    else
                                      text report.tokens testId=`usage-tokens-${report.id}` font-size="2.25rem" line-height="2.5rem" font-weight=700 font-variant-numeric="tabular-nums"
                                      text report.sessions font-size="0.875rem" color="muted"
                                  column flex=(usageWide ? "1 1 0px" : "0 0 auto") min-width=0 padding=(usageWide ? 16 : 0) gap=7 border-radius=24 background-color="card" testId=`chart-card-${report.id}`
                                    if usageWide
                                      text `${usageDays == 1 ? "Hourly" : "Daily"} ${usageView == "Cost" ? "cost" : "processed tokens"}` font-size="0.875rem" font-weight=500
                                    UsageChart(data=report.chart, metric=usageView, environment=report.id, native=(device.kind != "web" and device.kind != ""), wide=usageWide, unpriced=(report.cost == "Unpriced"))
                                if report.note != ""
                                  text report.note color="muted"
              if e.name == "settings"
                column navigationKey=`${e.id}` navigationScroll="settings" data-workspace-header=(split ? "brand" : "page") data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Settings" role="heading" aria-level=2
                  list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "T3 Code" font="-exact-body"
                        text "Exact iOS" font="-exact-footnote" color="-exact-secondary-label"
                      button press=openEnvironments testId="environments-button" aria-label="Environments"
                        text "Environments"
                        image "symbol:forward-chevron"
                      button press=openKeyboardSettings testId="keyboard-button" aria-label="Keyboard"
                        text "Keyboard"
                        image "symbol:forward-chevron"
      if device.kind == "web" or device.kind == ""
        column id="environment-filter-menu" popover="auto" role="menu" aria-label="Filter threads by environment"
          button press=filterEnvironment("") role="menuitemradio" aria-checked=(selectedEnvironment == "") popovertarget="environment-filter-menu" popovertargetaction="hide" testId="filter-all"
            text "All environments"
          for environment in catalog.environments key=environment.id
            button press=filterEnvironment(environment.id) role="menuitemradio" aria-checked=(selectedEnvironment == environment.id) popovertarget="environment-filter-menu" popovertargetaction="hide" testId=`filter-${environment.id}`
              text environment.label
        column id="pull-environments-menu" popover="auto" role="menu" aria-label="Choose pull request environment"
          button press=filterPullEnvironment("") role="menuitemradio" aria-checked=(selectedPullEnvironment == "") popovertarget="pull-environments-menu" popovertargetaction="hide" testId="pull-environment-all"
            text "All environments"
          for env in catalog.environments key=env.id
            button press=filterPullEnvironment(env.id) role="menuitemradio" aria-checked=(selectedPullEnvironment == env.id) popovertarget="pull-environments-menu" popovertargetaction="hide" testId=`pull-environment-${env.id}`
              text env.label
        column id="pull-controls-menu" popover="auto" role="menu" aria-label="More filters" max-height="70dvh" overflow-y="auto"
          for group in pullControls.groups key=group.id
            button role="menuitem" aria-haspopup="menu" popovertarget=`pull-controls-${group.id}` testId=`pull-more-${group.id}`
              text group.title
              image "symbol:forward-chevron"
            column id=`pull-controls-${group.id}` popover="auto" role="menu" aria-label=group.title
              for option in group.options key=option.id
                button role="menuitemradio" aria-checked=option.selected press=choosePullControl(option.id) popovertarget="pull-controls-menu" popovertargetaction="hide" testId=`pull-choice-${option.id}`
                  text option.title
          button role="menuitem" disabled=(not pullControls.reset) press=choosePullControl("reset") popovertarget="pull-controls-menu" popovertargetaction="hide" testId="pull-more-reset"
            text "Reset filters"
        PullFilterMenu(field="state", selected=pullState, options=["open", "closed", "merged", "all"], label="Filter by state", choose=filterPullState)
        PullFilterMenu(field="involvement", selected=pullInvolvement, options=["all", "reviewing", "authored"], label="Filter by involvement", choose=filterPullInvolvement)
        PullFacetMenu(field="labels", label="Filter by label", facet=facets.labels, choose=labelMenuAction)
        PullFacetMenu(field="authors", label="Filter by author", facet=facets.authors, choose=authorMenuAction)
        column id="project-filter-menu" popover="auto" role="menu" aria-label="Filter threads by project"
          button press=filterProject("") role="menuitemradio" aria-checked=(selectedProject == "") popovertarget="project-filter-menu" popovertargetaction="hide" testId="project-all"
            text "All projects"
          for project in catalog.projects key=project.id
            button press=filterProject(project.id) role="menuitemradio" aria-checked=(selectedProject == project.id) popovertarget="project-filter-menu" popovertargetaction="hide" testId=`project-${project.id}`
              text project.title
      dialog id="force-stop-confirmation" role="alertdialog" aria-label="Force stop the agent?"
        text "It has not answered Stop. Force stop ends the turn and kills the agent's processes, unless other working threads share them."
        button commandfor="force-stop-confirmation" command="close" testId="force-stop-cancel"
          text "Cancel"
        button press=forceStopTurn destructive=true commandfor="force-stop-confirmation" command="close" disabled=pending(forceStopped) testId="force-stop-confirm"
          text "Force stop"
      dialog id="force-stop-result" role="alertdialog" aria-label=forceStopTitle
        text forceStopMessage
        button commandfor="force-stop-result" command="close" testId="force-stop-ok"
          text "OK"
      column id="draft-menu" popover="auto" role="menu"
        button press=confirmDiscardDraft(discardKey, discardKind) destructive=true popovertarget="draft-menu" popovertargetaction="hide" testId="draft-menu-discard"
          image "symbol:delete"
          text (discardKind == "unsent" ? "Delete" : "Discard")
      column id="thread-row-menu" popover="auto" role="menu" min-width="min(176px, 46vw)" aria-label="Thread actions"
        for thread in selectedThread(catalog, copyTargetId) key=thread.id
          button press=copyRowId(thread.serverThreadId) role="menuitem" popovertarget="thread-row-menu" popovertargetaction="hide" testId="thread-menu-copy-id"
            image "symbol:sf/doc.on.doc"
            text "Copy thread ID"
          if thread.canSettle and thread.wakeAt <= rowMenuOpened and copyTargetId == pinTargetId
            button press=changeRowSettlementState(thread.id, thread.controls.accessKey, thread.settled ? "unsettle" : "settle", "") role="menuitem" disabled=(pending(settlementChanged) or pending(rowSnoozed) or pending(pinChanged)) testId=(thread.settled ? "thread-menu-unsettle" : "thread-menu-settle")
              image (thread.settled ? "symbol:sf/arrow.uturn.backward" : "symbol:checkmark")
              text (thread.settled ? "Un-settle" : "Settle")
        button press=changePin role="menuitem" popovertarget="thread-row-menu" popovertargetaction="hide" disabled=(pinTargetKey == "" or pending(pinChanged) or pending(rowSnoozed)) testId="thread-menu-pin"
          image (pinTargetDesired ? "symbol:pin" : "symbol:sf/pin.slash")
          text (pinTargetDesired ? "Pin" : "Unpin")
        if rowSnooze.available
          if rowSnooze.sleeping
            button role="menuitem" press=submitRowSnooze("wake") disabled=pending(rowSnoozed) testId="thread-menu-wake"
              image "symbol:sf/sunrise"
              text "Unsnooze"
          else
            button role="menuitem" popovertarget="row-snooze-menu" disabled=pending(rowSnoozed) testId="thread-menu-snooze"
              image "symbol:sf/clock"
              text "Snooze"
        if device.kind == "web"
          for thread in selectedThread(catalog, pinTargetId) key=thread.id
            button role="menuitem" press=beginRename(thread.title) disabled=pending(titleUpdated) testId="thread-menu-rename"
              image "symbol:sf/square.and.pencil"
              text "Rename"
            if thread.canRegenerateTitle
              button role="menuitem" press=regenerateTitle disabled=(thread.regeneratingTitle or pending(titleUpdated)) testId="thread-menu-regenerate"
                image "symbol:refresh"
                text (thread.regeneratingTitle ? "Regenerating…" : "Regenerate title")
            if thread.canSetAutoSettle
              button role="menuitem" popovertarget="auto-settle-menu" disabled=pending(autoSettleUpdated) testId="thread-menu-auto-settle"
                image "symbol:sf/timer"
                text "Auto-settle behavior"
        else
          button role="menuitem" popovertarget="thread-more-menu" testId="thread-menu-more"
            image "symbol:sf/ellipsis.circle"
            text "More"
      column id="thread-more-menu" popover="auto" role="menu" aria-label="More thread actions"
        for thread in selectedThread(catalog, pinTargetId) key=thread.id
          button role="menuitem" press=beginRename(thread.title) disabled=pending(titleUpdated) testId="more-rename"
            image "symbol:sf/square.and.pencil"
            text "Rename"
          if thread.canRegenerateTitle
            button role="menuitem" press=regenerateTitle disabled=(thread.regeneratingTitle or pending(titleUpdated)) testId="more-regenerate"
              image "symbol:refresh"
              text (thread.regeneratingTitle ? "Regenerating…" : "Regenerate title")
          if thread.canSetAutoSettle
            button role="menuitem" popovertarget="auto-settle-menu" disabled=pending(autoSettleUpdated) testId="more-auto-settle"
              image "symbol:sf/timer"
              text "Auto-settle behavior"
      column id="auto-settle-menu" popover="auto" role="menu" aria-label="Auto-settle behavior"
        for thread in selectedThread(catalog, pinTargetId).filter(row => row.canSetAutoSettle) key=thread.id
          for choice in ["Follow settings", "Never"] key=choice
            button role="menuitemradio" aria-checked=(thread.followsAutoSettle == (choice == "Follow settings")) press=selectAutoSettle(choice == "Follow settings") disabled=pending(autoSettleUpdated) testId=(choice == "Never" ? "auto-settle-never" : "auto-settle-follow")
              text choice
      dialog id="rename-thread" role="alertdialog" aria-label="Rename thread"
        input value=renameDraft input=editRename aria-label="Thread title" testId="rename-title"
        button commandfor="rename-thread" command="close" testId="rename-cancel"
          text "Cancel"
        button press=confirmRename commandfor="rename-thread" command="close" testId="rename-confirm"
          text "Rename"
      column id="row-snooze-menu" popover="auto" role="menu" min-width="min(176px, 46vw)" aria-label="Snooze thread"
        for choice in rowSnooze.choices key=choice.id
          button role="menuitem" press=submitRowSnooze(choice.id) disabled=pending(rowSnoozed) testId=`snooze-${choice.id}`
            text choice.label
            text choice.detail
        button role="menuitem" popovertarget="custom-snooze" press=beginCustomSnooze disabled=pending(customSubmitted) testId="snooze-custom"
          text "Custom…"
      column id="custom-snooze" popover="auto" role="dialog" aria-label="Custom snooze" position-area="none" inset=0 margin="auto" width="min(360px, calc(100vw - 32px))" height=(customError == "" ? 324 : 364) max-height="calc(100dvh - 96px)" overflow-y="auto" box-sizing="border-box" padding=16 gap=16
        row align-items="center" gap=8
          button popovertarget="custom-snooze" popovertargetaction="hide" aria-label="Cancel custom snooze" min-height=44 testId="custom-cancel"
            text "Cancel"
          text "Custom snooze" role="heading" flex=1 text-align="center" font-size=16 line-height="20px" font-weight=600
          button press=submitCustomSnooze disabled=pending(customSubmitted) min-height=44 testId="custom-submit"
            text "Snooze"
        if device.kind == "web"
          row role="radiogroup" aria-label="Snooze mode" padding=2 border-radius=8 background-color="input-fill"
            for mode in ["date", "duration"] key=mode
              button role="radio" aria-checked=(customMode == mode) press=editCustomMode(mode) testId=`custom-${mode}-mode` appearance="none" flex=1 min-height=30 border-radius=6 background-color=(customMode == mode ? "card" : "transparent") font-size=14 font-weight=500
                text (mode == "date" ? "Date and time" : "Duration")
        else
          row role="radiogroup" aria-label="Snooze mode"
            for mode in ["date", "duration"] key=mode
              button role="radio" aria-checked=(customMode == mode) press=editCustomMode(mode) testId=`custom-${mode}-mode` flex=1
                text (mode == "date" ? "Date and time" : "Duration")
        column justify-content="center" min-height=180
          if customMode == "date"
            input type="datetime-local" value=(customEdited ? customField : customStart.field) change=editCustomField aria-label="Snooze until" testId="custom-date" width="100%" box-sizing="border-box"
          else
            row align-items="center" gap=8
              if device.kind == "web"
                input type="number" value=customAmount input=editCustomAmount step="any" aria-label="Duration amount" testId="custom-amount" flex=1 min-width=0
              else
                select value=customAmount change=editCustomAmount aria-label="Duration amount" testId="custom-amount" flex=1 min-width=0
                  for amount in customStart.amounts key=amount
                    option amount value=amount
              select value=customUnit change=editCustomUnit aria-label="Duration unit" testId="custom-unit" flex=1 min-width=0
                option "Minutes" value="minutes"
                option "Hours" value="hours"
                option "Days" value="days"
        if customError != ""
          text customError role="alert" testId="custom-error"
      dialog id="discard-draft" role="alertdialog" aria-label="Discard draft?"
        text `“${match first(homeDrafts.filter(row => row.key == discardKey)) { case some(row) => row.title, case none => "New thread" }}” will be removed.`
        button commandfor="discard-draft" command="close" testId="discard-draft-cancel"
          text "Cancel"
        button press=discardDraft destructive=true commandfor="discard-draft" command="close" testId="discard-draft-confirm"
          text "Discard"
      dialog id="delete-pending-task" role="alertdialog" aria-label="Delete pending task?"
        text `“${match first(homeDrafts.filter(row => row.key == discardKey)) { case some(row) => row.title, case none => "New thread" }}” has not been sent yet and will be removed from the outbox.`
        button commandfor="delete-pending-task" command="close" testId="delete-pending-cancel"
          text "Cancel"
        button press=discardDraft destructive=true commandfor="delete-pending-task" command="close" testId="delete-pending-confirm"
          text "Delete"
      dialog id="app-access" role="alertdialog" aria-label=appAccessTitle
        text appAccessBody
        button commandfor="app-access" command="close" testId="app-access-cancel"
          text "Not now"
        button press=installAppAccess commandfor="app-access" command="close" testId="app-access-install"
          text "Install"
      dialog id="task-alert" role="alertdialog" aria-label=taskAlertTitle
        text taskAlertBody testId="task-alert-body"
        button commandfor="task-alert" command="close" testId="task-alert-ok"
          text "OK"
      dialog id="composer-import-alert" role="alertdialog" aria-label=composerImportAlertTitle
        text composerImportAlertBody testId="composer-import-alert-body"
        button commandfor="composer-import-alert" command="close" testId="composer-import-alert-ok"
          text "OK"
      dialog id="remove-environment" role="alertdialog" aria-label=`Remove ${environmentLabel(catalog, removedEnvironment)}?`
        text "This environment will be removed from this device. Your projects and threads will stay on the server."
        button commandfor="remove-environment" command="close" testId="environment-remove-cancel"
          text "Cancel"
        button press=removeEnvironment destructive=true commandfor="remove-environment" command="close" testId="environment-remove-confirm"
          text "Remove"
      column id="terminal-menu" popover="auto" role="menu" aria-label="Terminal"
        for script in terminalMenu.scripts key=script.id
          button role="menuitem" press=runTerminalScript(activeThreadId, script.id) popovertarget="terminal-menu" popovertargetaction="hide" disabled=(not terminalMenu.canOperate)
            image (script.icon == "test" ? "symbol:sf/testtube.2" : script.icon == "lint" ? "symbol:sf/checkmark.seal" : script.icon == "configure" ? "symbol:sf/wrench.and.screwdriver" : script.icon == "build" ? "symbol:sf/hammer" : script.icon == "debug" ? "symbol:sf/ladybug" : "symbol:sf/play.fill")
            text script.label
            text script.command
        if terminalMenu.scripts.length == 0
          button role="menuitem" disabled=true
            image "symbol:sf/play"
            text "No project scripts"
            text "This project has no saved scripts yet"
        for session in terminalMenu.sessions key=session.terminalId
          button role="menuitem" press=openTerminal(activeThreadId, session.terminalId) popovertarget="terminal-menu" popovertargetaction="hide"
            image "symbol:sf/terminal"
            text session.displayLabel
            text `${session.status == "running" ? (session.hasRunningSubprocess ? "Task running" : "Ready") : session.status == "starting" ? "Starting" : session.status == "exited" ? "Exited" : "Error"} · ${terminalBasename(session.cwd)}`
        button role="menuitem" press=openNewTerminal(activeThreadId) popovertarget="terminal-menu" popovertargetaction="hide" disabled=(not terminalMenu.canOperate)
          image "symbol:sf/plus"
          text "Open new terminal"
          text `Start another shell in ${terminalMenu.workspaceRoot == "" ? "this workspace" : terminalBasename(terminalMenu.workspaceRoot)}`
      column id="pull-file-filter-menu" popover="auto" role="menu" aria-label="Review files"
        button role="menuitemcheckbox" aria-checked=hidePullTests press=togglePullTests popovertarget="pull-file-filter-menu" popovertargetaction="hide" testId="pull-hide-test-files"
          text "Hide test files"
      column id="terminal-options-menu" popover="auto" role="menu" aria-label="Terminal options"
        button role="menuitem" popovertarget="terminal-text-size-menu"
          image "symbol:sf/textformat.size"
          text "Text size"
        for session in terminalMenu.sessions key=`option-${session.terminalId}`
          button role="menuitemradio" aria-checked=(session.terminalId == (threadRoute.name == "terminal" ? threadRoute.params.terminalId : "")) press=openTerminal(activeThreadId, session.terminalId) popovertarget="terminal-options-menu" popovertargetaction="hide"
            image "symbol:sf/terminal"
            text session.displayLabel
        button role="menuitem" press=openNewTerminal(activeThreadId) popovertarget="terminal-options-menu" popovertargetaction="hide" disabled=(not terminalMenu.canOperate)
          image "symbol:sf/plus"
          text "Open new terminal"
      column id="terminal-text-size-menu" popover="auto" role="menu" aria-label="Text size"
        button role="menuitem" press=decreaseTerminalFont popovertarget="terminal-text-size-menu" popovertargetaction="hide" disabled=(terminalFontSize <= 6)
          text `A- ${max(6, terminalFontSize - 0.5)} pt`
        button role="menuitem" press=increaseTerminalFont popovertarget="terminal-text-size-menu" popovertargetaction="hide" disabled=(terminalFontSize >= 14)
          text `A+ ${min(14, terminalFontSize + 0.5)} pt`
      column id="git-menu" popover="auto" role="menu" aria-label="Git controls"
        button role="menuitem" press=ignoreGitStatus disabled=true testId="git-status-row"
          image "symbol:sf/point.topleft.down.curvedto.point.bottomright.up"
          text (pending(gitStatus) ? "Checking status" : gitBranchLabel(gitStatus))
          text (pending(gitStatus) ? "Checking status" : gitStatusLabel(gitStatus)) testId="git-status"
        button role="menuitem" press=runQuickGitAction popovertarget="git-menu" popovertargetaction="hide" disabled=(pending(gitStatus) or gitBusy or not gitStatus.isRepo or ["detached", "no_origin", "no_commits", "clean", "diverged"].includes(gitQuickActionKind(gitStatus, gitBusy, gitWritable)) or (not gitWritable and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "open_pr") or (activeDraftKey != "" and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "pull")) testId="git-quick-action"
          image (gitQuickActionKind(gitStatus, gitBusy, gitWritable) == "pull" ? "symbol:sf/arrow.down.circle" : gitQuickActionKind(gitStatus, gitBusy, gitWritable) == "commit" ? "symbol:sf/checkmark.circle" : "symbol:sf/arrow.up.circle")
          text (pending(gitStatus) ? "Checking status" : gitQuickAction(gitStatus, gitBusy, gitWritable))
          text (activeDraftKey != "" and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "pull" ? "Available after the first message" : gitError != "" ? gitError : gitStatus.unavailableReason != "" ? gitStatus.unavailableReason : not gitWritable and gitQuickActionKind(gitStatus, gitBusy, gitWritable) != "open_pr" ? "This connection cannot change source control." : gitBusy ? gitOperation.label : gitQuickActionHint(gitStatus, gitBusy, gitWritable))
        button role="menuitem" press=inspect("git") popovertarget="git-menu" popovertargetaction="hide" disabled=(pending(gitStatus) or not gitStatus.isRepo or not activeThreadHasMessage) testId="git-review-changes"
          image "symbol:sf/text.bubble"
          text "Review changes"
          text (not activeThreadHasMessage ? "Available after the first message" : "Inspect changes, uncommitted edits, and turn diffs")
        button role="menuitem" press=openGitOverview popovertarget="git-menu" popovertargetaction="hide" disabled=(activeThreadId == "" or not activeThreadHasMessage) testId="git-more"
          image "symbol:sf/ellipsis"
          text "More"
          text (not activeThreadHasMessage ? "Available after the first message" : "Branches, worktrees, links, and repository details")
      workspace-tab-bar selected-tab=visibleTab shows-compose=(visibleTab == "threads" ? "true" : "false") compact="true" message=workspaceAction height=128 position="absolute" bottom="calc(0px - env(safe-area-inset-bottom))" left=8 right=(visibleTab == "threads" ? 12 : 76) display=(atRoot and not device.rail and device.kind != "web" ? "flex" : "none")
      row role="tablist" aria-label="Workspace" testId="tabs" padding-right=(device.kind == "web" ? 64 : 0) display=(device.rail or (atRoot and device.kind == "web") ? "flex" : "none")
        button role="tab" aria-label="Chats" aria-controls="panel-threads" aria-selected=(nav.tab == "threads") press=selectTab("threads") testId="tab-threads" flex=1 min-width=0
          image (device.kind == "web" ? "symbol:messages" : "symbol:sf/text.bubble")
          text "Chats" max-width="100%" line-clamp=1
        button role="tab" aria-controls="panel-threadDetail" aria-selected=(nav.tab == "threadDetail") press=selectTab("threadDetail") testId="tab-threadDetail" display="none"
          image "symbol:sf/text.bubble"
          text "Thread"
        button role="tab" appearance="none" aria-label="PRs" aria-controls="panel-pullRequests" aria-selected=(nav.tab == "pullRequests") press=selectTab("pullRequests") testId="tab-pullRequests" flex=1 min-width=0 display="flex" flex-direction="column" justify-content="center" align-items="center" padding="0 8px" gap=3 border="none" background-color="transparent" color=(nav.tab == "pullRequests" ? "tab-selected" : "tab-muted") font-size="0.75rem" font-weight=500
          if device.kind == "web"
            svg viewBox="0 0 24 24" width=20 height=20 fill="none" stroke=(nav.tab == "pullRequests" ? "tab-selected" : "tab-muted") stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
              path d="M6 8v8 M18 16V9a3 3 0 0 0-3-3h-4 M14 3l-3 3 3 3"
              circle cx=6 cy=6 r=2
              circle cx=6 cy=18 r=2
              circle cx=18 cy=18 r=2
          else
            image "assets/pull-request.png" width=20 height=20 -exact-tint-color=(nav.tab == "pullRequests" ? "tab-selected" : "tab-muted")
          text "PRs" max-width="100%" line-clamp=1
        button role="tab" aria-label="Usage" aria-controls="panel-usage" aria-selected=(nav.tab == "usage") press=selectTab("usage") testId="tab-usage" flex=1 min-width=0
          image (device.kind == "web" ? "symbol:chart" : "symbol:sf/chart.bar.xaxis")
          text "Usage" max-width="100%" line-clamp=1
        button role="tab" aria-label="Settings" aria-controls="panel-settings" aria-selected=(nav.tab == "settings") press=selectTab("settings") testId="tab-settings" flex=1 min-width=0
          image "symbol:settings"
          text "Settings" max-width="100%" line-clamp=1
        button role="tab" aria-controls="panel-settingsDetail" aria-selected=(nav.tab == "settingsDetail") press=selectTab("settingsDetail") testId="tab-settingsDetail" display="none"
          image "symbol:settings"
          text "Setting"
      if device.kind == "web" and atRoot and visibleTab == "threads"
        button press=compose buttonStyle="glass" aria-label="New chat" testId="workspace-compose" position="absolute" right=10 bottom="calc(6px + env(safe-area-inset-bottom))" width=44 height=44
          image "symbol:compose"

component ThreadList
  props
    now: number
    catalog: Catalog
    drafts: HomeDraftRow[]
    openDraft: action
    discardDraft: action
    aimDraft: action
    aimPin: action
    visibleThreads: Thread[]
    searchHits: SearchHit[]
    searchPending: bool
    searchIncomplete: bool
    selectedEnvironment: string
    selectedProject: string
    selectedProjectLabel: string
    nativeMenus: bool
    query: string
    showSettled: bool
    showSnoozed: bool
    showWorking: bool
    sidebar: bool
    selectedId: string
    toggleShelf: action
    toggleWorking: action
    openThread: action
    filterEnvironment: action
    filterProject: action
    resetFilters: action
  derive searching = query.trim() != ""
  derive awakeThreads = visibleThreads.filter(thread => thread.wakeAt <= now)
  derive snoozedThreads = sortBy(visibleThreads.filter(thread => thread.wakeAt > now), thread => thread.wakeAt)
  derive pinnedThreads = sortBy(awakeThreads.filter(thread => not thread.settled and thread.pinRank >= 0), thread => thread.pinRank)
  derive ordinaryThreads = awakeThreads.filter(thread => not thread.settled and thread.pinRank < 0 and not thread.working)
  derive activeThreads = searching ? awakeThreads.filter(thread => not thread.settled) : pinnedThreads.concat(ordinaryThreads)
  derive workingThreads = awakeThreads.filter(thread => not searching and not thread.settled and thread.pinRank < 0 and thread.working)
  derive displayedWorking = workingThreads.filter(thread => showWorking or selectedId == thread.id)
  derive settledThreads = awakeThreads.filter(thread => thread.settled)
  derive availableProjects = catalog.projects.filter(project => selectedEnvironment == "" or project.environmentId == selectedEnvironment)
  view
    list id="home" appearance="none" flex=1 min-height=0 background-color=(sidebar ? "transparent" : "screen")
      section
        scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0
          row gap=8 padding="2px 20px 10px" flex-wrap="nowrap" align-items="center"
            if nativeMenus
              workspace-filter-menu chip-label=(selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) options-query=("=All%20environments&" + catalog.environments.map(environment => `${encodeURIComponent(environment.id)}=${encodeURIComponent(environment.label)}`).join("&")) selected-id=selectedEnvironment active=(selectedEnvironment != "" ? "true" : "false") accessibility-label="Filter threads by environment" test-id="all-environments" testId="all-environments" message=filterEnvironment flex-shrink=0
              workspace-filter-menu chip-label=selectedProjectLabel options-query=("=All%20projects&" + availableProjects.map(project => `${encodeURIComponent(project.id)}=${encodeURIComponent(project.title)}`).join("&")) selected-id=selectedProject active=(selectedProject != "" ? "true" : "false") accessibility-label="Filter threads by project" test-id="all-projects" testId="all-projects" message=filterProject flex-shrink=0
            else
              button popovertarget="environment-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedEnvironment == "" ? "muted" : "white") background-color=(selectedEnvironment == "" ? "transparent" : "AccentColor") testId="all-environments"
                text (selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) max-width=180 line-clamp=1
                image "symbol:icon.disclose-down" width=11 height=11
              button popovertarget="project-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedProject == "" ? "muted" : "white") background-color=(selectedProject == "" ? "transparent" : "AccentColor") testId="all-projects"
                text selectedProjectLabel max-width=180 line-clamp=1
                image "symbol:icon.disclose-down" width=11 height=11
            if selectedEnvironment != "" or selectedProject != ""
              button press=resetFilters appearance="none" aria-label="Reset thread filters" testId="reset-filters" width=28 height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:sf/xmark.circle.fill" width=18 height=18 color="muted"
      if drafts.length > 0
        section
          row align-items="center" gap=8.75 margin="14px 0 5.25px" padding=(sidebar ? "0 10.5px" : "0 17.5px") testId="home-unsent"
            text "Unsent" font-size=13 line-height="17px" font-weight=500 color="muted"
            view flex=1 height=1 background-color="edge"
          for draft, index in drafts key=draft.key
            row press=openDraft(draft.key, draft.kind, draft.threadId) swipeleft=discardDraft(draft.key, draft.kind) contextmenu=aimDraft(draft.key, draft.kind) contextPopover="draft-menu" role="button" width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) aria-label=draft.title testId=`home-draft-${draft.key}`
              HomeDraftRowContent(draft=draft, sidebar=sidebar, showEnvironment=(catalog.environments.length > 1), last=(index == drafts.length - 1))
      section
        if searching and searchIncomplete
          text "Some environments could not search messages." font="-exact-footnote" color="muted" text-align="center"
        if searching and searchPending and visibleThreads.length == 0 and drafts.length == 0
          text "Searching thread messages…" font="-exact-body" color="muted" text-align="center"
        else if visibleThreads.length == 0 and drafts.length == 0
          column align-items="center" padding="28px 21px" gap=7
            text (searching ? (sidebar ? "No matching threads" : "No results") : selectedProject != "" ? `No threads in ${selectedProjectLabel}` : selectedEnvironment != "" ? `No threads in ${environmentLabel(catalog, selectedEnvironment)}` : "No threads yet") font="-exact-title3" font-weight=700 text-align="center" testId="empty-title"
            if not sidebar
              text (searching ? `No threads matching "${query}".` : selectedProject != "" ? "Choose another project or create a new task." : selectedEnvironment != "" ? "Choose another environment or create a new task." : "Create a task to start a new coding session.") font="-exact-body" color="muted" text-align="center" testId="empty-thread-detail"
      for threads, groupIndex in [activeThreads, displayedWorking] key=groupIndex
        section
          if groupIndex == 1 and workingThreads.length > 0
            button press=toggleWorking appearance="none" padding="14px 17.5px 5.25px" width="100%" box-sizing="border-box" aria-label="Working threads" testId="working-threads"
              row align-items="center" gap=8.75 width="100%"
                text (showWorking ? "Working" : `Working (${workingThreads.length})`) font-size=13 line-height="17px" font-weight=500 color="muted"
                view flex=1 height=1 background-color="edge"
                image (showWorking ? "symbol:icon.disclose-up" : "symbol:icon.disclose-down") font-size=10 color="muted"
          for thread, index in threads key=thread.id
            button press=openThread(path("thread", thread.id)) contextmenu=aimPin(thread.id, thread.controls.accessKey, thread.pinRank < 0) contextPopover="thread-row-menu" appearance="none" testId=`thread-${thread.id}` width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" text-align="left" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) background-color=(sidebar and selectedId == thread.id ? "thread-selected" : "transparent")
              column flex=1 min-width=0 gap=3.5 opacity=(thread.working and selectedId != thread.id ? 0.55 : 1) padding=(sidebar ? "10px 12px" : "8.75px 17.5px")
                row align-items="flex-start" gap=7 color=(sidebar ? "sidebar-foreground" : "foreground")
                  if thread.projectIcon != ""
                    image thread.projectIcon width=20 height=20 margin-top=1.5 border-radius=4
                  else
                    text thread.projectInitials width=20 height=20 margin-top=1.5 line-height="20px" border-radius=4 font-size=10 font-weight=700 color=thread.projectIconColor background-color=`${thread.projectIconColor}22` text-align="center"
                  text thread.title aria-label=(thread.regeneratingTitle ? `${thread.title}, regenerating title` : thread.title) opacity=(thread.regeneratingTitle ? 0.55 : 1) font-size=16 line-height="23px" font-weight=(thread.working and selectedId != thread.id ? 400 : 500) flex=1 min-width=0 line-clamp=2
                  if thread.pinRank >= 0
                    column width=11 height=23 flex-shrink=0 justify-content="center" testId=`pin-${thread.id}` aria-label="Pinned"
                      if nativeMenus
                        image "symbol:pin" width=11 height=11 font-size=11 color=(sidebar ? "sidebar-muted" : "muted")
                      else
                        svg viewBox="0 0 16 16" width=11 height=11 fill="none" stroke=(sidebar ? "sidebar-muted" : "muted") stroke-width=1.5 stroke-linejoin="round" stroke-linecap="round" aria-hidden=true
                          path d="m6 1 6 2-1 1-1.5 4 1 2-7-2 .9-1.6L6.5 6 8 2.8ZM6.9 9.2 5 14.5"
                  if thread.status != ""
                    row align-items="center" gap=3.5 min-height=23 color=(sidebar and selectedId == thread.id ? "foreground" : threadStatusColor(thread.status))
                      image threadStatusSymbol(thread.status) width=13 height=13 font-weight=600
                      text thread.status font-size=13 line-height="17px" font-weight=700
                  else
                    text compactAge(thread.activityAt, now) testId=`age-${thread.id}` font-size=13 line-height="23px" color=(sidebar ? "sidebar-muted" : "muted") font-variant-numeric="tabular-nums"
                row align-items="center" gap=7 min-height=14 padding-left=28
                  if searchHits.filter(hit => hit.id == thread.id).length > 0
                    SearchExcerpt(hits=searchHits, id=thread.id)
                  else if thread.lastError != ""
                    text thread.lastError font-size=13 line-height="17px" color=(sidebar and selectedId == thread.id ? "muted" : "danger") flex=1 min-width=0 line-clamp=1
                  else if catalog.environments.length > 1
                    image "symbol:sf/laptopcomputer" font-size=12 color="muted"
                    text environmentLabel(catalog, thread.environmentId) font-size=13 line-height="17px" color="muted" flex=1 min-width=0 line-clamp=1
                  else
                    view flex=1
                  row opacity=0.6
                    ProviderIcon(provider=thread.provider, size=14)
            if index < threads.length - 1
              view height=1 background-color="edge" opacity=0.7 margin-left=17.5 display=(sidebar ? "none" : "flex")
      for shelf in ["snoozed", "settled"].filter(key => key == "snoozed" ? snoozedThreads.length > 0 : settledThreads.length > 0) key=shelf
        section
          if not searching
            button press=toggleShelf(shelf) appearance="none" padding=(sidebar ? "14px 10.5px 5.25px" : "14px 17.5px 5.25px") width="100%" box-sizing="border-box" aria-expanded=(shelf == "snoozed" ? showSnoozed : showSettled) aria-label=(shelf == "snoozed" ? `${snoozedThreads.length} snoozed ${snoozedThreads.length == 1 ? "thread" : "threads"}` : "Settled threads") testId=`${shelf}-threads`
              row align-items="center" gap=8.75 width="100%"
                text (shelf == "snoozed" ? (showSnoozed ? "Snoozed" : `Snoozed (${snoozedThreads.length})`) : (showSettled ? "Settled" : `Settled (${settledThreads.length})`)) testId=`${shelf}-title` font-size="0.8125rem" line-height="1.0625rem" font-weight=500 color="muted"
                view flex=1 height=1 background-color=(shelf == "snoozed" ? "AccentColor" : "edge") opacity=(shelf == "snoozed" ? 0.2 : 1)
                if nativeMenus
                  image ((shelf == "snoozed" ? showSnoozed : showSettled) ? "symbol:icon.disclose-up" : "symbol:icon.disclose-down") width=10 height=10 font-size=10 color="muted"
                else
                  svg viewBox="0 0 10 10" width=10 height=10 fill="none" stroke="muted" stroke-width=1.4 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                    path d=((shelf == "snoozed" ? showSnoozed : showSettled) ? "M1.5 6.5 5 3l3.5 3.5" : "M1.5 3.5 5 7l3.5-3.5")
          for thread in (shelf == "snoozed" ? snoozedThreads : settledThreads).filter(thread => searching or (shelf == "snoozed" ? showSnoozed : showSettled) or selectedId == thread.id) key=thread.id
            button press=openThread(path("thread", thread.id)) contextmenu=aimPin(thread.id, thread.controls.accessKey, thread.pinRank < 0) contextPopover="thread-row-menu" appearance="none" testId=`thread-${thread.id}` width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" text-align="left" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) background-color=(sidebar and selectedId == thread.id ? "thread-selected" : "transparent")
              row flex=1 min-width=0 min-height=44 box-sizing="border-box" align-items="center" gap=7 padding=(sidebar ? "7px 10.5px" : "7px 17.5px")
                if thread.projectIcon != ""
                  image thread.projectIcon width=20 height=20 border-radius=4 opacity=0.4
                else
                  text thread.projectInitials width=20 height=20 line-height="20px" border-radius=4 font-size=10 font-weight=700 color=thread.projectIconColor background-color=`${thread.projectIconColor}22` text-align="center" opacity=0.4
                column flex=1 min-width=0
                  text thread.title aria-label=(thread.regeneratingTitle ? `${thread.title}, regenerating title` : thread.title) opacity=(thread.regeneratingTitle ? 0.55 : 1) font-size=16 line-height="23px" font-weight=400 line-clamp=1 color=(sidebar and selectedId == thread.id ? "foreground" : sidebar ? "sidebar-muted" : "muted")
                  SearchExcerpt(hits=searchHits, id=thread.id)
                text (shelf == "snoozed" ? wakeLabel(thread.wakeAt - now) : compactAge(thread.activityAt, now)) testId=`${shelf == "snoozed" ? "wake" : "age"}-${thread.id}` font-family="Menlo" font-size="0.875rem" line-height="1.1875rem" color=(sidebar ? "sidebar-muted" : "muted") font-variant-numeric="tabular-nums"

component PullIdentity
  props
    pull: PullRequest
    detail: PullRequestDetail
    loaded: bool
    now: number
    copy: action
  derive author = loaded and detail.author != "" ? detail.author : pull.author
  derive added = loaded ? detail.counts.added : pull.row.addedText
  derive deleted = loaded ? detail.counts.deleted : pull.row.deletedText
  derive ink = pull.row.status == "Merged" ? "status-input" : pull.row.status == "Closed" ? "danger" : pull.row.status == "Draft" ? "muted" : "status-done"
  view
    column min-width=0 gap=10.5 testId="pull-identity"
      row align-items="center" flex-wrap="wrap" gap=7 min-height=28
        image "assets/pull-request.png" width=14 height=14 -exact-tint-color=ink
        text pull.row.status color=ink font-size="0.8125rem" font-weight=500 testId="pull-identity-status"
        if added != ""
          text added color="status-done" font-size="0.75rem" font-weight=500 font-variant-numeric="tabular-nums"
        if deleted != ""
          text deleted color="danger" font-size="0.75rem" font-weight=500 font-variant-numeric="tabular-nums"
        if loaded and detail.counts.files != ""
          text detail.counts.files color="muted" font-size="0.75rem" testId="pull-request-change-counts"
      text pull.title role="heading" aria-level=2 user-select="text" font-size="1.25rem" line-height="1.75rem" font-weight=700 overflow-wrap="break-word" testId="pull-identity-title"
      row align-items="center" gap=7 min-width=0
        column width=20 height=20 border-radius=10 background-color="card" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          text pull.row.initial font-size=9 font-weight=500 color="muted"
        text (author != "" ? author : "Unknown author") flex=1 min-width=0 font-size="0.8125rem" font-weight=500 line-clamp=1 testId="pull-identity-author"
        if pull.row.updatedMs > 0
          text `Updated ${compactAge(pull.row.updatedMs, now)} ago` min-width=0 max-width="55%" text-align="right" color="muted" font-size="0.75rem" line-clamp=1 testId="pull-identity-updated"
      row align-items="center" gap=5.25 min-width=0
        if pull.baseBranch != ""
          button appearance="none" press=copy(pull.baseBranch) aria-label=`Copy base branch ${pull.baseBranch}` min-width=0 min-height=32 testId="pull-copy-base"
            text pull.baseBranch color="muted" font-family="ui-monospace" font-size="0.75rem" line-clamp=2 overflow-wrap="anywhere"
        if pull.baseBranch != "" and pull.headBranch != ""
          text "←" color="muted" font-size=11 aria-hidden=true
        if pull.headBranch != ""
          button appearance="none" press=copy(pull.headBranch) aria-label=`Copy head branch ${pull.headBranch}` min-width=0 min-height=32 testId="pull-copy-head"
            text pull.headBranch color="muted" font-family="ui-monospace" font-size="0.75rem" line-clamp=2 overflow-wrap="anywhere"

component PullPageFooter
  props
    error: string
    busy: bool
    load: action
  view
    column align-items="center" gap=7 padding="14px 28px"
      if busy
        progress width=18 height=18 aria-label="Loading more pull requests" testId="pulls-loading-more"
      else
        if error != ""
          text error font-size=13 line-height="17px" color="muted" text-align="center" testId="pulls-more-error"
        button press=load aria-label=(error == "" ? "Load more pull requests" : "Retry loading more pull requests") buttonStyle="bordered" testId="pulls-more"
          text (error == "" ? "Load more" : "Try again")

component PullFacetChip
  props
    field: string
    title: string
    label: string
    active: bool
    facet: PullFacet
    native: bool
    choose: action
  view
    if native
      workspace-filter-menu chip-label=title flat-options=facet.menu active=(active ? "true" : "false") accessibility-label=label test-id=`pull-filter-${field}` testId=`pull-filter-${field}` message=choose flex-shrink=0
    else
      button popovertarget=`pull-facet-${field}` aria-haspopup="menu" aria-label=label appearance="none" display="flex" align-items="center" gap=5.25 border-radius=16 padding="5.25px 10.5px" min-height=28 flex-shrink=0 white-space="nowrap" backgroundMaterial="glass" color=(active ? "white" : "muted") background-color=(active ? "AccentColor" : "transparent") font-size="0.875rem" font-weight=500 testId=`pull-filter-${field}`
        text title max-width=180 line-clamp=1
        image "symbol:icon.disclose-down" width=11 height=11

component PullFacetMenu
  props
    field: string
    label: string
    facet: PullFacet
    choose: action
  view
    column id=`pull-facet-${field}` popover="auto" role="menu" aria-label=label max-height="70dvh" overflow-y="auto"
      button role="menuitem" press=choose("search") popovertarget=`pull-facet-${field}` popovertargetaction="hide" testId=`pull-search-${field}`
        image "symbol:search"
        text `Search ${field}…`
      for option in facet.options key=option.id
        button role=(field == "labels" ? "menuitemcheckbox" : "menuitemradio") aria-checked=option.selected press=choose(`value:${option.id}`) popovertarget=`pull-facet-${field}` popovertargetaction="hide" testId=`pull-${field}-${option.id}`
          if option.color != ""
            box width=10 height=10 border-radius=5 background-color=option.color flex-shrink=0
          text option.title

component PullFilterChip
  props
    field: string
    selected: string
    options: string[]
    label: string
    native: bool
    choose: action
  derive involvement = field == "involvement"
  derive active = selected != (involvement ? "all" : "open")
  view
    if native
      workspace-filter-menu chip-label=pullFilterLabel(selected, involvement) options-query=options.map(option => `${option}=${encodeURIComponent(pullFilterLabel(option, involvement))}`).join("&") selected-id=selected active=(active ? "true" : "false") accessibility-label=label test-id=`pull-filter-${field}` testId=`pull-filter-${field}` message=choose flex-shrink=0
    else
      button popovertarget=`pull-filter-menu-${field}` aria-haspopup="menu" aria-label=label appearance="none" display="flex" align-items="center" gap=5.25 border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" backgroundMaterial="glass" color=(active ? "white" : "muted") background-color=(active ? "AccentColor" : "transparent") font-size=14 line-height="19px" font-weight=500 testId=`pull-filter-${field}`
        text pullFilterLabel(selected, involvement)
        image "symbol:icon.disclose-down" width=11 height=11

component PullFilterMenu
  props
    field: string
    selected: string
    options: string[]
    label: string
    choose: action
  view
    column id=`pull-filter-menu-${field}` popover="auto" role="menu" aria-label=label
      for option in options key=option
        button press=choose(option) role="menuitemradio" aria-checked=(option == selected) popovertarget=`pull-filter-menu-${field}` popovertargetaction="hide" testId=`pull-${field}-${option}`
          text pullFilterLabel(option, field == "involvement")

component SearchExcerpt
  props
    hits: SearchHit[]
    id: string
  view
    match first(hits.filter(hit => hit.id == id))
      case some(hit)
        text testId=`thread-excerpt-${id}` font="-exact-footnote" flex=1 min-width=0 line-clamp=1 color="muted"
          text (hit.source == "user" ? "You: " : "Agent: ") font-weight=500 color=(hit.source == "user" ? "muted" : "status-done")
          for run in hit.runs key=run.start
            text run.text font-weight=(run.highlighted ? 700 : 400) color=(run.highlighted ? "foreground" : "muted")
      case none
        view display="none"

component EnvironmentList
  props
    scrollId: string
    catalog: Catalog
    toggleEnvironment: action
    manageEnvironment: action
  view
    scroll id=scrollId flex=1 min-height=0 padding="14px 17.5px 36px"
      column border-radius=24 background-color="card" overflow="hidden"
        if catalog.environments.length == 0
          column align-items="center" gap=10.5 padding="28px 21px"
            row width=42 height=42 border-radius=16 background-color="bubble" align-items="center" justify-content="center"
              image "symbol:sf/point.3.connected.trianglepath.dotted" width=20 height=20 color="muted"
            text "No environments connected yet.\nTap + to add one." font-size=14 line-height="21px" color="muted" text-align="center"
        for environment in catalog.environments key=environment.id
          EnvironmentRow(environment=environment, toggleEnvironment=toggleEnvironment, manageEnvironment=manageEnvironment, detail=false, expanded=false)

component EnvironmentRow
  props
    environment: Environment
    toggleEnvironment: action
    manageEnvironment: action
    detail: bool
    expanded: bool
  derive label = detail ? `${expanded ? "Collapse" : "Expand"} details for ${environment.label}` : `Manage ${environment.label}`
  view
    row gap=10.5 padding="12.25px 14px" align-items="center"
      button press=manageEnvironment(environment.id) appearance="none" aria-label=label testId=`manage-${environment.id}` text-align="left" flex=1 min-width=0 display="flex" flex-direction="column" align-items="stretch" gap=1.75 color="foreground"
        row align-items="center" gap=5.25
          row width=16 height=16 align-items="center" justify-content="center"
            view width=8 height=8 border-radius=4 background-color=(environment.status == "Connected" ? "online" : "muted")
          image `symbol:sf/${environment.machineSymbol}` width=14 height=14 color="muted"
          text environment.label font-weight=700 font-size=16 line-height="20px" flex=1 min-width=0 line-clamp=1
        text (environment.url.endsWith("/") ? environment.url : environment.url + "/") font-size=13 line-height="17px" color="muted" line-clamp=1
        text environment.status font-size=13 line-height="17px" color="muted"
      input type="checkbox" switch accent-color="AccentColor" checked=environment.enabled change=toggleEnvironment(environment.id) aria-label=`Enable ${environment.label}` testId=`environment-${environment.id}`
      button press=manageEnvironment(environment.id) aria-label=label appearance="none" width=44 height=44 color="muted"
        image (detail ? (expanded ? "symbol:icon.disclose-up" : "symbol:icon.disclose-down") : "symbol:forward-chevron") width=12 height=12
