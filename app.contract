use ProviderIcon from "./provider-icon.contract"
use ToolRow, ToolChild, ToolExpansion, ToolImage, ToolPanel, ToolBatch, toolAttempt, matchingToolPanels, toolCopyText from "./tool-row.contract"
use MediaBatch, MediaImage from "./media-image.contract"
use TurnReview, TurnReviewContent, ReviewRow from "./turn-review.contract"
use ThreadDraft, threadDraft, DraftAttachment, PendingSend, DraftReceipt, SendReply, CleanupAttachment, ComposerAttachments, ComposerThumbnail, TaskStamp from "./attachments.contract"
use NewTaskView, ProjectChoices, ProjectChoice, EnvironmentChoice, BranchChoices, BranchRow, HomeDraftRow, isDraftKey, launchOf, launching, launchText, launchTitle, launchStrategy, launchError, routeMode, DraftHero, DraftControls, PreparingThread, ProjectMark, InlineControl, EnvironmentControl, ProjectPicker, EnvironmentPicker, BranchPicker, HomeDraftRowContent from "./new-task.contract"
use TurnChanges, TurnChangeStat, Message, BlockRef, CodeBatch, TableBatch, MarkdownLink, FilePreview, MarkdownMessage, MarkdownBlock, MarkdownBlockView, markdownPalette, syntaxColor from "./markdown.contract"
use EmptyState from "exact:content"
use UsageChart, UsageChartData, providerColor from "./usage-chart.contract"
use ThreadControls, ControlAccess, ControlReply, QuestionDraft, ControlQuestion, RequestCard, noControls, questionDraft from "./controls.contract"
use ThreadScrollPosition from "./thread-scroll.contract"
use CloneBannerModel, AddProjectSourceScreen, AddProjectRepositoryScreen, AddProjectDestinationScreen, AddProjectLocalScreen, AddProjectNewScreen, AddProjectCloneBanner from "./add-project.contract"
use ToolGroup from "./tool-group.contract"
use ComposerSession, ComposerCommandSurface, ComposerQueue from "./composer-parity.contract"

font "DM Sans"
  400 = "assets/fonts/DMSans_400Regular.ttf"
  500 = "assets/fonts/DMSans_500Medium.ttf"
  700 = "assets/fonts/DMSans_700Bold.ttf"
  400 italic = "assets/fonts/DMSans_400Regular_Italic.ttf"
  500 italic = "assets/fonts/DMSans_500Medium_Italic.ttf"
  700 italic = "assets/fonts/DMSans_700Bold_Italic.ttf"

keyframes undoArrival
  from translate="0px 62px"
keyframes undoDeparture
  to opacity=0

shape UndoViewport
  prefersReducedMotion: bool

routes nav
  tab threads "/"
  tab threadDetail "/detail"
    thread "/threads/:id"
      inspector "/threads/:id/inspect/:kind"
      gitOverview "/threads/:id/git"
      gitCommit "/threads/:id/git/commit"
      gitConfirm "/threads/:id/git/confirm"
      linkedFile "/threads/:id/file/:file/:line/:column"
      turnReview "/threads/:id/review/:turn"
      terminal "/threads/:id/terminal/:terminalId"
      composerQueue "/threads/:id/queue"
      composerContext "/threads/:id/context"
      threadSettings "/threads/:id/settings"
        settingChoice "/threads/:id/settings/:kind/:option"
      chooseProject "/threads/:id/project"
        addProject "/threads/:id/project/add"
          addProjectNew "/threads/:id/project/add/new"
          addProjectLocal "/threads/:id/project/add/local"
          addProjectRepository "/threads/:id/project/add/repo/:source"
            addProjectDestination "/threads/:id/project/add/clone/:source"
      draftEnvironment "/threads/:id/environment"
      draftBranch "/threads/:id/branch"
  tab pullRequests "/pulls"
    pullFilterSearch "/pulls/filter/:kind/search"
    pullRequest "/pulls/:project/:number"
      pullFile "/pulls/:project/:number/file/:file"
        pullFilesSheet "/pulls/:project/:number/file/:file/picker"
  tab usage "/usage"
  tab settings "/settings"
  tab settingsDetail "/settings/detail"
    keyboardSettings "/settings/keyboard"
    environments "/environments"
      addEnvironment "/environments/new"
      environmentDetail "/environments/:id"

