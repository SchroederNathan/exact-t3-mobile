                      if e.params.id == activeThreadId and selectedThread(catalog, e.params.id).length > 0 and (threadAway or workingStatus.length > 0)
                        workspace-working-island status-label=floatingStatus.label status-kind=floatingStatus.kind status-symbol=floatingStatus.symbol indicator=floatingStatus.indicator status-action=islandAction action-label=islandActionLabel action-pending=(islandActionBusy ? "true" : "false") action-disabled=(islandActionDisabled ? "true" : "false") action-accessibility-label=(forceStopVisible ? "Force stop the agent" : floatingStatus.actionLabel) reconnect=(floatingStatus.action == "reconnect" ? "true" : "false") show-arrow=(threadAway ? "true" : "false") message=workingIslandAction position="absolute" left=18 right=(split ? "calc(env(safe-area-inset-right) + 18px)" : 18) bottom=2 min-height=38.5 z-index=3
