use ThreadDraft, threadDraft, DraftAttachment, PendingSend, DraftReceipt, SendReply, CleanupAttachment, ComposerAttachments from "./attachments.contract"
use Message, BlockRef, CodeBatch, TableBatch, MarkdownLink, FilePreview, MarkdownMessage from "./markdown.contract"
use EmptyState from "exact:content"
use ThreadControls, ControlAccess, ControlReply, QuestionDraft, ControlQuestion, RequestCard, noControls, questionDraft from "./controls.contract"

font "DM Sans"
  400 = "assets/fonts/DMSans_400Regular.ttf"
  500 = "assets/fonts/DMSans_500Medium.ttf"
  700 = "assets/fonts/DMSans_700Bold.ttf"
  400 italic = "assets/fonts/DMSans_400Regular_Italic.ttf"
  500 italic = "assets/fonts/DMSans_500Medium_Italic.ttf"
  700 italic = "assets/fonts/DMSans_700Bold_Italic.ttf"

routes nav
  tab threads "/"
  tab threadDetail "/detail"
    newThread "/threads/new"
    thread "/threads/:id"
      inspector "/threads/:id/inspect/:kind"
      linkedFile "/threads/:id/file/:file/:line/:column"
      threadSettings "/threads/:id/settings"
        settingChoice "/threads/:id/settings/:kind/:option"
  tab pullRequests "/pulls"
  tab usage "/usage"
  tab settings "/settings"
  tab settingsDetail "/settings/detail"
    environments "/environments"
      addEnvironment "/environments/new"
      environmentDetail "/environments/:id"

shape Choice
  id: string
  label: string
  description: string
  available: bool
  unavailableReason: string

shape Model
  id: string
  instanceId: string
  provider: string
  label: string
  slug: string
  available: bool
  unavailableReason: string
  isDefault: bool
  isLegacy: bool
  isFavorite: bool

shape ProviderGroup
  id: string
  label: string
  provider: string
  models: Model[]

shape ModelOption
  id: string
  label: string
  kind: string
  value: string
  valueLabel: string
  choices: Choice[]

shape SheetSettings
  groups: ProviderGroup[]
  options: ModelOption[]
  selectedModelId: string
  appliedModelId: string
  runtimeMode: string
  runtimeLabel: string
  runtimeChoices: Choice[]
  saveLabel: string
  error: string

shape NavigationChange
  before: Router
  after: Router
  split: bool

shape Time
  epochAtZero: number

shape Device
  kind: string
  rail: bool
  split: bool

shape Environment
  id: string
  label: string
  url: string
  status: string
  enabled: bool
  machineSymbol: string

shape ToolSummary
  category: string
  status: string
  title: string
  symbol: string
  revision: string
  exitLabel: string

shape FeedRow
  id: string
  message: option<Message>
  activity: option<ToolSummary>

shape ToolRequest
  rowId: string
  revision: string
  retry: number

shape ToolExpansion
  threadId: string
  rowId: string
  attempt: number

shape ToolPanel
  rowId: string
  revision: string
  retry: number
  state: string
  input: string
  output: string
  truncated: bool
  error: string

shape ToolBatch
  viewKey: string
  panels: ToolPanel[]

shape VisitMetadata
  ready: bool
  supported: bool
  at: string
  watermark: number
  seen: number
  urgent: bool

shape VisitTracker
  id: string
  openPending: bool
  watermark: number
  cooling: bool
  serial: number

shape ThreadOpen
  id: string
  at: number

shape ThreadHistory
  ready: bool
  synchronized: bool
  hasMore: bool
  loading: bool
  error: string

shape Thread
  id: string
  listed: bool
  visit: VisitMetadata
  history: ThreadHistory
  environmentId: string
  project: string
  projectId: string
  model: string
  activityAt: number
  settled: bool
  projectIcon: string
  projectInitials: string
  projectIconColor: string
  provider: string
  lastError: string
  lastErrorTime: string
  title: string
  status: string
  updatedAt: string
  rows: FeedRow[]
  toolViewKey: string
  markdownRevision: number
  controls: ThreadControls

shape Project
  id: string
  title: string
  environmentId: string

shape Catalog
  modelDraftRevision: number
  projects: Project[]
  environments: Environment[]
  threads: Thread[]

shape CreatedThread
  ok: bool
  error: string
  threadId: string

shape Reply
  ok: bool
  error: string


shape InspectionItem
  id: string
  label: string
  detail: string
  kind: string

shape Inspection
  ok: bool
  error: string
  title: string
  body: string
  items: InspectionItem[]

fn selectedThread(catalog: Catalog, id: string): Thread[] = catalog.threads.filter(thread => thread.id == id)
fn environmentLabel(catalog: Catalog, id: string): string = match first(catalog.environments.filter(environment => environment.id == id)) { case some(environment) => environment.label, case none => "Unknown environment" }
fn threadFeed(threads: Thread[]): FeedRow[] = match first(threads) { case some(thread) => thread.rows, case none => [] }
fn threadRows(threads: Thread[]): option<FeedRow>[] = [none].concat(threadFeed(threads).map(row => some(row)))
fn threadToolViewKey(threads: Thread[]): string = match first(threads) { case some(thread) => thread.toolViewKey, case none => "" }
fn toolAttempt(expanded: ToolExpansion[], threadId: string, rowId: string): number = match first(expanded.filter(entry => entry.threadId == threadId and entry.rowId == rowId)) { case some(entry) => entry.attempt, case none => -1 }
fn toolRevision(row: FeedRow): string = match row.activity { case some(tool) => tool.revision, case none => "" }
fn wantedTools(rows: FeedRow[], expanded: ToolExpansion[], threadId: string): ToolRequest[] = rows.filter(row => toolRevision(row) != "" and toolAttempt(expanded, threadId, row.id) >= 0).map(row => ToolRequest(rowId=row.id, revision=toolRevision(row), retry=toolAttempt(expanded, threadId, row.id)))
fn matchingToolPanels(batch: ToolBatch, viewKey: string, rowId: string, revision: string, attempt: number): ToolPanel[] = batch.viewKey == viewKey ? batch.panels.filter(panel => panel.rowId == rowId and panel.revision == revision and panel.retry == attempt) : []
fn toolStatusSymbol(status: string): string = status == "error" ? "symbol:sf/exclamationmark.circle" : status == "interrupted" ? "symbol:sf/stop.circle" : "symbol:sf/clock"
fn toolCopyText(batch: ToolBatch, viewKey: string, rowId: string, revision: string, attempt: number, title: string): string = attempt < 0 or matchingToolPanels(batch, viewKey, rowId, revision, attempt).length == 0 ? title : matchingToolPanels(batch, viewKey, rowId, revision, attempt).map(panel => [panel.input, panel.output].filter(part => part != "").join("\n\n")).join("\n\n")
fn currentThreadTitle(threads: Thread[]): string = match first(threads) { case some(thread) => thread.title, case none => "" }
fn currentThreadSubtitle(catalog: Catalog, threads: Thread[]): string = match first(threads) { case some(thread) => `${thread.project} · ${environmentLabel(catalog, thread.environmentId)}`, case none => "" }
fn filteredThreads(threads: Thread[], environmentId: string, query: string): Thread[] = threads.filter(thread => thread.listed and (environmentId == "" or thread.environmentId == environmentId) and (query.trim() == "" or thread.title.toLowerCase().includes(query.trim().toLowerCase()) or thread.project.toLowerCase().includes(query.trim().toLowerCase())))
fn threadStatusSymbol(status: string): string = status == "Done" ? "symbol:sf/checkmark.circle" : status == "Approval" ? "symbol:sf/exclamationmark.shield" : status == "Input" ? "symbol:sf/questionmark.bubble" : status == "Request" ? "symbol:sf/person.crop.circle" : status == "Working" or status == "Goal" ? "symbol:sf/circle.dashed" : status == "Waiting" ? "symbol:sf/circle.dashed.inset.filled" : "symbol:sf/exclamationmark.circle"
fn threadStatusColor(status: string): string = status == "Done" ? "status-done" : status == "Approval" or status == "Limited" ? "status-warning" : status == "Input" ? "status-input" : status == "Request" ? "status-request" : status == "Working" or status == "Goal" ? "status-working" : status == "Failed" ? "danger" : "muted"


fn matchingModels(group: ProviderGroup, query: string, showLegacy: bool, selectedId: string, favoritesOnly: bool): Model[] = group.models.filter(model => (showLegacy or not model.isLegacy or model.id == selectedId or model.isFavorite) and (not favoritesOnly or model.isFavorite) and (query.trim() == "" or model.label.toLowerCase().includes(query.trim().toLowerCase()) or model.slug.toLowerCase().includes(query.trim().toLowerCase()) or group.label.toLowerCase().includes(query.trim().toLowerCase())))
fn modelGroupCollapsed(group: ProviderGroup, overrides: string[], selectedId: string, narrowed: bool): bool = not narrowed and ((["codex", "claudeAgent", "antigravity"].includes(group.provider) or group.models.filter(model => model.id == selectedId).length > 0) ? overrides.includes(group.id) : not overrides.includes(group.id))
fn optionTitle(options: ModelOption[], id: string): string = match first(options.filter(option => option.id == id)) { case some(option) => option.label, case none => "Option" }
fn optionChoices(options: ModelOption[], id: string): Choice[] = match first(options.filter(option => option.id == id)) { case some(option) => option.choices, case none => [] }
fn optionValue(options: ModelOption[], id: string): string = match first(options.filter(option => option.id == id)) { case some(option) => option.value, case none => "" }

component T3Code
  members "./controls-state.contract"
  members "./attachment-state.contract"
  state modelQuery = ""
  state modelProviderFilter = ""
  state modelExpansionOverrides: string[] = []
  state showLegacyModels = false
  state settingsThreadId = ""
  state query = ""
  state sidebarHidden = false
  state selectedEnvironment = ""
  state selectedProject = ""
  state draftEdits: ThreadDraft[] = []
  state address = ""
  state code = ""
  state expandedEnvironment = ""
  state environmentName = ""
  state environmentUrl = ""
  state removedEnvironment = ""
  state showSettled = false
  state inspectorPath = ""
  state composerBottomAdjustment = 0
  state visitTracker = VisitTracker(id="", openPending=false, watermark=-1, cooling=false, serial=0)
  state threadOpens: ThreadOpen[] = []
  state loadingHistoryId = ""
  state expandedTools: ToolExpansion[] = []
  state toolAttemptSerial = 0
  state observedBlocks: BlockRef[] = []
  state wrappedCodes: BlockRef[] = []
  mutation markdownLink as shape MarkdownLink then afterMarkdownLink
  resource linkedFile = loadLinkedFile(threadRoute.name == "linkedFile" ? activeThreadId : "", threadRoute.name == "linkedFile" ? threadRoute.params.file : "", threadRoute.name == "linkedFile" ? threadRoute.params.line : "0", threadRoute.name == "linkedFile" ? threadRoute.params.column : "0") as shape FilePreview else empty()
  derive markdownLinkError = failed(markdownLink) ? "This link could not be opened." : match markdownLink { case some(link) => link.originRoute == `${threadRoute.id}` ? link.error : "", case none => "" }
  resource savedDrafts = loadDrafts() as shape ThreadDraft[] else empty()
  mutation savedDraft as shape DraftReceipt queue then afterDraftSave
  resource restoredModelSettings = restoreModelSettings() as shape Reply else empty()
  mutation persistedModelSettings as shape Reply queue
  derive modelDraftsReady = not pending(restoredModelSettings) and not failed(restoredModelSettings)
  derive modelDraftError = failed(restoredModelSettings) ? "Saved model settings could not be loaded." : failed(persistedModelSettings) ? "Model settings could not be saved." : ""
  derive draftsReady = not pending(savedDrafts) and not failed(savedDrafts)
  derive draftError = failed(savedDrafts) ? "Saved drafts could not be loaded." : failed(savedDraft) ? "The draft could not be saved." : match savedDraft { case some(reply) => reply.error, case none => "" }
  resource settings = loadSettings(settingsThreadId) as shape SheetSettings else empty()
  mutation favoriteChanged as shape Reply refreshes settings
  mutation settingsOpened as shape Reply refreshes settings then afterSettingsOpen
  mutation settingsUpdated as shape Reply refreshes settings then afterSettingsUpdate
  mutation settingsClosed as shape Reply refreshes settings then afterSettingsClose
  derive favoriteError = failed(favoriteChanged) ? "The favorite could not be updated." : match favoriteChanged { case some(reply) => reply.error, case none => "" }
  derive settingsUpdateError = failed(settingsUpdated) ? "The model setting could not be changed." : match settingsUpdated { case some(reply) => reply.error, case none => "" }
  derive settingsCloseError = failed(settingsClosed) ? "The model settings could not be saved." : match settingsClosed { case some(reply) => reply.error, case none => "" }
  derive shownModelGroups = settings.groups.filter(group => (modelProviderFilter == "" or modelProviderFilter == "@favorites" or group.id == modelProviderFilter) and matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites").length > 0)
  resource time = exactTime() as shape Time
  resource device = deviceTraits() as shape Device else empty()
  resource environmentRecords = loadEnvironmentRecords() as shape Environment[] else empty()
  resource catalog = loadCatalog(selectedEnvironment, activeThreadId, environmentRecords) with time.epochAtZero as shape Catalog else empty()
  mutation regrouped as shape NavigationChange then afterRegroup
  mutation changed as shape Reply refreshes environmentRecords, catalog
  mutation sent as shape SendReply then afterSend
  mutation created as shape CreatedThread then afterCreate
  mutation paired as shape Reply refreshes environmentRecords, catalog then afterPair
  mutation savedEnvironment as shape Reply refreshes environmentRecords, catalog then afterEnvironmentSave
  mutation removed as shape Reply refreshes environmentRecords, catalog then afterEnvironmentRemove
  mutation inspected as shape Inspection
  mutation visited as shape Reply queue
  mutation earlierHistory as shape Reply refreshes catalog
  derive historyError = failed(earlierHistory) ? "Earlier messages could not be loaded." : match earlierHistory { case some(reply) => reply.error, case none => "" }
  derive environmentError = failed(savedEnvironment) ? "The environment could not be updated." : match savedEnvironment { case some(reply) => reply.error, case none => "" }
  derive changeError = failed(changed) ? "The connection could not be changed." : match changed { case some(reply) => reply.error, case none => "" }
  derive removeError = failed(removed) ? "The environment could not be removed." : match removed { case some(reply) => reply.error, case none => "" }
  derive pairError = match paired { case some(reply) => reply.error, case none => "" }
  derive sendError = failed(sent) ? "The message could not be sent. Try again." : match sent { case some(reply) => reply.error, case none => "" }
  derive current = top(nav)
  derive duoFolded = device.kind == "duo-folded"
  derive duoDevice = duoFolded or device.kind == "duo-unfolded"
  derive split = device.split
  derive threadNav = nav.tab == "threadDetail" ? nav : select(nav, "threadDetail")
  derive settingsNav = nav.tab == "settingsDetail" ? nav : select(nav, "settingsDetail")
  derive visibleTab = nav.tab == "threadDetail" ? "threads" : nav.tab == "settingsDetail" ? "settings" : nav.tab
  derive threadRoute = split ? top(threadNav) : current
  derive activeThreadId = visibleTab == "threads" and (threadRoute.name == "thread" or threadRoute.name == "inspector" or threadRoute.name == "linkedFile" or threadRoute.name == "threadSettings" or threadRoute.name == "settingChoice") ? threadRoute.params.id : ""
  derive activeToolThreadId = visibleTab == "threads" and threadRoute.name == "thread" ? threadRoute.params.id : ""
  derive toolViewKey = threadToolViewKey(selectedThread(catalog, activeToolThreadId))
  derive toolRequests = wantedTools(threadFeed(selectedThread(catalog, activeToolThreadId)), expandedTools, activeToolThreadId)
  derive codeRevision = match first(selectedThread(catalog, activeToolThreadId)) { case some(thread) => thread.markdownRevision, case none => 0 }
  derive blockCandidates = observedBlocks.filter(ref => ref.threadId == activeToolThreadId and ref.viewKey == toolViewKey)
  resource tableLayouts = loadTableLayouts(activeToolThreadId, toolViewKey, codeRevision, blockCandidates) as shape TableBatch else empty()
  resource codeHighlights = loadCodeHighlights(activeToolThreadId, toolViewKey, codeRevision, blockCandidates) as shape CodeBatch else empty()
  resource toolPanels = loadToolPanels(activeToolThreadId, toolViewKey, toolRequests) as shape ToolBatch else empty()
  derive visitShell = match first(selectedThread(catalog, activeThreadId)) { case some(thread) => thread.visit, case none => VisitMetadata(ready=false, supported=false, at="", watermark=-1, seen=-1, urgent=false) }
  derive atRoot = current.name == "threads" or current.name == "pullRequests" or current.name == "usage" or current.name == "settings"
  derive needsRegroup = split ? nav.tab == "threads" or nav.tab == "settings" or depth(select(nav, "threads")) > 1 or depth(select(nav, "settings")) > 1 : nav.tab == "threadDetail" or nav.tab == "settingsDetail" or depth(threadNav) > 1 or depth(settingsNav) > 1
  derive visibleThreads = filteredThreads(catalog.threads, selectedEnvironment, query).filter(thread => selectedProject == "" or thread.projectId == selectedProject)
  derive selectedProjectLabel = match first(catalog.projects.filter(project => project.id == selectedProject)) { case some(project) => project.title, case none => "All projects" }
  derive composer = threadDraft(savedDrafts, draftEdits, activeThreadId).text
  derive composerError = match sent { case some(reply) => reply.id == activeThreadId and not pending(sent) ? reply.error : "", case none => "" }
  derive canSend = draftsReady and modelDraftsReady and (composer.trim() != "" or composerAttachments.length > 0) and attachmentSendReady and pendingMessage == none and not pending(sent) and not pending(preparedSend)

  task visitObservation key=`${activeThreadId}:${visitShell.ready}:${visitShell.supported}:${visitShell.at}:${visitShell.watermark}:${visitShell.seen}:${visitShell.urgent}`
    after(1, observeVisit)

  task visitCooldown when activeThreadId != "" and activeThreadId == visitTracker.id and visitTracker.cooling key=visitTracker.serial
    after(10000, releaseVisit)

  action observeVisit
    evaluateVisit(false)

  action releaseVisit
    evaluateVisit(true)

  action evaluateVisit(expired: bool)
    let changedThread = visitTracker.id != activeThreadId
    let openedAt = match first(threadOpens.filter(entry => entry.id == activeThreadId)) { case some(entry) => entry.at, case none => -600000 }
    let opened = changedThread and activeThreadId != "" and performanceNow() - openedAt >= 600000
    let next = changedThread ? VisitTracker(id=activeThreadId, openPending=opened, watermark=-1, cooling=false, serial=visitTracker.serial) : VisitTracker(visitTracker, cooling=expired ? false : visitTracker.cooling)
    if opened
      threadOpens = threadOpens.filter(entry => entry.id != activeThreadId).concat([ThreadOpen(id=activeThreadId, at=performanceNow())])
    if activeThreadId == "" or not visitShell.ready or not visitShell.supported
      visitTracker = next
    else if next.openPending
      visitTracker = VisitTracker(next, openPending=false, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, true)
    else if visitShell.seen >= visitShell.watermark
      visitTracker = VisitTracker(next, watermark=max(next.watermark, visitShell.watermark))
    else if visitShell.watermark > next.watermark and (visitShell.urgent or not next.cooling)
      visitTracker = VisitTracker(next, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, false)
    else
      visitTracker = next

  action loadEarlier(id: string)
    loadingHistoryId = id
    send earlierHistory = loadEarlierThread(id)

  action toggleTool(threadId: string, rowId: string)
    if toolAttempt(expandedTools, threadId, rowId) >= 0
      expandedTools = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId)
    else
      let attempt = toolAttemptSerial + 1
      toolAttemptSerial = attempt
      expandedTools = expandedTools.concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  action retryTool(threadId: string, rowId: string)
    let attempt = toolAttemptSerial + 1
    toolAttemptSerial = attempt
    expandedTools = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId).concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  task defaultSettings when split and current.name == "settingsDetail" key=current.id
    after(1, openEnvironments)

  task reconciledModels when modelDraftsReady and catalog.modelDraftRevision > 0 key=catalog.modelDraftRevision
    after(1, persistReconciledModels)

  action observeBlock(threadId: string, viewKey: string, messageId: string, blockId: string, kind: string, event: IntersectionObserverEntry)
    if threadId == activeToolThreadId and viewKey == toolViewKey
      let retained = observedBlocks.filter(ref => ref.threadId == threadId and ref.viewKey == viewKey and not (ref.messageId == messageId and ref.blockId == blockId))
      if event.isIntersecting
        observedBlocks = retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-64)
      else if kind != "table"
        observedBlocks = retained

  action toggleCodeWrap(threadId: string, viewKey: string, messageId: string, blockId: string)
    let retained = wrappedCodes.filter(ref => ref.threadId != threadId or ref.viewKey == viewKey)
    let exists = retained.filter(ref => ref.threadId == threadId and ref.messageId == messageId and ref.blockId == blockId).length > 0
    wrappedCodes = exists ? retained.filter(ref => ref.threadId != threadId or ref.messageId != messageId or ref.blockId != blockId) : retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-256)

  action followMarkdownLink(threadId: string, href: string)
    send markdownLink = resolveMarkdownLink(threadId, href, `${threadRoute.id}`)

  action afterMarkdownLink
    match markdownLink
      case some(link)
        if link.originThreadId == activeThreadId and link.originRoute == `${threadRoute.id}` and link.error == ""
          if link.kind == "thread"
            nav = push(split ? threadNav : nav, path("thread", link.threadId))
          else if link.kind == "file"
            nav = push(split ? threadNav : nav, path("linkedFile", link.threadId, link.path, `${link.line}`, `${link.column}`))
      case none
        nav = nav

  task linkedFilePosition when threadRoute.name == "linkedFile" and not pending(linkedFile) and linkedFile.path == threadRoute.params.file and linkedFile.error == "" key=`${threadRoute.id}:${linkedFile.path}:${linkedFile.lines.length}`
    after(1, revealFileLine)

  action revealFileLine
    if threadRoute.name == "linkedFile" and threadRoute.params.line != "0"
      scrollIntoView("linked-file-lines", linkedFile.targetLine, block="center")

  action persistReconciledModels
    send persistedModelSettings = persistModelSettings()

  task inspector when current.name == "inspector" and selectedThread(catalog, current.params.id).length > 0 key=`${current.id}:${current.params.kind}`
    after(1, loadInspector)

  action openModelSettings
    let id = activeThreadId
    favoriteChanged = none
    settingsUpdated = none
    settingsClosed = none
    settingsThreadId = id
    modelQuery = ""
    modelProviderFilter = ""
    showLegacyModels = false
    modelExpansionOverrides = []
    send settingsOpened = beginSettings(id)
  action afterSettingsOpen
    if match settingsOpened { case some(reply) => reply.ok, case none => false }
      nav = push(split ? threadNav : nav, path("threadSettings", settingsThreadId))
  action cancelModelSettings
    send settingsClosed = closeSettings(settingsThreadId, false)
  action saveModelSettings
    send settingsClosed = closeSettings(settingsThreadId, true)
  action afterSettingsClose
    if match settingsClosed { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      nav = go(nav, path("thread", settingsThreadId))
      settingsThreadId = ""
  action searchModels(value: string)
    modelQuery = value
  action filterModelProvider(id: string)
    modelProviderFilter = id
  action toggleLegacyModels
    showLegacyModels = not showLegacyModels
  action toggleModelGroup(id: string)
    modelExpansionOverrides = modelExpansionOverrides.includes(id) ? modelExpansionOverrides.filter(value => value != id) : modelExpansionOverrides.concat([id])
  action toggleModelFavorite(id: string, favorite: bool)
    send favoriteChanged = setModelFavorite(settingsThreadId, id, favorite)
  action selectSettingsModel(id: string)
    send settingsUpdated = changeSettings(settingsThreadId, "model", id, "")
  action toggleSettingsOption(id: string, value: bool)
    send settingsUpdated = changeSettings(settingsThreadId, "option", id, value ? "true" : "false")
  action openSettingChoice(kind: string, option: string)
    nav = push(nav, path("settingChoice", settingsThreadId, kind, option))

  action chooseSetting(kind: string, id: string, value: string)
    send settingsUpdated = changeSettings(settingsThreadId, kind, id, value)
  action afterSettingsUpdate
    if match settingsUpdated { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      if top(nav).name == "settingChoice"
        nav = back(nav)


  action loadInspector
    send inspected = inspectThread(current.params.id, current.params.kind, "")

  task regroup when needsRegroup key=`${split}:${nav.tab}:${nav.next}:${current.id}`
    after(1, regroupNow)

  action regroupNow
    if needsRegroup
      send regrouped = regroupNavigation(nav, split)

  action afterRegroup
    match regrouped
      case some(change)
        if change.before == nav and change.split == split
          nav = change.after
      case none
        nav = nav

  action selectTab(name: string)
    nav = select(nav, split and name == "threads" ? "threadDetail" : split and name == "settings" ? "settingsDetail" : name)

  action search(value: string)
    query = value

  action toggleSidebar
    sidebarHidden = not sidebarHidden

  action filterEnvironment(id: string)
    selectedEnvironment = id
    selectedProject = ""

  action filterProject(id: string)
    selectedProject = id

  action resetFilters
    selectedEnvironment = ""
    selectedProject = ""

  action openEnvironments
    nav = go(split ? select(settingsNav, "settingsDetail") : nav, "/environments")

  action manageEnvironment(id: string)
    expandedEnvironment = ""
    nav = push(split ? settingsNav : nav, path("environmentDetail", id))

  action expandEnvironment(id: string)
    expandedEnvironment = expandedEnvironment == id ? "" : id
    match first(catalog.environments.filter(environment => environment.id == id))
      case some(environment)
        environmentName = environment.label
        environmentUrl = environment.url.endsWith("/") ? environment.url : environment.url + "/"
      case none
        expandedEnvironment = ""

  action editEnvironmentName(value: string)
    environmentName = value

  action editEnvironmentUrl(value: string)
    environmentUrl = value

  action saveEnvironment(id: string)
    send savedEnvironment = updateEnvironment(id, environmentName, environmentUrl)

  action afterEnvironmentSave
    if environmentError == ""
      expandedEnvironment = ""

  action reconnectEnvironment(id: string)
    send changed = command("reconnect", id, "")

  action askRemoveEnvironment(id: string)
    removedEnvironment = id
    showModal("remove-environment")

  action removeEnvironment
    send removed = command("remove", removedEnvironment, "")

  action afterEnvironmentRemove
    if removeError == ""
      nav = back(nav)

  action addEnvironment
    nav = split ? push(select(settingsNav, "settingsDetail"), "/environments/new") : push(nav, "/environments/new")

  action editAddress(value: string)
    address = value

  action editCode(value: string)
    code = value

  action pair
    send paired = command("pair", address.trim(), code.trim())

  action afterPair
    if pairError == "" and current.name == "addEnvironment"
      nav = back(nav)
      address = ""
      code = ""

  action follow(url: string)
    let base = split and nav.tab == "threads" ? threadNav : split and nav.tab == "settings" ? settingsNav : nav
    let followed = go(base, url)
    nav = followed.next == base.next ? followed : open(base, url)

  action openThread(url: string)
    let base = split ? threadNav : nav
    let detail = activeThreadId != "" ? go(base, path("thread", activeThreadId)) : base
    nav = split and depth(detail) > 1 ? replace(detail, url) : go(detail, url)

  action compose
    nav = split ? push(select(threadNav, "threadDetail"), "/threads/new") : push(nav, "/threads/new")

  action workspaceAction(value: string)
    if value.startsWith("tab:")
      nav = select(nav, value.replaceAll("tab:", ""))
    else if value == "compose"
      nav = push(nav, "/threads/new")

  action createProjectThread(id: string)
    send created = createThread(id, "New thread")

  action afterCreate
    match created
      case some(reply)
        if reply.ok
          nav = replace(split ? threadNav : nav, path("thread", reply.threadId))
      case none
        nav = nav

  action toggleSettled
    showSettled = not showSettled

  action toggleEnvironment(id: string, enabled: bool)
    send changed = command("toggle", id, enabled ? "true" : "false")

  action editComposer(value: string)
    if draftsReady and activeThreadId != ""
      let previous = threadDraft(savedDrafts, draftEdits, activeThreadId)
      persistDraft(ThreadDraft(previous, text=value, revision=previous.revision + 1))

  action copyMessage(body: string)
    copyText(body)

  action composerMetrics(value: string)
    composerBottomAdjustment = match parseNumber(value) { case some(inset) => inset, case none => 0 }

  action inspect(kind: string)
    inspectorPath = ""
    nav = push(split ? threadNav : nav, path("inspector", activeThreadId, kind))

  action inspectEntry(id: string, kind: string)
    inspectorPath = id
    send inspected = inspectThread(activeThreadId, kind == "directory" ? "files" : "file", id)

  action sendMessage
    if canSend and activeThreadId != ""
      attachmentError = ""
      send preparedSend = prepareSend(activeDraft)

  action afterSend
    match sent
      case some(reply)
        let draft = threadDraft(savedDrafts, draftEdits, reply.id)
        match draft.pendingSend
          case some(message)
            if message.commandId == reply.commandId
              let same = draft.revision == message.revision
              let revision = draft.revision + 1
              let updated = ThreadDraft(draft, revision=revision, text=(reply.ok and same ? "" : draft.text), attachments=(reply.ok and same ? [] : draft.attachments), pendingSend=(reply.state == "unknown" ? some(PendingSend(message, state="unknown", revision=(same ? revision : message.revision))) : none))
              persistDraft(updated)
              if reply.state != "unknown"
                attachmentCleanup = attachmentCleanup.concat(message.paths.filter(path => updated.attachments.filter(item => item.path == path).length == 0).map(path => CleanupAttachment(threadId=draft.id, accessKey="", attachmentId="", path=path, revision=updated.revision)))
          case none
            draftEdits = draftEdits
      case none
        draftEdits = draftEdits

  view
    main interactive-widget="resizes-content" testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" display="flex" flex-direction="column" font-family="DM Sans" font-size=16 color="foreground" background-color="screen"
      input type="file" id="attachment-photos" accept="image/*" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-photos"
      input type="file" id="attachment-files" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-files"
      column id="attachment-menu" popover="auto" role="menu" aria-label="Add attachment"
        button press=pickAttachments(true) role="menuitem" testId="choose-photos"
          image "symbol:sf/photo.on.rectangle"
          text "Photo Library"
        if attachmentAccess.maxFileBytes > 0
          button press=pickAttachments(false) role="menuitem" testId="choose-files"
            image "symbol:sf/folder"
            text "Choose Files"
      match attachmentViewer
        case some(viewer)
          if viewer.state != "presented"
            column position="absolute" inset=0 z-index=10 align-items="center" justify-content="center" background-color="screen" gap=12 padding=24
              text (viewer.error != "" ? viewer.error : "Opening attachment…") color=(viewer.error != "" ? "danger" : "muted") font-size=16
              button press=closeAttachmentViewer buttonStyle="bordered" testId="cancel-attachment-preview"
                text "Close"
        case none
          view display="none"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "threads"
                column navigationKey=`${e.id}` navigationScroll="home" data-workspace-header="brand" data-search-placement=(split ? "integrated" : "button") data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column" background-color=(split ? "drawer" : "screen")
                  header
                    text "Chats" role="heading" aria-level=2
                    input type="search" value=query input=search placeholder="Search threads" aria-label="Search threads" testId="search"
                    if duoFolded
                      button press=compose buttonStyle="glass" aria-label="New chat" testId="workspace-compose"
                        image "symbol:compose"
                  if failed(environmentRecords) or failed(catalog)
                    EmptyState(symbol="symbol:alert", title="Can’t load threads", message="Check the connection and try again.")
                  else if catalog.environments.length == 0 and not pending(catalog) and not pending(environmentRecords)
                    column flex=1 align-items="center" justify-content="center" padding="122px 60px 128px" gap=7
                      text (catalog.environments.length == 0 ? "No environments connected" : "No threads yet") font-size=21 line-height="28px" font-weight=700 text-align="center" testId="empty-title"
                      text (catalog.environments.length == 0 ? "Add an environment to load projects and start coding sessions." : "Start a new thread to begin coding.") font-size=16 line-height="24px" color="muted" text-align="center"
                      if catalog.environments.length == 0
                        button press=addEnvironment appearance="none" aria-label="Add environment" testId="empty-add-environment" background-color="AccentColor" color="white" border-radius=999 padding="10px 21px" min-height=42 margin-top=10.5 font-size=16 font-weight=500
                          text "Add environment"
                  else
                    ThreadList(catalog=catalog, visibleThreads=visibleThreads, selectedEnvironment=selectedEnvironment, selectedProject=selectedProject, selectedProjectLabel=selectedProjectLabel, nativeMenus=(device.kind != "web" and device.kind != ""), showSettled=showSettled, sidebar=split, selectedId=(split ? activeThreadId : ""), toggleSettled=toggleSettled, openThread=openThread, filterEnvironment=filterEnvironment, filterProject=filterProject, resetFilters=resetFilters)
              if e.name == "threadDetail"
                column navigationKey=`${e.id}` navigationScroll="thread-empty" data-workspace-header="editor" data-sidebar=(sidebarHidden ? "hidden" : "shown") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    button press=toggleSidebar buttonStyle="glass" aria-label=(sidebarHidden ? "Show sidebar" : "Maximize content") testId="sidebar-toggle"
                      image (sidebarHidden ? "symbol:sf/sidebar.left" : "symbol:sf/arrow.up.left.and.arrow.down.right")
                    text "" role="heading" aria-level=2
                    button press=compose buttonStyle="glass" aria-label="New chat" testId="detail-compose"
                      image "symbol:compose"
                  scroll id="thread-empty" flex=1 min-height=0
                    column min-height="100%" box-sizing="border-box" align-items="center" justify-content="center" gap=10.5 padding="0 35px 46px"
                      image "symbol:sf/sidebar.left" width=34 height=34 color="muted"
                      text "Select a thread" font-size=21 line-height="28px" font-weight=700 text-align="center"
                      text "Choose a thread from the sidebar or start a new task." font-size=16 line-height="24px" color="muted" max-width=360 text-align="center"
              if e.name == "settingsDetail"
                column navigationKey=`${e.id}` data-workspace-header="editor" position="absolute" inset=0 background-color="screen"
                  header
                    text "Settings" role="heading" aria-level=2
                  button press=openEnvironments testId="detail-environments" aria-label="Environments"
                    text "Environments"
              if e.name == "environments"
                column navigationKey=`${e.id}` navigationScroll=`environments-${e.id}` data-workspace-header=(split ? "editor" : "page") data-hides-back=(split ? "true" : "false") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text "Environments" role="heading" aria-level=2
                    button press=addEnvironment buttonStyle="glass" aria-label="Add environment" testId=`environment-add-${e.name}`
                      image "symbol:add"
                  if failed(environmentRecords) or failed(catalog)
                    EmptyState(symbol="symbol:alert", title="Can’t load environments", message="Check the connection and try again.")
                  else
                    EnvironmentList(scrollId=`environments-${e.id}`, catalog=catalog, toggleEnvironment=toggleEnvironment, manageEnvironment=manageEnvironment)
                  if changeError != ""
                    text changeError color="danger" padding=16 testId="connection-error"
              if e.name == "environmentDetail"
                column navigationKey=`${e.id}` navigationScroll=`connection-${e.id}` data-workspace-header=(split ? "editor" : "page") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text environmentLabel(catalog, e.params.id) role="heading" aria-level=2
                  scroll id=`connection-${e.id}` flex=1 min-height=0 padding="14px 17.5px 36px"
                    for environment in catalog.environments.filter(entry => entry.id == e.params.id) key=environment.id
                      column gap=8.75
                        text "Connection" font-size=14 line-height="21px" color="muted" padding="0 7px"
                        column border-radius=24 background-color="card" overflow="hidden"
                          EnvironmentRow(environment=environment, toggleEnvironment=toggleEnvironment, manageEnvironment=expandEnvironment, detail=true, expanded=(expandedEnvironment == environment.id))
                          if expandedEnvironment == environment.id
                            column gap=10.5 padding="0 14px 14px"
                              column gap=5.25
                                text "LABEL" font-size=12 font-weight=700 letter-spacing="0.8px" color="muted"
                                input value=environmentName input=editEnvironmentName aria-label="Label" testId="environment-label" appearance="none" font-family="DM Sans" font-size=16 padding="12.25px 14px" background-color="input-fill" border="1px solid input-edge" border-radius=14
                              column gap=5.25
                                text "URL" font-size=12 font-weight=700 letter-spacing="0.8px" color="muted"
                                input value=environmentUrl input=editEnvironmentUrl aria-label="URL" testId="environment-url" appearance="none" font-family="DM Sans" font-size=16 padding="12.25px 14px" background-color="input-fill" border="1px solid input-edge" border-radius=14
                              row gap=7
                                button press=saveEnvironment(environment.id) disabled=pending(savedEnvironment) appearance="none" testId="environment-save" aria-label="Save" flex=1 min-height=42 border-radius=14 background-color="AccentColor" color="white" display="flex" align-items="center" justify-content="center" gap=5.25
                                  image "symbol:sf/checkmark" width=13 height=13
                                  text "SAVE" font-size=13 font-weight=700 letter-spacing="0.8px"
                                button press=reconnectEnvironment(environment.id) disabled=(not environment.enabled or pending(changed)) appearance="none" aria-label="Reconnect environment" testId="environment-reconnect" width=42 height=42 border-radius=14 background-color="input-fill" border="1px solid input-edge" color="muted" display="flex" align-items="center" justify-content="center"
                                  image "symbol:sf/arrow.clockwise" width=14 height=14
                                button press=askRemoveEnvironment(environment.id) appearance="none" aria-label="Remove environment" testId="environment-remove" width=42 height=42 border-radius=14 background-color="danger-fill" border="1px solid danger-edge" color="danger" display="flex" align-items="center" justify-content="center"
                                  image "symbol:sf/trash" width=14 height=14
                              if environmentError != ""
                                text environmentError color="danger" font-size=14 testId="environment-error"
                        if changeError != "" or removeError != ""
                          text (changeError != "" ? changeError : removeError) color="danger" font-size=14 testId="connection-error"
              if e.name == "addEnvironment"
                column navigationKey=`${e.id}` navigationScroll="add-environment" data-workspace-header=(split ? "editor" : "page") data-hides-back=(split ? "true" : "false") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text "Add environment" role="heading" aria-level=2
                    button press=pair buttonStyle="glass" disabled=(address.trim() == "" or pending(paired)) aria-label="Connect" testId="connect"
                      image "symbol:sf/checkmark"
                  scroll id="add-environment" flex=1 min-height=0 padding="4px 16px 36px"
                    column gap=22.75
                      column height=250 border-radius=26 background-image="radial-gradient(ellipse closest-side, #f4f4f5, #d9d9dc)" align-items="center" padding-top=36 box-sizing="border-box" gap=12.25
                        column width=150 height=150 box-sizing="border-box" border-radius=28 border="3px solid #4d4d4d" align-items="center" justify-content="center" gap=7
                          image "symbol:sf/qrcode.viewfinder" width=44 height=44 font-size=44 font-weight=300 color="#666666"
                          text "Tap to scan" font-size=14 font-weight=500 color="#4d4d4d"
                        text "Scan the code from t3 pair or desktop Connections settings" font-size=14 color="#4d4d4d" text-align="center"
                      column gap=7
                        text "Or enter it" font-size=14 line-height="19px" font-weight=500 color="muted" padding="0 14px"
                        column background-color="card" border-radius=26 border="1px solid transparent" overflow="hidden"
                          row height=45.5 gap=10.5 padding="0 14px" align-items="center"
                            text "Address" width=70 color="muted" line-height="23px"
                            input value=address input=editAddress placeholder="192.168.1.100:3773" aria-label="Address" testId="address" appearance="none" flex=1 min-width=0 border="none" padding=0 background-color="transparent" font-family="DM Sans" font-size=16 line-height="23px" transform="translate(-0.333px, 1px)"
                              ::placeholder
                                color="muted"
                          view height=1 margin-left=14 background-color="edge"
                          row height=45.5 gap=10.5 padding="0 14px" align-items="center"
                            text "Code" width=70 color="muted" line-height="23px"
                            input value=code input=editCode submit=pair placeholder="Pairing code" aria-label="Code" testId="pair-code" appearance="none" flex=1 min-width=0 border="none" padding=0 background-color="transparent" font-family="DM Sans" font-size=16 line-height="23px" transform="translate(-0.333px, 1px)"
                              ::placeholder
                                color="muted"
                        text (pairError != "" ? pairError : "For machines on your local network or tailnet. The machine keeps its own provider credentials.") font-size=14 line-height="21px" color=(pairError != "" ? "-exact-system-red" : "muted") padding="0 14px" testId="pair-message"
              if e.name == "newThread"
                column navigationKey=`${e.id}` navigationScroll="projects" data-workspace-header=(split ? "editor" : "page") data-hides-back=(split ? "true" : "false") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text "New thread" role="heading" aria-level=2
                  list id="projects" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Select a project"
                      for project in catalog.projects key=project.id
                        button press=createProjectThread(project.id) disabled=pending(created) testId=`project-pick-${project.id}`
                          text project.title
                      footer
                        text (match created { case some(reply) => reply.error, case none => "" }) color="danger"
              if e.name == "thread"
                column navigationKey=`${e.id}` navigationScroll=`thread-${e.params.id}` data-workspace-header="editor" data-hides-back=(split ? "true" : "false") data-sidebar=(sidebarHidden ? "hidden" : "shown") position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    if split and sidebarHidden
                      button press=toggleSidebar buttonStyle="glass" aria-label="Show sidebar" testId="thread-sidebar-toggle"
                        image "symbol:sf/sidebar.left"
                    text currentThreadTitle(selectedThread(catalog, e.params.id)) role="heading" aria-level=2
                    text currentThreadSubtitle(catalog, selectedThread(catalog, e.params.id))
                    if split
                      button press=compose buttonStyle="glass" aria-label="New chat" testId="thread-compose"
                        image "symbol:compose"
                    if split
                      button press=inspect("files") aria-label="Show inspector" testId="thread-inspector"
                        image "symbol:sf/sidebar.right"
                    button aria-label="Terminal" popovertarget="terminal-menu" testId="thread-terminal"
                      image "symbol:sf/terminal"
                    button aria-label="Git controls" popovertarget="git-menu" testId="thread-git"
                      image "symbol:sf/point.topleft.down.curvedto.point.bottomright.up"
                    button press=inspect("files") aria-label="Open files" testId="thread-files"
                      image "symbol:sf/folder"
                  list id=`thread-${e.params.id}` appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 padding-top=12 padding-left=16 padding-right=16 padding-bottom=12
                    for item in threadRows(selectedThread(catalog, e.params.id)) key=(match item { case some(row) => row.id, case none => "history" })
                      column width="100%" box-sizing="border-box"
                        match item
                          case none
                            for thread in selectedThread(catalog, e.params.id) key=thread.id
                              column align-items="center" gap=6 padding-bottom=12
                                if thread.history.hasMore
                                  button press=loadEarlier(e.params.id) disabled=(thread.history.loading or (loadingHistoryId == e.params.id and pending(earlierHistory))) appearance="none" color="muted" padding="8px 12px" testId="load-earlier"
                                    text (thread.history.loading or (loadingHistoryId == e.params.id and pending(earlierHistory)) ? "Loading earlier messages…" : "Load earlier messages") font-size=14
                                if thread.history.error != "" or (loadingHistoryId == e.params.id and historyError != "")
                                  text (loadingHistoryId == e.params.id and historyError != "" ? historyError : thread.history.error) color="danger" font-size=14 testId="history-error"
                          case some(row)
                            match row.message
                              case some(message)
                                MarkdownMessage(message=message, threadId=e.params.id, viewKey=threadToolViewKey(selectedThread(catalog, e.params.id)), highlights=codeHighlights, layouts=tableLayouts, wrapped=wrappedCodes, seenBlock=observeBlock, toggleWrap=toggleCodeWrap, followLink=followMarkdownLink, copy=copyMessage, attachments=attachmentPreviews, seenAttachment=observeAttachment, openAttachment=openAttachment, retryAttachment=retryAttachmentPreview, thumbnailFailures=thumbnailFailures, imageFailed=attachmentImageFailed, imageLoaded=attachmentImageLoaded)
                              case none
                                match row.activity
                                  case some(tool)
                                    column padding-bottom=2 testId=`tool-${row.id}`
                                      button press=toggleTool(e.params.id, row.id) contextmenu=copyMessage(toolCopyText(toolPanels, threadToolViewKey(selectedThread(catalog, e.params.id)), row.id, tool.revision, toolAttempt(expandedTools, e.params.id, row.id), tool.title)) appearance="none" display="flex" align-items="center" gap=6 min-height=32 width="100%" box-sizing="border-box" padding="0 2px" text-align="left" color="muted" aria-label=`${tool.title}, ${tool.status}, ${toolAttempt(expandedTools, e.params.id, row.id) >= 0 ? "expanded" : "collapsed"}` aria-expanded=(toolAttempt(expandedTools, e.params.id, row.id) >= 0) testId=`tool-toggle-${row.id}`
                                        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0
                                          image `symbol:sf/${tool.symbol}` width=14 height=14
                                        text tool.title flex=1 min-width=0 font-size=14 line-height="19px" line-clamp=1 text-overflow="ellipsis" testId=`tool-title-${row.id}`
                                        if tool.status != "completed"
                                          image toolStatusSymbol(tool.status) width=12 height=12 color=(tool.status == "error" ? "danger" : "muted")
                                        image (toolAttempt(expandedTools, e.params.id, row.id) >= 0 ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") width=11 height=11
                                      if toolAttempt(expandedTools, e.params.id, row.id) >= 0
                                        column padding-top=2 padding-bottom=4 gap=6 min-width=0
                                          if matchingToolPanels(toolPanels, threadToolViewKey(selectedThread(catalog, e.params.id)), row.id, tool.revision, toolAttempt(expandedTools, e.params.id, row.id)).length == 0
                                            if failed(toolPanels)
                                              text "Could not load this activity." color="danger" font-size=12 testId=`tool-error-${row.id}`
                                              button press=retryTool(e.params.id, row.id) aria-label="Retry activity" testId=`tool-retry-${row.id}`
                                                text "Retry"
                                            else
                                              text "Loading output…" color="muted" font-size=12 testId=`tool-loading-${row.id}`
                                          for panel in matchingToolPanels(toolPanels, threadToolViewKey(selectedThread(catalog, e.params.id)), row.id, tool.revision, toolAttempt(expandedTools, e.params.id, row.id)) key=panel.rowId
                                            if panel.state == "loading"
                                              text "Loading output…" color="muted" font-size=12 testId=`tool-loading-${row.id}`
                                            else if panel.state == "error" or panel.state == "missing"
                                              text panel.error color="danger" font-size=12 overflow-wrap="break-word" testId=`tool-error-${row.id}`
                                              if panel.state == "error"
                                                button press=retryTool(e.params.id, row.id) aria-label="Retry activity" testId=`tool-retry-${row.id}`
                                                  text "Retry"
                                            else
                                              if panel.truncated
                                                text "Earlier or large output not shown" color="muted" font-size=11 testId=`tool-truncated-${row.id}`
                                              if tool.category == "command"
                                                list appearance="none" virtualized=true max-height=210 min-height=0 scroll-start="end" scrollFollowEnd=true
                                                  for detail in [panel] key=detail.rowId
                                                    ToolDetail(panel=detail, tool=tool, rowId=row.id)
                                              else
                                                scroll max-height=210 min-height=0
                                                  ToolDetail(panel=panel, tool=tool, rowId=row.id)
                                  case none
                                    view
                  for thread in selectedThread(catalog, e.params.id) key=thread.id
                    if thread.lastError != ""
                      row align-items="flex-start" gap=8 padding="0 16px 6px 20px"
                        image "symbol:sf/exclamationmark.circle" width=16 height=16 margin-top=1.5 color="danger"
                        column gap=2 flex=1 min-width=0
                          row align-items="center" gap=8
                            text "Provider error" flex=1 color="rose" font-size=14 line-height="19px" font-weight=500
                            text thread.lastErrorTime color="foreground" font-size=14 line-height="19px"
                          text thread.lastError color="foreground" font-size=14 line-height="19px" user-select="text"
                  if draftError != "" or modelDraftError != ""
                    text (draftError != "" ? draftError : modelDraftError) color="danger" font-size=14 line-height="19px" padding="0 16px 6px 20px" testId="draft-error"
                  if markdownLinkError != ""
                    text markdownLinkError color="danger" font-size=14 line-height="19px" padding="0 16px 6px 20px" testId="markdown-link-error"
                  if composerError != ""
                    text composerError color="danger" font-size=14 line-height="19px" padding="0 16px 6px 20px" testId="send-error"
                  if e.params.id == activeThreadId
                    if threadControls.requests.length > 0
                      column max-height="80%" width="100%" box-sizing="border-box" min-width=0 min-height=0 flex-shrink=1 padding="4px 12px" padding-bottom=(hasQuestion ? "calc(6px + env(safe-area-inset-bottom))" : "4px") gap=8 testId="requests-panel"
                        for request in shownRequests key=request.key
                          RequestCard(request=request, threadId=e.params.id, allowed=controlsAllowed, busy=sendingControls.includes(request.key), collapsed=collapsedRequests.includes(request.key), drafts=questionDrafts, respond=respondControl, toggle=toggleRequest, choose=chooseAnswer, edit=editAnswer, followLink=followMarkdownLink, accessKey=threadControls.accessKey, runId=threadControls.stop.runId, stopping=(stopBusy or threadControls.stop.state == "unresponsive"), explanationOpen=explainedApprovals.includes(request.key), explain=explainApproval, stop=stopTurn)
                    if threadControls.requests.length > 0 or threadControls.stop.runId != ""
                      if controlsAccessError != ""
                        row padding="4px 16px" gap=8 align-items="center"
                          text controlsAccessError flex=1 min-width=0 color="danger" font-size=13 line-height="18px" testId="controls-access-error"
                          button press=retryControlAccess disabled=pending(controlAccess) testId="controls-access-retry"
                            text "Retry"
                      else if not controlsAllowed
                        text (threadControls.ready ? "Checking permission…" : "Reconnecting…") padding="4px 16px" color="muted" font-size=13 testId="controls-access-loading"
                    if controlSendError != ""
                      text controlSendError padding="4px 16px" color="danger" font-size=13 line-height="18px" testId="controls-error"
                    if stopSendError != ""
                      text stopSendError padding="4px 16px" color="danger" font-size=13 line-height="18px" testId="stop-error"
                    if stopBusy or threadControls.stop.state == "unresponsive"
                      text (threadControls.stop.state == "unresponsive" ? "The turn is not responding to Stop. Check the provider on your computer." : "Stopping…") padding="4px 16px" color="muted" font-size=13 line-height="18px" testId="stop-state"
                  if not hasQuestion
                    if composerAttachments.length > 0
                      ComposerAttachments(items=composerAttachments, uploads=uploadProgresses, remove=removeAttachment, retry=retryAttachment, preview=previewDraftAttachment)
                    if attachmentError != "" or attachmentStatus != ""
                      text (attachmentError != "" ? attachmentError : attachmentStatus) padding="4px 16px" font-size=13 color=(attachmentError != "" or composerAttachments.filter(item => item.state == "failed").length > 0 ? "danger" : "muted") testId="attachment-status"
                    if draftError != ""
                      button press=retryDraftSave appearance="none" color="danger" min-height=32 testId="retry-draft-save"
                        text "Retry saving draft" font-size=13
                    if pendingDelivery
                      button press=retryPendingSend disabled=pending(sent) buttonStyle="bordered" min-height=44 testId="retry-message-delivery"
                        text (pending(sent) ? "Sending…" : "Retry message delivery")
                    row align-items="flex-end" gap=8 padding="6px 12px 7px" margin-bottom=composerBottomAdjustment margin-right=(split ? "env(safe-area-inset-right)" : 0) flex-shrink=0 z-index=2 flex-wrap="wrap" min-width=0 box-sizing="border-box"
                      row flex=1 min-width=0 width="100%" box-sizing="border-box" align-items="center" gap=0 padding="2px 0" min-height=48 border-radius=27 position="relative" z-index=0 box-shadow="0 6px 28px #00000026"
                        workspace-composer-glass message=composerMetrics position="absolute" inset=0 z-index=-1 pointer-events="none"
                        button popovertarget="attachment-menu" disabled=(not draftsReady or pending(stagedAttachments)) appearance="none" display="flex" align-items="center" justify-content="center" aria-label="Add attachment" width=44 height=44 testId="add-attachment"
                          image "symbol:sf/plus" width=20 height=20
                        textarea id="composer" disabled=not draftsReady value=composer input=editComposer rows=1 field-sizing="content" max-height=104 height=36 min-height=36 box-sizing="border-box" flex=1 min-width=0 padding="6px 0" font-family="DM Sans" font-size=16 line-height="23px" appearance="none" border-width=0 outline="none" background-color="transparent" placeholder="Ask anything" aria-label="Message" testId="composer"
                          ::placeholder
                            color="muted"
                        button press=openModelSettings disabled=not modelDraftsReady appearance="none" aria-label="Model and reasoning settings" testId="model-settings" height=44 padding="0 7px"
                          row align-items="center" gap=7
                            ProviderIcon(provider=(match first(selectedThread(catalog, e.params.id)) { case some(thread) => thread.provider, case none => "" }), size=16)
                            image "symbol:sf/chevron.down" font-size=10
                        if threadControls.stop.runId != "" and composer.trim() == "" and composerAttachments.length == 0
                          button press=stopTurn(e.params.id, threadControls.accessKey, threadControls.stop.runId) disabled=(not controlsAllowed or stopBusy or threadControls.stop.state == "unresponsive") appearance="none" display="flex" align-items="center" justify-content="center" retainFocus=true aria-label=(stopBusy ? "Stopping turn" : "Stop turn") testId="stop" width=44 height=44
                            row width=30 height=30 border-radius=15 background-color=(controlsAllowed and not stopBusy and threadControls.stop.state != "unresponsive" ? "control-danger-fill" : "send-disabled") color=(controlsAllowed and not stopBusy and threadControls.stop.state != "unresponsive" ? "danger" : "send-disabled-ink") align-items="center" justify-content="center"
                              image "symbol:sf/stop.fill" font-size=12
                        else
                          button press=sendMessage disabled=not canSend appearance="none" display="flex" align-items="center" justify-content="center" retainFocus=true aria-label=(threadControls.stop.runId != "" ? "Queue message" : "Send") testId="send" width=44 height=44
                            row width=30 height=30 border-radius=15 background-color=(canSend ? "AccentColor" : "send-disabled") color=(canSend ? "white" : "send-disabled-ink") align-items="center" justify-content="center"
                              image "symbol:sf/arrow.up" font-size=16 font-weight=600
              if e.name == "threadSettings"
                column navigationKey=`${e.id}` data-workspace-header="settings-sheet" navigationPresentation="modal" navigationDetent="large" navigationGrabber="visible" navigationScroll="models-list" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    button id="back" press=cancelModelSettings aria-label="Cancel thread settings" testId="cancel-settings"
                      image "symbol:close"
                    text "Thread settings" role="heading" aria-level=2
                    input type="search" value=modelQuery input=searchModels placeholder="Find a model" aria-label="Find a model" testId="model-search"
                    button popovertarget="model-filters" aria-label="Model filters" testId="model-filters-button"
                      image "symbol:filter"
                    button press=saveModelSettings buttonStyle="bordered-prominent" accent-color="foreground" aria-label=settings.saveLabel disabled=(settings.error != "" or pending(settingsUpdated) or pending(settingsClosed)) testId="save-settings"
                      image "symbol:checkmark"
                  scroll id="models-list" flex=1 min-height=0 padding-top=4 padding-bottom="calc(env(safe-area-inset-bottom) + 64px)" background-color="screen"
                    for group in shownModelGroups key=group.id
                      column
                        button press=toggleModelGroup(group.id) disabled=(modelProviderFilter != "" or modelQuery.trim() != "") appearance="none" aria-label=`${group.label}, ${matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites").length} models` display="flex" align-items="center" gap=7 margin="3.5px 14px 0" padding="7px 3.5px 0" min-height=38.5 box-sizing="border-box" text-align="left" color="muted"
                          ProviderIcon(provider=group.provider, size=15)
                          text group.label font-size=14 line-height="19px" font-weight=500
                          view flex=1
                          if modelProviderFilter == "" and modelQuery.trim() == ""
                            if modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, false)
                              text `${matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, false).length}` font-size=12 font-weight=500
                            image (modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, false) ? "symbol:sf/chevron.down" : "symbol:sf/chevron.up") width=12 height=12
                        if not modelGroupCollapsed(group, modelExpansionOverrides, settings.appliedModelId, modelProviderFilter != "" or modelQuery.trim() != "")
                          column margin="0 14px" border-radius=14 overflow="hidden" background-color="card"
                            for model, index in matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites") key=model.id
                              if index > 0
                                view height=1 background-color="edge" opacity=0.5
                              row align-items="center" gap=7 padding="0 14px" min-height=38.5
                                button role="radio" aria-checked=(settings.selectedModelId == model.id) press=selectSettingsModel(model.id) disabled=(not model.available or pending(settingsUpdated)) testId=`model-${model.id}` appearance="none" display="flex" align-items="center" gap=7 text-align="left" flex=1 min-width=0 min-height=38.5 color="foreground"
                                  column flex=1 min-width=0
                                    row align-items="center" gap=7
                                      text model.label font-size=16 line-height="23px" font-weight=500 min-width=0 flex-shrink=1 line-clamp=1
                                      if model.isDefault or model.isLegacy
                                        text (model.isDefault ? "Default" : "Legacy") font-size=10 font-weight=700 color="muted" background-color="screen" padding="1.75px 5.25px" border-radius=5.25
                                    if model.unavailableReason != ""
                                      text model.unavailableReason font-size=13 line-height="17px" color="muted"
                                  if settings.selectedModelId == model.id
                                    image "symbol:checkmark" width=16 height=16 font-weight=600
                                button press=toggleModelFavorite(model.id, not model.isFavorite) disabled=pending(favoriteChanged) appearance="none" display="flex" align-items="center" justify-content="center" min-width=38.5 min-height=38.5 color=(model.isFavorite ? "foreground" : "muted") aria-label=`${model.isFavorite ? "Remove from" : "Add to"} favorites: ${group.label}, ${model.label}` testId=`favorite-${model.id}`
                                  image (model.isFavorite ? "symbol:sf/star.fill" : "symbol:sf/star") width=18 height=18
                    if shownModelGroups.length == 0
                      text (modelProviderFilter == "@favorites" ? "No favorite models" : "No matching models") padding="49px 28px" font-size=14 color="muted" text-align="center" testId="empty-models"
                    text "Options" padding="7px 17.5px" font-size=14 line-height="19px" font-weight=500 color="muted"
                    column margin="0 14px" border-radius=14 overflow="hidden" background-color="card"
                      for option in settings.options key=option.id
                        if option.kind == "boolean"
                          row align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box"
                            text option.label font-size=14 line-height="19px" font-weight=500 flex=1
                            input type="checkbox" switch checked=(option.value == "true") change=toggleSettingsOption(option.id) aria-label=option.label testId=`option-${option.id}`
                        else
                          button press=openSettingChoice("option", option.id) testId=`option-${option.id}` appearance="none" display="flex" align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box" color="foreground"
                            text option.label font-size=14 line-height="19px" font-weight=500
                            view flex=1
                            text option.valueLabel font-size=14 line-height="19px" color="muted"
                            image "symbol:forward-chevron" width=12 height=12 color="muted"
                        view height=1 background-color="edge" opacity=0.5
                      button press=openSettingChoice("runtime", "runtime") testId="runtime-options" appearance="none" display="flex" align-items="center" gap=7 padding="7px 14px" min-height=38.5 box-sizing="border-box" color="foreground"
                        text "Runtime" font-size=14 line-height="19px" font-weight=500
                        view flex=1
                        text settings.runtimeLabel font-size=14 line-height="19px" color="muted"
                        image "symbol:forward-chevron" width=12 height=12 color="muted"
                    text (favoriteError != "" ? favoriteError : settingsCloseError != "" ? settingsCloseError : settingsUpdateError != "" ? settingsUpdateError : settings.error) margin="7px 17.5px" font-size=13 color="danger" testId="settings-error"
                  column id="model-filters" popover="auto" role="menu"
                    button role="menuitemradio" aria-checked=(modelProviderFilter == "") press=filterModelProvider("")
                      text "All providers"
                    button role="menuitemradio" aria-checked=(modelProviderFilter == "@favorites") press=filterModelProvider("@favorites")
                      text "Favorites"
                    for group in settings.groups key=group.id
                      button role="menuitemradio" aria-checked=(modelProviderFilter == group.id) press=filterModelProvider(group.id)
                        text group.label
                    button role="menuitemcheckbox" aria-checked=showLegacyModels press=toggleLegacyModels
                      text "Show legacy models"
              if e.name == "settingChoice"
                column navigationKey=`${e.id}` data-workspace-header="settings-sheet" navigationScroll="choices-list" background-color="screen" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text (e.params.kind == "runtime" ? "Runtime" : optionTitle(settings.options, e.params.option)) role="heading" aria-level=2
                  scroll id="choices-list" flex=1 min-height=0 padding="16px 16px calc(env(safe-area-inset-bottom) + 12px)" background-color="screen"
                    column border-radius=14 overflow="hidden" background-color="card"
                      for choice, index in (e.params.kind == "runtime" ? settings.runtimeChoices : optionChoices(settings.options, e.params.option)) key=choice.id
                        if index > 0
                          view height=1 background-color="edge" opacity=0.5
                        button role="radio" aria-checked=((e.params.kind == "runtime" ? settings.runtimeMode : optionValue(settings.options, e.params.option)) == choice.id) press=chooseSetting(e.params.kind, e.params.option, choice.id) disabled=(not choice.available or pending(settingsUpdated)) testId=`choice-${choice.id}` appearance="none" display="flex" align-items="center" gap=10.5 padding="10.5px 14px" min-height=49 box-sizing="border-box" color="foreground" text-align="left"
                          column flex=1 min-width=0 gap=1.75 opacity=(choice.available ? 1 : 0.5)
                            text choice.label font-size=16 line-height="23px" font-weight=500
                            if choice.description != "" or choice.unavailableReason != ""
                              text (choice.available ? choice.description : choice.unavailableReason) font-size=14 line-height="17.5px" color="muted"
                          if (e.params.kind == "runtime" ? settings.runtimeMode : optionValue(settings.options, e.params.option)) == choice.id
                            image "symbol:checkmark" width=16 height=16 font-weight=600
                    text settingsUpdateError font-size=13 color="danger" margin-top=7
              if e.name == "linkedFile"
                column navigationKey=`${e.id}` navigationScroll="linked-file-lines" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text e.params.file role="heading" aria-level=2
                  if pending(linkedFile)
                    text "Loading…" color="muted" padding=16
                  else if failed(linkedFile) or linkedFile.error != ""
                    text (failed(linkedFile) ? "This file could not be opened." : linkedFile.error) color="danger" padding=16 testId="linked-file-error"
                  else
                    list id="linked-file-lines" appearance="none" virtualized=true flex=1 min-height=0 estimated-item-height=23 padding="12px 0"
                      for line in linkedFile.lines key=line.id
                        row align-items="flex-start" gap=12 padding="0 12px" background-color=(line.id == linkedFile.targetLine ? "thread-selected" : "transparent") testId=`file-line-${line.id}`
                          text line.id color="muted" font-family="Menlo" font-size=12 width=42 text-align="right" line-height="23px"
                          text user-select="text" white-space="pre-wrap" overflow-wrap="break-word" flex=1 min-width=0 color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.prefix white-space="pre-wrap" color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.focus white-space="pre-wrap" color="foreground" background-color="send-disabled" font-family="Menlo" font-size=14.4 line-height="23px"
                            text line.suffix white-space="pre-wrap" color="foreground" font-family="Menlo" font-size=14.4 line-height="23px"
              if e.name == "inspector"
                column navigationKey=`${e.id}` navigationScroll="inspector" position="absolute" inset=0 display="flex" flex-direction="column" background-color="screen"
                  header
                    text (e.params.kind == "git" ? "Source control" : "Files") role="heading" aria-level=2
                  scroll id="inspector" flex=1 min-height=0 padding=16
                    if pending(inspected)
                      text "Loading…" color="muted"
                    else
                      match inspected
                        case some(result)
                          if result.error != ""
                            text result.error color="-exact-system-red"
                          else
                            column gap=10
                              text result.title font-size=21 font-weight=700
                              text result.body user-select="text" white-space="pre-wrap" font-size=14 line-height="21px" color="muted"
                              for item in result.items key=item.id
                                button press=inspectEntry(item.id, item.kind) disabled=(item.kind == "info") appearance="none" padding="12px 0" width="100%" text-align="left"
                                  row align-items="center" gap=10
                                    image (item.kind == "directory" ? "symbol:sf/folder" : "symbol:sf/document") width=20 height=20
                                    column flex=1 min-width=0 gap=3
                                      text item.label font-size=16
                                      if item.detail != ""
                                        text item.detail font-size=13 color="muted"
                        case none
                          view
              if e.name == "pullRequests"
                column navigationKey=`${e.id}` navigationScroll="pulls" data-workspace-header="brand" data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Pull Requests" role="heading" aria-level=2
                  list id="pulls" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "No pull requests yet" font="-exact-body"
                      footer
                        text "Pull requests linked to your threads will appear here." font="-exact-footnote" color="-exact-secondary-label"
              if e.name == "usage"
                column navigationKey=`${e.id}` navigationScroll="usage" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Usage" role="heading" aria-level=2
                  list id="usage" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        column gap=3
                          text "This month" font="-exact-body"
                          text "0 agent minutes" font="-exact-footnote" color="-exact-secondary-label"
              if e.name == "settings"
                column navigationKey=`${e.id}` navigationScroll="settings" data-workspace-header=(split ? "brand" : "page") data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column"
                  header
                    text "Settings" role="heading" aria-level=2
                  list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "T3 Code" font="-exact-body"
                        text "Exact iOS" font="-exact-footnote" color="-exact-secondary-label"
                      button press=openEnvironments testId="environments-button" aria-label="Environments"
                        text "Environments"
                        image "symbol:forward-chevron"
      if device.kind == "web" or device.kind == ""
        column id="environment-filter-menu" popover="auto" role="menu" aria-label="Filter threads by environment"
          button press=filterEnvironment("") role="menuitemradio" aria-checked=(selectedEnvironment == "") popovertarget="environment-filter-menu" popovertargetaction="hide" testId="filter-all"
            text "All environments"
          for environment in catalog.environments key=environment.id
            button press=filterEnvironment(environment.id) role="menuitemradio" aria-checked=(selectedEnvironment == environment.id) popovertarget="environment-filter-menu" popovertargetaction="hide" testId=`filter-${environment.id}`
              text environment.label
        column id="project-filter-menu" popover="auto" role="menu" aria-label="Filter threads by project"
          button press=filterProject("") role="menuitemradio" aria-checked=(selectedProject == "") popovertarget="project-filter-menu" popovertargetaction="hide" testId="project-all"
            text "All projects"
          for project in catalog.projects key=project.id
            button press=filterProject(project.id) role="menuitemradio" aria-checked=(selectedProject == project.id) popovertarget="project-filter-menu" popovertargetaction="hide" testId=`project-${project.id}`
              text project.title
      dialog id="remove-environment" role="alertdialog" aria-label=`Remove ${environmentLabel(catalog, removedEnvironment)}?`
        text "This environment will be removed from this device. Your projects and threads will stay on the server."
        button commandfor="remove-environment" command="close" testId="environment-remove-cancel"
          text "Cancel"
        button press=removeEnvironment destructive=true commandfor="remove-environment" command="close" testId="environment-remove-confirm"
          text "Remove"
      column id="terminal-menu" popover="auto" role="menu" aria-label="Terminal"
        button role="menuitem" disabled=true
          text "No project scripts"
      column id="git-menu" popover="auto" role="menu" aria-label="Git controls"
        button role="menuitem" press=inspect("git") popovertarget="git-menu" popovertargetaction="hide"
          image "symbol:sf/text.bubble"
          text "Review changes"
      workspace-tab-bar selected-tab=visibleTab shows-compose=(visibleTab == "threads" ? "true" : "false") compact="true" message=workspaceAction height=128 position="absolute" bottom="calc(0px - env(safe-area-inset-bottom))" left=8 right=(visibleTab == "threads" ? 12 : 76) display=(atRoot and not device.rail ? "flex" : "none")
      row role="tablist" aria-label="Workspace" testId="tabs" display=(device.rail ? "flex" : "none")
        button role="tab" aria-controls="panel-threads" aria-selected=(nav.tab == "threads") press=selectTab("threads") testId="tab-threads" flex=1
          image "symbol:sf/text.bubble"
          text "Chats"
        button role="tab" aria-controls="panel-threadDetail" aria-selected=(nav.tab == "threadDetail") press=selectTab("threadDetail") testId="tab-threadDetail" display="none"
          image "symbol:sf/text.bubble"
          text "Thread"
        button role="tab" aria-controls="panel-pullRequests" aria-selected=(nav.tab == "pullRequests") press=selectTab("pullRequests") testId="tab-pullRequests" flex=1
          image "symbol:sf/arrow.triangle.branch"
          text "PRs"
        button role="tab" aria-controls="panel-usage" aria-selected=(nav.tab == "usage") press=selectTab("usage") testId="tab-usage" flex=1
          image "symbol:sf/chart.bar.xaxis"
          text "Usage"
        button role="tab" aria-controls="panel-settings" aria-selected=(nav.tab == "settings") press=selectTab("settings") testId="tab-settings" flex=1
          image "symbol:settings"
          text "Settings"
        button role="tab" aria-controls="panel-settingsDetail" aria-selected=(nav.tab == "settingsDetail") press=selectTab("settingsDetail") testId="tab-settingsDetail" display="none"
          image "symbol:settings"
          text "Setting"

component ToolDetail
  props
    panel: ToolPanel
    tool: ToolSummary
    rowId: string
  view
    column gap=5.25 padding-right=8
      if panel.input != ""
        text panel.input font-family="Menlo" font-size=12 line-height="18px" color="foreground" white-space="pre-wrap" overflow-wrap="break-word" user-select="text" testId=`tool-input-${rowId}`
      if panel.output != ""
        text panel.output font-family="Menlo" font-size=12 line-height="18px" color="muted" white-space="pre-wrap" overflow-wrap="break-word" user-select="text" testId=`tool-output-${rowId}`
      else
        text (tool.status == "running" or tool.status == "pending" ? "No output yet." : "No output.") font-family="Menlo" font-size=12 line-height="18px" color="muted" testId=`tool-empty-${rowId}`
      if tool.exitLabel != ""
        text tool.exitLabel font-family="Menlo" font-size=12 line-height="18px" color="danger" testId=`tool-exit-${rowId}`

component ThreadList
  props
    catalog: Catalog
    visibleThreads: Thread[]
    selectedEnvironment: string
    selectedProject: string
    selectedProjectLabel: string
    nativeMenus: bool
    showSettled: bool
    sidebar: bool
    selectedId: string
    toggleSettled: action
    openThread: action
    filterEnvironment: action
    filterProject: action
    resetFilters: action
  derive displayedThreads = visibleThreads.filter(thread => not thread.settled or showSettled)
  derive availableProjects = catalog.projects.filter(project => selectedEnvironment == "" or project.environmentId == selectedEnvironment)
  view
    list id="home" appearance="none" flex=1 min-height=0 background-color=(sidebar ? "transparent" : "screen")
      section
        scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0
          row gap=8 padding="2px 20px 10px" flex-wrap="nowrap" align-items="center"
            if nativeMenus
              workspace-filter-menu chip-label=(selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) options-query=("=All%20environments&" + catalog.environments.map(environment => `${encodeURIComponent(environment.id)}=${encodeURIComponent(environment.label)}`).join("&")) selected-id=selectedEnvironment active=(selectedEnvironment != "" ? "true" : "false") accessibility-label="Filter threads by environment" test-id="all-environments" testId="all-environments" message=filterEnvironment flex-shrink=0
              workspace-filter-menu chip-label=selectedProjectLabel options-query=("=All%20projects&" + availableProjects.map(project => `${encodeURIComponent(project.id)}=${encodeURIComponent(project.title)}`).join("&")) selected-id=selectedProject active=(selectedProject != "" ? "true" : "false") accessibility-label="Filter threads by project" test-id="all-projects" testId="all-projects" message=filterProject flex-shrink=0
            else
              button popovertarget="environment-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedEnvironment == "" ? "muted" : "white") background-color=(selectedEnvironment == "" ? "transparent" : "AccentColor") testId="all-environments"
                text (selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)) max-width=180 line-clamp=1
                image "symbol:sf/chevron.down" width=11 height=11
              button popovertarget="project-filter-menu" appearance="none" display="flex" align-items="center" backgroundMaterial="glass" border-radius=16 padding="5.25px 10.5px" min-height=28 box-sizing="border-box" white-space="nowrap" gap=5.25 font-size=14 line-height="19px" font-weight=500 color=(selectedProject == "" ? "muted" : "white") background-color=(selectedProject == "" ? "transparent" : "AccentColor") testId="all-projects"
                text selectedProjectLabel max-width=180 line-clamp=1
                image "symbol:sf/chevron.down" width=11 height=11
            if selectedEnvironment != "" or selectedProject != ""
              button press=resetFilters appearance="none" aria-label="Reset thread filters" testId="reset-filters" width=28 height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:sf/xmark.circle.fill" width=18 height=18 color="muted"
      section
        if visibleThreads.length == 0
          column align-items="center" padding="28px 21px" gap=7
            text "No threads yet" font-size=21 line-height="28px" font-weight=700 text-align="center" testId="empty-title"
            text "Start a new thread to begin coding." font-size=16 line-height="24px" color="muted" text-align="center"
        for thread, index in displayedThreads key=thread.id
          button press=openThread(path("thread", thread.id)) appearance="none" testId=`thread-${thread.id}` width=(sidebar ? "calc(100% - 16px)" : "100%") box-sizing="border-box" text-align="left" margin=(sidebar ? "0 8px" : "0") border-radius=(sidebar ? 12 : 0) background-color=(sidebar and selectedId == thread.id ? "thread-selected" : "transparent")
            column flex=1 min-width=0 gap=3.5 padding=(sidebar ? "10px 12px" : "8.75px 17.5px")
              row align-items="flex-start" gap=7 color=(sidebar ? "sidebar-foreground" : "foreground")
                if thread.projectIcon != ""
                  image thread.projectIcon width=20 height=20 margin-top=1.5 border-radius=4
                else
                  text thread.projectInitials width=20 height=20 margin-top=1.5 line-height="20px" border-radius=4 font-size=10 font-weight=700 color=thread.projectIconColor background-color=`${thread.projectIconColor}22` text-align="center"
                text thread.title font-size=16 line-height="23px" font-weight=500 flex=1 min-width=0 line-clamp=2
                if thread.status != ""
                  row align-items="center" gap=3.5 min-height=23 color=(sidebar and selectedId == thread.id ? "foreground" : threadStatusColor(thread.status))
                    image threadStatusSymbol(thread.status) width=13 height=13 font-weight=600
                    text thread.status font-size=13 line-height="17px" font-weight=700
                else
                  text thread.updatedAt font-size=13 line-height="23px" color=(sidebar ? "sidebar-muted" : "muted") font-variant-numeric="tabular-nums"
              row align-items="center" gap=7 min-height=14 padding-left=27
                if thread.lastError != ""
                  text thread.lastError font-size=13 line-height="17px" color=(sidebar and selectedId == thread.id ? "muted" : "danger") flex=1 min-width=0 line-clamp=1
                else if catalog.environments.length > 1
                  image "symbol:sf/laptopcomputer" font-size=12 color="muted"
                  text environmentLabel(catalog, thread.environmentId) font-size=13 line-height="17px" color="muted" flex=1 min-width=0 line-clamp=1
                else
                  view flex=1
                row opacity=0.6
                  ProviderIcon(provider=thread.provider, size=14)
          if index < displayedThreads.length - 1
            view height=1 background-color="edge" opacity=0.7 margin-left=16 display=(sidebar ? "none" : "flex")
      if visibleThreads.filter(thread => thread.settled).length > 0
        section
          button press=toggleSettled appearance="none" padding="14px 17.5px" width="100%" box-sizing="border-box" aria-label="Settled threads"
            row align-items="center" gap=10 width="100%"
              text `Settled (${visibleThreads.filter(thread => thread.settled).length})` font-size=13 color="muted"
              view flex=1 height=1 background-color="edge"
              image (showSettled ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") font-size=11 color="muted"

component EnvironmentList
  props
    scrollId: string
    catalog: Catalog
    toggleEnvironment: action
    manageEnvironment: action
  view
    scroll id=scrollId flex=1 min-height=0 padding="14px 17.5px 36px"
      column border-radius=24 background-color="card" overflow="hidden"
        if catalog.environments.length == 0
          column align-items="center" gap=10.5 padding="28px 21px"
            row width=42 height=42 border-radius=16 background-color="bubble" align-items="center" justify-content="center"
              image "symbol:sf/point.3.connected.trianglepath.dotted" width=20 height=20 color="muted"
            text "No environments connected yet.\nTap + to add one." font-size=14 line-height="21px" color="muted" text-align="center"
        for environment in catalog.environments key=environment.id
          EnvironmentRow(environment=environment, toggleEnvironment=toggleEnvironment, manageEnvironment=manageEnvironment, detail=false, expanded=false)

component EnvironmentRow
  props
    environment: Environment
    toggleEnvironment: action
    manageEnvironment: action
    detail: bool
    expanded: bool
  derive label = detail ? `${expanded ? "Collapse" : "Expand"} details for ${environment.label}` : `Manage ${environment.label}`
  view
    row gap=10.5 padding="12.25px 14px" align-items="center"
      button press=manageEnvironment(environment.id) appearance="none" aria-label=label testId=`manage-${environment.id}` text-align="left" flex=1 min-width=0 display="flex" flex-direction="column" align-items="stretch" gap=1.75 color="foreground"
        row align-items="center" gap=5.25
          row width=16 height=16 align-items="center" justify-content="center"
            view width=8 height=8 border-radius=4 background-color=(environment.status == "Connected" ? "online" : "muted")
          image `symbol:sf/${environment.machineSymbol}` width=14 height=14 color="muted"
          text environment.label font-weight=700 font-size=16 line-height="20px" flex=1 min-width=0 line-clamp=1
        text (environment.url.endsWith("/") ? environment.url : environment.url + "/") font-size=13 line-height="17px" color="muted" line-clamp=1
        text environment.status font-size=13 line-height="17px" color="muted"
      input type="checkbox" switch accent-color="AccentColor" checked=environment.enabled change=toggleEnvironment(environment.id) aria-label=`Enable ${environment.label}` testId=`environment-${environment.id}`
      button press=manageEnvironment(environment.id) aria-label=label appearance="none" width=44 height=44 color="muted"
        image (detail ? (expanded ? "symbol:sf/chevron.up" : "symbol:sf/chevron.down") : "symbol:forward-chevron") width=12 height=12

component ProviderIcon
  props
    provider: string
    size: number
  derive monochrome = provider == "codex" or provider == "cursor" or provider == "grok" or provider == "fx" or provider == "pi" or provider == "openrouter" or provider == "acpRegistry" or provider == ""
  derive source = provider == "claudeAgent" ? "assets/provider-claude.svg" : provider == "antigravity" ? "assets/provider-antigravity.png" : provider == "acpRegistry" ? "assets/provider-acp-registry.svg" : ["codex", "cursor", "grok", "fx", "kiro", "muse", "pi", "openrouter"].includes(provider) ? `assets/provider-${provider}.svg` : "assets/provider-codex.svg"
  derive ink = provider == "cursor" ? "provider-cursor-ink" : provider == "grok" or provider == "fx" or provider == "pi" ? "provider-neutral-ink" : provider == "openrouter" ? "provider-openrouter-ink" : "provider-ink"
  view
    if provider == "opencode"
      svg width=size height=size viewBox="0 0 32 40" fill="none"
        path d="M24 32H8V16H24V32Z" fill="provider-opencode-inner"
        path d="M24 8H8V32H24V8ZM32 40H0V0H32V40Z" fill="provider-opencode-outer"
    else if monochrome or source == "assets/provider-codex.svg"
      image source width=size height=size -exact-tint-color=ink
    else
      image source width=size height=size
