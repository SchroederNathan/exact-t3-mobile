use EmptyState from "exact:content"

routes nav
  home "/"
  environments "/environments"
  thread "/threads/:id"

shape Environment
  id: string
  label: string
  url: string
  status: string
  enabled: bool

shape Message
  id: string
  role: string
  body: string
  createdAt: string

shape Thread
  id: string
  environmentId: string
  project: string
  title: string
  status: string
  updatedAt: string
  messages: Message[]

shape Catalog
  environments: Environment[]
  threads: Thread[]

shape Reply
  ok: bool
  error: string

fn selectedThread(catalog: Catalog, id: string): Thread[] = catalog.threads.filter(thread => thread.id == id)
fn environmentLabel(catalog: Catalog, id: string): string = match first(catalog.environments.filter(environment => environment.id == id)) { case some(environment) => environment.label, case none => "Unknown environment" }
fn filteredThreads(threads: Thread[], environmentId: string, query: string): Thread[] = threads.filter(thread => (environmentId == "" or thread.environmentId == environmentId) and (query.trim() == "" or thread.title.toLowerCase().includes(query.trim().toLowerCase()) or thread.project.toLowerCase().includes(query.trim().toLowerCase())))

component T3Code
  state query = ""
  state selectedEnvironment = ""
  state composer = ""
  resource catalog = loadCatalog() as shape Catalog else empty()
  mutation changed as shape Reply refreshes catalog
  derive currentThreadId = match stack(nav).filter(e => e.name == "thread").at(-1) { case some(e) => e.params.id, case none => "" }
  derive currentThread = selectedThread(catalog, currentThreadId)
  derive visibleThreads = filteredThreads(catalog.threads, selectedEnvironment, query)
  derive selectedEnvironmentLabel = selectedEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedEnvironment)
  derive canSend = composer.trim() != "" and not pending(changed)

  action search(value: string)
    query = value

  action filterEnvironment(id: string)
    selectedEnvironment = id

  action openEnvironments
    nav = push(nav, "/environments")

  action openThread(url: string)
    nav = go(nav, url)

  action back
    nav = back(nav)

  action toggleEnvironment(id: string, enabled: bool)
    send changed = command("toggle", id, enabled ? "true" : "false")

  action editComposer(value: string)
    composer = value

  action sendMessage
    if canSend and currentThreadId != ""
      send changed = command("send", currentThreadId, composer.trim())
      composer = ""

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=openThread width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="home" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              text "T3 Code" role="heading" aria-level=1 flex=1
              button press=openEnvironments buttonStyle="glass" aria-label="Environments" testId="environments-button"
                image "symbol:sf/point.3.connected.trianglepath.dotted"
            input type="search" value=query input=search placeholder="Search threads" aria-label="Search threads" testId="search" margin="0 16px 8px"
            row gap=8 padding="0 16px 10px"
              button press=filterEnvironment("") buttonStyle=(selectedEnvironment == "" ? "filled" : "glass") testId="all-environments"
                text "All environments"
              for environment in catalog.environments key=environment.id
                button press=filterEnvironment(environment.id) buttonStyle=(selectedEnvironment == environment.id ? "filled" : "glass") testId=`filter-${environment.id}`
                  text environment.label
            if failed(catalog)
              EmptyState(symbol="symbol:alert", title="Can’t load threads", message="Check the connection and try again.")
            else if visibleThreads.length == 0 and not pending(catalog)
              EmptyState(symbol="symbol:messages", title="No threads yet", message="Create a task to start a new coding session.")
            else
              list id="home" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  for thread in visibleThreads key=thread.id
                    link href=path("thread", thread.id) testId=`thread-${thread.id}`
                      column flex=1 min-width=0 gap=3
                        row align-items="center" gap=6
                          text thread.title font="-exact-body" flex=1 min-width=0
                          text thread.status font="-exact-footnote" color="-exact-secondary-label"
                        row align-items="center" gap=6
                          text thread.project font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0
                          text thread.updatedAt font="-exact-footnote" color="-exact-tertiary-label"
                      image "symbol:forward-chevron"
        if e.name == "environments"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="environments" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              button press=back buttonStyle="glass" aria-label="Close environments" testId="environments-close"
                image "symbol:close"
              text "Environments" role="heading" aria-level=1 flex=1
            list id="environments" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 padding="16px 20px"
              section
                header
                  text "Connected"
                for environment in catalog.environments key=environment.id
                  row gap=12 padding="12px 4px"
                    column flex=1 min-width=0 gap=3
                      row align-items="center" gap=7
                        text environment.label font="-exact-body" flex=1 min-width=0
                        text environment.status font="-exact-footnote" color="-exact-secondary-label"
                      text environment.url font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
                    input type="checkbox" switch checked=environment.enabled change=toggleEnvironment(environment.id) aria-label=`Enable ${environment.label}` testId=`environment-${environment.id}`
              section
                footer
                  text "Environments connect T3 Code to your machines and remote workspaces." font="-exact-footnote" color="-exact-secondary-label"
        if e.name == "thread"
          column navigationKey=`${e.id}` navigationScroll="thread" position="absolute" inset=0 display="flex" flex-direction="column"
            for thread in currentThread key=thread.id
              header display="flex" align-items="center" padding="8px 16px"
                column flex=1 min-width=0 gap=2
                  text thread.title role="heading" aria-level=1
                  text `${thread.project} · ${environmentLabel(catalog, thread.environmentId)}` font="-exact-footnote" color="-exact-secondary-label"
                button buttonStyle="glass" aria-label="Thread actions" testId="thread-actions"
                  image "symbol:ellipsis"
              list id="thread" appearance="none" flex=1 min-height=0 padding="16px"
                for message in thread.messages key=message.id
                  row justify-content=(message.role == "user" ? "flex-end" : "flex-start") padding="5px 0" width="100%"
                    if message.role == "user"
                      text message.body user-select="text" overflow-wrap="break-word" max-width="84%" padding="11px 15px" border-radius=22 background-color="AccentColor" color="AccentColorText" testId=`message-${message.id}`
                    else
                      text message.body user-select="text" overflow-wrap="break-word" max-width="94%" padding="8px 0" testId=`message-${message.id}`
              row align-items="flex-end" gap=8 padding="8px 14px calc(env(safe-area-inset-bottom) + 10px)"
                row flex=1 align-items="flex-end" gap=8 padding="5px 6px 5px 16px" border-radius=24 backgroundMaterial="glass" border-width=1 border-style="solid" border-color="-exact-separator"
                  textarea id="composer" value=composer input=editComposer rows=1 max-height=140 flex=1 min-width=0 padding="7px 0" appearance="none" border-width=0 outline="none" background-color="transparent" placeholder="Message" aria-label="Message" testId="composer"
                  button press=sendMessage disabled=not canSend buttonStyle="prominent-glass" retainFocus=true aria-label="Send" testId="send"
                    image "symbol:send"
