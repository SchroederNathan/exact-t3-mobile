                        else
                          button popovertarget="pull-environments-menu" aria-haspopup="menu" aria-label="Choose pull request environment" appearance="none" display="flex" align-items="center" gap=5.25 border-radius=16 padding="5.25px 10.5px" min-height=28 white-space="nowrap" backgroundMaterial="glass" font-size="0.875rem" font-weight=500 color=(selectedPullEnvironment != "" ? "white" : "muted") background-color=(selectedPullEnvironment != "" ? "AccentColor" : "transparent") testId="pull-filter-environment"
                            text (selectedPullEnvironment == "" ? "All environments" : environmentLabel(catalog, selectedPullEnvironment)) max-width=180 line-clamp=1
                            image "symbol:icon.disclose-down" width=11 height=11
                      PullFilterChip(field="state", selected=pullState, options=["open", "closed", "merged", "all"], label="Filter by state", native=(device.kind != "web" and device.kind != ""), choose=filterPullState)
                      PullFilterChip(field="involvement", selected=pullInvolvement, options=["all", "reviewing", "authored"], label="Filter by involvement", native=(device.kind != "web" and device.kind != ""), choose=filterPullInvolvement)
                      PullFacetChip(field="labels", title=(pullLabels.length > 0 ? `Labels ${pullLabels.length}` : "Labels"), label="Filter by label", active=(pullLabels.length > 0), facet=facets.labels, native=(device.kind != "web" and device.kind != ""), choose=labelMenuAction)
                      PullFacetChip(field="authors", title=(pullAuthor == "me" ? "By you" : pullAuthor != "" ? pullAuthor : "Author"), label="Filter by author", active=(pullAuthor != ""), facet=facets.authors, native=(device.kind != "web" and device.kind != ""), choose=authorMenuAction)
                  if pullPrefsError != ""
