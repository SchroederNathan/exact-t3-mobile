                                text pull.row.stackText font-size=12 line-height="16px" color="muted" font-variant-numeric="tabular-nums"
                              text compactAge(pull.row.updatedMs, time.epochAtZero + threadListClock) font-size=12 line-height="16px" color="muted" font-variant-numeric="tabular-nums" flex-shrink=0
                            text pull.title font-size=16 line-height="17.5px" font-weight=500 line-clamp=2
                            row align-items="center" gap=5.25 min-width=0
                              row flex=1 min-width=0 align-items="center" gap=3.5
                                for label in pull.row.labels key=label.name
