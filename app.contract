                          column min-width=0 flex=1 padding="8.75px 0" gap=3.5 border-bottom="1px solid border-subtle"
                            row align-items="center" gap=5.25 min-width=0
                              column width=16 height=16 flex-shrink=0 border-radius=8 background-color="card" align-items="center" justify-content="center"
                                text pull.row.initial font-size=7.2 line-height="10px" font-weight=500 color="muted"
                              text `${pull.repository} #${pull.number}` flex=1 min-width=0 font-size=13 line-height="17px" color="muted" line-clamp=1
                              if pull.row.stackText != ""
