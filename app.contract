use ToolRow, ToolChild, ToolExpansion, ToolImage, ToolPanel, ToolBatch, toolAttempt, matchingToolPanels, toolCopyText from "./tool-row.contract"
use MediaBatch, MediaImage from "./media-image.contract"
use TurnReview, TurnReviewContent from "./turn-review.contract"
use ThreadDraft, threadDraft, DraftAttachment, PendingSend, DraftReceipt, SendReply, CleanupAttachment, ComposerAttachments, ComposerThumbnail from "./attachments.contract"
use TurnChanges, TurnChangeStat, Message, BlockRef, CodeBatch, TableBatch, MarkdownLink, FilePreview, MarkdownMessage, MarkdownBlock, MarkdownBlockView, markdownPalette from "./markdown.contract"
use EmptyState from "exact:content"
use ThreadControls, ControlAccess, ControlReply, QuestionDraft, ControlQuestion, RequestCard, noControls, questionDraft from "./controls.contract"
use ThreadScrollPosition from "./thread-scroll.contract"
use ToolGroup from "./tool-group.contract"

font "DM Sans"
  400 = "assets/fonts/DMSans_400Regular.ttf"
  500 = "assets/fonts/DMSans_500Medium.ttf"
  700 = "assets/fonts/DMSans_700Bold.ttf"
  400 italic = "assets/fonts/DMSans_400Regular_Italic.ttf"
  500 italic = "assets/fonts/DMSans_500Medium_Italic.ttf"
  700 italic = "assets/fonts/DMSans_700Bold_Italic.ttf"

routes nav
  tab threads "/"
  tab threadDetail "/detail"
    newThread "/threads/new"
    thread "/threads/:id"
      inspector "/threads/:id/inspect/:kind"
      gitOverview "/threads/:id/git"
      gitCommit "/threads/:id/git/commit"
      gitConfirm "/threads/:id/git/confirm"
      linkedFile "/threads/:id/file/:file/:line/:column"
      turnReview "/threads/:id/review/:turn"
      threadSettings "/threads/:id/settings"
        settingChoice "/threads/:id/settings/:kind/:option"
  tab pullRequests "/pulls"
    pullRequest "/pulls/:project/:number"
  tab usage "/usage"
  tab settings "/settings"
  tab settingsDetail "/settings/detail"
    environments "/environments"
      addEnvironment "/environments/new"
      environmentDetail "/environments/:id"

shape Choice
  id: string
  label: string
  description: string
  available: bool
  unavailableReason: string

shape Model
  id: string
  instanceId: string
  provider: string
  label: string
  slug: string
  available: bool
  unavailableReason: string
  isDefault: bool
  isLegacy: bool
  isFavorite: bool

shape ProviderGroup
  id: string
  label: string
  provider: string
  models: Model[]

shape ModelOption
  id: string
  label: string
  kind: string
  value: string
  valueLabel: string
  choices: Choice[]

shape SheetSettings
  groups: ProviderGroup[]
  options: ModelOption[]
  selectedModelId: string
  appliedModelId: string
  runtimeMode: string
  runtimeLabel: string
  runtimeChoices: Choice[]
  saveLabel: string
  error: string

shape ComposerModel
  provider: string
  label: string
  summary: string

shape NavigationChange
  before: Router
  after: Router
  split: bool

shape Time
  epochAtZero: number

shape Device
  kind: string
  rail: bool
  split: bool

shape Environment
  id: string
  label: string
  url: string
  status: string
  enabled: bool
  machineSymbol: string

shape EnvironmentState
  loaded: bool
  items: Environment[]

shape ToolSummary
  id: string
  category: string
  status: string
  title: string
  displayTitle: string
  live: bool
  symbol: string
  revision: string
  exitLabel: string
  groupCount: number
  grouped: ToolChild[]
  groupedIds: string[]

shape FeedRow
  id: string
  foldId: string
  changes: option<TurnChanges>
  message: option<Message>
  activity: option<ToolSummary>

shape ToolRequest
  rowId: string
  revision: string
  retry: number

shape VisitMetadata
  ready: bool
  supported: bool
  at: string
  watermark: number
  seen: number
  urgent: bool

shape VisitTracker
  id: string
  openPending: bool
  watermark: number
  cooling: bool
  serial: number

shape ThreadOpen
  id: string
  at: number

shape ThreadHistory
  ready: bool
  synchronized: bool
  hasMore: bool
  loading: bool
  error: string

shape WorkingStatus
  kind: string
  label: string
  symbol: string
  indicator: string
  action: string
  actionLabel: string
  actionPendingLabel: string
  ticking: bool

shape Thread
  id: string
  listed: bool
  visit: VisitMetadata
  history: ThreadHistory
  environmentId: string
  project: string
  projectId: string
  model: string
  modelRevision: string
  activityAt: number
  settled: bool
  working: bool
  projectIcon: string
  projectInitials: string
  projectIconColor: string
  provider: string
  lastError: string
  lastErrorTime: string
  title: string
  status: string
  updatedAt: string
  rows: FeedRow[]
  toolViewKey: string
  markdownRevision: number
  controls: ThreadControls

shape GitFile
  path: string
  insertions: number
  deletions: number

shape GitPullRequest
  number: number
  title: string
  url: string
  baseBranch: string
  headBranch: string
  state: string
  isDraft: bool
  updatedAt: string

shape GitStatus
  cwd: string
  isRepo: bool
  canWrite: bool
  refName: string
  isDefaultRef: bool
  hasWorkingTreeChanges: bool
  hasUpstream: bool
  hasPrimaryRemote: bool
  aheadCount: number
  behindCount: number
  aheadOfDefaultCount: number
  branchBaseRef: string
  branchInsertions: number
  branchDeletions: number
  workingFiles: GitFile[]
  pullRequest: option<GitPullRequest>
  unavailableReason: string

shape GitOperation
  status: string
  actionId: string
  action: string
  label: string
  error: string

shape GitActionResult
  branchStatus: string
  branchName: string
  commitStatus: string
  commitSha: string
  commitSubject: string
  pushStatus: string
  pushBranch: string
  prStatus: string
  prUrl: string
  prNumber: number
  toastTitle: string
  toastDescription: string

shape GitActionReply
  ok: bool
  error: string
  actionId: string
  action: string
  result: GitActionResult

shape PullRequest
  number: number
  title: string
  url: string
  state: string
  isDraft: bool
  repository: string
  baseBranch: string
  headBranch: string
  updatedAt: string
  projectId: string
  author: string
  body: string
  additions: number
  deletions: number
  changedFiles: number

shape GitRef
  name: string
  isRemote: bool
  remoteName: string
  upstreamRef: string
  current: bool
  isDefault: bool
  worktreePath: string

shape GitRefs
  isRepo: bool
  hasPrimaryRemote: bool
  refs: GitRef[]

shape PullRequests
  ready: bool
  error: string
  items: PullRequest[]

shape PullRequestDetail
  ready: bool
  error: string
  body: string
  author: string
  additions: number
  deletions: number
  changedFiles: number
  checksState: string

shape PullRequestComment
  id: string
  author: string
  body: string
  createdAt: string
  kind: string
  path: string
  reviewState: string

shape PullRequestCommit
  id: string
  subject: string
  author: string
  createdAt: string

shape PullRequestActivity
  ready: bool
  error: string
  comments: PullRequestComment[]
  commits: PullRequestCommit[]
  commentCount: number
  commentsTruncated: bool

shape Project
  id: string
  title: string
  environmentId: string

shape Catalog
  modelDraftRevision: number
  projects: Project[]
  environments: Environment[]
  threads: Thread[]

shape CreatedThread
  ok: bool
  error: string
  threadId: string

shape Reply
  ok: bool
  error: string


shape InspectionItem
  id: string
  label: string
  detail: string
  kind: string

shape Inspection
  ok: bool
  error: string
  title: string
  body: string
  items: InspectionItem[]

fn selectedThread(catalog: Catalog, id: string): Thread[] = catalog.threads.filter(thread => thread.id == id)
fn environmentLabel(catalog: Catalog, id: string): string = match first(catalog.environments.filter(environment => environment.id == id)) { case some(environment) => environment.label, case none => "Unknown environment" }
fn threadFeed(threads: Thread[]): FeedRow[] = match first(threads) { case some(thread) => thread.rows, case none => [] }
fn threadRows(threads: Thread[], expanded: ToolExpansion[], threadId: string): option<FeedRow>[] = [none].concat(threadFeed(threads).filter(row => row.foldId == "" or toolAttempt(expanded, threadId, row.foldId) >= 0).map(row => some(row)))
fn threadToolViewKey(threads: Thread[]): string = match first(threads) { case some(thread) => thread.toolViewKey, case none => "" }
fn toolRevision(row: FeedRow): string = match row.activity { case some(tool) => tool.revision, case none => "" }
fn reasoningOnly(tool: ToolSummary): bool = tool.grouped.length > 0 and tool.category == "reasoning"
fn wantedTools(rows: FeedRow[], expanded: ToolExpansion[], threadId: string): ToolRequest[] = rows.filter(row => (row.foldId == "" or toolAttempt(expanded, threadId, row.foldId) >= 0) and toolRevision(row) != "" and toolAttempt(expanded, threadId, row.id) >= 0).map(row => match row.activity { case some(tool) => tool.category == "run-fold" ? [] : tool.groupedIds.length > 0 ? tool.grouped.filter(child => reasoningOnly(tool) or toolAttempt(expanded, threadId, child.id) >= 0).map(child => ToolRequest(rowId=child.id, revision=child.revision, retry=toolAttempt(expanded, threadId, reasoningOnly(tool) ? row.id : child.id))) : [ToolRequest(rowId=row.id, revision=tool.revision, retry=toolAttempt(expanded, threadId, row.id))], case none => [] }).flat()
fn toolChild(tool: ToolSummary): ToolChild = ToolChild(id=tool.id, category=tool.category, status=tool.status, title=tool.title, displayTitle=tool.displayTitle, live=tool.live, symbol=tool.symbol, revision=tool.revision, exitLabel=tool.exitLabel)
fn currentThreadTitle(threads: Thread[]): string = match first(threads) { case some(thread) => thread.title, case none => "" }
fn currentThreadEnvironment(threads: Thread[]): string = match first(threads) { case some(thread) => thread.environmentId, case none => "" }
fn currentThreadSubtitle(catalog: Catalog, threads: Thread[]): string = match first(threads) { case some(thread) => `${thread.project} · ${environmentLabel(catalog, thread.environmentId)}`, case none => "" }
fn filteredThreads(threads: Thread[], environmentId: string, query: string): Thread[] = threads.filter(thread => thread.listed and (environmentId == "" or thread.environmentId == environmentId) and (query.trim() == "" or thread.title.toLowerCase().includes(query.trim().toLowerCase()) or thread.project.toLowerCase().includes(query.trim().toLowerCase())))
fn threadStatusSymbol(status: string): string = status == "Done" ? "symbol:sf/checkmark.circle" : status == "Approval" ? "symbol:sf/exclamationmark.shield" : status == "Input" ? "symbol:sf/questionmark.bubble" : status == "Request" ? "symbol:sf/person.crop.circle" : status == "Working" or status == "Goal" ? "symbol:sf/circle.dashed" : status == "Waiting" ? "symbol:sf/circle.dashed.inset.filled" : "symbol:sf/exclamationmark.circle"
fn threadStatusColor(status: string): string = status == "Done" ? "status-done" : status == "Approval" or status == "Limited" ? "status-warning" : status == "Input" ? "status-input" : status == "Request" ? "status-request" : status == "Working" or status == "Goal" ? "status-working" : status == "Failed" ? "danger" : "muted"
fn gitBranchLabel(status: GitStatus): string = status.refName == "" ? "Detached HEAD" : status.refName
fn gitHasOpenPr(status: GitStatus): bool = match status.pullRequest { case some(pr) => pr.state == "open", case none => false }
fn gitPrLabel(status: GitStatus): string = match status.pullRequest { case some(pr) => `PR #${pr.number}`, case none => "" }
fn gitStatusLabel(status: GitStatus): string = not status.isRepo ? "Not a repo" : (status.hasWorkingTreeChanges ? `${status.workingFiles.length} changed` : status.aheadCount == 0 and status.behindCount == 0 ? "Clean" : "") + (status.aheadCount > 0 ? `${status.hasWorkingTreeChanges ? " · " : ""}${status.aheadCount} ahead` : "") + (status.behindCount > 0 ? `${status.hasWorkingTreeChanges or status.aheadCount > 0 ? " · " : ""}${status.behindCount} behind` : "") + (gitHasOpenPr(status) ? `${status.hasWorkingTreeChanges or status.aheadCount > 0 or status.behindCount > 0 ? " · " : ""}${gitPrLabel(status)}` : "")
fn gitQuickActionKind(status: GitStatus, busy: bool, writable: bool): string =
  not status.isRepo ? "unavailable" : busy ? "busy" : status.refName == "" ? "detached" : status.hasWorkingTreeChanges ? (status.behindCount > 0 or (not status.hasUpstream and not status.hasPrimaryRemote) ? "commit" : gitHasOpenPr(status) or status.isDefaultRef ? "commit_push" : "commit_push_pr") : not status.hasUpstream ? (not status.hasPrimaryRemote ? (gitHasOpenPr(status) and status.aheadCount == 0 ? "open_pr" : "no_origin") : status.aheadCount == 0 ? (gitHasOpenPr(status) ? "open_pr" : "no_commits") : gitHasOpenPr(status) or status.isDefaultRef ? (status.isDefaultRef ? "commit_push" : "push") : "create_pr") : status.aheadCount > 0 and status.behindCount > 0 ? "diverged" : status.behindCount > 0 ? "pull" : status.aheadCount > 0 ? (gitHasOpenPr(status) or status.isDefaultRef ? (status.isDefaultRef ? "commit_push" : "push") : "create_pr") : gitHasOpenPr(status) ? "open_pr" : "clean"
fn gitQuickAction(status: GitStatus, busy: bool, writable: bool): string = gitQuickActionKind(status, busy, writable) == "unavailable" ? "Git unavailable" : gitQuickActionKind(status, busy, writable) == "busy" ? "Commit" : gitQuickActionKind(status, busy, writable) == "detached" ? "Commit" : gitQuickActionKind(status, busy, writable) == "commit" ? "Commit" : gitQuickActionKind(status, busy, writable) == "commit_push" ? (status.hasWorkingTreeChanges ? "Commit & push" : "Push") : gitQuickActionKind(status, busy, writable) == "commit_push_pr" ? "Commit, push & create PR" : gitQuickActionKind(status, busy, writable) == "push" ? "Push" : gitQuickActionKind(status, busy, writable) == "create_pr" ? "Push & create PR" : gitQuickActionKind(status, busy, writable) == "pull" ? "Pull" : gitQuickActionKind(status, busy, writable) == "open_pr" ? "View PR" : gitQuickActionKind(status, busy, writable) == "diverged" ? "Sync branch" : "Commit"
fn gitQuickActionHint(status: GitStatus, busy: bool, writable: bool): string = gitQuickActionKind(status, busy, writable) == "detached" ? "Create and checkout a branch before pushing or opening a pull request." : gitQuickActionKind(status, busy, writable) == "no_origin" ? "Add an \"origin\" remote before pushing or creating a pull request." : gitQuickActionKind(status, busy, writable) == "no_commits" ? "No local commits to push." : gitQuickActionKind(status, busy, writable) == "diverged" ? "Branch has diverged from upstream. Rebase or merge first." : gitQuickActionKind(status, busy, writable) == "clean" ? "Branch is up to date. No action needed." : ""


fn matchingModels(group: ProviderGroup, query: string, showLegacy: bool, selectedId: string, favoritesOnly: bool): Model[] = group.models.filter(model => (showLegacy or not model.isLegacy or model.id == selectedId or model.isFavorite) and (not favoritesOnly or model.isFavorite) and (query.trim() == "" or model.label.toLowerCase().includes(query.trim().toLowerCase()) or model.slug.toLowerCase().includes(query.trim().toLowerCase()) or group.label.toLowerCase().includes(query.trim().toLowerCase())))
fn modelGroupCollapsed(group: ProviderGroup, overrides: string[], selectedId: string, narrowed: bool): bool = not narrowed and ((["codex", "claudeAgent", "antigravity"].includes(group.provider) or group.models.filter(model => model.id == selectedId).length > 0) ? overrides.includes(group.id) : not overrides.includes(group.id))
fn optionTitle(options: ModelOption[], id: string): string = match first(options.filter(option => option.id == id)) { case some(option) => option.label, case none => "Option" }
fn optionChoices(options: ModelOption[], id: string): Choice[] = match first(options.filter(option => option.id == id)) { case some(option) => option.choices, case none => [] }
fn optionValue(options: ModelOption[], id: string): string = match first(options.filter(option => option.id == id)) { case some(option) => option.value, case none => "" }

component T3Code
  members "./controls-state.contract"
  members "./attachment-state.contract"
  members "./fork-state.contract"
  members "./media-image.contract"
  members "./tool-row.contract"
  members "./thread-scroll.contract"
  members "./tool-group.contract"
  members "./question-attachments.contract"
  state modelQuery = ""
  state modelProviderFilter = ""
  state modelExpansionOverrides: string[] = []
  state showLegacyModels = false
  state settingsThreadId = ""
  state query = ""
  state sidebarHidden = false
  state selectedEnvironment = ""
  state selectedProject = ""
  state draftEdits: ThreadDraft[] = []
  state address = ""
  state code = ""
  state expandedEnvironment = ""
  state environmentName = ""
  state environmentUrl = ""
  state removedEnvironment = ""
  state showSettled = false
  state showWorking = false
  state inspectorPath = ""
  state composerBottomAdjustment = 0
  state composerFocus = false
  state composerWide = false
  state composerThumbnailLimit = 1
  state reviewRetry = 0
  resource turnReview = loadTurnReview(threadRoute.name == "turnReview" ? activeThreadId : "", threadRoute.name == "turnReview" ? threadRoute.params.turn : "0", reviewRetry) as shape TurnReview else empty()
  state visitTracker = VisitTracker(id="", openPending=false, watermark=-1, cooling=false, serial=0)
  state threadOpens: ThreadOpen[] = []
  state loadingHistoryId = ""
  state expandedTools: ToolExpansion[] = []
  state toolAttemptSerial = 0
  state observedBlocks: BlockRef[] = []
  state wrappedCodes: BlockRef[] = []
  mutation markdownLink as shape MarkdownLink then afterMarkdownLink
  resource linkedFile = loadLinkedFile(threadRoute.name == "linkedFile" ? activeThreadId : "", threadRoute.name == "linkedFile" ? threadRoute.params.file : "", threadRoute.name == "linkedFile" ? threadRoute.params.line : "0", threadRoute.name == "linkedFile" ? threadRoute.params.column : "0") as shape FilePreview else empty()
  derive markdownLinkError = failed(markdownLink) ? "This link could not be opened." : match markdownLink { case some(link) => link.originRoute == `${threadRoute.id}` ? link.error : "", case none => "" }
  resource savedDrafts = loadDrafts() as shape ThreadDraft[] else empty()
  mutation savedDraft as shape DraftReceipt queue then afterDraftSave
  resource restoredModelSettings = restoreModelSettings() as shape Reply else empty()
  mutation persistedModelSettings as shape Reply queue
  derive modelDraftsReady = not pending(restoredModelSettings) and not failed(restoredModelSettings)
  derive modelDraftError = failed(restoredModelSettings) ? "Saved model settings could not be loaded." : failed(persistedModelSettings) ? "Model settings could not be saved." : ""
  derive draftsReady = not pending(savedDrafts) and not failed(savedDrafts)
  derive draftError = failed(savedDrafts) ? "Saved drafts could not be loaded." : failed(savedDraft) ? "The draft could not be saved." : match first(failedDraftSaves) { case some(reply) => reply.error, case none => "" }
  resource settings = loadSettings(settingsThreadId) as shape SheetSettings else empty()
  resource composerModel = loadComposerModel(activeThreadId, catalog.modelDraftRevision, activeModelRevision) as shape ComposerModel else empty()
  mutation favoriteChanged as shape Reply refreshes settings
  mutation settingsOpened as shape Reply refreshes settings then afterSettingsOpen
  mutation settingsUpdated as shape Reply refreshes settings, composerModel then afterSettingsUpdate
  mutation settingsClosed as shape Reply refreshes settings, composerModel then afterSettingsClose
  derive favoriteError = failed(favoriteChanged) ? "The favorite could not be updated." : match favoriteChanged { case some(reply) => reply.error, case none => "" }
  derive settingsUpdateError = failed(settingsUpdated) ? "The model setting could not be changed." : match settingsUpdated { case some(reply) => reply.error, case none => "" }
  derive settingsCloseError = failed(settingsClosed) ? "The model settings could not be saved." : match settingsClosed { case some(reply) => reply.error, case none => "" }
  derive shownModelGroups = settings.groups.filter(group => (modelProviderFilter == "" or modelProviderFilter == "@favorites" or group.id == modelProviderFilter) and matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites").length > 0)
  resource time = exactTime() as shape Time
  resource device = deviceTraits() as shape Device else empty()
  resource environmentState = loadEnvironmentState() as shape EnvironmentState else empty()
  resource catalog = loadCatalog(selectedEnvironment, activeThreadId, environmentState.items) with time.epochAtZero as shape Catalog else empty()
  state gitCommitMessage = ""
  state gitExcludedFiles: string[] = []
  state gitConfirmAction = ""
  state gitConfirmIncludesCommit = false
  state gitReadOnly = false
  state gitNewBranch = ""
  state gitWorktreeBase = ""
  state gitWorktreeBranch = ""
  state gitStatusRevision = 0
  resource gitStatus = loadGitStatus(activeThreadId, gitStatusRevision) as shape GitStatus else empty()
  resource gitRefs = loadGitRefs(activeThreadId) as shape GitRefs else empty()
  resource gitOperation = loadGitOperation(activeThreadId) as shape GitOperation else empty()
  resource pullRequests = loadPullRequests() as shape PullRequests else empty()
  resource pullRequestDetail = loadPullRequestDetail(current.name == "pullRequest" ? current.params.project : "", current.name == "pullRequest" ? current.params.number : "") as shape PullRequestDetail else empty()
  resource pullRequestActivity = loadPullRequestActivity(current.name == "pullRequest" ? current.params.project : "", current.name == "pullRequest" ? current.params.number : "") as shape PullRequestActivity else empty()
  state statusNow = 0
  derive floatingStatus = match first(workingStatus) { case some(status) => status, case none => WorkingStatus(kind="", label="", symbol="", indicator="none", action="none", actionLabel="", actionPendingLabel="", ticking=false) }
  resource workingStatus = loadThreadStatus(activeThreadId, catalog, stopBusy, statusNow) with time.epochAtZero + statusNow as shape WorkingStatus[] else empty()
  task tickThreadStatus when workingStatus.filter(status => status.ticking).length > 0 key=`${activeThreadId}:${statusNow}`
    after(1000, updateStatusClock)
  action updateStatusClock
    statusNow = performanceNow()
  mutation regrouped as shape NavigationChange then afterRegroup
  mutation changed as shape Reply refreshes environmentState, catalog
  mutation sent as shape SendReply then afterSend
  mutation created as shape CreatedThread then afterCreate
  mutation paired as shape Reply refreshes environmentState, catalog then afterPair
  mutation savedEnvironment as shape Reply refreshes environmentState, catalog then afterEnvironmentSave
  mutation removed as shape Reply refreshes environmentState, catalog then afterEnvironmentRemove
  mutation inspected as shape Inspection
  mutation lifecycleChanged as shape Reply refreshes catalog
  state lifecycleThreadId = ""
  derive lifecycleBusy = pending(lifecycleChanged) and lifecycleThreadId == activeThreadId
  derive lifecycleError = match lifecycleChanged { case some(reply) => lifecycleThreadId == activeThreadId ? reply.error : "", case none => "" }
  mutation visited as shape Reply queue
  mutation earlierHistory as shape Reply refreshes catalog
  mutation pulled as shape Reply refreshes gitStatus, gitOperation then afterGitAction
  mutation gitRefChanged as shape Reply refreshes gitRefs, gitStatus, gitOperation
  mutation gitBranchCreated as shape Reply refreshes gitRefs, gitStatus, gitOperation
  mutation gitWorktreeCreated as shape Reply refreshes gitRefs, gitStatus, gitOperation, catalog
  mutation gitActionResult as shape GitActionReply refreshes gitStatus, gitOperation, pullRequests then afterGitAction
  derive historyError = failed(earlierHistory) ? "Earlier messages could not be loaded." : match earlierHistory { case some(reply) => reply.error, case none => "" }
  derive environmentError = failed(savedEnvironment) ? "The environment could not be updated." : match savedEnvironment { case some(reply) => reply.error, case none => "" }
  derive changeError = failed(changed) ? "The connection could not be changed." : match changed { case some(reply) => reply.error, case none => "" }
  derive removeError = failed(removed) ? "The environment could not be removed." : match removed { case some(reply) => reply.error, case none => "" }
  derive pairError = match paired { case some(reply) => reply.error, case none => "" }
  derive sendError = failed(sent) ? "The message could not be sent. Try again." : match sent { case some(reply) => reply.error, case none => "" }
  derive current = top(nav)
  derive selectedPullRequest = match first(pullRequests.items.filter(item => item.projectId == current.params.project and `${item.number}` == current.params.number)) { case some(item) => some(item), case none => none }
  derive duoFolded = device.kind == "duo-folded"
  derive duoDevice = duoFolded or device.kind == "duo-unfolded"
  derive split = device.split
  derive threadNav = nav.tab == "threadDetail" ? nav : select(nav, "threadDetail")
  derive settingsNav = nav.tab == "settingsDetail" ? nav : select(nav, "settingsDetail")
  derive visibleTab = nav.tab == "threadDetail" ? "threads" : nav.tab == "settingsDetail" ? "settings" : nav.tab
  derive threadRoute = split ? top(threadNav) : current
  derive activeThreadId = visibleTab == "threads" and (threadRoute.name == "thread" or threadRoute.name == "inspector" or threadRoute.name == "gitOverview" or threadRoute.name == "gitCommit" or threadRoute.name == "gitConfirm" or threadRoute.name == "linkedFile" or threadRoute.name == "turnReview" or threadRoute.name == "threadSettings" or threadRoute.name == "settingChoice") ? threadRoute.params.id : ""
  derive activeToolThreadId = visibleTab == "threads" and threadRoute.name == "thread" ? threadRoute.params.id : ""
  derive toolViewKey = threadToolViewKey(selectedThread(catalog, activeToolThreadId))
  derive toolRequests = wantedTools(threadFeed(selectedThread(catalog, activeToolThreadId)), expandedTools, activeToolThreadId)
  derive codeRevision = match first(selectedThread(catalog, activeToolThreadId)) { case some(thread) => thread.markdownRevision, case none => 0 }
  derive blockCandidates = observedBlocks.filter(ref => ref.threadId == activeToolThreadId and ref.viewKey == toolViewKey)
  derive reasoningBlocks = toolPanels.panels.map(panel => panel.blocks).flat()
  resource tableLayouts = loadTableLayouts(activeToolThreadId, toolViewKey, codeRevision, blockCandidates, reasoningBlocks) as shape TableBatch else empty()
  resource codeHighlights = loadCodeHighlights(activeToolThreadId, toolViewKey, codeRevision, blockCandidates, reasoningBlocks) as shape CodeBatch else empty()
  resource toolPanels = loadToolPanels(activeToolThreadId, toolViewKey, toolRequests, toolImageClock) with time.epochAtZero + toolImageNow as shape ToolBatch else empty()
  derive visitShell = match first(selectedThread(catalog, activeThreadId)) { case some(thread) => thread.visit, case none => VisitMetadata(ready=false, supported=false, at="", watermark=-1, seen=-1, urgent=false) }
  derive atRoot = current.name == "threads" or current.name == "pullRequests" or current.name == "usage" or current.name == "settings"
  derive needsRegroup = split ? nav.tab == "threads" or nav.tab == "settings" or depth(select(nav, "threads")) > 1 or depth(select(nav, "settings")) > 1 : nav.tab == "threadDetail" or nav.tab == "settingsDetail" or depth(threadNav) > 1 or depth(settingsNav) > 1
  derive visibleThreads = filteredThreads(catalog.threads, selectedEnvironment, query).filter(thread => selectedProject == "" or thread.projectId == selectedProject)
  derive catalogLoading = not environmentState.loaded or pending(environmentState) or pending(catalog) or catalog.environments.filter(environment => environment.enabled and (environment.status == "Disconnected" or environment.status == "Connecting" or environment.status == "Reconnecting")).length > 0
  derive selectedProjectLabel = match first(catalog.projects.filter(project => project.id == selectedProject)) { case some(project) => project.title, case none => "All projects" }
  derive composer = threadDraft(savedDrafts, draftEdits, activeThreadId).text
  derive composerExpanded = composer != "" and (composer.includes("\n") or composerWide)
  derive activeModelRevision = match first(selectedThread(catalog, activeThreadId)) { case some(thread) => thread.modelRevision, case none => "" }
  derive composerError = match sent { case some(reply) => reply.id == activeThreadId and not pending(sent) ? reply.error : "", case none => "" }
  derive canSend = draftsReady and modelDraftsReady and (composer.trim() != "" or composerAttachments.length > 0) and attachmentSendReady and pendingMessage == none and not pending(sent) and not pending(preparedSend)
  derive gitWritable = not gitReadOnly and gitStatus.canWrite
  derive gitBusy = pending(gitActionResult) or pending(pulled) or pending(gitRefChanged) or pending(gitBranchCreated) or pending(gitWorktreeCreated) or gitOperation.status == "running"
  derive gitError = match gitActionResult { case some(reply) => reply.error, case none => match pulled { case some(reply) => reply.error, case none => match gitRefChanged { case some(reply) => reply.error, case none => match gitBranchCreated { case some(reply) => reply.error, case none => match gitWorktreeCreated { case some(reply) => reply.error, case none => gitOperation.error } } } } }
  derive activeThreadHasMessage = threadFeed(selectedThread(catalog, activeThreadId)).filter(row => row.message != none).length > 0
  derive selectedGitFiles = gitStatus.workingFiles.filter(file => not gitExcludedFiles.includes(file.path))
  derive selectedGitInsertions = sum(selectedGitFiles.map(file => file.insertions))
  derive selectedGitDeletions = sum(selectedGitFiles.map(file => file.deletions))

  task visitObservation key=`${activeThreadId}:${visitShell.ready}:${visitShell.supported}:${visitShell.at}:${visitShell.watermark}:${visitShell.seen}:${visitShell.urgent}`
    after(1, observeVisit)

  task visitCooldown when activeThreadId != "" and activeThreadId == visitTracker.id and visitTracker.cooling key=visitTracker.serial
    after(10000, releaseVisit)

  action observeVisit
    evaluateVisit(false)

  action releaseVisit
    evaluateVisit(true)

  action evaluateVisit(expired: bool)
    let changedThread = visitTracker.id != activeThreadId
    let openedAt = match first(threadOpens.filter(entry => entry.id == activeThreadId)) { case some(entry) => entry.at, case none => -600000 }
    let opened = changedThread and activeThreadId != "" and performanceNow() - openedAt >= 600000
    let next = changedThread ? VisitTracker(id=activeThreadId, openPending=opened, watermark=-1, cooling=false, serial=visitTracker.serial) : VisitTracker(visitTracker, cooling=expired ? false : visitTracker.cooling)
    if opened
      threadOpens = threadOpens.filter(entry => entry.id != activeThreadId).concat([ThreadOpen(id=activeThreadId, at=performanceNow())])
    if activeThreadId == "" or not visitShell.ready or not visitShell.supported
      visitTracker = next
    else if next.openPending
      visitTracker = VisitTracker(next, openPending=false, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, true)
    else if visitShell.seen >= visitShell.watermark
      visitTracker = VisitTracker(next, watermark=max(next.watermark, visitShell.watermark))
    else if visitShell.watermark > next.watermark and (visitShell.urgent or not next.cooling)
      visitTracker = VisitTracker(next, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, false)
    else
      visitTracker = next

  action loadEarlier(id: string)
    loadingHistoryId = id
    send earlierHistory = loadEarlierThread(id)

  action preserveThreadDisclosure(threadId: string, rowId: string)
    if threadId == activeThreadId
      let savedScroll = threadScroll.scope == threadScrollScope ? threadScroll : ThreadScrollPosition(scope=threadScrollScope, following=true, away=false, key=none, offset=0)
      let visibleIds = threadRows(selectedThread(catalog, threadId), expandedTools, threadId).map(item => match item { case some(row) => row.id, case none => "history" })
      let savedKey = match savedScroll.key { case some(key) => visibleIds.includes(key) ? some(key) : visibleIds.includes(`${key}:group`) ? some(`${key}:group`) : none, case none => none }
      threadScroll = ThreadScrollPosition(savedScroll, following=false, key=savedKey)
      threadScrollRevision = threadScrollRevision + 1
      match savedKey
        case some(key)
          scrollIntoView("thread-messages", key, offset=savedScroll.offset, behavior="instant")
        case none
          let anchor = match first(threadFeed(selectedThread(catalog, threadId)).filter(row => row.id == rowId or (match row.activity { case some(tool) => tool.groupedIds.includes(rowId), case none => false }))) { case some(row) => row.id, case none => rowId }
          let port = frame("thread-messages")
          let row = frame(`thread-tool-${anchor}`)
          if not port.unavailable and not row.unavailable and not port.provisional and not row.provisional
            scrollIntoView("thread-messages", anchor, offset=port.y - row.y, behavior="instant")

  action scrollToEnd
    // Keep the island mounted while the native scroll animation is running.
    // The scroll observer clears `away` once the list settles at its end.
    threadScroll = ThreadScrollPosition(scope=threadScrollScope, following=true, away=true, key=none, offset=0)
    threadScrollRevision = threadScrollRevision + 1
    let lastRow = match threadRows(selectedThread(catalog, activeThreadId), expandedTools, activeThreadId).map(item => match item { case some(row) => row.id, case none => "history" }).at(-1) { case some(key) => key, case none => "history" }
    scrollIntoView("thread-messages", lastRow, block="end", behavior="smooth")

  action toggleTool(threadId: string, rowId: string)
    preserveThreadDisclosure(threadId, rowId)
    let inheritedParents = threadFeed(selectedThread(catalog, threadId)).filter(row => row.id != rowId and (match row.activity { case some(tool) => tool.groupedIds.includes(rowId), case none => false }) and toolAttempt(expandedTools, threadId, row.id) >= 0 and expandedTools.filter(entry => entry.threadId == threadId and entry.rowId == row.id).length == 0).map(row => ToolExpansion(threadId=threadId, rowId=row.id, attempt=toolAttempt(expandedTools, threadId, row.id)))
    let retained = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId).concat(inheritedParents)
    if toolAttempt(expandedTools, threadId, rowId) >= 0
      expandedTools = rowId.endsWith(":group") ? retained.concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=-1)]) : retained
    else
      let attempt = toolAttemptSerial + 1
      toolAttemptSerial = attempt
      expandedTools = retained.concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  action openTurnReview(threadId: string, turnCount: number)
    cancelForkNavigation()
    clearForceStopDialogs()
    nav = push(nav, path("turnReview", threadId, `${turnCount}`))

  action retryTurnReview
    reviewRetry = reviewRetry + 1

  action retryTool(threadId: string, rowId: string)
    let attempt = toolAttemptSerial + 1
    toolAttemptSerial = attempt
    expandedTools = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId).concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  action workingIslandAction(value: string)
    if value == "scroll"
      scrollToEnd()
    else if value == "force-stop"
      confirmForceStop()
    else if value == "reconnect"
      reconnectEnvironment(currentThreadEnvironment(selectedThread(catalog, activeThreadId)))
    else if value == floatingStatus.action and controlsAllowed and not pending(lifecycleChanged)
      lifecycleThreadId = activeThreadId
      send lifecycleChanged = updateThreadLifecycle(activeThreadId, threadControls.accessKey, value, time.epochAtZero + performanceNow())

  task defaultSettings when split and current.name == "settingsDetail" key=current.id
    after(1, openEnvironments)

  task reconciledModels when modelDraftsReady and catalog.modelDraftRevision > 0 key=catalog.modelDraftRevision
    after(1, persistReconciledModels)

  action observeBlock(threadId: string, viewKey: string, messageId: string, blockId: string, kind: string, event: IntersectionObserverEntry)
    if threadId == activeToolThreadId and viewKey == toolViewKey
      let retained = observedBlocks.filter(ref => ref.threadId == threadId and ref.viewKey == viewKey and not (ref.messageId == messageId and ref.blockId == blockId))
      if event.isIntersecting
        observedBlocks = retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-64)
      else if kind != "table"
        observedBlocks = retained

  action toggleCodeWrap(threadId: string, viewKey: string, messageId: string, blockId: string)
    let retained = wrappedCodes.filter(ref => ref.threadId != threadId or ref.viewKey == viewKey)
    let exists = retained.filter(ref => ref.threadId == threadId and ref.messageId == messageId and ref.blockId == blockId).length > 0
    wrappedCodes = exists ? retained.filter(ref => ref.threadId != threadId or ref.messageId != messageId or ref.blockId != blockId) : retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-256)

  action followMarkdownLink(threadId: string, href: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    send markdownLink = resolveMarkdownLink(threadId, href, `${threadRoute.id}`)

  action afterMarkdownLink
    match markdownLink
      case some(link)
        if link.originThreadId == activeThreadId and link.originRoute == `${threadRoute.id}` and link.error == ""
          if link.kind == "thread"
            nav = push(split ? threadNav : nav, path("thread", link.threadId))
          else if link.kind == "file"
            nav = push(split ? threadNav : nav, path("linkedFile", link.threadId, link.path, `${link.line}`, `${link.column}`))
      case none
        nav = nav

  task linkedFilePosition when threadRoute.name == "linkedFile" and not pending(linkedFile) and linkedFile.path == threadRoute.params.file and linkedFile.error == "" key=`${threadRoute.id}:${linkedFile.path}:${linkedFile.lines.length}`
    after(1, revealFileLine)

  action revealFileLine
    if threadRoute.name == "linkedFile" and threadRoute.params.line != "0"
      scrollIntoView("linked-file-lines", linkedFile.targetLine, block="center")

  action persistReconciledModels
    send persistedModelSettings = persistModelSettings()

  task inspector when current.name == "inspector" and selectedThread(catalog, current.params.id).length > 0 key=`${current.id}:${current.params.kind}`
    after(1, loadInspector)

  action openModelSettings
    cancelForkNavigation()
    clearForceStopDialogs()
    let id = activeThreadId
    favoriteChanged = none
    settingsUpdated = none
    settingsClosed = none
    settingsThreadId = id
    modelQuery = ""
    modelProviderFilter = ""
    showLegacyModels = false
    modelExpansionOverrides = []
    send settingsOpened = beginSettings(id)
  action afterSettingsOpen
    if match settingsOpened { case some(reply) => reply.ok, case none => false }
      nav = push(split ? threadNav : nav, path("threadSettings", settingsThreadId))
  action cancelModelSettings
    send settingsClosed = closeSettings(settingsThreadId, false)
  action saveModelSettings
    send settingsClosed = closeSettings(settingsThreadId, true)
  action afterSettingsClose
    if match settingsClosed { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      nav = go(nav, path("thread", settingsThreadId))
      settingsThreadId = ""
  action searchModels(value: string)
    modelQuery = value
  action filterModelProvider(id: string)
    modelProviderFilter = id
  action toggleLegacyModels
    showLegacyModels = not showLegacyModels
  action toggleModelGroup(id: string)
    modelExpansionOverrides = modelExpansionOverrides.includes(id) ? modelExpansionOverrides.filter(value => value != id) : modelExpansionOverrides.concat([id])
  action toggleModelFavorite(id: string, favorite: bool)
    send favoriteChanged = setModelFavorite(settingsThreadId, id, favorite)
  action selectSettingsModel(id: string)
    send settingsUpdated = changeSettings(settingsThreadId, "model", id, "")
  action toggleSettingsOption(id: string, value: bool)
    send settingsUpdated = changeSettings(settingsThreadId, "option", id, value ? "true" : "false")
  action openSettingChoice(kind: string, option: string)
    nav = push(nav, path("settingChoice", settingsThreadId, kind, option))

  action chooseSetting(kind: string, id: string, value: string)
    send settingsUpdated = changeSettings(settingsThreadId, kind, id, value)
  action afterSettingsUpdate
    if match settingsUpdated { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      if top(nav).name == "settingChoice"
        nav = back(nav)


  action loadInspector
    send inspected = inspectThread(current.params.id, current.params.kind, "")

  task regroup when needsRegroup key=`${split}:${nav.tab}:${nav.next}:${current.id}`
    after(1, regroupNow)

  action regroupNow
    if needsRegroup
      send regrouped = regroupNavigation(nav, split)

  action afterRegroup
    match regrouped
      case some(change)
        if change.before == nav and change.split == split
          nav = change.after
      case none
        nav = nav

  action selectTab(name: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    nav = select(nav, split and name == "threads" ? "threadDetail" : split and name == "settings" ? "settingsDetail" : name)

  action search(value: string)
    query = value

  action toggleSidebar
    sidebarHidden = not sidebarHidden

  action filterEnvironment(id: string)
    selectedEnvironment = id
    selectedProject = ""

  action filterProject(id: string)
    selectedProject = id

  action resetFilters
    selectedEnvironment = ""
    selectedProject = ""

  action openEnvironments
    nav = go(split ? select(settingsNav, "settingsDetail") : nav, "/environments")

  action manageEnvironment(id: string)
    expandedEnvironment = ""
    nav = push(split ? settingsNav : nav, path("environmentDetail", id))

  action expandEnvironment(id: string)
    expandedEnvironment = expandedEnvironment == id ? "" : id
    match first(catalog.environments.filter(environment => environment.id == id))
      case some(environment)
        environmentName = environment.label
        environmentUrl = environment.url.endsWith("/") ? environment.url : environment.url + "/"
      case none
        expandedEnvironment = ""

  action editEnvironmentName(value: string)
    environmentName = value

  action editEnvironmentUrl(value: string)
    environmentUrl = value

  action saveEnvironment(id: string)
    send savedEnvironment = updateEnvironment(id, environmentName, environmentUrl)

  action afterEnvironmentSave
    if environmentError == ""
      expandedEnvironment = ""

  action reconnectEnvironment(id: string)
    send changed = command("reconnect", id, "")

  action askRemoveEnvironment(id: string)
    removedEnvironment = id
    showModal("remove-environment")

  action removeEnvironment
    send removed = command("remove", removedEnvironment, "")

  action afterEnvironmentRemove
    if removeError == ""
      nav = back(nav)

  action addEnvironment
    nav = split ? push(select(settingsNav, "settingsDetail"), "/environments/new") : push(nav, "/environments/new")

  action editAddress(value: string)
    address = value

  action editCode(value: string)
    code = value

  action pair
    send paired = command("pair", address.trim(), code.trim())

  action afterPair
    if pairError == "" and current.name == "addEnvironment"
      nav = back(nav)
      address = ""
      code = ""

  action follow(url: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    let base = split and nav.tab == "threads" ? threadNav : split and nav.tab == "settings" ? settingsNav : nav
    let followed = go(base, url)
    nav = followed.next == base.next ? followed : open(base, url)

  action openPullRequest(projectId: string, number: number)
    nav = push(nav, path("pullRequest", projectId, `${number}`))

  action backPullRequest
    nav = back(nav)

  action openPullRequestUrl(url: string)
    if url != ""
      openURL(url)

  action openThread(url: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    let base = split ? threadNav : nav
    let detail = activeThreadId != "" ? go(base, path("thread", activeThreadId)) : base
    nav = split and depth(detail) > 1 ? replace(detail, url) : go(detail, url)

  action compose
    cancelForkNavigation()
    clearForceStopDialogs()
    nav = split ? push(select(threadNav, "threadDetail"), "/threads/new") : push(nav, "/threads/new")

  action workspaceAction(value: string)
    if value.startsWith("tab:")
      cancelForkNavigation()
      clearForceStopDialogs()
      nav = select(nav, value.replaceAll("tab:", ""))
    else if value == "compose"
      cancelForkNavigation()
      clearForceStopDialogs()
      nav = push(nav, "/threads/new")

  action createProjectThread(id: string)
    send created = createThread(id, "New thread")

  action afterCreate
    match created
      case some(reply)
        if reply.ok
          nav = replace(split ? threadNav : nav, path("thread", reply.threadId))
      case none
        nav = nav

  action toggleSettled
    showSettled = not showSettled

  action toggleWorking
    showWorking = not showWorking

  action toggleEnvironment(id: string, enabled: bool)
    send changed = command("toggle", id, enabled ? "true" : "false")

  action editComposer(value: string)
    if draftsReady and activeThreadId != ""
      let previous = threadDraft(savedDrafts, draftEdits, activeThreadId)
      persistDraft(ThreadDraft(previous, text=value, revision=previous.revision + 1))

  action copyMessage(body: string)
    copyText(body)

  action composerMetrics(value: string)
    composerBottomAdjustment = match parseNumber(value) { case some(inset) => inset, case none => 0 }

  action composerFocused
    composerFocus = true

  action composerBlurred
    composerFocus = false

  action focusComposer
    focus("composer")

  task composerFit when activeThreadId != "" key=`${threadRoute.id}:${composer}:${composerAttachments.length}:${composerFocus}:${split}:${sidebarHidden}`
    after(1, fitComposer, wait=frame)

  action fitComposer
    let surface = frame("composer-surface")
    let line = frame("composer-mirror")
    if not surface.unavailable and not line.unavailable and not surface.provisional and not line.provisional
      let limit = surface.width >= 500 ? 3 : 1
      let shown = composerFocus ? 0 : min(composerAttachments.length, limit)
      let thumbnails = shown == 0 ? 0 : 4 + shown * 30 + (shown - 1) * 4 + (composerAttachments.length > limit ? 34 : 0)
      composerThumbnailLimit = limit
      composerWide = line.width > surface.width - 146 - thumbnails

  action inspect(kind: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    inspectorPath = ""
    nav = push(split ? threadNav : nav, path("inspector", activeThreadId, kind))

  action editGitCommitMessage(value: string)
    gitCommitMessage = value

  action toggleGitFile(path: string)
    gitExcludedFiles = gitExcludedFiles.includes(path) ? gitExcludedFiles.filter(value => value != path) : gitExcludedFiles.concat([path])

  action toggleAllGitFiles
    gitExcludedFiles = gitExcludedFiles.length == 0 ? gitStatus.workingFiles.map(file => file.path) : []

  action openGitCommit
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and not gitBusy
      gitCommitMessage = ""
      gitExcludedFiles = []
      nav = push(split ? threadNav : nav, path("gitCommit", activeThreadId))

  action openGitOverview
    if activeThreadId != "" and activeThreadHasMessage
      gitNewBranch = ""
      gitWorktreeBase = gitStatus.refName == "" ? "main" : gitStatus.refName
      gitWorktreeBranch = ""
      nav = push(split ? threadNav : nav, path("gitOverview", activeThreadId))

  action refreshGitOverview
    if not gitBusy
      gitStatusRevision = gitStatusRevision + 1

  action editGitNewBranch(value: string)
    gitNewBranch = value

  action editGitWorktreeBase(value: string)
    gitWorktreeBase = value

  action editGitWorktreeBranch(value: string)
    gitWorktreeBranch = value

  action createGitBranch
    if activeThreadId != "" and gitWritable and not gitBusy and gitNewBranch.trim() != ""
      send gitBranchCreated = createGitBranch(activeThreadId, gitNewBranch.trim())

  action createGitWorktree
    if activeThreadId != "" and gitWritable and not gitBusy and gitWorktreeBase.trim() != "" and gitWorktreeBranch.trim() != ""
      send gitWorktreeCreated = createGitWorktree(activeThreadId, gitWorktreeBase.trim(), gitWorktreeBranch.trim())

  action requestGitAction(action: string, includesCommit: bool)
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and not gitBusy
      if gitStatus.isDefaultRef and (action == "push" or action == "create_pr" or action == "commit_push" or action == "commit_push_pr")
        gitConfirmAction = action
        gitConfirmIncludesCommit = includesCommit
        nav = push(split ? threadNav : nav, path("gitConfirm", activeThreadId))
      else
        runGit(action, gitCommitMessage, false, selectedGitFiles.map(file => file.path))

  action confirmGitAction(featureBranch: bool)
    nav = back(nav)
    runGit(gitConfirmAction, gitCommitMessage, featureBranch, selectedGitFiles.map(file => file.path))

  action submitGitCommit(featureBranch: bool)
    nav = back(nav)
    runGit("commit", gitCommitMessage, featureBranch, selectedGitFiles.map(file => file.path))

  action cancelGitRoute
    nav = back(nav)

  action afterGitAction
    if gitError.toLowerCase().includes("permission") or gitError.toLowerCase().includes("scope") or gitError.toLowerCase().includes("not authorized")
      gitReadOnly = true

  action runQuickGitAction
    let kind = gitQuickActionKind(gitStatus, gitBusy, gitWritable)
    if kind == "pull"
      pullLatest()
    else if kind == "open_pr"
      match gitStatus.pullRequest
        case some(pr)
          openURL(pr.url)
        case none
          inspect("git")
    else if kind == "commit"
      requestGitAction("commit", true)
    else if kind == "commit_push"
      requestGitAction("commit_push", true)
    else if kind == "commit_push_pr"
      requestGitAction("commit_push_pr", true)
    else if kind == "push"
      requestGitAction("push", false)
    else if kind == "create_pr"
      requestGitAction("create_pr", false)
    else
      inspect("git")

  action pullLatest
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and gitStatus.behindCount > 0 and gitOperation.status != "running"
      send pulled = pullGit(activeThreadId)

  action switchGitRef(name: string)
    if activeThreadId != "" and gitWritable and not gitBusy and name != ""
      send gitRefChanged = switchGitRef(activeThreadId, name)

  action runGit(action: string, message: string, featureBranch: bool, files: string[])
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and gitOperation.status != "running"
      send gitActionResult = runGitAction(activeThreadId, action, message, featureBranch, files)

  action inspectEntry(id: string, kind: string)
    inspectorPath = id
    send inspected = inspectThread(activeThreadId, kind == "directory" ? "files" : "file", id)

  action sendMessage
    if canSend and activeThreadId != ""
      attachmentError = ""
      send preparedSend = prepareSend(activeDraft, composerSendScope)

  action afterSend
    match sent
      case some(reply)
        let draft = threadDraft(savedDrafts, draftEdits, reply.id)
        match draft.pendingSend
          case some(message)
            if message.commandId == reply.commandId
              let same = draft.revision == message.revision
              let revision = draft.revision + 1
              let updated = ThreadDraft(draft, revision=revision, text=(reply.ok and same ? "" : draft.text), attachments=(reply.ok and same ? [] : draft.attachments), pendingSend=(reply.state == "unknown" ? some(PendingSend(message, state="unknown", revision=(same ? revision : message.revision))) : none))
              persistDraft(updated)
              if reply.state != "unknown"
                attachmentCleanup = attachmentCleanup.concat(message.paths.filter(path => updated.attachments.filter(item => item.path == path).length == 0).map(path => CleanupAttachment(threadId=draft.id, draftId=draft.id, accessKey="", attachmentId="", path=path, revision=updated.revision)))
          case none
            draftEdits = draftEdits
      case none
        draftEdits = draftEdits

  view
    main interactive-widget="resizes-content" testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" display="flex" flex-direction="column" font-family="DM Sans" font-size=16 color="foreground" background-color="screen"
      input type="file" id="attachment-photos" accept="image/*" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-photos"
      input type="file" id="attachment-files" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-files"
      column id="attachment-menu" popover="auto" role="menu" aria-label="Add attachment"
        button press=pickAttachments(true) role="menuitem" testId="choose-photos"
          image "symbol:sf/photo.on.rectangle"
          text "Photo Library"
        if attachmentAccess.maxFileBytes > 0
          button press=pickAttachments(false) role="menuitem" testId="choose-files"
            image "symbol:sf/folder"
            text "Choose Files"
      match attachmentViewer
        case some(viewer)
          if viewer.state != "presented"
