                        button press=openPullRequest(pull.routeKey, pull.number) appearance="none" aria-label=pull.row.accessible testId=`pull-${pull.environmentId}-${pull.host}-${pull.repository}-${pull.projectId}-${pull.number}` width="100%" box-sizing="border-box" display="flex" flex-direction="row" align-items="flex-start" text-align="left" gap=10.5 padding="0 14px" border="none" background-color="transparent" color="foreground"
                          column position="relative" flex-shrink=0 margin-top=8.75 width=20 height=20 aria-hidden=true
                            if pull.row.status == "Open" or pull.row.status == "Draft"
