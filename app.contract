                                    if label.color != ""
                                      column width=5 height=5 border-radius=3 background-color=label.color flex-shrink=0
                                    text label.name min-width=0 line-clamp=1 font-size=12 line-height="16px" font-weight=500 color="muted"
                                if pull.row.extraLabels > 0
                                  text `+${pull.row.extraLabels}` font-size=12 line-height="16px" color="muted" flex-shrink=0
                              if pull.row.checks != ""
