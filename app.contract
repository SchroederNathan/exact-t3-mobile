                                      row width=30 height=30 border-radius=15 background-color=((canSend or canSaveQueuedComposer) ? "AccentColor" : "send-disabled") color=((canSend or canSaveQueuedComposer) ? "white" : "send-disabled-ink") align-items="center" justify-content="center"
                                        image (composerSession.editingQueueId != "" ? "symbol:checkmark" : threadControls.stop.runId != "" and serverQueue.canSendNow and (activeApproval == none or hasQuestion) ? "symbol:sf/arrow.turn.left.up" : threadControls.stop.runId != "" and (activeApproval == none or hasQuestion) ? "symbol:sf/list.number" : "symbol:sf/arrow.up") width=16 height=16 font-weight=600

              if e.name == "composerQueue"
