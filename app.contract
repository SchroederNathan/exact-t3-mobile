  members "./composer-parity.contract"
  members "./composer-import.contract"
  members "./pairing-scan.contract"
  state modelQuery = ""
  state modelProviderFilter = ""
  state modelExpansionOverrides: string[] = []
  state showLegacyModels = false
  state settingsThreadId = ""
  state query = ""
  state messageQuery = ""
  state sidebarHidden = false
  state selectedEnvironment = ""
  state selectedProject = ""
  state draftEdits: ThreadDraft[] = []
  state address = ""
  state code = ""
  state expandedEnvironment = ""
  state environmentName = ""
  state environmentUrl = ""
  state removedEnvironment = ""
  state showSettled = false persist
  state showSnoozed = false persist
  state showWorking = false persist
  state inspectorPath = ""
  state composerBottomAdjustment = 0
  state composerFocus = false
  state composerWide = false
  state composerThumbnailLimit = 1
  state reviewRetry = 0
  state terminalClock = 0
  state terminalFontSize = 10.5 persist
  state composerReturnBehavior = "send" persist
  state terminalModifier = ""
  state terminalKeyboardVisible = false
  resource turnReview = loadTurnReview(threadRoute.name == "turnReview" ? activeThreadId : "", threadRoute.name == "turnReview" ? threadRoute.params.turn : "0", reviewRetry) as shape TurnReview else empty()
  state visitTracker = VisitTracker(id="", openPending=false, watermark=-1, cooling=false, serial=0)
  state threadOpens: ThreadOpen[] = []
  state loadingHistoryId = ""
  state expandedTools: ToolExpansion[] = []
  state toolAttemptSerial = 0
  state observedBlocks: BlockRef[] = []
  state wrappedCodes: BlockRef[] = []
  mutation markdownLink as shape MarkdownLink then afterMarkdownLink
  resource linkedFile = loadLinkedFile(threadRoute.name == "linkedFile" ? threadRoute.params.id : "", threadRoute.name == "linkedFile" ? threadRoute.params.file : "", threadRoute.name == "linkedFile" ? threadRoute.params.line : "0", threadRoute.name == "linkedFile" ? threadRoute.params.column : "0", newTask.environmentId, newTask.cwd) as shape FilePreview else empty()
  derive markdownLinkError = failed(markdownLink) ? "This link could not be opened." : match markdownLink { case some(link) => link.originRoute == `${threadRoute.id}` ? link.error : "", case none => "" }
  resource savedDrafts = loadDrafts() as shape ThreadDraft[] else empty()
  mutation savedDraft as shape DraftReceipt queue then afterDraftSave
  resource restoredModelSettings = restoreModelSettings() as shape Reply else empty()
  mutation persistedModelSettings as shape Reply queue
  derive modelDraftsReady = not pending(restoredModelSettings) and not failed(restoredModelSettings)
  derive modelDraftError = failed(restoredModelSettings) ? "Saved model settings could not be loaded." : failed(persistedModelSettings) ? "Model settings could not be saved." : ""
  derive draftsReady = not pending(savedDrafts) and not failed(savedDrafts)
  derive draftError = failed(savedDrafts) ? "Saved drafts could not be loaded." : failed(savedDraft) ? "The draft could not be saved." : match first(failedDraftSaves) { case some(reply) => reply.error, case none => "" }
  resource settings = loadSettings(settingsThreadId, newTask.environmentId, newTask.projectId) as shape SheetSettings else empty()
  resource composerModel = loadComposerModel(activeComposerId, catalog.modelDraftRevision, activeModelRevision, newTask.environmentId, newTask.projectId) as shape ComposerModel else empty()
  mutation favoriteChanged as shape Reply refreshes settings
  mutation settingsOpened as shape Reply refreshes settings then afterSettingsOpen
  mutation settingsUpdated as shape Reply refreshes settings, composerModel then afterSettingsUpdate
  mutation settingsClosed as shape Reply refreshes settings, composerModel then afterSettingsClose
  derive favoriteError = failed(favoriteChanged) ? "The favorite could not be updated." : match favoriteChanged { case some(reply) => reply.error, case none => "" }
  derive settingsUpdateError = failed(settingsUpdated) ? "The model setting could not be changed." : match settingsUpdated { case some(reply) => reply.error, case none => "" }
  derive settingsCloseError = failed(settingsClosed) ? "The model settings could not be saved." : match settingsClosed { case some(reply) => reply.error, case none => "" }
  derive shownModelGroups = settings.groups.filter(group => (modelProviderFilter == "" or modelProviderFilter == "@favorites" or group.id == modelProviderFilter) and matchingModels(group, modelQuery, showLegacyModels, settings.selectedModelId, modelProviderFilter == "@favorites").length > 0)
  resource time = exactTime() as shape Time
  resource device = deviceTraits() as shape Device else empty()
  resource environmentState = loadEnvironmentState() as shape EnvironmentState else empty()
  state pullEnvironment = "" persist
  derive pullDetailRoute = current.name == "pullRequest" or current.name == "pullFile" or current.name == "pullFilesSheet"
  derive pullWorkspace = current.name == "pullRequests" or pullDetailRoute or current.name == "pullFilterSearch"
  derive selectedPullEnvironment = environmentState.items.filter(env => env.id == pullEnvironment).length > 0 ? pullEnvironment : ""
  resource pullLink = parsePullLink(pullDetailRoute ? current.params.project : "", pullDetailRoute ? current.params.number : "") as shape PullRef[] else empty()
  derive pullLinkEnvironment = match first(pullLink) { case some(ref) => ref.environmentId, case none => "" }
  derive wantedPullEnvironment = pullLinkEnvironment != "" ? pullLinkEnvironment : selectedPullEnvironment
  derive defaultEnvironmentId = match first(environmentState.items.filter(env => env.enabled)) { case some(env) => env.id, case none => "" }
  derive pullCatalogEnvironment = wantedPullEnvironment == defaultEnvironmentId and selectedEnvironment == "" ? "" : wantedPullEnvironment
  resource catalog = loadCatalog(pullWorkspace and device.kind == "web" and wantedPullEnvironment != "" ? pullCatalogEnvironment : selectedEnvironment, activeThreadId, environmentState.items) with time.epochAtZero as shape Catalog else empty()
  state usageDays = 30
  state usageView = "Limits"
  state usageRefresh = 0
  state usageWindowTime = 0
  state usageWide = false
  state limitBarWidth = 0
  action measureLimitBar(width: number, height: number)
    limitBarWidth = width
  action measureUsage(width: number, height: number)
    usageWide = width >= 600
  resource usageReport = loadUsage(current.name == "usage" and usageView != "Limits" ? catalog.environments : [], usageDays, usageRefresh) with time.epochAtZero + usageWindowTime as shape UsageRow[] else empty()
  state gitCommitMessage = ""
  state gitExcludedFiles: string[] = []
  state gitConfirmAction = ""
  state gitConfirmIncludesCommit = false
  state gitReadOnly = false
  state gitNewBranch = ""
  state gitWorktreeBase = ""
  state gitWorktreeBranch = ""
  state gitStatusRevision = 0
  resource gitStatus = loadGitStatus(activeThreadId != "" ? activeThreadId : activeDraftKey, gitStatusRevision, newTask.environmentId, newTask.cwd) as shape GitStatus else empty()
  resource gitRefs = loadGitRefs(activeThreadId) as shape GitRefs else empty()
  resource gitOperation = loadGitOperation(activeThreadId) as shape GitOperation else empty()
  resource savedPullPrefs = readPullPrefs() as shape SavedPullPreferences else empty()
  mutation wrotePullPrefs as shape Reply queue
  state editedPullPrefs: PullPreference[] = []
  derive defaultPullPrefs = PullPreference(scope=selectedPullEnvironment, state="open", involvement="all", draft="all", review="all", checks="all", sort="updated", project="", labels=[], author="")
  derive activePullPrefs = match first(editedPullPrefs.concat(savedPullPrefs.items).filter(pref => pref.scope == selectedPullEnvironment)) { case some(pref) => pref, case none => defaultPullPrefs }
  derive pullState = activePullPrefs.state
  derive pullInvolvement = activePullPrefs.involvement
  derive pullDraftFilter = activePullPrefs.draft
  derive pullReviewFilter = activePullPrefs.review
  derive pullChecksFilter = activePullPrefs.checks
  derive pullSort = activePullPrefs.sort
  derive pullProject = activePullPrefs.project
  derive pullLabels = activePullPrefs.labels
  derive pullAuthor = activePullPrefs.author
  derive pullPrefsError = savedPullPrefs.error != "" ? savedPullPrefs.error : match wrotePullPrefs { case some(reply) => reply.error, case none => "" }
  action editPullPrefs(field: string, value: string, labels: string[])
    let next = field == "reset" ? defaultPullPrefs : PullPreference(scope=selectedPullEnvironment, state=(field == "state" ? value : pullState), involvement=(field == "involvement" ? value : pullInvolvement), draft=(field == "draft" ? value : pullDraftFilter), review=(field == "review" ? value : pullReviewFilter), checks=(field == "checks" ? value : pullChecksFilter), sort=(field == "sort" ? value : pullSort), project=(field == "project" ? value : pullProject), labels=(field == "labels" ? labels : pullLabels), author=(field == "author" ? value : pullAuthor))
    editedPullPrefs = editedPullPrefs.filter(pref => pref.scope != selectedPullEnvironment).concat([next])
    send wrotePullPrefs = writePullPrefs(next)
  derive scopedPullProject = catalog.projects.filter(project => project.id == pullProject and not project.isScratch and (selectedPullEnvironment == "" or selectedPullEnvironment == project.environmentId)).length > 0 ? pullProject : ""
  resource pullControls = pullControlMenu(pullState, pullInvolvement, pullDraftFilter, pullReviewFilter, pullChecksFilter, pullSort, catalog.projects, catalog.environments, selectedPullEnvironment, scopedPullProject, pullLabels.length + (pullAuthor != "" ? 1 : 0)) as shape PullControlMenu else empty()
  state pullPageIndex = 0
  state pullSearchDraft = ""
  state pullQuery = ""
  derive pullSearchText = pullSearchDraft.trim()
  task debouncePullSearch when current.name == "pullRequests" and pullSearchText != pullQuery key=pullSearchText
    after(180, applyPullSearch)
  derive pullTargets = catalog.environments.filter(env => selectedPullEnvironment == "" or env.id == selectedPullEnvironment)
  derive connectedPullTargets = savedPullPrefs.ready and environmentState.loaded ? pullTargets.filter(env => env.enabled and env.status == "Connected").map(env => env.id) : []
  derive effectivePullQuery = `${pullDraftFilter == "only" ? "draft:true " : pullDraftFilter == "hide" ? "draft:false " : ""}${pullReviewFilter == "all" ? "" : `review:${pullReviewFilter} `}${pullChecksFilter == "all" ? "" : `checks:${pullChecksFilter} `}${pullQuery}`.trim()
  resource pullRequests = loadPullRequests(pullWorkspace ? connectedPullTargets : [], pullState, pullInvolvement, effectivePullQuery, pullPageIndex, scopedPullProject, pullLabels, pullAuthor) as shape PullRequests else empty()
  resource facets = pullFacets(pullRequests.items, pullLabels, pullAuthor) as shape PullFacets else empty()
  state facetDraft = ""
  state facetSent = ""
  state facetSuggestions: PullFacetOption[] = []
  derive facetKind = current.name == "pullFilterSearch" and ["labels", "authors"].includes(current.params.kind) ? current.params.kind : ""
  derive facetTyped = facetDraft.trim().slice(0, 100)
  task debounceFacet when facetKind != "" and facetTyped != facetSent key=facetTyped
    after(250, applyFacetQuery)
  resource hostedFacets = loadFacetOptions(facetKind != "" ? connectedPullTargets : [], facetKind, facetSent, scopedPullProject) as shape HostedFacets else empty()
  derive facetSelected = facetKind == "labels" ? pullLabels : (pullAuthor != "" ? [pullAuthor] : [])
  derive facetSettled = facetTyped == facetSent and hostedFacets.query == facetSent and hostedFacets.kind == facetKind and not pending(hostedFacets)
  resource facetRows = facetSearchRows(facetSelected, facetSuggestions, facetSettled ? hostedFacets.rows : [], facetTyped) as shape PullFacetOption[] else empty()
  action editFacetQuery(value: string)
    facetDraft = value
  action applyFacetQuery
    facetSent = facetTyped
  action openFacetPicker(kind: string)
    facetDraft = ""
    facetSent = ""
    facetSuggestions = (kind == "labels" ? facets.labels.options : facets.authors.options).filter(option => option.id != "")
    nav = push(nav, path("pullFilterSearch", kind))
  action chooseFacetRow(value: string)
    if facetKind == "labels"
      let held = pullLabels.filter(label => label.toLowerCase() == value.toLowerCase())
      if held.length > 0
        editPullPrefs("labels", "", pullLabels.filter(label => label.toLowerCase() != value.toLowerCase()))
      else if pullLabels.length < 10
        editPullPrefs("labels", "", pullLabels.concat([value]))
    else if facetKind == "authors"
      editPullPrefs("author", pullAuthor.toLowerCase() == value.toLowerCase() ? "" : value, [])
      nav = back(nav)
    pullPageIndex = 0
  action labelMenuAction(id: string)
    if id == "search"
      openFacetPicker("labels")
    else if id.startsWith("value:")
      pickPullLabel(id.slice(6))
  action authorMenuAction(id: string)
    if id == "search"
      openFacetPicker("authors")
    else if id.startsWith("value:")
      pickPullAuthor(id.slice(6))
  action pickPullLabel(id: string)
    if id == ""
      editPullPrefs("labels", "", [])
    else if pullLabels.includes(id)
      editPullPrefs("labels", "", pullLabels.filter(label => label != id))
    else if pullLabels.length < 10
      editPullPrefs("labels", "", pullLabels.concat([id]))
    pullPageIndex = 0
  action pickPullAuthor(id: string)
    editPullPrefs("author", id, [])
    pullPageIndex = 0
  resource orderedPulls = orderPulls(pullRequests.items, pullSort) as shape PullRequest[] else empty()
  action choosePullControl(id: string)
    if id == "reset"
      editPullPrefs("reset", "", [])
      pullPageIndex = 0
    else if id.startsWith("project:")
      editPullPrefs("project", id.slice(8), [])
      pullPageIndex = 0
    else if ["sort:updated", "sort:created", "sort:oldest"].includes(id)
      editPullPrefs("sort", id.slice(5), [])
    else if ["draft:all", "draft:only", "draft:hide"].includes(id)
      editPullPrefs("draft", id.slice(6), [])
      pullPageIndex = 0
    else if ["review:all", "review:approved", "review:changes-requested", "review:review-required", "review:none"].includes(id)
      editPullPrefs("review", id.slice(7), [])
      pullPageIndex = 0
    else if ["checks:all", "checks:passing", "checks:failing"].includes(id)
      editPullPrefs("checks", id.slice(7), [])
      pullPageIndex = 0
  action filterPullEnvironment(id: string)
    if id == "" or environmentState.items.filter(env => env.id == id).length > 0
      pullEnvironment = id
      pullPageIndex = 0
  task resetHiddenPullPages when not pullWorkspace key=current.name
    change(resetPullPages)
  derive matchingPulls = pullRequests.items.filter(item => pullDetailRoute and (item.routeKey == current.params.project or item.projectId == current.params.project) and `${item.number}` == current.params.number)
  derive listedRefs = matchingPulls.map(item => PullRef(environmentId=item.environmentId, projectId=item.projectId, host=item.host, repository=item.repository, number=item.number, routeKey=item.routeKey))
  derive pullRefs = pullLink.length > 0 ? pullLink.filter(ref => catalog.environments.filter(env => env.id == ref.environmentId and env.enabled and env.status == "Connected").length > 0) : listedRefs
  resource pullRequestDetail = loadPullRequestDetail(pullRefs) as shape PullRequestDetail else empty()
  resource viewedFiles = loadViewedFiles(pullRefs, pullRequestDetail.viewedKey) as shape ViewedFiles else empty()
  derive viewedScope = viewedFiles.key != "" and pullRefs.filter(ref => `${ref.routeKey}:${ref.number}` == viewedFiles.key).length == 1
  resource pullRequestActivity = loadPullRequestActivity(pullRefs) as shape PullRequestActivity else empty()
  state pullFileRevision = 0
  state collapsedDiffFiles: string[] = []
  state diffJumped = ""
  task clearHiddenPullFiles when not pullDetailRoute key=current.name
    change(resetPullFiles)
  action resetPullFiles
    pullFileRevision = 0
    collapsedDiffFiles = []
    diffJumped = ""
  resource pullFiles = loadPullFiles(pullRefs, pullFileRevision) as shape PullFileList else empty()
  state hidePullTests = false persist
  derive visiblePullFiles = pullFiles.files.filter(file => not hidePullTests or not file.testFile)
  derive hiddenPullFileCount = pullFiles.files.length - visiblePullFiles.length
  state foldedPullDirectories: string[] = []
  resource pickerFiles = pullFilePickerRows(current.name == "pullFilesSheet" ? visiblePullFiles : [], foldedPullDirectories) as shape FilePickerRow[] else empty()
  action openFilePicker
    if current.name == "pullFile"
      foldedPullDirectories = []
      nav = push(nav, path("pullFilesSheet", current.params.project, current.params.number, current.params.file))
  action foldFileDirectory(directory: string)
    foldedPullDirectories = foldedPullDirectories.includes(directory) ? foldedPullDirectories.filter(item => item != directory) : foldedPullDirectories.concat([directory])
  action jumpFromFilePicker(file: string)
    if current.name == "pullFilesSheet" and visiblePullFiles.filter(item => item.path == file).length == 1
      let next = path("pullFile", current.params.project, current.params.number, file)
      collapsedDiffFiles = collapsedDiffFiles.filter(item => item != file)
      diffJumped = ""
      nav = replace(back(nav), next)
  derive visibleViewedCount = visiblePullFiles.filter(file => viewedFiles.paths.includes(file.path)).length
  action togglePullTests
    hidePullTests = not hidePullTests
  action retryPullFiles
    pullFileRevision = pullFileRevision + 1
  derive diffPath = current.name == "pullFile" or current.name == "pullFilesSheet" ? current.params.file : ""
  derive diffVisit = current.name == "pullFile" ? `${current.id}:${diffPath}` : ""
  derive diffFileFound = pullFiles.files.filter(file => file.path == diffPath).length > 0
  derive diffVisibleFiles = pullFiles.files.filter(file => not hidePullTests or not file.testFile or file.path == diffPath)
  resource diffRows = pullDiffRows(diffPath != "" ? diffVisibleFiles : [], collapsedDiffFiles) as shape PullDiffRow[] else empty()
  task fetchDiffTarget when current.name == "pullFile" and not diffFileFound and pullFiles.nextCursor != "" and pullFiles.error == "" and not pending(pullFiles) key=`${diffVisit}:${pullFiles.nextCursor}`
    after(1, retryPullFiles)
  task jumpToPullFile when current.name == "pullFile" and diffVisit != diffJumped and diffRows.filter(row => row.key == `file:${diffPath}`).length > 0 key=diffVisit
    after(1, revealPullFile)
  action revealPullFile
    scrollIntoView("pull-diff-lines", `file:${diffPath}`, block="start", behavior="instant")
    diffJumped = diffVisit
  action openPullFile(project: string, number: number, file: string)
    collapsedDiffFiles = []
    nav = push(nav, path("pullFile", project, `${number}`, file))
  action foldDiffFile(file: string)
    collapsedDiffFiles = collapsedDiffFiles.includes(file) ? collapsedDiffFiles.filter(path => path != file) : collapsedDiffFiles.concat([file])
  mutation changedViewedFile as shape ViewedChange refreshes viewedFiles then afterViewedFile
  state viewedPendingKey = ""
  state viewedPendingPath = ""
  derive viewedError = match changedViewedFile { case some(reply) => viewedScope and reply.key == viewedFiles.key ? reply.error : "", case none => "" }
  action toggleViewedFile(file: string)
    if current.name == "pullFile" and viewedScope and viewedFiles.writable and not pending(changedViewedFile) and not pending(viewedFiles) and diffVisibleFiles.filter(item => item.path == file).length == 1
      viewedPendingKey = viewedFiles.key
      viewedPendingPath = file
      send changedViewedFile = changeViewedFile(pullRefs, viewedFiles.key, viewedFiles.access, file, not viewedFiles.paths.includes(file))
  action afterViewedFile
    match changedViewedFile
      case some(reply)
        if reply.error == "" and current.name == "pullFile" and pullRefs.filter(ref => `${ref.routeKey}:${ref.number}` == reply.key).length == 1 and diffVisibleFiles.filter(item => item.path == reply.path).length == 1
          collapsedDiffFiles = reply.viewed ? collapsedDiffFiles.filter(path => path != reply.path).concat([reply.path]) : collapsedDiffFiles.filter(path => path != reply.path)
      case none
        viewedPendingKey = ""
    viewedPendingPath = ""
  resource terminalAccess = loadTerminalAccess(activeThreadId) as shape TerminalAccess else empty()
  resource terminalMenu = loadTerminalMenu(activeThreadId, threadRoute.name == "terminal" ? threadRoute.params.terminalId : "", terminalAccess.canRead, terminalAccess.canOperate, terminalClock) as shape TerminalMenu else empty()
  resource terminal = loadTerminal(activeThreadId, threadRoute.name == "terminal" ? threadRoute.params.terminalId : "", terminalAccess.canRead, terminalAccess.canOperate, terminalClock) as shape TerminalView else empty()
  derive terminalHost = terminalHostPlatform(catalog, activeThreadId)
  state statusNow = 0
  state threadListClock = 0
  derive floatingStatus = match first(workingStatus) { case some(status) => status, case none => WorkingStatus(kind="", label="", symbol="", indicator="none", action="none", actionLabel="", actionPendingLabel="", ticking=false) }
  resource workingStatus = loadThreadStatus(activeThreadId, catalog, stopBusy, statusNow) with time.epochAtZero + statusNow as shape WorkingStatus[] else empty()
  task tickThreadStatus when workingStatus.filter(status => status.ticking).length > 0 key=`${activeThreadId}:${statusNow}`
    after(1000, updateStatusClock)
  action updateStatusClock
    statusNow = performanceNow()
  task tickTerminal when visibleTab == "threads" and (threadRoute.name == "thread" or threadRoute.name == "terminal") key=`${activeThreadId}:${threadRoute.name}:${terminalClock}`
    after(500, updateTerminalClock)
  action updateTerminalClock
    terminalClock = performanceNow()
  task leaveExitedTerminal when threadRoute.name == "terminal" and terminal.status == "exited" and terminal.updatedAt != "" key=`${activeThreadId}:${threadRoute.params.terminalId}:${terminal.updatedAt}`
    after(1, closeTerminal)
  action decreaseTerminalFont
    terminalFontSize = max(6, terminalFontSize - 0.5)
  action increaseTerminalFont
    terminalFontSize = min(14, terminalFontSize + 0.5)
  action toggleTerminalModifier(modifier: string)
    terminalModifier = terminalModifier == modifier ? "" : modifier
  mutation regrouped as shape NavigationChange then afterRegroup
  mutation changed as shape Reply refreshes environmentState, catalog
  mutation sent as shape SendReply then afterSend
  mutation paired as shape Reply refreshes environmentState, catalog then afterPair
  mutation savedEnvironment as shape Reply refreshes environmentState, catalog then afterEnvironmentSave
  mutation removed as shape Reply refreshes environmentState, catalog then afterEnvironmentRemove
  mutation inspected as shape Inspection
  state terminalInput = ""
  state terminalLaunchThreadId = ""
  mutation terminalWritten as shape Reply queue
  mutation terminalCleared as shape Reply queue
  mutation terminalScriptStarted as shape TerminalLaunchReply then afterTerminalScript
  mutation lifecycleChanged as shape Reply refreshes catalog
  state pinTargetId = ""
  state copyTargetId = ""
  state pinTargetKey = ""
  state pinTargetDesired = false
  state renameId = ""
  state renameKey = ""
  state renameOriginal = ""
  state renameDraft = ""
  state titleActionError = ""
  mutation titleUpdated as shape Reply then afterTitleUpdate
  action afterTitleUpdate
    match titleUpdated
      case some(reply)
        if not reply.ok
          taskAlertTitle = titleActionError
          taskAlertBody = reply.error
          showModal("task-alert")
      case none
        titleActionError = ""
  action beginRename(title: string)
    hidePopover("thread-row-menu")
    hidePopover("thread-more-menu")
    renameId = pinTargetId
    renameKey = pinTargetKey
    renameOriginal = title
    renameDraft = title
    showModal("rename-thread")
  action editRename(value: string)
    renameDraft = value
  action confirmRename
    if renameDraft.trim() == ""
      taskAlertTitle = "Could not rename thread"
      taskAlertBody = "Thread title cannot be empty."
      showModal("task-alert")
    else if renameDraft.trim() != renameOriginal and not pending(titleUpdated)
      haptic("selection")
      titleActionError = "Could not rename thread"
      send titleUpdated = updateRowTitle(renameId, renameKey, renameOriginal, renameDraft, false)
  action regenerateTitle
    hidePopover("thread-row-menu")
    hidePopover("thread-more-menu")
    if not pending(titleUpdated)
      haptic("selection")
      titleActionError = "Could not regenerate title"
      send titleUpdated = updateRowTitle(pinTargetId, pinTargetKey, "", "", true)
  state rowMenuOpened = 0
  mutation autoSettleUpdated as shape Reply then afterAutoSettle
  action afterAutoSettle
    match autoSettleUpdated
      case some(reply)
        if not reply.ok
          taskAlertTitle = "Could not update auto-settle"
          taskAlertBody = reply.error
          showModal("task-alert")
      case none
        taskAlertBody = ""
  action selectAutoSettle(enabled: bool)
    hidePopover("auto-settle-menu")
    hidePopover("thread-more-menu")
    hidePopover("thread-row-menu")
    if not pending(autoSettleUpdated)
      haptic("selection")
      send autoSettleUpdated = setRowAutoSettle(pinTargetId, pinTargetKey, enabled)
  state customThread = ""
  state customKey = ""
  state customOpened = 0
  state customMode = "date"
  state customField = ""
  state customEdited = false
  state customAmount = "2"
  state customUnit = "hours"
  state customError = ""
  resource customStart = customSnoozeStart(customOpened) as shape CustomSnoozeStart else empty()
  mutation customSubmitted as shape UndoableReply then afterCustomSnooze
  action beginCustomSnooze
    customThread = pinTargetId
    customKey = pinTargetKey
    customOpened = time.epochAtZero + performanceNow()
    customMode = "date"
    customEdited = false
    customAmount = "2"
    customUnit = "hours"
    customError = ""
  action editCustomMode(value: string)
    customMode = value
    customError = ""
  action editCustomField(value: string)
    customEdited = true
    customField = value
    customError = ""
  action editCustomAmount(value: string)
    customAmount = value
    customError = ""
  action editCustomUnit(value: string)
    customUnit = value
    customError = ""
  action submitCustomSnooze
    if customKey != "" and not pending(customSubmitted)
      send customSubmitted = setCustomSnooze(customThread, customKey, customMode, customEdited ? customField : customStart.field, customAmount, customUnit, time.epochAtZero + performanceNow())
  action afterCustomSnooze
    match customSubmitted
      case some(reply)
        customError = reply.error
        if reply.ok
          haptic("selection")
          hidePopover("custom-snooze")
          hidePopover("row-snooze-menu")
          hidePopover("thread-row-menu")
          offerUndo("snooze", customThread, customKey, reply.undo)
          customKey = ""
      case none
        customError = ""
  resource rowSnooze = loadRowSnooze(pinTargetId, pinTargetKey, rowMenuOpened) as shape RowSnoozeMenu else empty()
  mutation rowSnoozed as shape UndoableReply then afterRowSnooze
  action submitRowSnooze(choice: string)
    hidePopover("row-snooze-menu")
    hidePopover("thread-row-menu")
    if rowSnooze.available and not pending(rowSnoozed) and not pending(pinChanged)
      haptic("selection")
      if pinTargetId == undoThreadId
        undoReceipt = ""
      send rowSnoozed = setRowSnooze(pinTargetId, pinTargetKey, choice, rowMenuOpened, time.epochAtZero + performanceNow())
  action afterRowSnooze
    match rowSnoozed
      case some(reply)
        if not reply.ok
          taskAlertTitle = "Could not update snooze"
          taskAlertBody = reply.error
          showModal("task-alert")
        else if reply.undo != ""
          offerUndo("snooze", pinTargetId, pinTargetKey, reply.undo)
        pinTargetId = ""
        pinTargetKey = ""
      case none
        rowMenuOpened = 0
  state undoReceipt = ""
  state undoKind = "unpin"
  state undoThreadId = ""
  state undoAccessKey = ""
  state undoingPin = false
  resource undoViewport = exactViewport() as shape UndoViewport
  mutation snoozeRestored as shape Reply then afterSnoozeRestored
  action afterSnoozeRestored
    match snoozeRestored
      case some(reply)
        if not reply.ok
          taskAlertTitle = "Could not restore snooze"
          taskAlertBody = reply.error
          showModal("task-alert")
      case none
        undoingPin = false
  mutation pinChanged as shape UndoableReply then afterPinChange
  state settlementId = ""
  state settlementKey = ""
  state settlementMode = ""
  mutation settlementChanged as shape UndoableReply then afterSettlement
  action changeRowSettlementState(id: string, key: string, mode: string, receipt: string)
    hidePopover("thread-row-menu")
    if key != "" and not pending(settlementChanged) and not pending(pinChanged) and not pending(rowSnoozed)
      settlementId = id
      settlementKey = key
      settlementMode = mode
      if undoThreadId == id
        undoReceipt = ""
      if mode != "undo"
        haptic("selection")
      send settlementChanged = changeRowSettlement(id, key, mode == "settle", receipt, time.epochAtZero + performanceNow())
  action afterSettlement
    match settlementChanged
      case some(reply)
        if not reply.ok
          taskAlertTitle = settlementMode == "undo" ? "Could not undo settle" : settlementMode == "settle" ? "Could not settle thread" : "Could not un-settle thread"
          taskAlertBody = reply.error
          showModal("task-alert")
        else if reply.undo != ""
          if settlementMode == "undo"
            send snoozeRestored = finishPinUndo(settlementId, reply.undo, time.epochAtZero + performanceNow())
          else
            offerUndo("settle", settlementId, settlementKey, reply.undo)
      case none
        settlementMode = ""
  mutation snoozeUndone as shape Reply then afterUndoSnooze
  action afterUndoSnooze
    match snoozeUndone
      case some(reply)
        if not reply.ok
          taskAlertTitle = "Could not undo snooze"
          taskAlertBody = reply.error
          showModal("task-alert")
      case none
        undoReceipt = ""
  action offerUndo(kind: string, id: string, key: string, receipt: string)
    undoKind = kind
    undoThreadId = id
    undoAccessKey = key
    undoReceipt = receipt
  action dismissPinUndo
    undoReceipt = ""
  task pinUndoExpiry when undoReceipt != "" key=undoReceipt
    after(5000, dismissPinUndo)
  action restoreThreadAction
    if undoReceipt != "" and not pending(pinChanged) and not pending(snoozeUndone) and not pending(settlementChanged) and not pending(rowSnoozed)
      let receipt = undoReceipt
      haptic("selection")
      undoReceipt = ""
      if undoKind == "snooze"
        send snoozeUndone = undoRowSnooze(undoThreadId, undoAccessKey, receipt, time.epochAtZero + performanceNow())
      else if undoKind == "settle"
        changeRowSettlementState(undoThreadId, undoAccessKey, "undo", receipt)
      else
        undoingPin = true
        send pinChanged = setThreadPin(undoThreadId, undoAccessKey, true, receipt)
  action aimPin(id: string, key: string, desired: bool)
    copyTargetId = id
    if not pending(pinChanged) and not pending(rowSnoozed)
      rowMenuOpened = time.epochAtZero + performanceNow()
      pinTargetId = id
      pinTargetKey = key
      pinTargetDesired = desired
  action copyRowId(value: string)
    copyText(value)
    haptic("impact-light")
  action changePin
    hidePopover("thread-row-menu")
    if not pending(pinChanged) and not pending(rowSnoozed) and pinTargetId != "" and pinTargetKey != ""
      haptic("selection")
      undoingPin = false
      if pinTargetId == undoThreadId or not pinTargetDesired
        undoReceipt = ""
      send pinChanged = setThreadPin(pinTargetId, pinTargetKey, pinTargetDesired, "")
  action afterPinChange
    match pinChanged
      case some(reply)
        if not reply.ok
          taskAlertTitle = undoingPin ? "Could not undo unpin" : pinTargetDesired ? "Could not pin thread" : "Could not unpin thread"
          taskAlertBody = reply.error
          showModal("task-alert")
        else if undoingPin and reply.undo != ""
          send snoozeRestored = finishPinUndo(undoThreadId, reply.undo, time.epochAtZero + performanceNow())
        else if reply.undo != ""
          offerUndo("unpin", pinTargetId, pinTargetKey, reply.undo)
        pinTargetId = ""
        pinTargetKey = ""
      case none
        pinTargetId = ""
  state lifecycleThreadId = ""
  derive lifecycleBusy = pending(lifecycleChanged) and lifecycleThreadId == activeThreadId
  derive lifecycleError = match lifecycleChanged { case some(reply) => lifecycleThreadId == activeThreadId ? reply.error : "", case none => "" }
  mutation visited as shape Reply queue
  mutation earlierHistory as shape Reply refreshes catalog
  mutation pulled as shape Reply refreshes gitStatus, gitOperation then afterGitAction
  mutation gitRefChanged as shape Reply refreshes gitRefs, gitStatus, gitOperation
  mutation gitBranchCreated as shape Reply refreshes gitRefs, gitStatus, gitOperation
  mutation gitWorktreeCreated as shape Reply refreshes gitRefs, gitStatus, gitOperation, catalog
  mutation gitActionResult as shape GitActionReply refreshes gitStatus, gitOperation, pullRequests then afterGitAction
  derive historyError = failed(earlierHistory) ? "Earlier messages could not be loaded." : match earlierHistory { case some(reply) => reply.error, case none => "" }
  derive environmentError = failed(savedEnvironment) ? "The environment could not be updated." : match savedEnvironment { case some(reply) => reply.error, case none => "" }
  derive changeError = failed(changed) ? "The connection could not be changed." : match changed { case some(reply) => reply.error, case none => "" }
  derive removeError = failed(removed) ? "The environment could not be removed." : match removed { case some(reply) => reply.error, case none => "" }
  derive pairError = match paired { case some(reply) => reply.error, case none => "" }
  derive sendError = failed(sent) ? "The message could not be sent. Try again." : match sent { case some(reply) => reply.error, case none => "" }
  derive current = top(nav)
  derive currentPullDetail = pullRefs.filter(ref => `${ref.routeKey}:${ref.number}` == pullRequestDetail.key).length == 1
  state pullSectionVisit = ""
  state chosenPullSection = "Overview"
  derive visiblePullSection = current.name == "pullRequest" and pullSectionVisit == `${current.id}:${current.params.project}:${current.params.number}` ? chosenPullSection : "Overview"
  action choosePullSection(section: string)
    if current.name == "pullRequest" and ["Overview", "Activity"].includes(section)
      pullSectionVisit = `${current.id}:${current.params.project}:${current.params.number}`
      chosenPullSection = section
  derive selectedPullRequest = first(currentPullDetail and pullRequestDetail.items.length == 1 ? pullRequestDetail.items : matchingPulls.length == 1 ? matchingPulls : [])
  derive duoFolded = device.kind == "duo-folded"
  derive duoDevice = duoFolded or device.kind == "duo-unfolded"
  derive split = device.split
  derive threadNav = nav.tab == "threadDetail" ? nav : select(nav, "threadDetail")
  derive settingsNav = nav.tab == "settingsDetail" ? nav : select(nav, "settingsDetail")
  derive visibleTab = nav.tab == "threadDetail" ? "threads" : nav.tab == "settingsDetail" ? "settings" : nav.tab
  derive threadRoute = split ? top(threadNav) : current
  derive activeComposerId = visibleTab == "threads" and threadRoute.url.startsWith("/threads/") ? threadRoute.params.id : ""
  derive activeDraftKey = isDraftKey(activeComposerId) ? activeComposerId : ""
  derive activeThreadId = activeDraftKey != "" or launching(allDrafts, activeComposerId) ? "" : activeComposerId
  derive attachmentThreadId = activeDraftKey != "" ? (newTask.key == activeDraftKey and newTask.environmentId != "" ? `${encodeURIComponent(newTask.environmentId)}:${activeDraftKey}` : "") : activeThreadId
  derive activeToolThreadId = visibleTab == "threads" and threadRoute.name == "thread" ? threadRoute.params.id : ""
  derive toolViewKey = threadToolViewKey(selectedThread(catalog, activeToolThreadId))
  derive toolRequests = wantedTools(threadFeed(selectedThread(catalog, activeToolThreadId)), expandedTools, activeToolThreadId)
  derive codeRevision = match first(selectedThread(catalog, activeToolThreadId)) { case some(thread) => thread.markdownRevision, case none => 0 }
  derive blockCandidates = observedBlocks.filter(ref => ref.threadId == activeToolThreadId and ref.viewKey == toolViewKey)
  derive reasoningBlocks = toolPanels.panels.map(panel => panel.blocks).flat()
  resource tableLayouts = loadTableLayouts(activeToolThreadId, toolViewKey, codeRevision, blockCandidates, reasoningBlocks) as shape TableBatch else empty()
  resource codeHighlights = loadCodeHighlights(activeToolThreadId, toolViewKey, codeRevision, blockCandidates, reasoningBlocks) as shape CodeBatch else empty()
  resource toolPanels = loadToolPanels(activeToolThreadId, toolViewKey, toolRequests, toolImageClock) with time.epochAtZero + toolImageNow as shape ToolBatch else empty()
  derive visitShell = match first(selectedThread(catalog, activeThreadId)) { case some(thread) => thread.visit, case none => VisitMetadata(ready=false, supported=false, at="", watermark=-1, seen=-1, urgent=false) }
  derive atRoot = current.name == "threads" or current.name == "pullRequests" or current.name == "usage" or current.name == "settings"
  derive needsRegroup = split ? nav.tab == "threads" or nav.tab == "settings" or depth(select(nav, "threads")) > 1 or depth(select(nav, "settings")) > 1 : nav.tab == "threadDetail" or nav.tab == "settingsDetail" or depth(threadNav) > 1 or depth(settingsNav) > 1
  derive searchText = query.trim().slice(0, 200).trim()
  derive searchHosts = (current.name == "threads" or (split and visibleTab == "threads" and not sidebarHidden)) and searchText.length >= 2 and searchText == messageQuery ? catalog.environments.filter(host => host.enabled and host.status == "Connected" and (selectedEnvironment == "" or host.id == selectedEnvironment) and (selectedProject == "" or catalog.projects.filter(project => project.id == selectedProject and project.environmentId == host.id).length > 0)).map(host => host.id) : []
  resource messageResults = searchMessages(host, messageQuery, selectedProject) for host in searchHosts key=host as shape SearchReply transient
  derive searchHits = messageResults.filter(reply => reply.query == searchText).map(reply => reply.hits).flat()
  derive visibleThreads = filteredThreads(catalog.threads, selectedEnvironment, searchText.toLowerCase(), searchHits).filter(thread => selectedProject == "" or thread.projectId == selectedProject)
  derive agesVisible = (current.name == "threads" or (split and visibleTab == "threads" and not sidebarHidden)) and visibleThreads.filter(thread => thread.wakeAt > time.epochAtZero or (thread.settled ? showSettled or searchText != "" or (split and thread.id == activeThreadId) : thread.status == "" and (thread.pinRank >= 0 or not thread.working or showWorking or searchText != "" or (split and thread.id == activeThreadId)))).length > 0
  derive listClockVisible = agesVisible or (current.name == "pullRequests" and pullRequests.items.length > 0) or (current.name == "pullRequest" and pullRefs.length == 1)
  task startThreadListClock when listClockVisible key=listClockVisible
    change(sampleThreadListClock)
  task tickThreadListClock when listClockVisible
    every(60000, sampleThreadListClock)
  derive nearWake = visibleThreads.filter(thread => thread.wakeAt > time.epochAtZero + threadListClock and thread.wakeAt <= time.epochAtZero + threadListClock + 60000).length > 0
  task tickImminentWake when agesVisible and nearWake
    every(1000, sampleThreadListClock)
  action sampleThreadListClock
    threadListClock = performanceNow()
  task debounceThreadSearch when searchText != messageQuery key=searchText
    after(120, startMessageSearch)
  derive catalogLoading = not environmentState.loaded or pending(environmentState) or pending(catalog) or catalog.environments.filter(environment => environment.enabled and (environment.status == "Disconnected" or environment.status == "Connecting" or environment.status == "Reconnecting")).length > 0
  derive selectedProjectLabel = match first(catalog.projects.filter(project => project.id == selectedProject)) { case some(project) => project.title, case none => "All projects" }
  derive composer = activeDraft.text
  derive composerExpanded = composer != "" and (composer.includes("\n") or composerWide)
  derive activeModelRevision = match first(selectedThread(catalog, activeThreadId)) { case some(thread) => thread.modelRevision, case none => "" }
  derive composerError = match sent { case some(reply) => reply.id == activeThreadId and not pending(sent) ? reply.error : "", case none => "" }
  derive composerBlockedReason = activeDraftKey != "" ? (newTask.key == activeDraftKey ? newTask.sendBlockedReason : "") : activeComposerId != "" and activeThreadId == "" ? "Starting the thread…" : ""
  derive canSend = not composerImportBusy and not pending(composerAttachmentsInserted) and not pending(stagedAttachments) and draftsReady and modelDraftsReady and (composer.trim() != "" or composerAttachments.length > 0) and attachmentSendReady and not composerVoiceBusy and pendingMessage == none and not pending(sent) and not pending(preparedSend) and composerBlockedReason == "" and (activeDraftKey == "" or (newTask.key == activeDraftKey and newTask.phase == "ready"))
  derive gitWritable = not gitReadOnly and gitStatus.canWrite
  derive gitBusy = pending(gitActionResult) or pending(pulled) or pending(gitRefChanged) or pending(gitBranchCreated) or pending(gitWorktreeCreated) or gitOperation.status == "running"
  derive gitError = match gitActionResult { case some(reply) => reply.error, case none => match pulled { case some(reply) => reply.error, case none => match gitRefChanged { case some(reply) => reply.error, case none => match gitBranchCreated { case some(reply) => reply.error, case none => match gitWorktreeCreated { case some(reply) => reply.error, case none => gitOperation.error } } } } }
  derive activeThreadHasMessage = threadFeed(selectedThread(catalog, activeThreadId)).filter(row => row.message != none).length > 0
  derive selectedGitFiles = gitStatus.workingFiles.filter(file => not gitExcludedFiles.includes(file.path))
  derive selectedGitInsertions = sum(selectedGitFiles.map(file => file.insertions))
  derive selectedGitDeletions = sum(selectedGitFiles.map(file => file.deletions))

  task visitObservation key=`${activeThreadId}:${visitShell.ready}:${visitShell.supported}:${visitShell.at}:${visitShell.watermark}:${visitShell.seen}:${visitShell.urgent}`
    after(1, observeVisit)

  task visitCooldown when activeThreadId != "" and activeThreadId == visitTracker.id and visitTracker.cooling key=visitTracker.serial
    after(10000, releaseVisit)

  action observeVisit
    evaluateVisit(false)

  action releaseVisit
    evaluateVisit(true)

  action evaluateVisit(expired: bool)
    let changedThread = visitTracker.id != activeThreadId
    let openedAt = match first(threadOpens.filter(entry => entry.id == activeThreadId)) { case some(entry) => entry.at, case none => -600000 }
    let opened = changedThread and activeThreadId != "" and performanceNow() - openedAt >= 600000
    let next = changedThread ? VisitTracker(id=activeThreadId, openPending=opened, watermark=-1, cooling=false, serial=visitTracker.serial) : VisitTracker(visitTracker, cooling=expired ? false : visitTracker.cooling)
    if opened
      threadOpens = threadOpens.filter(entry => entry.id != activeThreadId).concat([ThreadOpen(id=activeThreadId, at=performanceNow())])
    if activeThreadId == "" or not visitShell.ready or not visitShell.supported
      visitTracker = next
    else if next.openPending
      visitTracker = VisitTracker(next, openPending=false, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, true)
    else if visitShell.seen >= visitShell.watermark
      visitTracker = VisitTracker(next, watermark=max(next.watermark, visitShell.watermark))
    else if visitShell.watermark > next.watermark and (visitShell.urgent or not next.cooling)
      visitTracker = VisitTracker(next, watermark=visitShell.watermark, cooling=true, serial=next.serial + 1)
      send visited = visitThread(activeThreadId, visitShell.at, false)
    else
      visitTracker = next

  action loadEarlier(id: string)
    loadingHistoryId = id
    send earlierHistory = loadEarlierThread(id)

  action preserveThreadDisclosure(threadId: string, rowId: string)
    if threadId == activeThreadId
      let savedScroll = threadScroll.scope == threadScrollScope ? threadScroll : ThreadScrollPosition(scope=threadScrollScope, following=true, away=false, key=none, offset=0)
      let visibleIds = threadRows(selectedThread(catalog, threadId), expandedTools, threadId).map(item => match item { case some(row) => row.id, case none => "history" })
      let savedKey = match savedScroll.key { case some(key) => visibleIds.includes(key) ? some(key) : visibleIds.includes(`${key}:group`) ? some(`${key}:group`) : none, case none => none }
      threadScroll = ThreadScrollPosition(savedScroll, following=false, key=savedKey)
      threadScrollRevision = threadScrollRevision + 1
      match savedKey
        case some(key)
          scrollIntoView("thread-messages", key, offset=savedScroll.offset, behavior="instant")
        case none
          let anchor = match first(threadFeed(selectedThread(catalog, threadId)).filter(row => row.id == rowId or (match row.activity { case some(tool) => tool.groupedIds.includes(rowId), case none => false }))) { case some(row) => row.id, case none => rowId }
          let port = frame("thread-messages")
          let row = frame(`thread-tool-${anchor}`)
          if not port.unavailable and not row.unavailable and not port.provisional and not row.provisional
            scrollIntoView("thread-messages", anchor, offset=port.y - row.y, behavior="instant")

  action scrollToEnd
    // Hide the island for the requested jump. The scroll observer keeps it
    // hidden through intermediate frames and restores it if both attempts
    // settle away from the end.
    threadScrollEndPending = true
    threadScrollEndRetried = false
    threadScrollEndPendingScope = threadScrollScope
    // Let the native smooth jump own the offset. Following the end here would
    // snap the virtualized list before the requested animation can run.
    threadScroll = ThreadScrollPosition(scope=threadScrollScope, following=false, away=false, key=none, offset=0)
    threadScrollRevision = threadScrollRevision + 1
    let lastRow = match threadRows(selectedThread(catalog, activeThreadId), expandedTools, activeThreadId).map(item => match item { case some(row) => row.id, case none => "history" }).at(-1) { case some(key) => key, case none => "history" }
    scrollIntoView("thread-messages", lastRow, block="end", behavior="smooth")

  action retryScrollToEnd
    threadScrollEndRetried = true
    threadScrollEndPendingScope = threadScrollScope
    threadScroll = ThreadScrollPosition(scope=threadScrollScope, following=false, away=false, key=none, offset=0)
    threadScrollRevision = threadScrollRevision + 1
    let lastRow = match threadRows(selectedThread(catalog, activeThreadId), expandedTools, activeThreadId).map(item => match item { case some(row) => row.id, case none => "history" }).at(-1) { case some(key) => key, case none => "history" }
    scrollIntoView("thread-messages", lastRow, block="end", behavior="smooth")

  action toggleTool(threadId: string, rowId: string)
    preserveThreadDisclosure(threadId, rowId)
    let inheritedParents = threadFeed(selectedThread(catalog, threadId)).filter(row => row.id != rowId and (match row.activity { case some(tool) => tool.groupedIds.includes(rowId), case none => false }) and toolAttempt(expandedTools, threadId, row.id) >= 0 and expandedTools.filter(entry => entry.threadId == threadId and entry.rowId == row.id).length == 0).map(row => ToolExpansion(threadId=threadId, rowId=row.id, attempt=toolAttempt(expandedTools, threadId, row.id)))
    let retained = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId).concat(inheritedParents)
    if toolAttempt(expandedTools, threadId, rowId) >= 0
      expandedTools = rowId.endsWith(":group") ? retained.concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=-1)]) : retained
    else
      let attempt = toolAttemptSerial + 1
      toolAttemptSerial = attempt
      expandedTools = retained.concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  action openTurnReview(threadId: string, turnCount: number)
    cancelForkNavigation()
    clearForceStopDialogs()
    nav = push(nav, path("turnReview", threadId, `${turnCount}`))

  action retryTurnReview
    reviewRetry = reviewRetry + 1

  action retryTool(threadId: string, rowId: string)
    let attempt = toolAttemptSerial + 1
    toolAttemptSerial = attempt
    expandedTools = expandedTools.filter(entry => entry.threadId != threadId or entry.rowId != rowId).concat([ToolExpansion(threadId=threadId, rowId=rowId, attempt=attempt)])

  action workingIslandAction(value: string)
    if value == "scroll"
      scrollToEnd()
    else if value == "force-stop"
      confirmForceStop()
    else if value == "reconnect"
      reconnectEnvironment(currentThreadEnvironment(selectedThread(catalog, activeThreadId)))
    else if value == floatingStatus.action and controlsAllowed and not pending(lifecycleChanged)
      lifecycleThreadId = activeThreadId
      send lifecycleChanged = updateThreadLifecycle(activeThreadId, threadControls.accessKey, value, time.epochAtZero + performanceNow())

  task defaultSettings when split and current.name == "settingsDetail" key=current.id
    after(1, openEnvironments)

  task reconciledModels when modelDraftsReady and catalog.modelDraftRevision > 0 key=catalog.modelDraftRevision
    after(1, persistReconciledModels)

  action observeBlock(threadId: string, viewKey: string, messageId: string, blockId: string, kind: string, event: IntersectionObserverEntry)
    if threadId == activeToolThreadId and viewKey == toolViewKey
      let retained = observedBlocks.filter(ref => ref.threadId == threadId and ref.viewKey == viewKey and not (ref.messageId == messageId and ref.blockId == blockId))
      if event.isIntersecting
        observedBlocks = retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-64)
      else if kind != "table"
        observedBlocks = retained

  action toggleCodeWrap(threadId: string, viewKey: string, messageId: string, blockId: string)
    let retained = wrappedCodes.filter(ref => ref.threadId != threadId or ref.viewKey == viewKey)
    let exists = retained.filter(ref => ref.threadId == threadId and ref.messageId == messageId and ref.blockId == blockId).length > 0
    wrappedCodes = exists ? retained.filter(ref => ref.threadId != threadId or ref.messageId != messageId or ref.blockId != blockId) : retained.concat([BlockRef(threadId=threadId, viewKey=viewKey, messageId=messageId, blockId=blockId)]).slice(-256)

  action followMarkdownLink(threadId: string, href: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    send markdownLink = resolveMarkdownLink(threadId, href, `${threadRoute.id}`, threadId == activeDraftKey ? newTask.environmentId : "", threadId == activeDraftKey ? newTask.cwd : "")

  action afterMarkdownLink
    match markdownLink
      case some(link)
        if link.originThreadId == activeComposerId and link.originRoute == `${threadRoute.id}` and link.error == ""
          let destinationNav = threadRoute.name == "composerContext" ? back(split ? threadNav : nav) : (split ? threadNav : nav)
          if link.kind == "thread"
            nav = push(destinationNav, path("thread", link.threadId))
          else if link.kind == "file"
            nav = push(destinationNav, path("linkedFile", link.threadId, link.path, `${link.line}`, `${link.column}`))
      case none
        nav = nav

  task linkedFilePosition when threadRoute.name == "linkedFile" and not pending(linkedFile) and linkedFile.path == threadRoute.params.file and linkedFile.error == "" key=`${threadRoute.id}:${linkedFile.path}:${linkedFile.lines.length}`
    after(1, revealFileLine)

  action revealFileLine
    if threadRoute.name == "linkedFile" and threadRoute.params.line != "0"
      scrollIntoView("linked-file-lines", linkedFile.targetLine, block="center")

  action persistReconciledModels
    send persistedModelSettings = persistModelSettings()

  task inspector when current.name == "inspector" and (selectedThread(catalog, current.params.id).length > 0 or (isDraftKey(current.params.id) and newTask.cwd != "")) key=`${current.id}:${current.params.kind}:${inspectorPath}:${newTask.cwd}`
    after(1, loadInspector)

  action openModelSettings
    cancelForkNavigation()
    clearForceStopDialogs()
    let id = activeComposerId
    favoriteChanged = none
    settingsUpdated = none
    settingsClosed = none
    settingsThreadId = id
    modelQuery = ""
    modelProviderFilter = ""
    showLegacyModels = false
    modelExpansionOverrides = []
    send settingsOpened = beginSettings(id, newTask.environmentId, newTask.projectId)
  action afterSettingsOpen
    if match settingsOpened { case some(reply) => reply.ok, case none => false }
      nav = push(split ? threadNav : nav, path("threadSettings", settingsThreadId))
  action cancelModelSettings
    send settingsClosed = closeSettings(settingsThreadId, false, newTask.environmentId, newTask.projectId)
  action saveModelSettings
    send settingsClosed = closeSettings(settingsThreadId, true, newTask.environmentId, newTask.projectId)
  action afterSettingsClose
    if match settingsClosed { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      nav = go(nav, path("thread", settingsThreadId))
      settingsThreadId = ""
  action searchModels(value: string)
    modelQuery = value
  action filterModelProvider(id: string)
    modelProviderFilter = id
  action toggleLegacyModels
    showLegacyModels = not showLegacyModels
  action toggleModelGroup(id: string)
    modelExpansionOverrides = modelExpansionOverrides.includes(id) ? modelExpansionOverrides.filter(value => value != id) : modelExpansionOverrides.concat([id])
  action toggleModelFavorite(id: string, favorite: bool)
    send favoriteChanged = setModelFavorite(settingsThreadId, id, favorite, newTask.environmentId)
  action selectSettingsModel(id: string)
    send settingsUpdated = changeSettings(settingsThreadId, "model", id, "", newTask.environmentId, newTask.projectId)
  action toggleSettingsOption(id: string, value: bool)
    send settingsUpdated = changeSettings(settingsThreadId, "option", id, value ? "true" : "false", newTask.environmentId, newTask.projectId)
  action openSettingChoice(kind: string, option: string)
    nav = push(nav, path("settingChoice", settingsThreadId, kind, option))

  action chooseSetting(kind: string, id: string, value: string)
    send settingsUpdated = changeSettings(settingsThreadId, kind, id, value, newTask.environmentId, newTask.projectId)
  action afterSettingsUpdate
    if match settingsUpdated { case some(reply) => reply.ok, case none => false }
      send persistedModelSettings = persistModelSettings()
      if top(nav).name == "settingChoice"
        nav = back(nav)


  action loadInspector
    send inspected = inspectThread(current.params.id, current.params.kind, inspectorPath, newTask.environmentId, newTask.cwd)

  action openTerminal(id: string, terminalId: string)
    let base = split ? threadNav : nav
    nav = threadRoute.name == "terminal" ? replace(base, path("terminal", id, terminalId)) : push(base, path("terminal", id, terminalId))

  action openNewTerminal(id: string)
    let next = nextTerminalId(terminalMenu.sessions, threadRoute.name == "terminal" ? threadRoute.params.terminalId : "")
    let base = split ? threadNav : nav
    nav = threadRoute.name == "terminal" ? replace(base, path("terminal", id, next)) : push(base, path("terminal", id, next))

  action closeTerminal
    nav = back(nav)

  action editTerminalInput(value: string)
    terminalInput = value

  task resetTerminalInput when visibleTab == "threads" key=`${activeThreadId}:${threadRoute.name}:${threadRoute.name == "terminal" ? threadRoute.params.terminalId : ""}`
    after(1, clearTerminalInput)
  action clearTerminalInput
    terminalInput = ""
    terminalModifier = ""
    terminalKeyboardVisible = false

  action focusTerminal
    terminalKeyboardVisible = true

  action terminalFocused
    terminalKeyboardVisible = true

  action terminalBlurred
    terminalKeyboardVisible = false

  task focusTerminalInputLater when terminalKeyboardVisible and threadRoute.name == "terminal" key=`${activeThreadId}:${threadRoute.params.terminalId}:${terminalKeyboardVisible}`
    after(1, focusTerminalInput)
  action focusTerminalInput
    focus("terminal-input")

  action sendTerminalInput
    if terminalInput != "" and threadRoute.name == "terminal"
      send terminalWritten = writeTerminal(threadRoute.params.id, threadRoute.params.terminalId, `${terminalInput}\u{000D}`)
      terminalInput = ""

  action sendTerminalControl(data: string)
    if threadRoute.name == "terminal"
      let modified = terminalModifier == "ctrl" and data == "c" ? "\u{0003}" : terminalModifier == "ctrl" and data == "d" ? "\u{0004}" : terminalModifier == "ctrl" and data == "\u{001B}[A" ? "\u{001B}[1;5A" : terminalModifier == "ctrl" and data == "\u{001B}[B" ? "\u{001B}[1;5B" : terminalModifier == "ctrl" and data == "\u{001B}[C" ? "\u{001B}[1;5C" : terminalModifier == "ctrl" and data == "\u{001B}[D" ? "\u{001B}[1;5D" : terminalModifier == "meta" and data == "\u{001B}[A" ? "\u{001B}[1;3A" : terminalModifier == "meta" and data == "\u{001B}[B" ? "\u{001B}[1;3B" : terminalModifier == "meta" and data == "\u{001B}[C" ? "\u{001B}[1;3C" : terminalModifier == "meta" and data == "\u{001B}[D" ? "\u{001B}[1;3D" : terminalModifier == "meta" ? `\u{001B}${data}` : data
      send terminalWritten = writeTerminal(threadRoute.params.id, threadRoute.params.terminalId, modified)
      terminalModifier = ""

  action terminalKey(key: string, e: KeyboardEvent)
    if key == "Enter" and not e.shiftKey and not e.altKey
      sendTerminalInput()
      preventDefault()
    else if key == "ArrowUp"
      sendTerminalControl(e.ctrlKey ? "\u{001B}[1;5A" : e.altKey or e.metaKey ? "\u{001B}[1;3A" : "\u{001B}[A")
      preventDefault()
    else if key == "ArrowDown"
      sendTerminalControl(e.ctrlKey ? "\u{001B}[1;5B" : e.altKey or e.metaKey ? "\u{001B}[1;3B" : "\u{001B}[B")
      preventDefault()
    else if key == "ArrowLeft"
      sendTerminalControl(e.ctrlKey ? "\u{001B}[1;5D" : e.altKey or e.metaKey ? "\u{001B}[1;3D" : "\u{001B}[D")
      preventDefault()
    else if key == "ArrowRight"
      sendTerminalControl(e.ctrlKey ? "\u{001B}[1;5C" : e.altKey or e.metaKey ? "\u{001B}[1;3C" : "\u{001B}[C")
      preventDefault()
    else if key == "Escape"
      sendTerminalControl("\u{001B}")
      preventDefault()
    else if key == "Tab"
      sendTerminalControl("\u{0009}")
      preventDefault()
    else if key.toLowerCase() == "c" and e.ctrlKey
      sendTerminalControl("\u{0003}")
      preventDefault()
    else if key.toLowerCase() == "d" and e.ctrlKey
      sendTerminalControl("\u{0004}")
      preventDefault()

  action pasteTerminal(e: ClipboardEvent)
    if threadRoute.name == "terminal" and e.text != ""
      send terminalWritten = writeTerminal(threadRoute.params.id, threadRoute.params.terminalId, e.text)
      preventDefault()

  action clearTerminalOutput
    if threadRoute.name == "terminal"
      send terminalCleared = clearTerminal(threadRoute.params.id, threadRoute.params.terminalId)

  action runTerminalScript(threadId: string, scriptId: string)
    terminalLaunchThreadId = threadId
    send terminalScriptStarted = runTerminalScript(threadId, scriptId)

  action afterTerminalScript
    match terminalScriptStarted
      case some(reply)
        if reply.ok and terminalLaunchThreadId == activeThreadId
          let base = split ? threadNav : nav
          nav = threadRoute.name == "terminal" ? replace(base, path("terminal", terminalLaunchThreadId, reply.terminalId)) : push(base, path("terminal", terminalLaunchThreadId, reply.terminalId))
      case none
        nav = nav

  task regroup when needsRegroup key=`${split}:${nav.tab}:${nav.next}:${current.id}`
    after(1, regroupNow)

  action regroupNow
    if needsRegroup
      send regrouped = regroupNavigation(nav, split)

  action afterRegroup
    match regrouped
      case some(change)
        if change.before == nav and change.split == split
          nav = change.after
      case none
        nav = nav

  action selectTab(name: string)
    if name == "usage"
      usageWindowTime = performanceNow()
    cancelForkNavigation()
    clearForceStopDialogs()
    nav = select(nav, split and name == "threads" ? "threadDetail" : split and name == "settings" ? "settingsDetail" : name)

  action search(value: string)
    query = value

  action startMessageSearch
    messageQuery = searchText

  action toggleSidebar
    sidebarHidden = not sidebarHidden

  action filterEnvironment(id: string)
    selectedEnvironment = id
    selectedProject = ""

  action filterProject(id: string)
    selectedProject = id

  action resetFilters
    selectedEnvironment = ""
    selectedProject = ""

  action openEnvironments
    nav = go(split ? select(settingsNav, "settingsDetail") : nav, "/environments")

  action refreshUsage
    usageWindowTime = performanceNow()
    usageRefresh = usageRefresh + 1

  action selectUsageView(value: string)
    if usageView == "Limits"
      usageWindowTime = performanceNow()
      usageRefresh = 0
    usageView = value

  action selectUsageDays(days: number)
    usageWindowTime = performanceNow()
    usageDays = days
    usageRefresh = 0

  action openKeyboardSettings
    nav = push(split ? settingsNav : nav, "/settings/keyboard")

  action selectReturnBehavior(value: string)
    composerReturnBehavior = value

  action composerReturnKey(key: string, e: KeyboardEvent)
    if key == "Enter" and e.code != "" and not e.isComposing and not e.altKey
      let modified = e.metaKey or e.ctrlKey
      if (composerReturnBehavior == "send" and not e.shiftKey) or (composerReturnBehavior == "newline" and modified)
        preventDefault()
        if not e.repeat
          sendMessage(composerReturnBehavior == "send" ? modified : e.shiftKey)

  action manageEnvironment(id: string)
    expandedEnvironment = ""
    nav = push(split ? settingsNav : nav, path("environmentDetail", id))

  action expandEnvironment(id: string)
    expandedEnvironment = expandedEnvironment == id ? "" : id
    match first(catalog.environments.filter(environment => environment.id == id))
      case some(environment)
        environmentName = environment.label
        environmentUrl = environment.url.endsWith("/") ? environment.url : environment.url + "/"
      case none
        expandedEnvironment = ""

  action editEnvironmentName(value: string)
    environmentName = value

  action editEnvironmentUrl(value: string)
    environmentUrl = value

  action saveEnvironment(id: string)
    send savedEnvironment = updateEnvironment(id, environmentName, environmentUrl)

  action afterEnvironmentSave
    if environmentError == ""
      expandedEnvironment = ""

  action reconnectEnvironment(id: string)
    send changed = command("reconnect", id, "")

  action askRemoveEnvironment(id: string)
    removedEnvironment = id
    showModal("remove-environment")

  action removeEnvironment
    send removed = command("remove", removedEnvironment, "")

  action afterEnvironmentRemove
    if removeError == ""
      nav = back(nav)

  action addEnvironment
    nav = split ? push(select(settingsNav, "settingsDetail"), "/environments/new") : push(nav, "/environments/new")

  action editAddress(value: string)
    address = value

  action editCode(value: string)
    code = value

  action pair
    send paired = command("pair", address.trim(), code.trim())

  action afterPair
    if pairError == "" and current.name == "addEnvironment"
      nav = back(nav)
      address = ""
      code = ""

  action follow(url: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    let base = split and nav.tab == "threads" ? threadNav : split and nav.tab == "settings" ? settingsNav : nav
    let followed = go(base, url)
    nav = followed.next == base.next ? followed : open(base, url)

  action editPullSearch(value: string)
    pullSearchDraft = value

  action applyPullSearch
    pullQuery = pullSearchText
    pullPageIndex = 0

  action resetPullPages
    pullPageIndex = 0

  action morePulls
    if pullRequests.hasMore and not pending(pullRequests)
      pullPageIndex = pullPageIndex + 1

  action filterPullState(value: string)
    if value != pullState and (value == "open" or value == "closed" or value == "merged" or value == "all")
      editPullPrefs("state", value, [])
      pullPageIndex = 0

  action filterPullInvolvement(value: string)
    if value != pullInvolvement and (value == "all" or value == "reviewing" or value == "authored")
      editPullPrefs("involvement", value, [])
      pullPageIndex = 0

  action openPullRequest(projectId: string, number: number)
    nav = push(nav, path("pullRequest", projectId, `${number}`))

  action backPullRequest
    nav = back(nav)

  action openPullRequestUrl(url: string)
    if url != ""
      openURL(url)

  action openThread(url: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    let base = split ? threadNav : nav
    let detail = activeThreadId != "" ? go(base, path("thread", activeThreadId)) : base
    nav = split and depth(detail) > 1 ? replace(detail, url) : go(detail, url)

  action compose
    cancelForkNavigation()
    clearForceStopDialogs()
    if not pending(composed)
      send composed = startNewTask(activeThreadId != "" ? activeThreadId : activeDraftKey, time.epochAtZero + performanceNow())

  action workspaceAction(value: string)
    if value.startsWith("tab:")
      cancelForkNavigation()
      clearForceStopDialogs()
      nav = select(nav, value.replaceAll("tab:", ""))
    else if value == "compose"
      compose()

  action toggleShelf(key: string)
    if key == "snoozed"
      showSnoozed = not showSnoozed
    else if key == "settled"
      showSettled = not showSettled

  action toggleWorking
    showWorking = not showWorking

  action toggleEnvironment(id: string, enabled: bool)
    send changed = command("toggle", id, enabled ? "true" : "false")

  action editComposer(value: string)
    if draftsReady and activeComposerId != "" and (activeThreadId != "" or activeDraftKey != "")
      let previous = activeDraft
      let removedComposerAttachmentsAttachments = previous.attachments.filter(item => composerDocument.attachments.filter(ref => ref.attachmentId == item.localId or ref.attachmentId == item.id).length > 0 and composerDocument.attachments.filter(ref => (ref.attachmentId == item.localId or ref.attachmentId == item.id) and value.includes(ref.source)).length == 0)
      let revision = previous.revision + 1
      persistDraft(ThreadDraft(previous, text=value, attachments=previous.attachments.filter(item => removedComposerAttachmentsAttachments.filter(entry => entry.localId == item.localId).length == 0), revision=revision))
      transferSlots = transferSlots.filter(slot => slot.draftId != previous.id or removedComposerAttachmentsAttachments.filter(item => item.localId == slot.localId).length == 0)
      if previous.pendingSend == none
        attachmentCleanup = attachmentCleanup.concat(removedComposerAttachmentsAttachments.map(item => CleanupAttachment(threadId=attachmentThreadId, draftId=previous.id, accessKey=attachmentAccess.accessKey, attachmentId=item.id, path=item.path, revision=revision)))

  action inputComposer(value: string, event: InputEvent)
    editComposer(value)
    observeComposerSelection(event)

  action copyMessage(body: string)
    copyText(body)

  action composerMetrics(value: string)
    composerBottomAdjustment = match parseNumber(value) { case some(inset) => inset, case none => 0 }

  action composerFocused
    composerFocus = true

  action composerBlurred
    composerFocus = false

  action focusComposer
    storeComposerSession(ComposerSession(composerSession, focusSerial=composerSession.focusSerial + 1))
    focus("composer")

  task composerFit when activeComposerId != "" key=`${threadRoute.id}:${composer}:${composerAttachments.length}:${composerFocus}:${split}:${sidebarHidden}`
    after(1, fitComposer, wait=frame)

  action fitComposer
    let surface = frame("composer-surface")
    let line = frame("composer-mirror")
    if not surface.unavailable and not line.unavailable and not surface.provisional and not line.provisional
      let limit = surface.width >= 500 ? 3 : 1
      let shown = composerFocus ? 0 : min(composerAttachments.length, limit)
      let thumbnails = shown == 0 ? 0 : 4 + shown * 30 + (shown - 1) * 4 + (composerAttachments.length > limit ? 34 : 0)
      composerThumbnailLimit = limit
      composerWide = line.width > surface.width - 218 - thumbnails

  action inspect(kind: string)
    cancelForkNavigation()
    clearForceStopDialogs()
    inspectorPath = ""
    nav = push(split ? threadNav : nav, path("inspector", activeComposerId, kind))

  action ignoreGitStatus

  action editGitCommitMessage(value: string)
    gitCommitMessage = value

  action toggleGitFile(path: string)
    gitExcludedFiles = gitExcludedFiles.includes(path) ? gitExcludedFiles.filter(value => value != path) : gitExcludedFiles.concat([path])

  action toggleAllGitFiles
    gitExcludedFiles = gitExcludedFiles.length == 0 ? gitStatus.workingFiles.map(file => file.path) : []

  action openGitCommit
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and not gitBusy
      gitCommitMessage = ""
      gitExcludedFiles = []
      nav = push(split ? threadNav : nav, path("gitCommit", activeThreadId))

  action openGitOverview
    if activeThreadId != "" and activeThreadHasMessage
      gitNewBranch = ""
      gitWorktreeBase = gitStatus.refName == "" ? "main" : gitStatus.refName
      gitWorktreeBranch = ""
      nav = push(split ? threadNav : nav, path("gitOverview", activeThreadId))

  action refreshGitOverview
    if not gitBusy
      gitStatusRevision = gitStatusRevision + 1

  action editGitNewBranch(value: string)
    gitNewBranch = value

  action editGitWorktreeBase(value: string)
    gitWorktreeBase = value

  action editGitWorktreeBranch(value: string)
    gitWorktreeBranch = value

  action createGitBranch
    if activeThreadId != "" and gitWritable and not gitBusy and gitNewBranch.trim() != ""
      send gitBranchCreated = createGitBranch(activeThreadId, gitNewBranch.trim())

  action createGitWorktree
    if activeThreadId != "" and gitWritable and not gitBusy and gitWorktreeBase.trim() != "" and gitWorktreeBranch.trim() != ""
      send gitWorktreeCreated = createGitWorktree(activeThreadId, gitWorktreeBase.trim(), gitWorktreeBranch.trim())

  action requestGitAction(action: string, includesCommit: bool)
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and not gitBusy
      if gitStatus.isDefaultRef and (action == "push" or action == "create_pr" or action == "commit_push" or action == "commit_push_pr")
        gitConfirmAction = action
        gitConfirmIncludesCommit = includesCommit
        nav = push(split ? threadNav : nav, path("gitConfirm", activeThreadId))
      else
        runGit(action, gitCommitMessage, false, selectedGitFiles.map(file => file.path))

  action confirmGitAction(featureBranch: bool)
    nav = back(nav)
    runGit(gitConfirmAction, gitCommitMessage, featureBranch, selectedGitFiles.map(file => file.path))

  action submitGitCommit(featureBranch: bool)
    nav = back(nav)
    runGit("commit", gitCommitMessage, featureBranch, selectedGitFiles.map(file => file.path))

  action cancelGitRoute
    nav = back(nav)

  action afterGitAction
    if gitError.toLowerCase().includes("permission") or gitError.toLowerCase().includes("scope") or gitError.toLowerCase().includes("not authorized")
      gitReadOnly = true

  action runQuickGitAction
    let kind = gitQuickActionKind(gitStatus, gitBusy, gitWritable)
    if kind == "pull"
      pullLatest()
    else if kind == "open_pr"
      match gitStatus.pullRequest
        case some(pr)
          openURL(pr.url)
        case none
          inspect("git")
    else if kind == "commit"
      requestGitAction("commit", true)
    else if kind == "commit_push"
      requestGitAction("commit_push", true)
    else if kind == "commit_push_pr"
      requestGitAction("commit_push_pr", true)
    else if kind == "push"
      requestGitAction("push", false)
    else if kind == "create_pr"
      requestGitAction("create_pr", false)
    else
      inspect("git")

  action pullLatest
    if (activeThreadId != "" or activeDraftKey != "") and gitStatus.isRepo and gitWritable and gitStatus.behindCount > 0 and gitOperation.status != "running"
      send pulled = pullGit(activeThreadId != "" ? activeThreadId : activeDraftKey, newTask.environmentId, newTask.cwd)

  action switchGitRef(name: string)
    if activeThreadId != "" and gitWritable and not gitBusy and name != ""
      send gitRefChanged = switchGitRef(activeThreadId, name)

  action runGit(action: string, message: string, featureBranch: bool, files: string[])
    if activeThreadId != "" and gitStatus.isRepo and gitWritable and gitOperation.status != "running"
      send gitActionResult = runGitAction(activeThreadId, action, message, featureBranch, files)

  action inspectEntry(id: string, kind: string)
    if kind == "directory"
      inspectorPath = id
    else if kind == "file"
      nav = push(split ? threadNav : nav, path("linkedFile", activeThreadId, id, "0", "0"))

  action inspectParent
    inspectorPath = parentDirectory(inspectorPath)

  action sendMessage(alternate: bool)
    if composerSession.editingQueueId != ""
      saveQueuedComposer()
    else if activeDraftKey != ""
      launchTask()
    else if canSend and activeThreadId != ""
      attachmentError = ""
      let followUp = threadControls.stop.runId == "" ? "auto" : serverQueue.canSendNow ? (alternate ? "queue" : "steer") : "queue"
      send preparedSend = prepareSend(activeDraft, composerSendScope, newTask, followUp)

  action afterSend
    match sent
      case some(reply)
        let draft = threadDraft(savedDrafts, draftEdits, reply.id)
        match draft.pendingSend
          case some(message)
            if message.commandId == reply.commandId and message.launch != none
              let state = reply.ok ? "accepted" : reply.state == "unknown" ? "unknown" : "rejected"
              persistDraft(ThreadDraft(draft, revision=draft.revision + 1, text=(reply.ok ? "" : draft.text), context=(reply.ok ? "" : draft.context), freshContext=(reply.ok ? false : draft.freshContext), attachments=(reply.ok ? [] : draft.attachments), pendingSend=some(PendingSend(message, state=state, error=reply.error))))
              if reply.ok
                attachmentCleanup = attachmentCleanup.concat(message.paths.filter(path => allDrafts.filter(other => other.id.startsWith("composer-queue:") and other.attachments.filter(item => item.path == path).length > 0).length == 0).map(path => CleanupAttachment(threadId=draft.id, draftId=draft.id, accessKey="", attachmentId="", path=path, revision=draft.revision + 1)))
            else if message.commandId == reply.commandId
              let same = draft.revision == message.revision
              let revision = draft.revision + 1
              let updated = ThreadDraft(draft, revision=revision, text=(reply.ok and same ? "" : draft.text), context=(reply.ok and same ? "" : draft.context), freshContext=(reply.ok and same ? false : draft.freshContext), attachments=(reply.ok and same ? [] : draft.attachments), pendingSend=(reply.state == "unknown" ? some(PendingSend(message, state="unknown", revision=(same ? revision : message.revision))) : none))
              persistDraft(updated)
              if reply.state != "unknown"
                attachmentCleanup = attachmentCleanup.concat(message.paths.filter(path => updated.attachments.filter(item => item.path == path).length == 0 and allDrafts.filter(other => other.id.startsWith("composer-queue:") and other.attachments.filter(item => item.path == path).length > 0).length == 0).map(path => CleanupAttachment(threadId=draft.id, draftId=draft.id, accessKey="", attachmentId="", path=path, revision=updated.revision)))
          case none
            draftEdits = draftEdits
      case none
        draftEdits = draftEdits

  view
    main interactive-widget="resizes-content" testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" display="flex" flex-direction="column" font-family="DM Sans" font-size=16 color="foreground" background-color="screen"
      input type="file" id="attachment-photos" accept="image/*" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-photos"
      input type="file" id="attachment-files" multiple=true display="none" change=pickedAttachments cancel=cancelledAttachments testId="attachment-files"
      column id="attachment-menu" popover="auto" role="menu" aria-label="Add attachment"
        button press=pickAttachments(true) role="menuitem" testId="choose-photos"
          image "symbol:sf/photo.on.rectangle"
          text "Photo Library"
        if attachmentAccess.maxFileBytes > 0
          button press=pickAttachments(false) role="menuitem" testId="choose-files"
            image "symbol:icon.directory"
            text "Choose Files"
      match attachmentViewer
        case some(viewer)
          if viewer.state != "presented"
            column position="absolute" inset=0 z-index=10 align-items="center" justify-content="center" background-color="screen" gap=12 padding=24
              text (viewer.error != "" ? viewer.error : "Opening attachment…") color=(viewer.error != "" ? "danger" : "muted") font-size=16
              button press=closeAttachmentViewer buttonStyle="bordered" testId="cancel-attachment-preview"
                text "Close"
        case none
          view display="none"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "threads"
                column navigationKey=`${e.id}` navigationScroll="home" data-workspace-header="brand" data-search-placement=(split ? "integrated" : "button") data-brand-stage="DEV" position="absolute" inset=0 display="flex" flex-direction="column" background-color=(split ? "drawer" : "screen")
                  header
                    text "Chats" role="heading" aria-level=2
                    input type="search" value=query input=search placeholder="Search threads" aria-label="Search threads" testId="search"
                    if duoFolded
                      button press=compose buttonStyle="glass" aria-label="New chat" testId="workspace-compose"
                        image "symbol:compose"
                  if failed(environmentState) or failed(catalog)
                    EmptyState(symbol="symbol:alert", title="Can’t load threads", message="Check the connection and try again.")
                  else if catalogLoading
                    column flex=1 align-items="center" justify-content="center" padding="122px 60px 128px" gap=7
                      text "Loading threads…" font-size=21 line-height="28px" font-weight=700 text-align="center" testId="loading-threads"
                      text "Loading projects and threads from the saved environment." font-size=16 line-height="24px" color="muted" text-align="center"
                  else if catalog.environments.length == 0 and not pending(catalog) and not pending(environmentState)
                    column flex=1 align-items="center" justify-content="center" padding="122px 60px 128px" gap=7
                      text (catalog.environments.length == 0 ? "No environments connected" : "No threads yet") font-size=21 line-height="28px" font-weight=700 text-align="center" testId="empty-title"
                      text (catalog.environments.length == 0 ? "Add an environment to load projects and start coding sessions." : "Start a new thread to begin coding.") font-size=16 line-height="24px" color="muted" text-align="center"
                      if catalog.environments.length == 0
                        button press=addEnvironment appearance="none" aria-label="Add environment" testId="empty-add-environment" background-color="AccentColor" color="white" border-radius=999 padding="10px 21px" min-height=42 margin-top=10.5 font-size=16 font-weight=500
                          text "Add environment"
                  else
                    ThreadList(now=time.epochAtZero + threadListClock, catalog=catalog, drafts=homeDrafts, openDraft=openHomeDraft, discardDraft=confirmDiscardDraft, aimDraft=aimHomeDraft, aimPin=aimPin, visibleThreads=visibleThreads, searchHits=searchHits, searchPending=(searchText.length >= 2 and searchText != messageQuery or pending(messageResults)), searchIncomplete=messageResults.filter(reply => reply.query == searchText and reply.unavailable).length > 0, selectedEnvironment=selectedEnvironment, selectedProject=selectedProject, selectedProjectLabel=selectedProjectLabel, nativeMenus=(device.kind != "web" and device.kind != ""), query=query, showSnoozed=showSnoozed, showSettled=showSettled, showWorking=showWorking, sidebar=split, selectedId=(split ? activeThreadId : ""), toggleShelf=toggleShelf, toggleWorking=toggleWorking, openThread=openThread, filterEnvironment=filterEnvironment, filterProject=filterProject, resetFilters=resetFilters)
                  if undoReceipt != "" and visibleTab == "threads"
                    row role="status" aria-live="polite" swipeleft=dismissPinUndo swiperight=dismissPinUndo testId="unpin-notice" position="absolute" bottom=(device.kind == "web" or device.rail ? 8 : "calc(64px + env(safe-area-inset-bottom))") left=(split ? 20 : 29) right=(split ? 20 : 23) z-index=100 align-items="center" gap=10.5 padding="7px 7px 7px 24.5px" backgroundMaterial="glass" background-color="card" border-radius=28 box-shadow="0 0 8px var(--composer-shadow)"
                      animation=(undoViewport.prefersReducedMotion ? "none" : "undoArrival 200ms cubic-bezier(0.33,1,0.68,1) both")
