                      row position="relative" padding="6px 12px" margin-bottom=composerBottomAdjustment margin-right=(split ? "env(safe-area-inset-right)" : 0) flex-shrink=0 min-width=0 box-sizing="border-box" testId="composer-dock"
                        view aria-hidden=true position="absolute" inset=0 pointer-events="none" background-image="linear-gradient(to bottom, var(--composer-wash-0) 0%, var(--composer-wash-60) 78%, var(--composer-wash-68) 100%)"
                        view aria-hidden=true position="absolute" left=0 right=0 top="100%" height=120 pointer-events="none" background-image="linear-gradient(to bottom, var(--composer-wash-68) 0px, var(--composer-wash-90) 34px, var(--composer-wash-90) 120px)"
