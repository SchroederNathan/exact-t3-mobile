use DraftAttachment, ThreadDraft, CleanupAttachment, attachmentSize, draftReceiptRevision, threadDraft from "./attachments.contract"

shape ComposerContextItem
  id: string
  label: string
  kind: string
  detail: string
  path: string
  insertText: string

shape ComposerCommandItem
  id: string
  label: string
  description: string
  kind: string
  insertText: string
  path: string

shape ComposerQueueItem
  id: string
  text: string
  attachments: DraftAttachment[]
  context: ComposerContextItem[]

shape ComposerVoice
  phase: string
  error: string

shape ComposerSession
  id: string
  context: ComposerContextItem[]
  queue: ComposerQueueItem[]
  queueMode: string
  editingQueueId: string
  queueSerial: number
  pendingQueueId: string
  queuedDraftRevision: number
  queuedRecordRevision: number
  cursor: number
  dismissedTrigger: string
  pendingCommand: string
  voice: ComposerVoice

shape ComposerTrigger
  kind: string
  query: string
  start: number
  end: number

fn emptyComposerSession(id: string): ComposerSession = ComposerSession(id=id, context=[], queue=[], queueMode="normal", editingQueueId="", queueSerial=0, pendingQueueId="", queuedDraftRevision=0, queuedRecordRevision=0, cursor=-1, dismissedTrigger="", pendingCommand="", voice=ComposerVoice(phase="idle", error=""))
fn sessionForComposer(sessions: ComposerSession[], id: string): ComposerSession = match first(sessions.filter(session => session.id == id)) { case some(session) => session, case none => emptyComposerSession(id) }
fn composerLastToken(text: string): string = match first(text.replaceAll("\n", " ").replaceAll("\t", " ").split(" ").slice(-1)) { case some(token) => token, case none => "" }
fn composerTrigger(text: string, cursor: number): ComposerTrigger = ComposerTrigger(kind=composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).startsWith("/") ? "/" : composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).startsWith("@") ? "@" : composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).startsWith("$") and parseNumber(composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).slice(1)) == none ? "$" : composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).startsWith("#") ? "#" : "", query=composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).slice(1), start=(cursor < 0 ? text.length : cursor) - composerLastToken(text.slice(0, cursor < 0 ? text.length : cursor)).length, end=(cursor < 0 ? text.length : cursor))
fn composerContextSymbol(kind: string): string = kind == "file" ? "symbol:sf/doc" : kind == "thread" ? "symbol:sf/bubble.left" : kind == "environment" ? "symbol:sf/desktopcomputer" : kind == "pull-request" ? "symbol:sf/arrow.triangle.pull" : kind == "model" ? "symbol:sf/cpu" : "symbol:sf/command"
fn composerCommandMatches(item: ComposerCommandItem, query: string): bool = query == "" or item.label.toLowerCase().includes(query.toLowerCase()) or item.description.toLowerCase().includes(query.toLowerCase())
fn composerPathContexts(text: string): ComposerContextItem[] = text.replaceAll("\n", " ").replaceAll("\t", " ").split(" ").slice(0, -1).filter(token => token.startsWith("@") and token.length > 1).map(token => ComposerContextItem(id=`file:${token.slice(1)}`, label=token.slice(1), kind="file", detail="Repository path", path=token.slice(1), insertText=token))
fn composerBuiltins(): ComposerCommandItem[] = [ComposerCommandItem(id="clear", label="/clear", description="Clear the message text and context", kind="clear", insertText="", path=""), ComposerCommandItem(id="files", label="/files", description="Mention a file or thread", kind="trigger", insertText="@", path=""), ComposerCommandItem(id="models", label="/model", description="Choose a model and reasoning level", kind="model-settings", insertText="", path=""), ComposerCommandItem(id="queue", label="/queue", description="Save this message to the draft queue", kind="queue", insertText="", path=""), ComposerCommandItem(id="attach", label="/attach", description="Choose a document from Files", kind="attachment", insertText="", path=""), ComposerCommandItem(id="voice", label="/voice", description="Voice input availability", kind="voice", insertText="", path="")]

members T3Code
  state composerSessions: ComposerSession[] = []
  state composerQueueSerial = 0 persist
  derive composerQueuePrefix = `composer-queue:${encodeURIComponent(activeComposerId)}:`
  derive composerSavedQueue = allDrafts.filter(draft => draft.id.startsWith(composerQueuePrefix) and (draft.text != "" or draft.attachments.length > 0)).map(draft => ComposerQueueItem(id=draft.id.slice(composerQueuePrefix.length), text=draft.text, attachments=draft.attachments, context=[]))
  derive composerSession = ComposerSession(sessionForComposer(composerSessions, activeComposerId), queue=composerSavedQueue)
  derive composerToken = composerTrigger(composer, composerSession.cursor)
  derive composerTriggerKey = `${composerToken.kind}:${composerToken.start}:${composerToken.query}`
  derive composerMenuVisible = composerToken.kind != "" and composerSession.dismissedTrigger != composerTriggerKey
  derive composerContext = composerSession.context.filter(item => composer.includes(item.insertText)).concat(composerPathContexts(composer).filter(item => composerSession.context.filter(entry => entry.id == item.id).length == 0))
  derive composerMentionItems = gitStatus.workingFiles.map(file => ComposerCommandItem(id=`file:${file.path}`, label=file.path, description=`Changed file · +${file.insertions} −${file.deletions}`, kind="file", insertText=`@${file.path}`, path=file.path)).concat(catalog.threads.filter(thread => thread.id != activeThreadId).map(thread => ComposerCommandItem(id=`thread:${thread.id}`, label=thread.title, description=`Thread · ${thread.project}`, kind="thread", insertText=`[${thread.title}](/threads/${thread.id})`, path=thread.id))).concat(catalog.environments.map(environment => ComposerCommandItem(id=`environment:${environment.id}`, label=environment.label, description=`Environment · ${environment.status}`, kind="environment", insertText=`Environment: ${environment.label}`, path=environment.id)))
  derive composerPullRequestItems = pullRequests.items.map(item => ComposerCommandItem(id=`pr:${item.projectId}:${item.number}`, label=`#${item.number} ${item.title}`, description=item.repository, kind="pull-request", insertText=item.url, path=item.url))
  derive composerCommands = (composerToken.kind == "/" ? composerBuiltins() : composerToken.kind == "@" ? composerMentionItems : composerToken.kind == "#" ? composerPullRequestItems : []).filter(item => composerCommandMatches(item, composerToken.query)).concat(composerToken.kind == "@" and composerToken.query != "" and composerMentionItems.filter(item => item.path == composerToken.query).length == 0 ? [ComposerCommandItem(id="path", label=composerToken.query, description="Mention repository path", kind="file", insertText=`@${composerToken.query}`, path=composerToken.query)] : []).slice(0, 8)
  derive canQueueComposer = draftsReady and composerSession.pendingQueueId == "" and (composer.trim() != "" or composerAttachments.length > 0) and attachmentSendReady and pendingMessage == none and not pending(sent) and not pending(preparedSend)

  task finishQueuedComposer when composerSession.queueMode == "saving" and draftReceiptRevision(persistedDrafts, `${composerQueuePrefix}${composerSession.pendingQueueId}`) >= composerSession.queuedRecordRevision key=`${activeComposerId}:${composerSession.pendingQueueId}:${composerSession.queuedRecordRevision}`
    after(1, finishQueueComposer)
  task finishLoadedComposer when composerSession.queueMode == "loading" and draftReceiptRevision(persistedDrafts, activeComposerId) >= composerSession.queuedDraftRevision key=`${activeComposerId}:${composerSession.pendingQueueId}:${composerSession.queuedDraftRevision}`
    after(1, finishQueueEdit)
  task applyComposerCommand when composerSession.pendingCommand != "" key=`${activeComposerId}:${composerSession.pendingCommand}`
    after(1, finishComposerCommand)

  action finishComposerCommand
    if composerSession.pendingCommand == "queue" and canQueueComposer
      queueComposer()
    else if composerSession.pendingCommand == "voice"
      requestComposerVoice()
    else
      storeComposerSession(ComposerSession(composerSession, pendingCommand=""))

  action storeComposerSession(session: ComposerSession)
    composerSessions = composerSessions.filter(entry => entry.id != session.id).concat([session])

  action observeComposerSelection(event: InputEvent)
    storeComposerSession(ComposerSession(composerSession, cursor=event.selectionStart, dismissedTrigger=""))

  action closeComposerCommands
    storeComposerSession(ComposerSession(composerSession, dismissedTrigger=composerTriggerKey))

  action openComposerCommands
    let position = composerSession.cursor < 0 ? composer.length : composerSession.cursor
    let prefix = composer.slice(0, position)
    let insert = prefix == "" or prefix.endsWith(" ") or prefix.endsWith("\n") ? "/" : " /"
    editComposer(`${prefix}${insert}${composer.slice(position)}`)
    storeComposerSession(ComposerSession(composerSession, cursor=position + insert.length, dismissedTrigger=""))
    focus("composer")
    setSelectionRange("composer", position + insert.length, position + insert.length)

  action chooseComposerCommand(item: ComposerCommandItem)
    let start = composerToken.start
    let replacement = item.insertText == "" ? "" : `${item.insertText}${item.kind == "trigger" ? "" : " "}`
    let updated = `${composer.slice(0, composerToken.start)}${replacement}${composer.slice(composerToken.end)}`
    if item.kind == "clear"
      editComposer("")
      storeComposerSession(ComposerSession(composerSession, context=[], cursor=0, dismissedTrigger=""))
    else
      editComposer(updated)
      let id = item.kind == "file" ? `file:${item.path}` : item.id
      let context = ["file", "thread", "environment", "pull-request", "model"].includes(item.kind) ? composerContext.filter(entry => entry.id != id).concat([ComposerContextItem(id=id, label=item.label, kind=item.kind, detail=item.description, path=item.path, insertText=item.insertText)]) : composerContext
      storeComposerSession(ComposerSession(composerSession, context=context, cursor=start + replacement.length, dismissedTrigger="", pendingCommand=(item.kind == "queue" or item.kind == "voice" ? item.kind : "")))
      if item.kind == "model-settings"
        openModelSettings()
      else if item.kind == "attachment"
        pickAttachments(false)
    focus("composer")
    setSelectionRange("composer", item.kind == "clear" ? 0 : start + replacement.length, item.kind == "clear" ? 0 : start + replacement.length)

  action removeComposerContext(id: string)
    match first(composerContext.filter(item => item.id == id))
      case some(item)
        editComposer(composer.replaceAll(item.insertText, ""))
        storeComposerSession(ComposerSession(composerSession, context=composerContext.filter(entry => entry.id != id), cursor=-1))
      case none
        closeComposerCommands()

  action removeComposerAttachment(id: string)
    match first(composerAttachments.filter(item => item.localId == id))
      case some(item)
        if allDrafts.filter(draft => draft.id.startsWith("composer-queue:") and draft.attachments.filter(attachment => attachment.path == item.path).length > 0).length > 0
          persistDraft(ThreadDraft(activeDraft, attachments=composerAttachments.filter(attachment => attachment.localId != id), revision=activeDraft.revision + 1))
        else
          removeAttachment(id)
      case none
        closeComposerCommands()

  action queueComposer
    if canQueueComposer
      let serial = composerQueueSerial + 1
      let id = composerSession.editingQueueId != "" ? composerSession.editingQueueId : `draft-${serial}`
      let previous = threadDraft(savedDrafts, draftEdits, `${composerQueuePrefix}${id}`)
      composerQueueSerial = serial
      storeComposerSession(ComposerSession(composerSession, queueMode="saving", pendingCommand="", pendingQueueId=id, queuedDraftRevision=activeDraft.revision, queuedRecordRevision=previous.revision + 1, queueSerial=serial))
      persistDraft(ThreadDraft(previous, text=composer, attachments=composerAttachments, revision=previous.revision + 1))

  action finishQueueComposer
    if activeDraft.revision == composerSession.queuedDraftRevision
      persistDraft(ThreadDraft(activeDraft, text="", attachments=[], revision=activeDraft.revision + 1))
      storeComposerSession(ComposerSession(composerSession, context=[], queueMode="normal", pendingQueueId="", editingQueueId="", cursor=0))
    else
      storeComposerSession(ComposerSession(composerSession, queueMode="normal", pendingQueueId="", editingQueueId=""))

  action editQueuedComposer(id: string)
    if composer.trim() == "" and composerAttachments.length == 0 and pendingMessage == none
      match first(composerSession.queue.filter(item => item.id == id))
        case some(item)
          let revision = activeDraft.revision + 1
          persistDraft(ThreadDraft(activeDraft, text=item.text, attachments=item.attachments, revision=activeDraft.revision + 1))
          storeComposerSession(ComposerSession(composerSession, context=item.context, queueMode="loading", pendingQueueId=id, queuedDraftRevision=revision, editingQueueId=id, cursor=item.text.length))
          focus("composer")
        case none
          closeComposerCommands()

  action finishQueueEdit
    let draft = threadDraft(savedDrafts, draftEdits, `${composerQueuePrefix}${composerSession.pendingQueueId}`)
    persistDraft(ThreadDraft(draft, text="", attachments=[], revision=draft.revision + 1))
    storeComposerSession(ComposerSession(composerSession, queueMode="editing", pendingQueueId=""))

  action removeQueuedComposer(id: string)
    if composerSession.editingQueueId != id
      let draft = threadDraft(savedDrafts, draftEdits, `${composerQueuePrefix}${id}`)
      persistDraft(ThreadDraft(draft, text="", attachments=[], revision=draft.revision + 1))
      match first(composerSession.queue.filter(item => item.id == id))
        case some(item)
          attachmentCleanup = attachmentCleanup.concat(item.attachments.filter(attachment => allDrafts.filter(other => other.id != draft.id and other.attachments.filter(active => active.path == attachment.path).length > 0).length == 0).map(attachment => CleanupAttachment(threadId=attachmentThreadId, draftId=draft.id, accessKey=attachmentAccess.accessKey, attachmentId=attachment.id, path=attachment.path, revision=draft.revision + 1)))
        case none
          closeComposerCommands()

  action releaseComposerQueueEdit
    let draft = threadDraft(savedDrafts, draftEdits, `${composerQueuePrefix}${composerSession.editingQueueId}`)
    persistDraft(ThreadDraft(draft, text="", attachments=[], revision=draft.revision + 1))
    storeComposerSession(ComposerSession(composerSession, queueMode="normal", pendingQueueId="", editingQueueId=""))

  action requestComposerVoice
    storeComposerSession(ComposerSession(composerSession, pendingCommand="", voice=ComposerVoice(phase="unavailable", error="Voice input is unavailable on this build. Use your keyboard’s dictation to add speech.")))

  action dismissComposerVoice
    storeComposerSession(ComposerSession(composerSession, voice=ComposerVoice(phase="idle", error="")))

component ComposerCommandSurface
  props
    trigger: ComposerTrigger
    items: ComposerCommandItem[]
    choose: action
    dismiss: action
  view
    column border-radius=18 background-color="card" border="1px solid var(--edge)" margin="0 12px 6px" max-height=260 overflow="hidden" testId="composer-commands"
      row align-items="center" padding="4px 8px 0 14px"
        text (trigger.kind == "/" ? "Commands" : trigger.kind == "@" ? "Files & context" : trigger.kind == "$" ? "Skills" : "Pull requests") flex=1 font-size=12 font-weight=700 color="muted"
        button press=dismiss appearance="none" width=32 height=32 aria-label="Close commands" testId="composer-commands-close"
          image "symbol:sf/xmark" width=10 height=10 color="muted"
      scroll min-height=0 overflow-x="hidden" max-height=220
        column
          if items.length == 0
            text (trigger.kind == "$" ? "This connection has not provided any skills." : trigger.kind == "@" ? "No matching files or context. Type a repository path after @." : "No matching commands") padding="10px 14px 16px" font-size=13 line-height="18px" color="muted" testId="composer-commands-empty"
          for item in items key=item.id
            button press=choose(item) appearance="none" display="flex" align-items="center" gap=10 text-align="left" min-height=50 padding="7px 14px" width="100%" box-sizing="border-box" retainFocus=true testId=`composer-command-${item.id}`
              image composerContextSymbol(item.kind) width=18 height=18 color="muted"
              column flex=1 min-width=0 gap=2
                text item.label font-size=14 line-height="19px" font-weight=500 line-clamp=1 text-overflow="ellipsis"
                text item.description font-size=12 line-height="16px" color="muted" line-clamp=1 text-overflow="ellipsis"

component ComposerContextChips
  props
    items: ComposerContextItem[]
    remove: action
  view
    scroll overflow-x="auto" overflow-y="hidden" min-width=0 testId="composer-context"
      row gap=6 padding="8px 14px 4px"
        for item in items key=item.id
          button press=remove(item.id) appearance="none" display="flex" align-items="center" gap=6 flex-shrink=0 max-width=240 min-height=30 padding="4px 9px" border-radius=9 background-color="bubble" aria-label=`Remove ${item.label} context` testId=`composer-context-${item.id}`
            image composerContextSymbol(item.kind) width=12 height=12 color="muted"
            text item.label min-width=0 font-size=12 line-height="17px" line-clamp=1 text-overflow="ellipsis"
            image "symbol:sf/xmark" width=8 height=8 color="muted"

component ComposerQueue
  props
    items: ComposerQueueItem[]
    editing: string
    canEdit: bool
    edit: action
    remove: action
    release: action
  view
    column margin="0 12px 6px" padding="8px 12px" border-radius=16 background-color="card" border="1px solid var(--edge)" gap=4 testId="composer-queue"
      text (items.length > 0 ? `Draft queue · ${items.length}` : "Draft queue") font-size=12 line-height="17px" font-weight=700 color="muted"
      if editing != ""
        row align-items="center" gap=8 min-height=34
          text "Editing queued draft" flex=1 font-size=13 color="muted" testId="composer-queue-editing"
          button press=release appearance="none" min-height=32 color="AccentColor" testId="composer-queue-use-draft"
            text "Use as draft" font-size=13
      for item in items key=item.id
        row align-items="center" gap=8 min-height=38 testId=`composer-queue-${item.id}`
          image "symbol:sf/text.line.first.and.arrowtriangle.forward" width=14 height=14 color="muted"
          column flex=1 min-width=0 gap=2
            text (item.text.trim() == "" ? "Attachments" : item.text) font-size=13 line-height="18px" line-clamp=1 text-overflow="ellipsis"
            if item.attachments.length > 0
              text `${item.attachments.length} ${item.attachments.length == 1 ? "attachment" : "attachments"}` font-size=11 color="muted"
          button press=edit(item.id) disabled=(not canEdit or editing != "") appearance="none" width=32 height=32 aria-label="Edit queued draft" testId=`composer-queue-edit-${item.id}`
            image "symbol:sf/pencil" width=13 height=13 color="muted"
          button press=remove(item.id) disabled=(editing == item.id) appearance="none" width=32 height=32 aria-label="Remove queued draft" testId=`composer-queue-remove-${item.id}`
            image "symbol:sf/xmark" width=11 height=11 color="muted"

component ComposerFileDetails
  props
    items: DraftAttachment[]
    preview: action
  view
    column padding="0 14px 6px" gap=4 testId="composer-file-details"
      for item in items.filter(item => item.type != "image") key=item.localId
        button press=preview(item) appearance="none" display="flex" align-items="center" gap=8 text-align="left" min-height=34 testId=`composer-file-detail-${item.localId}`
          image "symbol:sf/doc.text" width=15 height=15 color="muted"
          column flex=1 min-width=0
            text item.name font-size=12 line-height="17px" line-clamp=1 text-overflow="ellipsis"
            text `${attachmentSize(item.sizeBytes)} · ${item.mimeType}` font-size=11 line-height="15px" color="muted" line-clamp=1 text-overflow="ellipsis"
