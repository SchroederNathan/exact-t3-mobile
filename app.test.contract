test "home shows seeded environments and threads"
  clock data
  expect tree has "root"
  expect tree has "thread-offline-launch"
  expect tree has "all-projects"

test "environment toggles persist"
  clock data
  tap "environments-button"
  clock settle
  type "environment-pocket-pi" "true"
  clock data
  expect state catalog.environments.2.enabled == true

test "a thread opens and sends a local reply"
  tap "thread-offline-launch"
  clock settle
  expect text "message-offline-launch-2" == "I will check the mobile startup path, cache the last environment snapshot, and verify the reconnect flow."
  type "composer" "Check the cache"
  tap "send"
  clock data
  expect text "composer" == ""
  expect tree has "message-offline-launch-4"
