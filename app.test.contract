test "usage without an environment does not report measured activity"
  at "/usage"
  clock data
  clock settle
  expect text "usage-status" == "Select an environment to see limits."
  tap "usage-view-Cost"
  expect text "usage-status" == "Connect an environment to see usage."

test "a web visitor can switch workspace tabs without editing the address" on web
  clock data
  tap "tab-usage"
  clock settle
  expect state current.name == "usage"
  tap "tab-settings"
  clock settle
  expect state current.name == "settings"
  tap "tab-threads"
  clock settle
  expect state current.name == "threads"

test "keyboard return choice survives a reload and can be reversed"
  at "/settings"
  clock data
  tap "keyboard-button"
  clock settle
  expect state current.name == "keyboardSettings"
  expect state composerReturnBehavior == "send"
  tap "keyboard-newline"
  clock settle
  reload
  clock data
  expect state composerReturnBehavior == "newline"
  tap "keyboard-send"
  clock settle
  expect state composerReturnBehavior == "send"
  back
  clock settle
  expect state current.name == "settings"

test "fresh install has no fabricated environments or threads"
  clock data
  expect state catalog.environments == []
  expect state catalog.threads == []
  expect tree has "empty-add-environment"

test "a refused pairing keeps the address available to correct"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "file:///untrusted"
  type "pair-code" "example"
  tap "connect"
  clock data
  expect state catalog.environments == []
  expect text "address" == "file:///untrusted"
  expect state paired.ok == false

test "Back from Add environment pops to the screen beneath"
  clock data
  tap "empty-add-environment"
  clock settle
  expect state current.name == "addEnvironment"
  back
  clock settle
  expect state current.name == "threads"
  tap "empty-add-environment"
  clock settle
  back
  clock settle
  expect state current.name == "threads"

test "a phone keeps the list tab selected and never the detail tab"
  clock data
  clock +5
  expect state split == false
  expect state visibleTab == "threads"
  expect state current.name == "threads"

test "a new thread draft without a project opens Choose project, and Back closes both"
  at "/threads/new-task~abc-12345678"
  clock data
  clock settle
  expect state current.name == "chooseProject"
  expect text "projects-empty-title" == "No environments connected"
  expect tree has "projects-add-environment"
  expect tree missing "project-add"
  tap "project-back"
  clock settle
  expect state current.name == "threads"

test "composer command filtering leaves unknown commands in the draft" on web
  at "/threads/composer-test"
  clock data
  clock settle
  type "composer" "/does-not-exist"
  clock data
  clock settle
  expect tree has "composer-commands"
  expect tree has "composer-commands-empty"
  expect text "composer" == "/does-not-exist"

test "disconnected file context never fabricates a matching repository path" on web
  at "/threads/composer-test"
  clock data
  clock settle
  type "composer" "Review @src/App.ts"
  clock data
  clock settle
  expect tree has "composer-commands-empty"
  expect tree missing "composer-command-path:src/App.ts"
  expect text "composer" == "Review @src/App.ts"

test "currency is not interpreted as a skill command" on web
  at "/threads/composer-test"
  clock data
  clock settle
  type "composer" "Budget $100"
  expect tree missing "composer-commands"
