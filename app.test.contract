test "fresh install has no fabricated environments or threads"
  clock data
  expect state catalog.environments == []
  expect state catalog.threads == []
  expect tree has "empty-add-environment"

test "a refused pairing keeps the address available to correct"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "file:///untrusted"
  type "pair-code" "example"
  tap "connect"
  clock data
  expect state catalog.environments == []
  expect text "address" == "file:///untrusted"
  expect state paired.ok == false
