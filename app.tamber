tamber t3

theme
  AccentColor = light-dark(#1b4ed8, #346bf1)
  screen = light-dark(#fcfcfc, #0a0a0a)
  diff-add-fill = light-dark(#e5f8f5, #0d2f28)
  diff-remove-fill = light-dark(#ffe6e7, #391415)
  card = light-dark(#f4f4f5, #1a1b1b)
  chart-codex = light-dark(#3c3c43, #e6e6e6)
  chart-grok = light-dark(#52525b, #a1a1aa)
  chart-claude = #d97757 scheme=fixed
  chart-cursor = #8b8b8b scheme=fixed
  chart-opencode = #5b9bbd scheme=fixed
  chart-antigravity = #8c7bd1 scheme=fixed
  chart-pi = #4d9f8a scheme=fixed
  chart-muse = #0866ff scheme=fixed
  control-surface = light-dark(#fcfcfc, #111111)
  control-secondary = light-dark(#fafafa, #111111)
  scan-center = light-dark(#f4f4f5, #2e2e2e)
  scan-edge = light-dark(#d9d9dc, #0e0e0e)
  scan-ink = light-dark(#000000b3, #ffffffcc)
  scan-icon = light-dark(#00000099, #ffffffb3)
  control-danger-fill = light-dark(#fcebec, #301214)
  drawer = light-dark(#f4f4f5, #000000)
  thread-selected = light-dark(#e0e0e0, #1a1b1b)
  sidebar-foreground = light-dark(#27272a, #f1f3f7)
  sidebar-muted = light-dark(#6f6f79, #a3a3a3)
  foreground = light-dark(#27272a, #f5f5f5)
  muted = light-dark(#6f6f79, #838383)
  tab-muted = light-dark(#686872, #a0a0a8)
  tab-selected = light-dark(#275cdd, #759aff)
  composer-menu-muted = light-dark(#6f6f79, #92929a)
  icon = light-dark(#27272a, #f5f5f5)
  icon-muted = light-dark(#71717b, #818181)
  chevron = light-dark(#71717b6b, #8181816b)
  border-subtle = light-dark(#e4e4e7b3, #191919b3)
  subtle = light-dark(#fafafa, #111111)
  draft-amber = light-dark(#bb4d00, #ffd230)
  bubble = light-dark(#efeff1, #161616)
  edge = light-dark(#e4e4e7, #191919)
  danger = light-dark(#c10007, #ff6467)
  rose = light-dark(#ec003f, #ff637e)
  online = light-dark(#059669, #34d399)
  input-fill = light-dark(#ffffff, #111111)
  input-edge = light-dark(#e4e4e7, #222222)
  danger-fill = light-dark(#fef2f2, #2b1215)
  danger-edge = light-dark(#ffc9c9, #7f1d1d)
  provider-ink = light-dark(#171717, #e5e5e5)
  composer-shadow = light-dark(#00000026, #00000059)
  composer-wash-0 = light-dark(#fcfcfc00, #0a0a0a00)
  composer-wash-60 = light-dark(#fcfcfc99, #0a0a0a99)
  composer-wash-68 = light-dark(#fcfcfcad, #0a0a0aad)
  composer-wash-90 = light-dark(#fcfcfce6, #0a0a0ae6)
  send-disabled = light-dark(#27272a1f, #f5f5f51f)
  send-disabled-ink = light-dark(#27272a61, #f5f5f561)
  status-done = light-dark(#007a55, #5ee9b5)
  status-warning = light-dark(#bb4d00, #ffb86a)
  status-input = light-dark(#4f39f6, #a3b3ff)
  status-request = light-dark(#c800de, #f4a8ff)
  status-working = light-dark(#0084d1, #00bcff)
  provider-cursor-ink = light-dark(#26251e, #edecec)
  provider-neutral-ink = light-dark(#0f0f0f, #f5f5f5)
  provider-openrouter-ink = light-dark(#03080a, #fcfcfe)
  provider-opencode-inner = light-dark(#cfcecd, #4b4646)
  provider-opencode-outer = light-dark(#211e1e, #f1ecec)
  code-keyword = light-dark(#cf222e, #ff7b72)
  code-string = light-dark(#0a3069, #a5d6ff)
  code-number = light-dark(#0550ae, #79c0ff)
  code-comment = light-dark(#6e7781, #8b949e)
  code-function = light-dark(#8250df, #d2a8ff)
  code-type = light-dark(#953800, #ffa657)
  code-tag = light-dark(#116329, #7ee787)
  code-surface = light-dark(#ffffff, #111111)
  terminal-surface = light-dark(#fcfcfc, #0a0a0a)
  terminal-foreground = light-dark(#6c6c71, #adadb1)
  terminal-muted = light-dark(#8e8e95, #8e8e95)
  terminal-edge = light-dark(#eeeeef, #2e2e30)
  user-code-surface = light-dark(#00000029, #00000047)
  user-inline-code = light-dark(#27272ac7, #f5f5f5c7)

icons
  icon.disclose-forward = icon(sf "chevron.forward", svg "icons/disclose-forward.svg")
  icon.disclose-down = icon(sf "chevron.down", svg "icons/disclose-down.svg")
  icon.disclose-up = icon(sf "chevron.up", svg "icons/disclose-up.svg")
  icon.directory = icon(sf "folder", svg "icons/directory.svg")
