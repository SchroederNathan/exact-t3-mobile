epoch "2026-11-10T12:05:00Z"
time-zone "UTC"

test "usage displays server totals and refreshes the selected window"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  tap "tab-usage"
  clock data
  clock settle
  expect text "usage-limit-[\"fixture\",\"fixture-provider\"]-weekly" == "76% left"
  tap "usage-view-Cost"
  clock data
  expect text "usage-cost-fixture" == "$1.00"
  expect tree has "chart-fixture"
  tap "usage-view-Tokens"
  clock settle
  expect text "usage-tokens-fixture" == "15"
  tap "usage-period-1"
  clock data
  clock settle
  expect text "usage-tokens-fixture" == "7"
  tap "usage-view-Cost"
  tap "usage-refresh"
  clock data
  clock settle
  expect text "usage-cost-fixture" == "$1.50"
