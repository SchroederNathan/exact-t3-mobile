epoch "2026-11-10T12:05:00Z"
time-zone "UTC"

test "an empty search keeps the filters available and recovers when cleared"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  expect tree has "thread-fixture:alpha"
  type "search" "No matching thread"
  clock settle
  expect tree missing "thread-fixture:alpha"
  expect tree has "all-environments"
  expect tree has "all-projects"
  type "search" ""
  clock settle
  expect tree has "thread-fixture:alpha"

test "thread drafts survive switching conversations and relaunch"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  type "composer" "Alpha draft"
  back
  clock settle
  tap "thread-fixture:beta"
  clock settle
  expect text "composer" == ""
  type "composer" "Beta draft"
  back
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == "Alpha draft"
  back
  clock settle
  tap "thread-fixture:beta"
  clock settle
  expect text "composer" == "Beta draft"
  clock data
  reload
  clock data
  type "root" "/"
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == "Alpha draft"
  back
  clock settle
  tap "thread-fixture:beta"
  clock settle
  expect text "composer" == "Beta draft"

test "a rejected send preserves the draft and shows the reason"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  type "composer" "Keep this draft"
  tap "send"
  clock data
  expect text "composer" == "Keep this draft"
  expect text "send-error" == "Fixture rejected the message."

test "accepted sends preserve other drafts and newer edits across relaunch"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  type "composer" "Accept after release"
  tap "send"
  back
  tap "thread-fixture:beta"
  type "composer" "Beta draft during Alpha send"
  request POST "http://127.0.0.1:0/release"
  clock data
  expect text "composer" == "Beta draft during Alpha send"
  back
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == ""
  clock data
  reload
  clock data
  type "root" "/"
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == ""
  back
  clock settle
  tap "thread-fixture:beta"
  clock settle
  expect text "composer" == "Beta draft during Alpha send"
  back
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == ""
  type "composer" "Accept after release"
  tap "send"
  type "composer" "A newer Alpha draft"
  request POST "http://127.0.0.1:0/release"
  clock data
  expect text "composer" == "A newer Alpha draft"
  clock data
  reload
  clock data
  type "root" "/"
  clock settle
  tap "thread-fixture:alpha"
  clock settle
  expect text "composer" == "A newer Alpha draft"
  back
  clock settle
  tap "thread-fixture:beta"
  clock settle
  expect text "composer" == "Beta draft during Alpha send"

test "two environments stay independent through filtering and connection management"
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  type "root" "/settings"
  tap "environments-button"
  clock settle
  tap "environment-add-environments"
  clock settle
  type "address" "http://127.0.0.2:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  request POST "http://127.0.0.1:0/checkpoint"
  type "root" "/"
  clock settle
  expect tree has "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  type "search" "Gamma remote"
  clock settle
  expect tree missing "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  request POST "http://127.0.0.1:0/assert/both"
  type "search" ""
  clock settle
  expect tree has "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  request POST "http://127.0.0.1:0/assert/both"
  type "root" "/environments"
  clock settle
  tap "environment-fixture"
  clock data
  request POST "http://127.0.0.1:0/await/secondary-only"
  type "root" "/"
  clock settle
  expect tree missing "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  tap "thread-secondary:gamma"
  clock settle
  type "composer" "Accept on secondary"
  tap "send"
  clock data
  expect text "composer" == ""
  expect tree missing "send-error"
  request POST "http://127.0.0.1:0/assert/sent-secondary"
  back
  clock settle
  type "root" "/environments"
  clock settle
  tap "environment-fixture"
  clock data
  request POST "http://127.0.0.1:0/await/restored"
  clock data
  type "root" "/"
  clock settle
  expect tree has "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  request POST "http://127.0.0.1:0/checkpoint"
  type "root" "/environments"
  clock settle
  tap "manage-fixture"
  clock settle
  tap "manage-fixture"
  expect text "environment-label" == "Fixture Mac"
  expect text "environment-url" == "http://127.0.0.1:0/"
  type "environment-label" ""
  tap "environment-save"
  clock data
  expect text "environment-error" == "Enter an environment name."
  expect state catalog.environments.0 .label == "Fixture Mac"
  type "environment-label" "Renamed Mac"
  type "environment-url" "http://127.0.0.1:0/"
  tap "environment-save"
  clock data
  expect tree missing "environment-label"
  expect state catalog.environments.0 .label == "Renamed Mac"
  request POST "http://127.0.0.1:0/assert/both"
  tap "manage-fixture"
  expect text "environment-label" == "Renamed Mac"
  expect text "environment-url" == "http://127.0.0.1:0/"
  tap "environment-reconnect"
  clock data
  request POST "http://127.0.0.1:0/await/restored"
  clock data
  request POST "http://127.0.0.1:0/checkpoint"
  tap "environment-remove"
  clock settle
  tap "environment-remove-cancel"
  clock settle
  expect tree has "manage-fixture"
  expect state catalog.environments.0 .label == "Renamed Mac"
  request POST "http://127.0.0.1:0/assert/both"
  tap "environment-remove"
  clock settle
  tap "environment-remove-confirm"
  clock data
  clock settle
  request POST "http://127.0.0.1:0/await/secondary-only"
  expect tree missing "manage-fixture"
  expect tree has "manage-secondary"
  type "root" "/"
  clock settle
  expect tree missing "thread-fixture:alpha"
  expect tree has "thread-secondary:gamma"
  tap "thread-secondary:gamma"
  clock settle
  type "composer" "Accept on secondary"
  tap "send"
  clock data
  expect text "composer" == ""
  request POST "http://127.0.0.1:0/assert/sent-secondary"

test "a native relaunch keeps environments and delivered links restore their parent chain" on ios
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  type "root" "/threads/fixture%3Aalpha"
  clock data
  clock settle
  expect state current.name == "thread"
  expect state activeThreadId == "fixture:alpha"
  expect text "message-alpha-message" == "This is a deterministic test conversation."
  reload
  clock data
  clock settle
  expect state current.name == "threads"
  expect tree has "thread-fixture:alpha"
  type "root" "/threads/fixture%3Aalpha"
  clock data
  clock settle
  expect state current.name == "thread"
  expect state activeThreadId == "fixture:alpha"
  expect text "message-alpha-message" == "This is a deterministic test conversation."
  back
  clock settle
  expect state current.name == "threads"
  type "root" "/threads/fixture%3Aalpha/inspect/files"
  clock settle
  clock data
  expect state current.name == "inspector"
  expect state current.params.id == "fixture:alpha"
  expect state current.params.kind == "files"
  back
  clock settle
  expect state current.name == "thread"
  expect text "message-alpha-message" == "This is a deterministic test conversation."
  back
  clock settle
  expect state current.name == "threads"
  expect tree has "thread-fixture:alpha"
  type "root" "/environments/fixture"
  clock settle
  expect state current.name == "environmentDetail"
  expect state current.params.id == "fixture"
  expect state activeThreadId == ""
  expect tree has "manage-fixture"
  back
  clock settle
  expect state current.name == "environments"
  expect tree has "manage-fixture"
  back
  clock settle
  expect state current.name == "settings"

test "native model settings save and cancel through their own navigation stack" on ios
  clock data
  tap "empty-add-environment"
  clock settle
  type "address" "http://127.0.0.1:0"
  type "pair-code" "fixture-code"
  tap "connect"
  clock data
  clock settle
  tap "thread-fixture:alpha"
  clock data
  clock settle
  tap "model-settings"
  clock data
  clock settle
  expect state current.name == "threadSettings"
  expect state settings.selectedModelId == "fixture-provider:fixture-model"
  tap "favorite-fixture-provider:fixture-fast"
  clock data
  expect state settings.groups.0.models.0.id == "fixture-provider:fixture-fast"
  expect state settings.groups.0.models.0.isFavorite == true
  tap "model-fixture-provider:fixture-fast"
  clock data
  tap "cancel-settings"
  clock data
  clock settle
  expect state current.name == "thread"
  tap "model-settings"
  clock data
  clock settle
  expect state settings.selectedModelId == "fixture-provider:fixture-model"
  tap "model-fixture-provider:fixture-fast"
  clock data
  tap "option-effort"
  clock settle
  expect state current.name == "settingChoice"
  tap "choice-high"
  clock data
  clock settle
  expect state current.name == "threadSettings"
  tap "runtime-options"
  clock settle
  tap "choice-approval-required"
  clock data
  clock settle
  expect state settings.runtimeMode == "approval-required"
  tap "save-settings"
  clock data
  clock settle
  expect state current.name == "thread"
  type "composer" "Send chosen settings"
  clock data
  reload
  clock data
  clock settle
  tap "thread-fixture:alpha"
  clock data
  clock settle
  expect text "composer" == "Send chosen settings"
  tap "model-settings"
  clock data
  clock settle
  expect state settings.selectedModelId == "fixture-provider:fixture-fast"
  expect state settings.runtimeMode == "approval-required"
  tap "option-effort"
  clock settle
  expect state settings.options.0.value == "high"
  back
  clock settle
  tap "cancel-settings"
  clock data
  clock settle
  tap "send"
  clock data
  expect text "composer" == ""
  request POST "http://127.0.0.1:0/assert/settings"
