fn draftReceiptRevision(receipts: PersistedDraft[], id: string): number = match first(receipts.filter(receipt => receipt.id == id)) { case some(receipt) => receipt.revision, case none => -1 }
fn attachmentProgress(uploads: UploadProgress[], localId: string, attempt: number): number = match first(uploads.filter(upload => upload.localId == localId and upload.attempt == attempt)) { case some(upload) => upload.progress, case none => 0 }
fn attachmentSize(bytes: number): string = bytes >= 1048576 ? `${round(bytes / 104857.6) / 10} MB` : bytes >= 1024 ? `${round(bytes / 1024)} KB` : `${bytes} B`
fn attachmentPreviews(batch: AttachmentBatch, threadId: string, viewKey: string, id: string): AttachmentPreview[] = batch.threadId == threadId and batch.viewKey == viewKey ? batch.previews.filter(preview => preview.attachmentId == id) : []

component ComposerAttachments
  props
    items: DraftAttachment[]
    uploads: UploadProgress[]
    remove: action
    retry: action
    preview: action
  view
    scroll overflow-x="auto" overflow-y="hidden" width="100%" min-width=0 height=90 flex-shrink=0 testId="composer-attachments"
      row gap=10 padding="8px 14px 10px" align-items="flex-start"
        for item in items key=item.localId
          column position="relative" width=72 height=72 flex-shrink=0
            button press=preview(item) appearance="none" display="flex" flex-direction="column" align-items="center" justify-content="center" gap=4 width=72 height=72 box-sizing="border-box" padding=(item.type == "image" or isImageMime(item.mimeType) ? 0 : "0 8px") border-radius=16 background-color="bubble" overflow="hidden" aria-label=`Open ${item.name}` testId=`preview-draft-${item.localId}`
              if item.type == "image" or isImageMime(item.mimeType)
                image item.path width=72 height=72 object-fit="cover" testId=`draft-image-${item.localId}`
              else
                image "symbol:sf/doc" width=22 height=22 color="muted"
                text item.name width="100%" font-size=12 line-height="16px" color="foreground" text-align="center" line-clamp=1 text-overflow="ellipsis"
            button press=remove(item.localId) appearance="none" aria-label=`Remove ${item.name}` width=34 height=34 position="absolute" right=-2 top=-2 display="flex" align-items="center" justify-content="center" testId=`remove-attachment-${item.localId}`
              row width=22 height=22 align-items="center" justify-content="center" border-radius=11 background-color="rgba(0, 0, 0, 0.55)"
                image "symbol:sf/xmark" width=9 height=9 font-weight=700 color="white"
            if item.state == "failed"
              button press=retry(item.localId) appearance="none" display="flex" align-items="center" gap=2 aria-label=`Retry uploading ${item.name}: ${item.error}` position="absolute" left=2 bottom=2 background-color="rgba(0, 0, 0, 0.7)" border-radius=999 padding="2px 4px" testId=`retry-attachment-${item.localId}`
                image "symbol:sf/arrow.clockwise" width=10 height=10 color="white"
                text "Retry" font-size=12 line-height="16px" color="white"
            else if item.state != "uploaded"
              row position="absolute" left=2 bottom=2 align-items="center" gap=2 padding="2px 4px" border-radius=999 background-color="rgba(0, 0, 0, 0.7)" pointer-events="none"
                image "symbol:sf/arrow.up" width=10 height=10 color="white"
                text `${attachmentProgress(uploads, item.localId, item.attempt)}%` font-size=12 line-height="16px" color="white" font-variant-numeric="tabular-nums"

component ComposerThumbnail
  props
    item: DraftAttachment
    uploads: UploadProgress[]
    preview: action
  view
    button press=preview(item) appearance="none" position="relative" display="flex" align-items="center" justify-content="center" width=30 height=30 flex-shrink=0 border-radius=8 background-color="bubble" overflow="hidden" aria-label=`Open ${item.name}` testId=`thumbnail-${item.localId}`
      if item.type == "image" or isImageMime(item.mimeType)
        image item.path width=30 height=30 object-fit="cover"
      else
        image "symbol:sf/doc" width=15 height=15 color="muted"
      if item.state != "uploaded"
        row position="absolute" left=2 bottom=2 align-items="center" padding="2px 4px" border-radius=999 background-color="rgba(0, 0, 0, 0.7)"
          image (item.state == "failed" ? "symbol:sf/arrow.clockwise" : "symbol:sf/arrow.up") width=8 height=8 color="white"

fn isImageMime(mimeType: string): bool = ["image/jpeg", "image/png", "image/gif", "image/webp"].includes(mimeType.toLowerCase())
fn isAttachmentImage(item: Attachment): bool = item.type == "image" or isImageMime(item.mimeType)
fn attachmentSourceId(threadId: string, messageId: string, id: string): string = `attachment-image-${threadId}-${messageId}-${id}`
fn imageRatio(item: Attachment, previews: AttachmentPreview[]): number = match first(previews.filter(preview => preview.width > 0 and preview.height > 0)) { case some(preview) => preview.width / preview.height, case none => item.width > 0 and item.height > 0 ? item.width / item.height : 1.3 }

component MessageAttachments
  props
    items: Attachment[]
    threadId: string
    messageId: string
    viewKey: string
    batch: AttachmentBatch
    failures: ThumbnailFailure[]
    seen: action
    open: action
    retry: action
    imageFailed: action
    imageLoaded: action
  derive images = items.filter(item => isAttachmentImage(item))
  view
    column width="100%" max-width=320 gap=8 margin-bottom=8 align-self="flex-end" testId=`attachments-${messageId}`
      view display="grid" grid-template-columns=(images.length == 3 ? "3fr 2fr" : images.length > 1 ? "1fr 1fr" : "1fr") gap=0.5 border-radius=20 overflow="hidden"
        for item, index in images key=item.id
          column intersect=seen(threadId, viewKey, messageId, item.id) intersect-margin="160px" min-width=0 grid-column=(images.length > 3 and index == images.length - 1 and images.length % 2 == 1 ? "1 / span 2" : "auto") grid-row=(images.length == 3 and index == 0 ? "1 / span 2" : "auto")
            button press=open(threadId, messageId, item, items) appearance="none" width="100%" height=(images.length == 1 ? "auto" : images.length == 2 or (images.length == 3 and index == 0) ? "192px" : images.length == 3 ? "95.75px" : "96px") aspect-ratio=(images.length == 1 ? `${imageRatio(item, attachmentPreviews(batch, threadId, viewKey, item.id))}` : "auto") max-height=(images.length == 1 ? "480px" : "none") background-color="bubble" aria-label=`Open ${item.name}` testId=`attachment-${messageId}-${item.id}`
              if attachmentPreviews(batch, threadId, viewKey, item.id).filter(preview => preview.state == "ready").length > 0 and failures.filter(failure => failure.threadId == threadId and failure.viewKey == viewKey and failure.messageId == messageId and failure.attachmentId == item.id and failure.error != "").length == 0
                for preview in attachmentPreviews(batch, threadId, viewKey, item.id) key=preview.attachmentId
                  image `${preview.url}#attachment-${preview.attempt}` width="100%" height="100%" object-fit=(images.length == 1 ? "contain" : "cover") error=imageFailed(threadId, viewKey, messageId, item.id, preview.attempt) load=imageLoaded(threadId, viewKey, messageId, item.id, preview.attempt) testId=attachmentSourceId(threadId, messageId, item.id)
              else
                column align-items="center" justify-content="center" gap=6 height="100%" padding=12 box-sizing="border-box"
                  image "symbol:sf/photo" width=28 height=28 color="muted"
                  text item.name font-size=12 color="muted" line-clamp=2
            if attachmentPreviews(batch, threadId, viewKey, item.id).filter(preview => preview.state == "error" or preview.state == "missing").length > 0 or failures.filter(failure => failure.threadId == threadId and failure.viewKey == viewKey and failure.messageId == messageId and failure.attachmentId == item.id and failure.error != "").length > 0
              button press=retry(threadId, viewKey, messageId, item.id) appearance="none" color="danger" min-height=32 aria-label=`Retry preview for ${item.name}`
                text "Retry preview" font-size=12
      for item in items.filter(item => not isAttachmentImage(item)) key=item.id
        button press=open(threadId, messageId, item, items) disabled=(item.type == "unknown") appearance="none" display="flex" align-items="center" gap=10 min-height=56 padding=12 width="100%" max-width=280 box-sizing="border-box" border-radius=12 border="1px solid var(--edge)" background-color="card" text-align="left" aria-label=`Open ${item.name}` testId=`attachment-${messageId}-${item.id}`
          image "symbol:sf/doc" width=24 height=24 color="muted"
          column flex=1 min-width=0 gap=3
            text item.name font-size=14 line-clamp=2 text-overflow="ellipsis"
            text (item.type == "unknown" ? "Unsupported attachment" : `${item.mimeType} · ${attachmentSize(item.sizeBytes)}`) font-size=12 color="muted"
          image "symbol:sf/chevron.right" width=12 height=12 color="muted"

shape VerifiedAttachment
  threadId: string
  draftId: string
  localId: string
  attachmentId: string
  attempt: number
  accessKey: string
  state: string
  error: string

shape AttachmentConnection
  key: string
  valid: bool

shape CleanupAttachment
  threadId: string
  draftId: string
  accessKey: string
  attachmentId: string
  path: string
  revision: number

fn attachmentIdentity(threadId: string, localId: string, attempt: number): string = `${threadId}:${localId}:${attempt}`
fn slotIdentity(slot: AttachmentSlot): string = attachmentIdentity(slot.draftId, slot.localId, slot.attempt)
fn uploadedVerified(verified: VerifiedAttachment[], draftId: string, item: DraftAttachment, accessKey: string): bool = verified.filter(entry => entry.draftId == draftId and entry.localId == item.localId and entry.attachmentId == item.id and entry.attempt == item.attempt and entry.accessKey == accessKey and entry.state == "ready").length > 0

fn threadDraft(saved: ThreadDraft[], edits: ThreadDraft[], id: string): ThreadDraft = match first(edits.filter(draft => draft.id == id)) { case some(draft) => draft, case none => match first(saved.filter(draft => draft.id == id)) { case some(draft) => draft, case none => ThreadDraft(id=id, text="", revision=0, attachments=[], pendingSend=none) } }
