{
  "$schema": "../exact2-origin-main/scripts/app.schema.json",
  "name": "T3 Code Exact iOS",
  "short_name": "T3 Code",
  "id": "com.schroedernathan.t3code.exactios",
  "start_url": "/",
  "display": "standalone",
  "modules": ["workspace-tab-bar", "workspace-composer-glass"],
  "app": {
    "id": "com.schroedernathan.t3code.exactios",
    "name": "T3 Code Exact iOS"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": ["iphone", "ipad"],
      "localNetworking": "Connect to your T3 Code environments on your local network."
    }
  },
  "deploy": {
    "store": {
      "ios": "0"
    }
  },
  "data": ["workspace-header", "search-placement", "brand-stage", "hides-back", "sidebar"]
}
