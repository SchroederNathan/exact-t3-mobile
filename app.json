{
  "$schema": "../exact2-origin-main/scripts/app.schema.json",
  "name": "T3 Code Exact iOS",
  "short_name": "T3 Code",
  "id": "com.exact.t3code.ios",
  "start_url": "/",
  "display": "standalone",
  "icons": [{ "src": "assets/icon.png", "sizes": "1024x1024", "type": "image/png" }],
  "modules": ["workspace-tab-bar", "workspace-composer-glass", "workspace-filter-menu"],
  "app": {
    "id": "com.exact.t3code.ios",
    "name": "T3 Code Exact iOS"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": ["iphone", "ipad"],
      "link": ["-lc++"],
      "localNetworking": "Connect to your T3 Code environments on your local network."
    }
  },
  "deploy": {
    "store": {
      "ios": "0"
    }
  },
  "data": ["workspace-header", "search-placement", "brand-stage", "hides-back", "sidebar"],
  "commands": {
    "prepare-ios": ["python3", "native/highlight/build.py", "--install"]
  }
}
